# ====================================================================================
# Agentic AI Algorithmic Trading System v5.0 - Environment Configuration
# ====================================================================================
# 
# IMPORTANT: Copy this file to .env and update with your actual credentials
# Command: cp .env.example .env
#
# SECURITY WARNING: Never commit .env to version control!
# The .env file should be in .gitignore
# ====================================================================================

# ==================== DATABASE PASSWORDS ====================

# PostgreSQL (Transactional + Fundamental Data + Vectors)
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=ChangeMeInProduction123!
# Note: Use a strong password in production (min 16 chars, mixed case, numbers, symbols)

# ClickHouse (Time-Series Analytics)
CLICKHOUSE_PASSWORD=ChangeMeInProduction123!

# Neo4j (Knowledge Graph)
NEO4J_PASSWORD=ChangeMeInProduction123!

# Redis (Caching)
REDIS_PASSWORD=ChangeMeInProduction123!

# Qdrant (Vector Database)
QDRANT_API_KEY=
# Leave empty for development, set in production

# ==================== KAFKA ====================

# Kafka Cluster ID (Generated once, keep consistent)
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
# Generate new: base64 /dev/urandom | tr -dc 'A-Za-z0-9' | head -c 22

# ==================== MONITORING ====================

# Grafana Admin Credentials
GRAFANA_ADMIN_PASSWORD=admin
# Change in production!

# ==================== AUTHENTICATION ====================

# Keycloak Admin Credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Change in production!

# ==================== EXTERNAL API KEYS ====================

# Alpha Vantage (Required for Fundamental Analysis)
# Get free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
# Free tier: 5 API calls/minute, 500 calls/day

# Financial Modeling Prep (Optional - Premium Features)
FINANCIAL_MODELING_PREP_API_KEY=
# Get key: https://financialmodelingprep.com/developer/docs/pricing
# Leave empty to use free Yahoo Finance fallback

# Yahoo Finance (No API key needed, used as fallback)
# Backup data source, rate limits may apply

# ==================== INTERACTIVE BROKERS (For Live Trading) ====================

# IBKR TWS/Gateway Credentials
IBKR_USERNAME=
IBKR_PASSWORD=
IBKR_ACCOUNT_ID=
IBKR_TRADING_MODE=paper
# Options: paper | live (start with paper!)

# TWS/Gateway Connection
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
# Paper trading port: 7497
# Live trading port: 7496

# ==================== APPLICATION SETTINGS ====================

# Environment
NODE_ENV=development
# Options: development | staging | production

# API Gateway
API_GATEWAY_PORT=8000
API_GATEWAY_HOST=0.0.0.0

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==================== SECURITY ====================

# JWT Secret (Generate strong random string)
JWT_SECRET=your_jwt_secret_here_min_32_characters_random
# Generate: openssl rand -base64 32

# JWT Expiration
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ==================== AI/ML SETTINGS ====================

# OpenAI API (Optional - for AI Assistant enhanced features)
OPENAI_API_KEY=
# Get key: https://platform.openai.com/api-keys
# Leave empty to use open-source models only

# Hugging Face (Optional - for additional models)
HUGGINGFACE_API_KEY=
# Get key: https://huggingface.co/settings/tokens

# Model Settings
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Options: all-MiniLM-L6-v2 (384d, fast) | all-mpnet-base-v2 (768d, better quality)

# GPU Settings
CUDA_VISIBLE_DEVICES=0
# Set to GPU ID if you have multiple GPUs, or empty string to disable GPU

# ==================== LOGGING ====================

# Log Level
LOG_LEVEL=INFO
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL

# Log Format
LOG_FORMAT=json
# Options: json | text

# ==================== FEATURE FLAGS ====================

# Enable/Disable Features
FEATURE_LIVE_TRADING_ENABLED=false
# Set to true only after 90+ days successful paper trading!

FEATURE_OPTIONS_TRADING_ENABLED=true

FEATURE_ML_STRATEGIES_ENABLED=true

FEATURE_FUNDAMENTAL_ANALYSIS_ENABLED=true

FEATURE_AI_ASSISTANT_ENABLED=true

# ==================== PERFORMANCE ====================

# Database Connection Pools
POSTGRES_POOL_SIZE=20
REDIS_POOL_SIZE=50
CLICKHOUSE_POOL_SIZE=10

# Kafka Consumer Groups
KAFKA_CONSUMER_GROUP_ID=trading-system-consumers

# Background Job Workers
CELERY_WORKERS=4

# ==================== BACKUP & RECOVERY ====================

# Backup Schedule (Cron format)
BACKUP_SCHEDULE=0 2 * * *
# Default: 2 AM daily

# Backup Retention (days)
BACKUP_RETENTION_DAYS=30

# S3 Backup (Optional)
AWS_S3_BACKUP_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ==================== NOTIFICATIONS ====================

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@trading.localhost

# Slack (Optional)
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#trading-alerts

# Discord (Optional)
DISCORD_WEBHOOK_URL=

# Telegram (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==================== DEVELOPMENT ONLY ====================

# Django Debug (Backend)
DEBUG=true
# ALWAYS false in production!

# Hot Reload
WATCHPACK_POLLING=true

# Test Mode
TEST_MODE=false

# ==================== NOTES ====================
#
# Required for Basic Setup:
# - POSTGRES_PASSWORD
# - ALPHA_VANTAGE_API_KEY (get free key)
# - JWT_SECRET
#
# Required for Live Trading:
# - IBKR_USERNAME, IBKR_PASSWORD, IBKR_ACCOUNT_ID
# - Strong passwords for all databases
# - FEATURE_LIVE_TRADING_ENABLED=true (only after 90+ days paper trading)
#
# Optional Enhancements:
# - FINANCIAL_MODELING_PREP_API_KEY (premium fundamental data)
# - OPENAI_API_KEY (enhanced AI features)
# - S3 backup configuration
# - Notification webhooks
#
# ====================================================================================
