class PatternVectorizer:
    """
    Converts market patterns to vector embeddings.
    Supports multi-timeframe analysis and cross-asset pattern recognition.
    """

    def __init__(self, config: VectorDatabaseConfig)"""
        self.config = config
        self.logger = logging.getLogger(__name__)

        # Feature extractors
        self.price_features = PriceFeatureExtractor()
        self.volume_features = VolumeFeatureExtractor()
        self.technical_features = TechnicalFeatureExtractor()
        self.sentiment_features = SentimentFeatureExtractor()

        # Normalization
        self.scalers = {}
        self._initialize_scalers()

    def vectorize_pattern(
        self,
        market_data: Dict[str, Any],
        pattern_type: PatternType,
        asset_class: AssetClass,
        timeframe: str
    ) -> List[float]:
        """
        Convert market pattern to vector embedding.

        Args:
            market_data: Market data including OHLCV, indicators, etc.
            pattern_type: Type of pattern to vectorize
            asset_class: Asset class for pattern-specific features
            timeframe: Timeframe for pattern analysis

        Returns:
            Vector embedding of the pattern
        """
        try:
            features = []

            # Extract price-based features
            if pattern_type in [PatternType.PRICE_ACTION, PatternType.BREAKOUT, PatternType.TECHNICAL]:
                price_vec = self.price_features.extract(market_data, timeframe)
                features.extend(price_vec)

            # Extract volume-based features
            if pattern_type in [PatternType.VOLUME, PatternType.MOMENTUM]:
                volume_vec = self.volume_features.extract(market_data, timeframe)
                features.extend(volume_vec)

            # Extract technical indicator features
            if pattern_type in [PatternType.TECHNICAL, PatternType.MOMENTUM, PatternType.MEAN_REVERSION]:
                technical_vec = self.technical_features.extract(market_data, timeframe)
                features.extend(technical_vec)

            # Extract sentiment features
            if pattern_type == PatternType.SENTIMENT:
                sentiment_vec = self.sentiment_features.extract(market_data, timeframe)
                features.extend(sentiment_vec)

            # Add asset class encoding
            asset_encoding = self._encode_asset_class(asset_class)
            features.extend(asset_encoding)

            # Add timeframe encoding
            timeframe_encoding = self._encode_timeframe(timeframe)
            features.extend(timeframe_encoding)

            # Pad or truncate to fixed size
            vector = self._normalize_vector_length(features, self.config.pattern_vector_size)

            # Normalize vector
            vector = self._normalize_vector(vector)

            return vector

        except Exception as e:
            self.logger.error(f"Error vectorizing pattern: {e}")
            return [0.0] * self.config.pattern_vector_size

    def _initialize_scalers(self):
        """Initialize feature scalers."""
        self.scalers['price'] = StandardScaler()
        self.scalers['volume'] = MinMaxScaler()
        self.scalers['technical'] = StandardScaler()

    def _encode_asset_class(self, asset_class: AssetClass) -> List[float]"""
        """One-hot encode asset class."""
        encoding = [0.0] * len(AssetClass)
        encoding[list(AssetClass).index(asset_class)] = 1.0
        return encoding

    def _encode_timeframe(self, timeframe: str) -> List[float]"""
        """Encode timeframe as normalized value."""
        # Convert timeframe to minutes
        timeframe_map = {
            "1m": 1, "5m": 5, "15m": 15, "30m": 30,
            "1h": 60, "4h": 240, "1d": 1440, "1w": 10080
        }
        minutes = timeframe_map.get(timeframe, 60)
        # Normalize to [0, 1] range
        normalized = np.log1p(minutes) / np.log1p(10080)
        return [normalized]

    def _normalize_vector_length(self, features: List[float], target_size: int) -> List[float]"""
        """Normalize vector to target size."""
        if len(features) == target_size:
            return features
        elif len(features) > target_size:
            return features[:target_size]
        else:
            # Pad with zeros
            return features + [0.0] * (target_size - len(features))

    def _normalize_vector(self, vector: List[float]) -> List[float]"""
        """Normalize vector to unit length."""
        vector_np = np.array(vector)
        norm = np.linalg.norm(vector_np)
        if norm == 0:
            return vector
        return (vector_np / norm).tolist()


class FeatureExtractor:
    """Base class for feature extractors."""

    def extract(self, market_data: Dict[str, Any], timeframe: str) -> List[float]"""
        """Extract features from market data."""
        raise NotImplementedError


class PriceFeatureExtractor(FeatureExtractor):
    """Extracts price-based features."""

    def extract(self, market_data: Dict[str, Any], timeframe: str) -> List[float]"""
        """Extract price features."""
        features = []

        # Basic OHLCV features
        if 'ohlcv' in market_data:
            ohlcv = market_data['ohlcv']
            if len(ohlcv) >= 20:  # Need at least 20 periods
                closes = np.array([bar[4] for bar in ohlcv[-20:]])
                highs = np.array([bar[2] for bar in ohlcv[-20:]])
                lows = np.array([bar[3] for bar in ohlcv[-20:]])
                volumes = np.array([bar[5] for bar in ohlcv[-20:]])

                # Returns
                returns = np.diff(closes) / closes[:-1]
                features.extend([
                    np.mean(returns),
                    np.std(returns),
                    np.max(returns),
                    np.min(returns),
                    np.percentile(returns, 95),
                    np.percentile(returns, 5)
                ])

                # Price levels
                features.extend([
                    closes[-1] / np.mean(closes),
                    (closes[-1] - np.min(lows)) / (np.max(highs) - np.min(lows)),
                    np.max(highs) / np.min(lows)
                ])

                # Volatility
                features.extend([
                    np.std(returns) * np.sqrt(252),  # Annualized volatility
                    np.mean(np.abs(returns)),  # Mean absolute deviation
                ])

        return features


class VolumeFeatureExtractor(FeatureExtractor):
    """Extracts volume-based features."""

    def extract(self, market_data: Dict[str, Any], timeframe: str) -> List[float]"""
        """Extract volume features."""
        features = []

        if 'ohlcv' in market_data:
            ohlcv = market_data['ohlcv']
            if len(ohlcv) >= 20:
                volumes = np.array([bar[5] for bar in ohlcv[-20:]])
                prices = np.array([bar[4] for bar in ohlcv[-20:]])

                # Volume metrics
                volume_returns = np.diff(volumes) / volumes[:-1]
                features.extend([
                    np.mean(volumes),
                    np.std(volumes),
                    np.mean(volume_returns),
                    np.std(volume_returns)
                ])

                # Volume-price relationship
                price_volume_corr = np.corrcoef(prices, volumes)[0, 1]
                features.append(price_volume_corr if not np.isnan(price_volume_corr) else 0.0)

                # On-balance volume
                obv = np.zeros_like(volumes)
                for i in range(1, len(volumes)):
                    if prices[i] > prices[i-1]:
                        obv[i] = obv[i-1] + volumes[i]
                    elif prices[i] < prices[i-1]:
                        obv[i] = obv[i-1] - volumes[i]

                features.extend([
                    obv[-1],
                    np.mean(np.diff(obv)),
                    np.std(np.diff(obv))
                ])

        return features


class TechnicalFeatureExtractor(FeatureExtractor):
    """Extracts technical indicator features."""

    def extract(self, market_data: Dict[str, Any], timeframe: str) -> List[float]"""
        """Extract technical indicator features."""
        features = []

        if 'technical_indicators' in market_data:
            indicators = market_data['technical_indicators']

            # Moving averages
            if 'sma_20' in indicators and 'sma_50' in indicators:
                features.extend([
                    indicators['sma_20'] / indicators['sma_50'],
                    indicators.get('ema_12', 0) / indicators.get('ema_26', 1)
                ])

            # RSI
            if 'rsi' in indicators:
                rsi = indicators['rsi']
                features.extend([
                    rsi,
                    1.0 if rsi > 70 else (0.0 if rsi < 30 else 0.5)  # Overbought/Oversold
                ])

            # MACD
            if 'macd' in indicators and 'macd_signal' in indicators:
                features.append(indicators['macd'] - indicators['macd_signal'])

            # Bollinger Bands
            if 'bb_upper' in indicators and 'bb_lower' in indicators and 'bb_middle' in indicators:
                bb_position = (indicators.get('close', 0) - indicators['bb_lower']) / (indicators['bb_upper'] - indicators['bb_lower'])
                features.append(bb_position)

            # Stochastic
            if 'stoch_k' in indicators and 'stoch_d' in indicators:
                features.extend([
                    indicators['stoch_k'],
                    indicators['stoch_d']
                ])

        return features


class SentimentFeatureExtractor(FeatureExtractor):
    """Extracts sentiment-based features."""

    def extract(self, market_data: Dict[str, Any], timeframe: str) -> List[float]"""
        """Extract sentiment features."""
        features = []

        if 'sentiment' in market_data:
            sentiment = market_data['sentiment']

            # News sentiment
            features.extend([
                sentiment.get('news_score', 0.0),
                sentiment.get('social_media_score', 0.0),
                sentiment.get('analyst_score', 0.0)
            ])

            # Sentiment momentum
            if 'sentiment_history' in sentiment:
                history = sentiment['sentiment_history'][-10:]  # Last 10 periods
                if len(history) > 1:
                    sentiment_momentum = np.mean(np.diff(history))
                    features.append(sentiment_momentum)

        return features


class MLPredictiveEngine:
    """
    ML-powered predictive analytics engine for trading signals.
    Supports ensemble methods and real-time inference.
    """

    def __init__(self, config: MLModelConfig)"""
        self.config = config
        self.logger = logging.getLogger(__name__)

        if not ML_AVAILABLE:
            raise ImportError("ML dependencies not available. Install with: pip install scikit-learn torch")

        self.models = {}
        self.scalers = {}
        self.feature_importance = {}
        self.model_performance = {}

        self._initialize_models()

    def _initialize_models(self):
        """Initialize ML models."""
        if 'random_forest' in self.config.ensemble_methods:
            self.models['random_forest'] = RandomForestRegressor(
                n_estimators=self.config.n_estimators,
                max_depth=self.config.max_depth,
                random_state=self.config.random_state
            )

        if 'gradient_boosting' in self.config.ensemble_methods:
            self.models['gradient_boosting'] = GradientBoostingRegressor(
                n_estimators=self.config.n_estimators,
                learning_rate=self.config.learning_rate,
                max_depth=self.config.max_depth,
                random_state=self.config.random_state
            )

        if 'linear_regression' in self.config.ensemble_methods:
            self.models['linear_regression'] = LinearRegression()

        # Initialize scalers
        self.scalers['features'] = StandardScaler()
        self.scalers['target'] = MinMaxScaler()

    async def train_models(
        self,
        training_data: List[Dict[str, Any]],
        target_column: str = 'future_return'
    ) -> Dict[str, float]:
        """
        Train ML models on historical data.

        Args:
            training_data: List of training samples with features and targets
            target_column: Name of target column to predict

        Returns:
            Dictionary with model performance metrics
        """
        try:
            # Prepare features and targets
            features = []
            targets = []

            for sample in training_data:
                if 'features' in sample and target_column in sample:
                    features.append(sample['features'])
                    targets.append(sample[target_column])

            if not features or not targets:
                raise ValueError("No valid training data provided")

            X = np.array(features)
            y = np.array(targets)

            # Split data
            split_idx = int(len(X) * (1 - self.config.train_test_split))
            X_train, X_test = X[:split_idx], X[split_idx:]
            y_train, y_test = y[:split_idx], y[split_idx:]

            # Scale features
            X_train_scaled = self.scalers['features'].fit_transform(X_train)
            X_test_scaled = self.scalers['features'].transform(X_test)

            # Scale targets
            y_train_scaled = self.scalers['target'].fit_transform(y_train.reshape(-1, 1)).ravel()
            y_test_scaled = self.scalers['target'].transform(y_test.reshape(-1, 1)).ravel()

            performance_metrics = {}

            # Train each model
            for model_name, model in self.models.items():
                self.logger.info(f"Training {model_name} model...")

                # Train model
                model.fit(X_train_scaled, y_train_scaled)

                # Make predictions
                y_pred_scaled = model.predict(X_test_scaled)
                y_pred = self.scalers['target'].inverse_transform(y_pred_scaled.reshape(-1, 1)).ravel()

                # Calculate metrics
                mse = mean_squared_error(y_test, y_pred)
                mae = mean_absolute_error(y_test, y_pred)
                r2 = r2_score(y_test, y_pred)

                # Sharpe ratio (simplified)
                returns = y_pred
                sharpe = np.mean(returns) / (np.std(returns) + 1e-8)

                performance_metrics[model_name] = {
                    'mse': mse,
                    'mae': mae,
                    'r2': r2,
                    'sharpe_ratio': sharpe,
                    'accuracy': max(0, r2)  # Simplified accuracy metric
                }

                # Store feature importance if available
                if hasattr(model, 'feature_importances_'):
                    self.feature_importance[model_name] = model.feature_importances_.tolist()

                self.logger.info(f"{model_name} trained. R²: {r2:.3f}, Sharpe: {sharpe:.3f}")

            self.model_performance = performance_metrics
            return performance_metrics

        except Exception as e:
            self.logger.error(f"Error training models: {e}")
            return {}

    async def predict(
        self,
        features: List[float],
        ensemble_method: str = 'weighted_average'
    ) -> Dict[str, Any]:
        """
        Make predictions using trained models.

        Args:
            features: Feature vector for prediction
            ensemble_method: Method for combining predictions from multiple models

        Returns:
            Dictionary with prediction and confidence scores
        """
        try:
            if not self.models:
                raise ValueError("No trained models available")

            # Scale features
            features_scaled = self.scalers['features'].transform([features])

            predictions = {}
            confidences = {}

            # Get predictions from each model
            for model_name, model in self.models.items():
                try:
                    pred_scaled = model.predict(features_scaled)[0]
                    pred = self.scalers['target'].inverse_transform([[pred_scaled]])[0][0]
                    predictions[model_name] = pred

                    # Calculate confidence based on model performance
                    if model_name in self.model_performance:
                        perf = self.model_performance[model_name]
                        confidences[model_name] = max(0, perf.get('r2', 0))
                    else:
                        confidences[model_name] = 0.5

                except Exception as e:
                    self.logger.warning(f"Prediction failed for {model_name}: {e}")
                    continue

            if not predictions:
                raise ValueError("No models produced valid predictions")

            # Ensemble predictions
            if ensemble_method == 'weighted_average':
                # Weight by model performance
                total_confidence = sum(confidences.values())
                if total_confidence > 0:
                    ensemble_prediction = sum(
                        pred * confidences[model]
                        for model, pred in predictions.items()
                    ) / total_confidence
                    ensemble_confidence = np.mean(list(confidences.values()))
                else:
                    ensemble_prediction = np.mean(list(predictions.values()))
                    ensemble_confidence = 0.5

            elif ensemble_method == 'majority_vote':
                # Simple majority vote (simplified for regression)
                ensemble_prediction = np.median(list(predictions.values()))
                ensemble_confidence = np.mean(list(confidences.values()))

            else:
                # Simple average
                ensemble_prediction = np.mean(list(predictions.values()))
                ensemble_confidence = np.mean(list(confidences.values()))

            return {
                'prediction': ensemble_prediction,
                'confidence': ensemble_confidence,
                'individual_predictions': predictions,
                'individual_confidences': confidences,
                'ensemble_method': ensemble_method
            }

        except Exception as e:
            self.logger.error(f"Error making prediction: {e}")
            return {
                'prediction': 0.0,
                'confidence': 0.0,
                'error': str(e)
            }

    def get_feature_importance(self, model_name: Optional[str] = None) -> Dict[str, float]"""
        """Get feature importance for models."""
        if model_name and model_name in self.feature_importance:
            return {f"feature_{i}": imp for i, imp in enumerate(self.feature_importance[model_name])}
        elif not model_name:
            # Average feature importance across all models
            avg_importance = {}
            for model_name, importance in self.feature_importance.items():
                for i, imp in enumerate(importance):
                    key = f"feature_{i}"
                    avg_importance[key] = avg_importance.get(key, 0) + imp

            # Normalize by number of models
            num_models = len(self.feature_importance)
            if num_models > 0:
                avg_importance = {k: v / num_models for k, v in avg_importance.items()}

            return avg_importance

        return {}

    def save_models(self, directory: str)"""
        """Save trained models to disk."""
        import os
        os.makedirs(directory, exist_ok=True)

        for model_name, model in self.models.items():
            model_path = os.path.join(directory, f"{model_name}.joblib")
            joblib.dump(model, model_path)

        # Save scalers
        for scaler_name, scaler in self.scalers.items():
            scaler_path = os.path.join(directory, f"{scaler_name}_scaler.joblib")
            joblib.dump(scaler, scaler_path)

        # Save metadata
        metadata = {
            'config': asdict(self.config),
            'feature_importance': self.feature_importance,
            'model_performance': self.model_performance
        }

        metadata_path = os.path.join(directory, "metadata.json")
        with open(metadata_path, 'w') as f:
            json.dump(metadata, f, indent=2, default=str)

        self.logger.info(f"Models saved to {directory}")

    def load_models(self, directory: str)"""
        """Load trained models from disk."""
        import os

        for model_name in self.models.keys():
            model_path = os.path.join(directory, f"{model_name}.joblib")
            if os.path.exists(model_path):
                self.models[model_name] = joblib.load(model_path)

        # Load scalers
        for scaler_name in self.scalers.keys():
            scaler_path = os.path.join(directory, f"{scaler_name}_scaler.joblib")
            if os.path.exists(scaler_path):
                self.scalers[scaler_name] = joblib.load(scaler_path)

        # Load metadata
        metadata_path = os.path.join(directory, "metadata.json")
        if os.path.exists(metadata_path):
            with open(metadata_path, 'r') as f:
                metadata = json.load(f)

            self.feature_importance = metadata.get('feature_importance', {})
            self.model_performance = metadata.get('model_performance', {})

        self.logger.info(f"Models loaded from {directory}")


