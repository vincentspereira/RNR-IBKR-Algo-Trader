            raise ImportError("Qdrant client not available. Install with: pip install qdrant-client")

        # Initialize components
        self.qdrant_wrapper = QdrantWrapper(qdrant_config or QdrantConfig())
        self.pattern_vectorizer = PatternVectorizer(vector_config)
        self.ml_engine = MLPredictiveEngine(ml_config)

        # Smart Money Analysis integration
        self.smart_money_engine = SmartMoneyAnalysisEngine()

        # Trading system integration
        self.trading_wrapper = None

        # State management
        self.pattern_cache = {}
        self.signal_cache = {}
        self.performance_metrics = {}

        # Background tasks
        self._update_task = None
        self._monitoring_task = None

    async def initialize(self):
        """Initialize the Vector Database ML Engine."""
        await self.qdrant_wrapper.initialize()

        # Create collections
        await self._create_collections()

        # Start background tasks
        if self.vector_config.real_time_updates:
            self._start_background_tasks()

        self.logger.info("Vector Database ML Engine initialized successfully")

    async def _create_collections(self):
        """Create necessary vector collections."""
        # Pattern collections for each asset class
        for asset_class in AssetClass:
            collection_name = f"{self.vector_config.pattern_collection_prefix}{asset_class.value}"

            try:
                await self.qdrant_wrapper.create_collection(
                    collection_name=collection_name,
                    vector_size=self.vector_config.pattern_vector_size,
                    distance=self.vector_config.distance_metric
                )
                self.logger.info(f"Created collection: {collection_name}")
            except Exception as e:
                self.logger.warning(f"Collection {collection_name} may already exist: {e}")

        # Signal collection
        signal_collection_name = f"{self.vector_config.signal_collection_prefix}main"
        try:
            await self.qdrant_wrapper.create_collection(
                collection_name=signal_collection_name,
                vector_size=self.vector_config.signal_vector_size,
                distance=self.vector_config.distance_metric
            )
            self.logger.info(f"Created collection: {signal_collection_name}")
        except Exception as e:
            self.logger.warning(f"Collection {signal_collection_name} may already exist: {e}")

    async def store_pattern(self, pattern: MarketPattern) -> bool"""
        """
        Store a market pattern in the vector database.

        Args:
            pattern: MarketPattern to store

        Returns:
            True if stored successfully
        """
        try:
            collection_name = f"{self.vector_config.pattern_collection_prefix}{pattern.asset_class.value}"

            # Create vector point
            point = VectorPoint(
                id=pattern.pattern_id,
                vector=pattern.vector,
                payload={
                    'symbol': pattern.symbol,
                    'pattern_type': pattern.pattern_type.value,
                    'timeframe': pattern.timeframe,
                    'confidence_score': pattern.confidence_score,
                    'start_time': pattern.start_time.isoformat(),
                    'end_time': pattern.end_time.isoformat(),
                    'success_rate': pattern.success_rate,
                    'profit_factor': pattern.profit_factor,
                    'max_drawdown': pattern.max_drawdown,
                    'sharpe_ratio': pattern.sharpe_ratio,
                    'volatility': pattern.volatility,
                    'trend_strength': pattern.trend_strength,
                    'volume_profile': pattern.volume_profile,
                    'metadata': pattern.metadata,
                    'created_at': pattern.created_at.isoformat(),
                    'updated_at': pattern.updated_at.isoformat()
                }
            )

            # Store in vector database
            success = await self.qdrant_wrapper.upsert_points(collection_name, [point])

            if success:
                # Update cache
                self.pattern_cache[pattern.pattern_id] = pattern
                self.logger.info(f"Stored pattern {pattern.pattern_id} in {collection_name}")

            return success

        except Exception as e:
            self.logger.error(f"Error storing pattern {pattern.pattern_id}: {e}")
            return False

    async def find_similar_patterns(
        self,
        query_pattern: MarketPattern,
        limit: int = 10,
        similarity_threshold: float = None
    ) -> List[Tuple[MarketPattern, float]]:
        """
        Find similar patterns in the vector database.

        Args:
            query_pattern: Pattern to search for
            limit: Maximum number of results
            similarity_threshold: Minimum similarity score

        Returns:
            List of (pattern, similarity_score) tuples
        """
        try:
            collection_name = f"{self.vector_config.pattern_collection_prefix}{query_pattern.asset_class.value}"

            # Search for similar vectors
            results = await self.qdrant_wrapper.search_points(
                collection_name=collection_name,
                query_vector=query_pattern.vector,
                limit=limit,
                score_threshold=similarity_threshold or self.vector_config.similarity_threshold
            )

            similar_patterns = []
            for result in results:
                # Reconstruct pattern from payload
                payload = result.payload or {}

                pattern = MarketPattern(
                    pattern_id=result.id,
                    asset_class=AssetClass(payload.get('symbol', '').split(':')[0] if ':' in payload.get('symbol', '') else query_pattern.asset_class.value),
                    symbol=payload.get('symbol', ''),
                    pattern_type=PatternType(payload.get('pattern_type', 'price_action')),
                    timeframe=payload.get('timeframe', '1h'),
                    vector=[],  # Not storing vector in payload for memory efficiency
                    metadata=payload.get('metadata', {}),
                    confidence_score=payload.get('confidence_score', 0.0),
                    start_time=datetime.fromisoformat(payload.get('start_time', '2023-01-01')),
                    end_time=datetime.fromisoformat(payload.get('end_time', '2023-01-01')),
                    success_rate=payload.get('success_rate', 0.0),
                    profit_factor=payload.get('profit_factor', 0.0),
                    max_drawdown=payload.get('max_drawdown', 0.0),
                    sharpe_ratio=payload.get('sharpe_ratio', 0.0),
                    volatility=payload.get('volatility', 0.0),
                    trend_strength=payload.get('trend_strength', 0.0),
                    volume_profile=payload.get('volume_profile', 0.0),
                    created_at=datetime.fromisoformat(payload.get('created_at', '2023-01-01')),
                    updated_at=datetime.fromisoformat(payload.get('updated_at', '2023-01-01'))
                )

                similar_patterns.append((pattern, result.score))

            self.logger.info(f"Found {len(similar_patterns)} similar patterns for {query_pattern.pattern_id}")
            return similar_patterns

        except Exception as e:
            self.logger.error(f"Error finding similar patterns: {e}")
            return []

    async def generate_trading_signal(
        self,
        current_pattern: MarketPattern,
        prediction_horizon: str = "1d"
    ) -> TradingSignal:
        """
        Generate AI-enhanced trading signal using pattern similarity and ML prediction.

        Args:
            current_pattern: Current market pattern
            prediction_horizon: Time horizon for prediction

        Returns:
            Generated trading signal
        """
        try:
            # Find similar historical patterns
            similar_patterns = await self.find_similar_patterns(
                current_pattern,
                limit=50,
                similarity_threshold=0.6
            )

            # Extract features for ML prediction
            features = self._extract_signal_features(current_pattern, similar_patterns)

            # Make ML prediction
            ml_prediction = await self.ml_engine.predict(features, ensemble_method='weighted_average')

            # Generate signal based on ML prediction and pattern analysis
            prediction = ml_prediction.get('prediction', 0.0)
            confidence = ml_prediction.get('confidence', 0.0)

            # Determine signal type
            if prediction > 0.01:  # Positive threshold
                signal_type = SignalType.BUY
            elif prediction < -0.01:  # Negative threshold
                signal_type = SignalType.SELL
            else:
                signal_type = SignalType.HOLD

            # Calculate risk score based on pattern volatility
            risk_score = min(1.0, current_pattern.volatility / 0.5)  # Normalize volatility

            # Enhance confidence with pattern similarity
            if similar_patterns:
                avg_success_rate = np.mean([p[0].success_rate for p in similar_patterns])
                confidence = confidence * 0.7 + avg_success_rate * 0.3

            # Create trading signal
            signal = TradingSignal(
                signal_id=str(uuid.uuid4()),
                pattern_id=current_pattern.pattern_id,
                asset_class=current_pattern.asset_class,
                symbol=current_pattern.symbol,
                signal_type=signal_type,
                confidence=min(1.0, max(0.0, confidence)),
                prediction_horizon=prediction_horizon,
                expected_return=prediction,
                risk_score=risk_score,
                model_version="v1.0_ensemble",
                ensemble_score=confidence,
                feature_importance=self.ml_engine.get_feature_importance(),
                market_regime=self._detect_market_regime(current_pattern),
                volatility_regime=self._detect_volatility_regime(current_pattern.volatility),
                liquidity_score=0.8,  # Would calculate from order book data
                generated_at=datetime.now(),
                valid_until=datetime.now() + timedelta(hours=24)
            )

            # Store signal in vector database
            await self.store_signal(signal)

            self.logger.info(f"Generated {signal_type.value} signal for {current_pattern.symbol} with confidence {confidence:.3f}")
            return signal

        except Exception as e:
            self.logger.error(f"Error generating trading signal: {e}")
            # Return neutral signal on error
            return TradingSignal(
                signal_id=str(uuid.uuid4()),
                pattern_id=current_pattern.pattern_id,
                asset_class=current_pattern.asset_class,
                symbol=current_pattern.symbol,
                signal_type=SignalType.NEUTRAL,
                confidence=0.0,
                prediction_horizon=prediction_horizon,
                expected_return=0.0,
                risk_score=1.0,
                model_version="v1.0_ensemble",
                ensemble_score=0.0,
                feature_importance={},
                market_regime="unknown",
                volatility_regime="unknown",
                liquidity_score=0.0,
                generated_at=datetime.now(),
                valid_until=datetime.now() + timedelta(hours=1)
            )

