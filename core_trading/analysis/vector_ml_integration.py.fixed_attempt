    def _extract_signal_features(
        self,
        current_pattern: MarketPattern,
        similar_patterns: List[Tuple[MarketPattern, float]]
    ) -> List[float]:
        """Extract features for ML signal prediction."""
        features = []

        # Current pattern features
        features.extend([
            current_pattern.confidence_score,
            current_pattern.volatility,
            current_pattern.trend_strength,
            current_pattern.volume_profile
        ])

        # Similar patterns statistics
        if similar_patterns:
            success_rates = [p[0].success_rate for p in similar_patterns]
            profit_factors = [p[0].profit_factor for p in similar_patterns]
            sharpe_ratios = [p[0].sharpe_ratio for p in similar_patterns]
            similarities = [p[1] for p in similar_patterns]

            features.extend([
                np.mean(success_rates),
                np.std(success_rates),
                np.mean(profit_factors),
                np.mean(sharpe_ratios),
                np.mean(similarities),
                np.max(similarities),
                len(similar_patterns)
            ])
        else:
            features.extend([0.0] * 7)

        # Market regime features
        features.extend([
            1.0 if current_pattern.trend_strength > 0.7 else 0.0,  # Strong trend
            1.0 if current_pattern.volatility > 0.3 else 0.0,     # High volatility
            1.0 if current_pattern.volume_profile > 0.6 else 0.0   # High volume
        ])

        return features

    def _create_signal_vector(self, signal: TradingSignal) -> List[float]"""
        """Create vector representation of trading signal."""
        vector = []

        # Signal characteristics
        signal_type_encoding = {
            SignalType.BUY: [1, 0, 0, 0],
            SignalType.SELL: [0, 1, 0, 0],
            SignalType.HOLD: [0, 0, 1, 0],
            SignalType.NEUTRAL: [0, 0, 0, 1]
        }
        vector.extend(signal_type_encoding[signal.signal_type])

        # Numerical features
        vector.extend([
            signal.confidence,
            signal.expected_return,
            signal.risk_score,
            signal.ensemble_score,
            signal.liquidity_score
        ])

        # Time features
        hours_to_expiry = (signal.valid_until - signal.generated_at).total_seconds() / 3600
        vector.append(hours_to_expiry / 168)  # Normalize to weeks

        # Asset class encoding
        asset_encoding = [0.0] * len(AssetClass)
        asset_encoding[list(AssetClass).index(signal.asset_class)] = 1.0
        vector.extend(asset_encoding)

        # Pad to required size
        target_size = self.vector_config.signal_vector_size
        if len(vector) < target_size:
            vector.extend([0.0] * (target_size - len(vector)))
        else:
            vector = vector[:target_size]

        return vector

    def _detect_market_regime(self, pattern: MarketPattern) -> str"""
        """Detect market regime based on pattern characteristics."""
        if pattern.trend_strength > 0.7:
            if pattern.volatility < 0.2:
                return "trending_low_vol"
            else:
                return "trending_high_vol"
        elif pattern.trend_strength < 0.3:
            if pattern.volatility < 0.2:
                return "ranging_low_vol"
            else:
                return "ranging_high_vol"
        else:
            return "transitional"

    def _detect_volatility_regime(self, volatility: float) -> str"""
        """Detect volatility regime."""
        if volatility < 0.1:
            return "very_low"
        elif volatility < 0.2:
            return "low"
        elif volatility < 0.4:
            return "normal"
        elif volatility < 0.6:
            return "high"
        else:
            return "very_high"

    def _start_background_tasks(self):
        """Start background tasks for real-time updates."""
        # Pattern update task
        async def update_patterns():
            while True:
                try:
                    await self._update_patterns_from_market_data()
                    await asyncio.sleep(self.vector_config.update_interval_seconds)
                except Exception as e:
                    self.logger.error(f"Error in pattern update task: {e}")
                    await asyncio.sleep(60)

        self._update_task = asyncio.create_task(update_patterns())

        # Performance monitoring task
        async def monitor_performance():
            while True:
                try:
                    await self._update_performance_metrics()
                    await asyncio.sleep(300)  # Every 5 minutes
                except Exception as e:
                    self.logger.error(f"Error in monitoring task: {e}")
                    await asyncio.sleep(60)

        self._monitoring_task = asyncio.create_task(monitor_performance())

    async def _update_patterns_from_market_data(self):
        """Update patterns from real-time market data."""
        # This would integrate with market data feeds
        # For now, it's a placeholder implementation
        pass

    async def _update_performance_metrics(self):
        """Update performance metrics."""
        # Calculate system performance metrics
        try:
            # Get search statistics from Qdrant wrapper
            search_stats = await self.qdrant_wrapper.get_search_stats()

            # Update internal metrics
            self.performance_metrics.update({
                'timestamp': datetime.now().isoformat(),
                'total_searches': search_stats.total_searches,
                'search_success_rate': search_stats.successful_searches / max(search_stats.total_searches, 1),
                'cache_hit_rate': search_stats.cached_searches / max(search_stats.total_searches, 1),
                'average_search_time': search_stats.average_search_time,
                'stored_patterns': len(self.pattern_cache),
                'stored_signals': len(self.signal_cache)
            })

        except Exception as e:
            self.logger.error(f"Error updating performance metrics: {e}")

    async def get_performance_metrics(self) -> Dict[str, Any]:
        """Get current performance metrics."""
        return self.performance_metrics.copy()

    async def shutdown(self):
        """Shutdown the Vector Database ML Engine."""
        # Cancel background tasks
        if self._update_task:
            self._update_task.cancel()
        if self._monitoring_task:
            self._monitoring_task.cancel()

        # Shutdown Qdrant wrapper
        await self.qdrant_wrapper.shutdown()

        self.logger.info("Vector Database ML Engine shutdown completed")


# Factory function for easy initialization
def create_vector_ml_engine(
    pattern_vector_size: int = 512,
    signal_vector_size: int = 256,
    enable_real_time: bool = True,
    ml_models: List[str] = None
) -> VectorDatabaseMLEngine:
    """
    Factory function to create Vector Database ML Engine with default configurations.

    Args:
        pattern_vector_size: Size of pattern vectors
        signal_vector_size: Size of signal vectors
        enable_real_time: Enable real-time updates
        ml_models: List of ML models to use

    Returns:
        Configured VectorDatabaseMLEngine instance
    """
    vector_config = VectorDatabaseConfig(
        pattern_vector_size=pattern_vector_size,
        signal_vector_size=signal_vector_size,
        real_time_updates=enable_real_time
    )

    ml_config = MLModelConfig(
        ensemble_methods=ml_models or ['random_forest', 'gradient_boosting']
    )

    qdrant_config = QdrantConfig(
        default_vector_size=pattern_vector_size,
        enable_metrics=True,
        enable_caching=True
    )

    return VectorDatabaseMLEngine(vector_config, ml_config, qdrant_config)


