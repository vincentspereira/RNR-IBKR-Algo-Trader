    print("\nTesting Augmented MACD...")

    try:
        from momentum.augmented_macd import AugmentedMACD
        from base import AugmentedIndicatorConfig

        config = AugmentedIndicatorConfig()
        macd = AugmentedMACD(config)

        print("✓ MACD initialized")

        # Test with sample data
        prices = [100 + i * 0.5 for i in range(50)]  # Upward trend

