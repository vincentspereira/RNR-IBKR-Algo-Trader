"""
Simple test script for institutional-grade indicators
"""

import sys
import os
sys.path.append(os.path.dirname(os.path.abspath(__file__)))

# Mock bar class for testing
class MockBar:
    def __init__(self, close, high=None, low=None, volume=1000):
        self.close = close
        self.high = high if high is not None else close * 1.01
        self.low = low if low is not None else close * 0.99
        self.volume = volume
        self.open = close * 0.995

def test_augmented_rsi():
    """Test Augmented RSI indicator"""
    print("Testing Augmented RSI...")

    try:
        from momentum.augmented_rsi import AugmentedRSI, AugmentedRSIConfig

        config = AugmentedRSIConfig(
            rsi_period=14,
            overbought_level=70,
            oversold_level=30
        )
        rsi = AugmentedRSI(config)

        print(f"✓ RSI initialized with period {config.rsi_period}")

        # Test with sample data
        prices = [100, 102, 101, 103, 102, 104, 103, 105, 104, 106,
                 105, 107, 106, 108, 107, 109, 108, 110, 109, 111]

        for price in prices:
            bar = MockBar(price)
            rsi.update(bar)

        print(f"✓ RSI processed {len(prices)} bars")

        if rsi.is_ready:
            signal = rsi.value_meta
            print(f"✓ RSI signal: {signal.signal_type}")
            print(f"✓ RSI confidence: {signal.composite_confidence:.3f}")
            print(f"✓ RSI value: {rsi.rsi:.2f}")
        else:
            print("⚠ RSI not ready yet")

        return True

    except Exception as e:
        print(f"✗ RSI test failed: {e}")
        return False

