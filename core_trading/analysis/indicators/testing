def test_augmented_ma_crossover():
    """Test Augmented MA Crossover system"""
    print("\nTesting Augmented MA Crossover...")

    try:
        from momentum.augmented_ma_crossover import AugmentedMACrossover, AugmentedMACrossoverConfig

        config = AugmentedMACrossoverConfig(
            fast_period=10,
            slow_period=20
        )
        ma_crossover = AugmentedMACrossover(config)

        print(f"✓ MA Crossover initialized with periods {config.fast_period}/{config.slow_period}")

        # Test with sample data
        prices = [100] * 30 + [105] * 30  # Should create crossover

        for price in prices:
            bar = MockBar(price)
            ma_crossover.handle_bar(bar)

        print(f"✓ MA Crossover processed {len(prices)} bars")

        if ma_crossover.is_ready:
            signal = ma_crossover.value_meta
            print(f"✓ MA Crossover signal: {signal.signal_type}")
            print(f"✓ MA Crossover confidence: {signal.composite_confidence:.3f}")
        else:
            print("⚠ MA Crossover not ready yet")

        return True

    except Exception as e:
        print(f"✗ MA Crossover test failed: {e}")
        return False

def main():
    """Run all tests"""
    print("=== Institutional-Grade Indicator Tests ===\n")

    results = []
    results.append(test_augmented_rsi())
    results.append(test_augmented_macd())
    results.append(test_augmented_ma_crossover())

    print("\n=== Test Results ===")
    passed = sum(results)
    total = len(results)
    print(f"Passed: {passed}/{total}")

    if passed == total:
        print("🎉 All tests passed! Institutional-grade indicators are working correctly.")
    else:
        print("⚠️ Some tests failed. Please check the implementation.")

    return passed == total

if __name__ == "__main__":
    success = main()
    sys.exit(0 if success else 1)
    sys.exit(0 if success else 1)
