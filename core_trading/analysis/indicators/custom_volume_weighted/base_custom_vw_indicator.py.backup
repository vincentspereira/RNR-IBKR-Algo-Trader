"""Base class for custom volume-weighted indicators.

This module provides the foundational architecture for all 39 custom
volume-weighted indicators, implementing the institutional-grade 5-pillar
architecture with enhanced volume integration and smart money detection.
"""

from abc import ABC, abstractmethod
from collections import deque
from dataclasses import dataclass, field
from datetime import datetime, timezone
from enum import Enum
from typing import Any, Dict, List, Optional, Tuple, Union

import numpy as np
import talib
from nautilus_trader.model.data import Bar
from nautilus_trader.model.identifiers import InstrumentId

try:
    from core_trading.nautilus_trader_engine.analysis.indicators.base import (
        AugmentedIndicator,
        AugmentedIndicatorConfig,
    )
except ImportError:
    # Fallback to backup location
    from backups.indicators_backup_pre_refactor.base import (
        AugmentedIndicator,
        AugmentedIndicatorConfig,
    )


class VWIndicatorType(Enum):
    """Types of volume-weighted indicators."""

    MOVING_AVERAGE = "moving_average"
    MOMENTUM = "momentum"
    VOLATILITY = "volatility"
    VOLUME_FLOW = "volume_flow"
    MARKET_STRUCTURE = "market_structure"
    RISK_MANAGEMENT = "risk_management"


class VWSignalStrength(Enum):
    """Volume-weighted signal strength levels."""

    VERY_STRONG = "very_strong"
    STRONG = "strong"
    MODERATE = "moderate"
    WEAK = "weak"
    NEUTRAL = "neutral"


class VWMarketRegime(Enum):
    """Market regime classifications for volume-weighted analysis."""

    ACCUMULATION = "accumulation"
    DISTRIBUTION = "distribution"
    TRENDING_UP = "trending_up"
    TRENDING_DOWN = "trending_down"
    SIDEWAYS = "sideways"
    HIGH_VOLATILITY = "high_volatility"
    LOW_VOLATILITY = "low_volatility"


@dataclass
class VWSignalData:
    """Volume-weighted signal data with institutional-grade metadata."""

    signal_value: float
    signal_strength: VWSignalStrength
    volume_confirmation: float  # 0.0 to 1.0
    smart_money_score: float  # 0.0 to 1.0
    regime_alignment: float  # 0.0 to 1.0
    confidence: float  # 0.0 to 1.0
    timestamp: datetime
    metadata: Dict[str, Any] = field(default_factory=dict)


@dataclass
class CustomVWIndicatorConfig(AugmentedIndicatorConfig):
    """Configuration for custom volume-weighted indicators.

    Extends the base augmented indicator config with volume-weighted
    specific parameters following institutional standards.
    """

    # Core volume-weighted parameters
    volume_ma_period: int = 20
    volume_threshold_multiplier: float = 1.5
    price_volume_correlation_period: int = 14

    # Smart money detection parameters
    large_volume_threshold: float = 2.0  # Multiple of average volume
    institutional_volume_threshold: float = 3.0
    dark_pool_detection_enabled: bool = True

    # Market regime adaptation parameters
    regime_detection_period: int = 50
    volatility_regime_threshold: float = 0.02
    trend_regime_threshold: float = 0.01

    # Risk management parameters
    max_drawdown_threshold: float = 0.05
    position_sizing_factor: float = 1.0
    stop_loss_atr_multiplier: float = 2.0

    # Performance optimization
    enable_caching: bool = True
    cache_size: int = 1000
    parallel_processing: bool = False


class BaseCustomVWIndicator(AugmentedIndicator, ABC):
    """
    Base class for all custom volume-weighted indicators.

    Implements the institutional-grade 5-pillar architecture:
    1. Volume Integration & Confirmation
    2. Market Regime Adaptation
    3. Smart Money Detection
    4. Behavioral Overlay
    5. Risk Management Integration

    This class provides the foundational framework that all 39 custom
    volume-weighted indicators will inherit from.
    """

    def __init__(self, config: CustomVWIndicatorConfig):
        super().__init__(config)
        self.config = config
        self.indicator_type = VWIndicatorType.MOVING_AVERAGE  # Override in subclasses

        # Core data storage
        self.values = deque(maxlen=config.buffer_size)
        self.volume_data = deque(maxlen=config.buffer_size)
        self.price_data = deque(maxlen=config.buffer_size)
        self.timestamps = deque(maxlen=config.buffer_size)

        # Volume analysis components
        self.volume_ma = deque(maxlen=config.volume_ma_period)
        self.volume_ratios = deque(maxlen=config.buffer_size)
        self.price_volume_correlation = deque(
            maxlen=config.price_volume_correlation_period
        )

        # Smart money detection
        self.large_volume_events = deque(maxlen=100)
        self.institutional_flow = deque(maxlen=config.buffer_size)
        self.dark_pool_indicators = deque(maxlen=config.buffer_size)

        # Market regime tracking
        self.current_regime = VWMarketRegime.SIDEWAYS
        self.regime_history = deque(maxlen=config.regime_detection_period)
        self.volatility_history = deque(maxlen=config.regime_detection_period)

        # Risk management
        self.drawdown_history = deque(maxlen=100)
        self.risk_adjusted_signals = deque(maxlen=config.buffer_size)

        # Performance tracking
        self.signal_history = deque(maxlen=1000)
        self.performance_metrics = {}

        # Caching for performance
        self._cache = {} if config.enable_caching else None

    @property
    def is_ready(self) -> bool:
        """Check if indicator has sufficient data for calculations."""
        return len(self.values) > 0 and len(self.volume_data) >= self.config.period

    @property
    def current_value(self) -> Optional[float]:
        """Get the most recent indicator value."""
        return self.values[-1] if self.values else None

    @property
    def current_signal(self) -> Optional[VWSignalData]:
        """Get the most recent signal data."""
        return self.signal_history[-1] if self.signal_history else None

    def on_aggregated_bar(self, bar: Bar) -> None:
        """Process new bar data and update all pillars."""
        # Store raw data
        self.price_data.append(bar.close.as_double())
        self.volume_data.append(bar.volume.as_double())
        self.timestamps.append(bar.ts_event)

        # Update all pillars
        self._update_pillars(bar)

        # Calculate indicator-specific value
        indicator_value = self._calculate_indicator_value(bar)
        if indicator_value is not None:
            self.values.append(indicator_value)

            # Generate signal
            signal = self._generate_signal(bar, indicator_value)
            if signal:
                self.signal_history.append(signal)

    @abstractmethod
    def _calculate_indicator_value(self, bar: Bar) -> Optional[float]:
        """Calculate the indicator-specific value. Must be implemented by subclasses."""
        pass

    def _update_pillars(self, bar: Bar) -> None:
        """Update all five pillars of the architecture."""
        self._update_volume_integration(bar)
        self._update_market_regime_adaptation(bar)
        self._update_smart_money_detection(bar)
        self._update_behavioral_overlay(bar)
        self._update_risk_management_integration(bar)

    def _update_volume_integration(self, bar: Bar) -> None:
        """Pillar 1: Volume Integration & Confirmation."""
        if len(self.volume_data) < 2:
            return

        # Calculate volume moving average
        if len(self.volume_data) >= self.config.volume_ma_period:
            recent_volumes = list(self.volume_data)[-self.config.volume_ma_period :]
            volume_ma = np.mean(recent_volumes)
            self.volume_ma.append(volume_ma)

            # Calculate volume ratio
            current_volume = bar.volume.as_double()
            volume_ratio = current_volume / volume_ma if volume_ma > 0 else 1.0
            self.volume_ratios.append(volume_ratio)

        # Calculate price-volume correlation
        if len(self.price_data) >= self.config.price_volume_correlation_period:
            recent_prices = list(self.price_data)[
                -self.config.price_volume_correlation_period :
            ]
            recent_volumes = list(self.volume_data)[
                -self.config.price_volume_correlation_period :
            ]

            if len(recent_prices) == len(recent_volumes):
                correlation = np.corrcoef(recent_prices, recent_volumes)[0, 1]
                if not np.isnan(correlation):
                    self.price_volume_correlation.append(correlation)

    def _update_market_regime_adaptation(self, bar: Bar) -> None:
        """Pillar 2: Market Regime Adaptation."""
        if len(self.price_data) < self.config.regime_detection_period:
            return

        # Calculate volatility
        recent_prices = np.array(
            list(self.price_data)[-self.config.regime_detection_period :]
        )
        returns = np.diff(recent_prices) / recent_prices[:-1]
        volatility = np.std(returns)
        self.volatility_history.append(volatility)

        # Detect regime
        price_change = (recent_prices[-1] - recent_prices[0]) / recent_prices[0]

        if volatility > self.config.volatility_regime_threshold:
            if abs(price_change) > self.config.trend_regime_threshold:
                self.current_regime = VWMarketRegime.HIGH_VOLATILITY
            else:
                self.current_regime = VWMarketRegime.HIGH_VOLATILITY
        elif price_change > self.config.trend_regime_threshold:
            self.current_regime = VWMarketRegime.TRENDING_UP
        elif price_change < -self.config.trend_regime_threshold:
            self.current_regime = VWMarketRegime.TRENDING_DOWN
        else:
            self.current_regime = VWMarketRegime.SIDEWAYS

        self.regime_history.append(self.current_regime)

    def _update_smart_money_detection(self, bar: Bar) -> None:
        """Pillar 3: Smart Money Detection."""
        if not self.volume_ma:
            return

        current_volume = bar.volume.as_double()
        avg_volume = self.volume_ma[-1]

        # Detect large volume events
        if current_volume > avg_volume * self.config.large_volume_threshold:
            self.large_volume_events.append(
                {
                    "timestamp": bar.ts_event,
                    "volume_ratio": current_volume / avg_volume,
                    "price": bar.close.as_double(),
                    "is_institutional": current_volume
                    > avg_volume * self.config.institutional_volume_threshold,
                }
            )

        # Calculate institutional flow indicator
        if len(self.large_volume_events) > 0:
            recent_events = [
                e for e in self.large_volume_events if e["is_institutional"]
            ]
            institutional_score = len(recent_events) / max(
                len(self.large_volume_events), 1
            )
            self.institutional_flow.append(institutional_score)
        else:
            self.institutional_flow.append(0.0)

    def _update_behavioral_overlay(self, bar: Bar) -> None:
        """Pillar 4: Behavioral Overlay."""
        # Implement behavioral analysis based on volume patterns
        # This can include sentiment analysis, crowd behavior detection, etc.
        pass

    def _update_risk_management_integration(self, bar: Bar) -> None:
        """Pillar 5: Risk Management Integration."""
        if len(self.values) < 2:
            return

        # Calculate drawdown
        if len(self.values) >= 20:
            recent_values = list(self.values)[-20:]
            peak = max(recent_values)
            current = recent_values[-1]
            drawdown = (peak - current) / peak if peak > 0 else 0.0
            self.drawdown_history.append(drawdown)

    def _generate_signal(
        self, bar: Bar, indicator_value: float
    ) -> Optional[VWSignalData]:
        """Generate a comprehensive signal with all pillar data."""
        if not self.is_ready:
            return None

        # Calculate volume confirmation
        volume_confirmation = self._calculate_volume_confirmation()

        # Calculate smart money score
        smart_money_score = self._calculate_smart_money_score()

        # Calculate regime alignment
        regime_alignment = self._calculate_regime_alignment()

        # Calculate signal strength
        signal_strength = self._calculate_signal_strength(indicator_value)

        # Calculate overall confidence
        confidence = self._calculate_confidence(
            volume_confirmation, smart_money_score, regime_alignment
        )

        return VWSignalData(
            signal_value=indicator_value,
            signal_strength=signal_strength,
            volume_confirmation=volume_confirmation,
            smart_money_score=smart_money_score,
            regime_alignment=regime_alignment,
            confidence=confidence,
            timestamp=datetime.now(timezone.utc),
            metadata={
                "regime": self.current_regime.value,
                "volume_ratio": self.volume_ratios[-1] if self.volume_ratios else 1.0,
                "price_volume_correlation": self.price_volume_correlation[-1]
                if self.price_volume_correlation
                else 0.0,
            },
        )

    def _calculate_volume_confirmation(self) -> float:
        """Calculate volume confirmation score (0.0 to 1.0)."""
        if not self.volume_ratios:
            return 0.5

        recent_ratio = self.volume_ratios[-1]
        if recent_ratio > self.config.volume_threshold_multiplier:
            return min(
                1.0, recent_ratio / (self.config.volume_threshold_multiplier * 2)
            )
        else:
            return max(0.0, recent_ratio / self.config.volume_threshold_multiplier)

    def _calculate_smart_money_score(self) -> float:
        """Calculate smart money detection score (0.0 to 1.0)."""
        if not self.institutional_flow:
            return 0.5

        return min(1.0, self.institutional_flow[-1])

    def _calculate_regime_alignment(self) -> float:
        """Calculate market regime alignment score (0.0 to 1.0)."""
        # This should be implemented based on how well the indicator
        # aligns with the current market regime
        return 0.7  # Default neutral alignment

    def _calculate_signal_strength(self, value: float) -> VWSignalStrength:
        """Calculate signal strength based on indicator value and context."""
        if not self.values or len(self.values) < 2:
            return VWSignalStrength.NEUTRAL

        # Calculate relative strength based on recent values
        recent_values = (
            list(self.values)[-10:] if len(self.values) >= 10 else list(self.values)
        )
        value_percentile = np.percentile(recent_values, 50)

        deviation = (
            abs(value - value_percentile) / value_percentile
            if value_percentile != 0
            else 0
        )

        if deviation > 0.05:
            return VWSignalStrength.VERY_STRONG
        elif deviation > 0.03:
            return VWSignalStrength.STRONG
        elif deviation > 0.01:
            return VWSignalStrength.MODERATE
        elif deviation > 0.005:
            return VWSignalStrength.WEAK
        else:
            return VWSignalStrength.NEUTRAL

    def _calculate_confidence(
        self, volume_conf: float, smart_money: float, regime_align: float
    ) -> float:
        """Calculate overall confidence score using pillar weights."""
        weights = self.config.confidence_weights

        confidence = (
            volume_conf * weights.get("volume", 0.25)
            + smart_money * weights.get("smart_money", 0.20)
            + regime_align * weights.get("regime", 0.20)
            + 0.7 * weights.get("behavioral", 0.15)
            + 0.8  # Default behavioral score
            * weights.get("risk", 0.20)  # Default risk score
        )

        return min(1.0, max(0.0, confidence))

    def get_volume_weighted_price(
        self, prices: List[float], volumes: List[float]
    ) -> float:
        """Calculate volume-weighted price using the standard methodology."""
        if not prices or not volumes or len(prices) != len(volumes):
            return 0.0

        total_pv = sum(p * v for p, v in zip(prices, volumes))
        total_volume = sum(volumes)

        return total_pv / total_volume if total_volume > 0 else 0.0

    def get_volume_weighted_ema(
        self, prices: List[float], volumes: List[float], alpha: float
    ) -> float:
        """Calculate volume-weighted EMA using proper alpha methodology."""
        if not prices or not volumes:
            return 0.0

        # Use pandas-style EMA calculation with volume weighting
        price_volume_series = np.array([p * v for p, v in zip(prices, volumes)])
        volume_series = np.array(volumes)

        # Calculate EMA of price*volume and volume separately
        pv_ema = talib.EMA(price_volume_series, timeperiod=int(1 / alpha))
        v_ema = talib.EMA(volume_series, timeperiod=int(1 / alpha))

        return pv_ema[-1] / v_ema[-1] if len(pv_ema) > 0 and v_ema[-1] != 0 else 0.0

    def reset(self) -> None:
        """Reset all indicator data."""
        super().reset()
        self.values.clear()
        self.volume_data.clear()
        self.price_data.clear()
        self.timestamps.clear()
        self.volume_ma.clear()
        self.volume_ratios.clear()
        self.price_volume_correlation.clear()
        self.large_volume_events.clear()
        self.institutional_flow.clear()
        self.dark_pool_indicators.clear()
        self.regime_history.clear()
        self.volatility_history.clear()
        self.drawdown_history.clear()
        self.risk_adjusted_signals.clear()
        self.signal_history.clear()

        if self._cache:
            self._cache.clear()

    def get_performance_metrics(self) -> Dict[str, float]:
        """Get comprehensive performance metrics for the indicator."""
        if not self.signal_history:
            return {}

        signals = list(self.signal_history)
        confidences = [s.confidence for s in signals]
        volume_confirmations = [s.volume_confirmation for s in signals]
        smart_money_scores = [s.smart_money_score for s in signals]

        return {
            "avg_confidence": np.mean(confidences),
            "avg_volume_confirmation": np.mean(volume_confirmations),
            "avg_smart_money_score": np.mean(smart_money_scores),
            "signal_count": len(signals),
            "strong_signal_ratio": len(
                [
                    s
                    for s in signals
                    if s.signal_strength
                    in [VWSignalStrength.STRONG, VWSignalStrength.VERY_STRONG]
                ]
            )
            / len(signals),
            "current_regime": self.current_regime.value,
        }
