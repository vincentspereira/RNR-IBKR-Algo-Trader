        # Check for bearish divergence (UO making lower highs while overbought)"""
        if max(recent_values) < max(prev_values) and all(v > 70 for v in recent_values):"""
            return "BEARISH_DIVERGENCE"""
"""
        return "NO_DIVERGENCE"
"""
