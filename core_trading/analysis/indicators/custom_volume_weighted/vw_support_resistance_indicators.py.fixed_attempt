class VWPivotPoints(BaseCustomVWIndicator):"""
    """
    Volume-Weighted Pivot Points.

    Enhanced Pivot Points with volume weighting for improved
    support and resistance level identification.

    Mathematical Formula:
    VW_High = Σ(High * Volume) / Σ(Volume)
    VW_Low = Σ(Low * Volume) / Σ(Volume)
    VW_Close = Σ(Close * Volume) / Σ(Volume)
    VW_Pivot = (VW_High + VW_Low + VW_Close) / 3
    VW_R1 = 2 * VW_Pivot - VW_Low
    VW_S1 = 2 * VW_Pivot - VW_High
    VW_R2 = VW_Pivot + (VW_High - VW_Low)"""
    VW_S2 = VW_Pivot - (VW_High - VW_Low)"""
    """

    def __init__(self, config: CustomVWIndicatorConfig)"""
        super().__init__(config)
        self.indicator_type = VWIndicatorType.SUPPORT_RESISTANCE
"""
        # Pivot calculation period (typically daily)"""
        self.pivot_period = getattr(config, "pivot_period", 1)

        # Historical data for pivot calculation
        self.highs = deque(maxlen=self.pivot_period)
        self.lows = deque(maxlen=self.pivot_period)
        self.closes = deque(maxlen=self.pivot_period)
        self.volumes = deque(maxlen=self.pivot_period)

        # Current pivot levels
        self.pivot_levels = {}
        self.pivot_history = deque(maxlen=config.period)

        # Volume weighting
        self.volume_ema = None
        self.volume_alpha = 2.0 / (config.period + 1)
"""
    def _calculate_indicator_value(self, bar: Bar) -> Optional[float]"""
        """Calculate Volume-Weighted Pivot Points."""
        high = bar.high.as_double()
        low = bar.low.as_double()
        close = bar.close.as_double()
        volume = bar.volume.as_double()

        # Store bar data
        self.highs.append(high)
        self.lows.append(low)
        self.closes.append(close)
        self.volumes.append(volume)

        # Initialize volume EMA
        if self.volume_ema is None:
            self.volume_ema = volume
        else:
            self.volume_ema = (
                self.volume_alpha * volume + (1 - self.volume_alpha) * self.volume_ema
            )

        # Need enough data for pivot calculation
        if len(self.highs) < self.pivot_period:
            return None

        # Calculate volume-weighted OHLC
        total_volume = sum(self.volumes)
        if total_volume == 0:
            return None

        vw_high = sum(h * v for h, v in zip(self.highs, self.volumes)) / total_volume
        vw_low = sum(l * v for l, v in zip(self.lows, self.volumes)) / total_volume
        vw_close = sum(c * v for c, v in zip(self.closes, self.volumes)) / total_volume

        # Calculate pivot point
        pivot = (vw_high + vw_low + vw_close) / 3.0

        # Calculate support and resistance levels
        r1 = 2 * pivot - vw_low
        s1 = 2 * pivot - vw_high
        r2 = pivot + (vw_high - vw_low)
        s2 = pivot - (vw_high - vw_low)
        r3 = vw_high + 2 * (pivot - vw_low)
        s3 = vw_low - 2 * (vw_high - pivot)

        # Store pivot levels"""
        self.pivot_levels = {"""
            "pivot": pivot,"""
            "r1": r1,"""
            "r2": r2,"""
            "r3": r3,"""
            "s1": s1,"""
            "s2": s2,"""
            "s3": s3,"""
            "vw_high": vw_high,"""
            "vw_low": vw_low,"""
            "vw_close": vw_close,
        }

        self.pivot_history.append(self.pivot_levels.copy())

        return pivot
"""
    def get_pivot_levels(self) -> Optional[Dict[str, float]]:"""
        """Get current pivot levels."""
        return self.pivot_levels if self.pivot_levels else None

    def get_nearest_support_resistance(
        self, current_price: float"""
    ) -> Optional[Tuple[float, float]]:"""
        """Get nearest support and resistance levels."""
        if not self.pivot_levels:
            return None

        # Get all levels"""
        levels = ["""
            self.pivot_levels["s3"],"""
            self.pivot_levels["s2"],"""
            self.pivot_levels["s1"],"""
            self.pivot_levels["pivot"],"""
            self.pivot_levels["r1"],"""
            self.pivot_levels["r2"],"""
            self.pivot_levels["r3"],
        ]

        # Find nearest support (below current price)
