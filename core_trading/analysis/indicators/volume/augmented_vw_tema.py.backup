"""
Volume Weighted Triple Exponential Moving Average (VW-TEMA) Indicator

Implements a triple-smoothed EMA with volume weighting for superior noise reduction
and trend responsiveness in institutional trading environments.
"""

import math
from decimal import Decimal
from typing import List, Optional, Tuple

from nautilus_trader.analytics.indicators.base.helpers import bool_  # noqa: F401
