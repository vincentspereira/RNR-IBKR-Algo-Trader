    def process_smart_money_signal(self, symbol: str,
                                 metrics: SmartMoneyMetrics) -> Optional[SmartMoneyMLSignal]:
        """
        Process smart money metrics through ML pipeline
        """
        try:
            if not SKLEARN_AVAILABLE:
                return self._create_basic_ml_signal(symbol, metrics)

            # Extract features
            features = self._extract_smart_money_features(symbol, metrics)
            if features is None:
                return None

            # Regime detection
            regime = self._detect_smart_money_regime(symbol, features)

            # Meta-labeling
            meta_label, meta_probability = self._apply_meta_labeling(symbol, features)

            # Probabilistic forecasting
            success_prob, expected_return, return_dist = self._probabilistic_forecast(symbol, features)

            # Factor validation
            factor_contributions = self._calculate_factor_contributions(symbol, features)

            # Signal adjustment
            ml_adjusted_strength, ml_confidence = self._adjust_signal_strength(symbol, features)

            # Signal quality assessment
            quality = self._assess_signal_quality(ml_adjusted_strength, ml_confidence,
                                                meta_probability, success_prob)

            # Calculate decay and timing
            signal_age, decay_factor, optimal_exit = self._calculate_timing_metrics(symbol, metrics)

            # Cross-validation
            cv_score, oos_performance = self._cross_validate_signal(symbol, features)

            # Create ML-enhanced signal
            ml_signal = SmartMoneyMLSignal(
                base_signal=metrics.smart_money_signal,
                base_strength=metrics.signal_strength,
                base_confidence=metrics.signal_confidence,

                ml_regime=regime,
                ml_quality=quality,
                ml_adjusted_strength=ml_adjusted_strength,
                ml_confidence=ml_confidence,

                success_probability=success_prob,
                expected_return=expected_return,
                risk_adjusted_return=expected_return * ml_confidence,

                meta_label=meta_label,
                meta_probability=meta_probability,

                forecast_horizon=self._determine_forecast_horizon(regime),
                return_distribution=return_dist,

                factor_contributions=factor_contributions,

                signal_age=signal_age,
                decay_factor=decay_factor,
                optimal_exit_time=optimal_exit,

                cross_validation_score=cv_score,
                out_of_sample_performance=oos_performance,

                timestamp=metrics.timestamp,
                symbol=symbol,
            )

            # Store signal for training
            self._store_training_data(symbol, features, ml_signal)

            # Update signal history
            self.signal_history[symbol].append(ml_signal)

            # Check if retraining is needed
            self._check_retraining(symbol)

            return ml_signal

        except Exception as e:
            self.logger.error(f"Error processing smart money signal for {symbol}: {e}")
            return None

    def _extract_smart_money_features(self, symbol: str,
                                    metrics: SmartMoneyMetrics) -> Optional[np.ndarray]:
        """Extract features for ML processing"""
        try:
            features = []

            # Base smart money metrics
            features.extend([
                metrics.signal_strength,
                metrics.signal_confidence,
                metrics.smart_money_index,
                metrics.institutional_flow,
                metrics.large_trade_ratio,
                metrics.dark_pool_activity,
                metrics.anomaly_score,
            ])

            # Volume and price impact features
            features.extend([
                metrics.volume_ratio,
                metrics.volume_trend,
                metrics.price_impact,
                metrics.volume_price_correlation,
                metrics.buying_pressure,
                metrics.selling_pressure,
            ])

            # Enhanced September 2025 features
            features.extend([
                float(metrics.net_flow),
                metrics.block_trade_activity,
                metrics.institutional_activity,
                metrics.liquidity_stress,
                metrics.support_strength,
                metrics.resistance_strength,
            ])

            # Categorical features (one-hot encoded)
            bias_encoding = self._encode_categorical(metrics.institutional_bias.value,
                                                   [e.value for e in SmartMoneyBias])
            activity_encoding = self._encode_categorical(metrics.activity_level.value,
                                                      [e.value for e in InstitutionalActivity])
            flow_type_encoding = self._encode_categorical(metrics.order_flow_type.value,
                                                        [e.value for e in OrderFlowType])
            liquidity_encoding = self._encode_categorical(metrics.liquidity_condition.value,
                                                        [e.value for e in LiquidityCondition])

            features.extend(bias_encoding + activity_encoding + flow_type_encoding + liquidity_encoding)

            # Binary features
            features.extend([
                float(metrics.unusual_volume),
                float(metrics.unusual_activity),
                float(metrics.accumulation_phase),
                float(metrics.distribution_phase),
                float(metrics.breakout_preparation),
                float(metrics.absorption_detected),
                float(metrics.structural_shift),
            ])

            # Historical features (if available)
            historical_features = self._extract_historical_features(symbol)
            features.extend(historical_features)

            # Cross-asset features (if enabled)
            if self.config.enable_cross_asset_correlation:
                cross_asset_features = self._extract_cross_asset_features(symbol)
                features.extend(cross_asset_features)

            # Time-based features
            time_features = self._extract_time_features(metrics.timestamp)
            features.extend(time_features)

            return np.array(features)

        except Exception as e:
            self.logger.error(f"Error extracting features for {symbol}: {e}")
            return None

    def _encode_categorical(self, value: str, categories: List[str]) -> List[float]"""
        """One-hot encode categorical value"""
        encoding = [0.0] * len(categories)
        if value in categories:
            encoding[categories.index(value)] = 1.0
        return encoding

    def _extract_historical_features(self, symbol: str) -> List[float]"""
        """Extract historical performance features"""
        if len(self.signal_history[symbol]) < 5:
            return [0.0] * 10  # Default for insufficient history

        recent_signals = list(self.signal_history[symbol])[-10:]

        # Recent performance metrics
        recent_success = np.mean([s.success_probability for s in recent_signals])
        recent_strength = np.mean([s.ml_adjusted_strength for s in recent_signals])
        recent_confidence = np.mean([s.ml_confidence for s in recent_signals])

        # Trend features
        strength_trend = np.polyfit(range(len(recent_signals)),
                                  [s.ml_adjusted_strength for s in recent_signals], 1)[0]
        confidence_trend = np.polyfit(range(len(recent_signals)),
                                    [s.ml_confidence for s in recent_signals], 1)[0]

        # Volatility features
        strength_volatility = np.std([s.ml_adjusted_strength for s in recent_signals])
        confidence_volatility = np.std([s.ml_confidence for s in recent_signals])

        # Regime consistency
        regime_counts = {}
        for signal in recent_signals:
            regime_counts[signal.ml_regime.value] = regime_counts.get(signal.ml_regime.value, 0) + 1
        regime_consistency = max(regime_counts.values()) / len(recent_signals)

        # Factor contribution stability
        if recent_signals and recent_signals[-1].factor_contributions:
            factor_stability = np.std(list(recent_signals[-1].factor_contributions.values()))
        else:
            factor_stability = 0.0

        return [
            recent_success, recent_strength, recent_confidence,
            strength_trend, confidence_trend,
            strength_volatility, confidence_volatility,
            regime_consistency, factor_stability,
            len(recent_signals) / 100.0,  # Normalized sample count
        ]

    def _extract_cross_asset_features(self, symbol: str) -> List[float]"""
        """Extract cross-asset correlation features"""
        if symbol not in self.cross_asset_correlations:
            return [0.0] * 5  # Default for no cross-asset data

        correlations = self.cross_asset_correlations[symbol]

        # Average correlation with other assets
        avg_correlation = np.mean(list(correlations.values())) if correlations else 0.0

        # Maximum correlation
        max_correlation = max(correlations.values()) if correlations else 0.0

        # Correlation with major indices (if available)
        spy_correlation = correlations.get('SPY', 0.0)
        qqq_correlation = correlations.get('QQQ', 0.0)

        # Number of correlated assets
        num_correlated = len([c for c in correlations.values() if abs(c) > 0.5])

        return [
            avg_correlation, max_correlation,
            spy_correlation, qqq_correlation,
            num_correlated / 10.0,  # Normalized
        ]

    def _extract_time_features(self, timestamp: datetime) -> List[float]"""
        """Extract time-based features"""
        # Time of day (market hours normalized)
        hour = timestamp.hour
        time_of_day = (hour - 9.5) / 6.5 if 9.5 <= hour <= 16 else 0.0  # Market hours

        # Day of week
        day_of_week = timestamp.weekday() / 6.0  # 0-6 normalized to 0-1

        # Month of year
        month = timestamp.month / 12.0  # 1-12 normalized to 0-1

        # Quarter
        quarter = ((timestamp.month - 1) // 3) / 3.0  # 0-3 normalized to 0-1

        # Is month end (window)
        is_month_end = 1.0 if timestamp.day >= 28 else 0.0

        # Is quarter end
        is_quarter_end = 1.0 if timestamp.month in [3, 6, 9, 12] and timestamp.day >= 28 else 0.0

        return [time_of_day, day_of_week, month, quarter, is_month_end, is_quarter_end]

    def _detect_smart_money_regime(self, symbol: str, features: np.ndarray) -> SmartMoneyRegime"""
        """Detect smart money specific regime using ML"""
        if symbol not in self.regime_models:
            # Initialize regime model if not exists
            self.regime_models[symbol] = self._initialize_regime_model(symbol)
            return SmartMoneyRegime.SMART_MONEY_NEUTRAL

        try:
            model = self.regime_models[symbol]

            # Ensure features are scaled
            if symbol in self.scalers:
                features_scaled = self.scalers[symbol].transform(features.reshape(1, -1))
            else:
                features_scaled = features.reshape(1, -1)

            # Predict regime
            regime_prediction = model.predict(features_scaled)[0]

            # Map prediction to regime enum
            regime_mapping = {
                0: SmartMoneyRegime.INSTITUTIONAL_ACCUMULATION,
                1: SmartMoneyRegime.INSTITUTIONAL_DISTRIBUTION,
                2: SmartMoneyRegime.RETAIL_FRENZY,
                3: SmartMoneyRegime.DARK_POOL_DOMINANCE,
                4: SmartMoneyRegime.SMART_MONEY_NEUTRAL,
                5: SmartMoneyRegime.MANIPULATION_DETECTED,
            }

            return regime_mapping.get(regime_prediction, SmartMoneyRegime.SMART_MONEY_NEUTRAL)

        except Exception as e:
            self.logger.error(f"Error detecting regime for {symbol}: {e}")
            return SmartMoneyRegime.SMART_MONEY_NEUTRAL

    def _initialize_regime_model(self, symbol: str)"""
        """Initialize regime detection model"""
        if not SKLEARN_AVAILABLE:
            return None

        model = RandomForestClassifier(
            n_estimators=100,
            max_depth=10,
            random_state=42,
            class_weight='balanced'
        )

        # Create synthetic training data for initialization
        n_samples = 100
        n_features = 50  # Approximate feature count

        X = np.random.randn(n_samples, n_features)
        y = np.random.randint(0, 6, n_samples)  # 6 regimes

        model.fit(X, y)

        return model

    def _apply_meta_labeling(self, symbol: str, features: np.ndarray) -> Tuple[int, float]"""
        """Apply meta-labeling to filter smart money signals"""
        if not self.config.enable_meta_labeling or symbol not in self.meta_labeling_models:
            return 1, 0.5  # Default: pass signal

        try:
            model = self.meta_labeling_models[symbol]

            # Scale features if scaler available
            if symbol in self.scalers:
                features_scaled = self.scalers[symbol].transform(features.reshape(1, -1))
            else:
                features_scaled = features.reshape(1, -1)

            # Predict meta-label
            meta_prediction = model.predict(features_scaled)[0]
            meta_probability = model.predict_proba(features_scaled)[0, 1]  # Probability of class 1

            return int(meta_prediction), float(meta_probability)

        except Exception as e:
            self.logger.error(f"Error applying meta-labeling for {symbol}: {e}")
            return 1, 0.5

    def _probabilistic_forecast(self, symbol: str, features: np.ndarray) -> Tuple[float, float, Dict[str, float]]"""
        """Generate probabilistic forecast for smart money signal"""
        if not self.config.enable_probabilistic_forecasting:
            return 0.6, 0.0, {'p50': 0.0, 'p75': 0.01, 'p90': 0.02, 'p95': 0.03}

        try:
            # Use historical performance for probabilistic forecast
            if len(self.performance_history[symbol]) < 10:
                return 0.6, 0.0, self._default_return_distribution()

            recent_performance = list(self.performance_history[symbol])[-50:]

            # Calculate success probability based on similar historical conditions
            success_probability = np.mean([p['success'] for p in recent_performance])

            # Expected return based on historical returns
            expected_return = np.mean([p['return'] for p in recent_performance])

            # Return distribution based on historical percentiles
            returns = [p['return'] for p in recent_performance]
            return_distribution = {
                'p5': np.percentile(returns, 5),
                'p10': np.percentile(returns, 10),
                'p25': np.percentile(returns, 25),
                'p50': np.percentile(returns, 50),
                'p75': np.percentile(returns, 75),
                'p90': np.percentile(returns, 90),
                'p95': np.percentile(returns, 95),
            }

            return success_probability, expected_return, return_distribution

        except Exception as e:
            self.logger.error(f"Error generating probabilistic forecast for {symbol}: {e}")
            return 0.6, 0.0, self._default_return_distribution()

