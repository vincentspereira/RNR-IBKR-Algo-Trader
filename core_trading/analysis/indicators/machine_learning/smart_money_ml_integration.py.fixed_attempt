    def _adjust_signal_strength(self, symbol: str, features: np.ndarray) -> Tuple[float, float]"""
        """Adjust signal strength based on ML analysis"""
        try:
            # Base adjustment factors
            regime_adjustment = self._get_regime_adjustment(symbol)
            quality_adjustment = self._get_quality_adjustment(symbol)

            # Combine adjustments
            total_adjustment = (regime_adjustment + quality_adjustment) / 2.0

            # Apply to base signal (extracted from features)
            base_strength = features[0] if len(features) > 0 else 0.5
            adjusted_strength = np.clip(base_strength * (1 + total_adjustment), -1.0, 1.0)

            # Calculate confidence based on adjustment consistency
            confidence = 1.0 - abs(total_adjustment)  # Lower adjustment = higher confidence

            return float(adjusted_strength), float(confidence)

        except Exception as e:
            self.logger.error(f"Error adjusting signal strength for {symbol}: {e}")
            return 0.5, 0.5

