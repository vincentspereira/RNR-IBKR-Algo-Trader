    def update_performance(self, symbol: str, signal: SmartMoneyMLSignal,
                         actual_return: float, success: bool):
        """Update performance tracking with actual results"""
        try:
            performance_update = {
                'timestamp': datetime.now(timezone.utc),
                'predicted_return': signal.expected_return,
                'actual_return': actual_return,
                'success': success,
                'signal_strength': signal.ml_adjusted_strength,
                'confidence': signal.ml_confidence,
                'regime': signal.ml_regime.value,
            }

            self.performance_history[symbol].append(performance_update)

            # Update model performance metrics
            if symbol not in self.model_performance:
                self.model_performance[symbol] = {
                    'total_signals': 0,
                    'successful_signals': 0,
                    'accuracy': 0.0,
                    'average_return': 0.0,
                    'sharpe_ratio': 0.0,
                }

            perf = self.model_performance[symbol]
            perf['total_signals'] += 1

            if success:
                perf['successful_signals'] += 1

            perf['accuracy'] = perf['successful_signals'] / perf['total_signals']

            # Update average return
            all_returns = [p['actual_return'] for p in self.performance_history[symbol]]
            perf['average_return'] = np.mean(all_returns)

            # Calculate Sharpe ratio
            if len(all_returns) > 1:
                perf['sharpe_ratio'] = np.mean(all_returns) / np.std(all_returns) if np.std(all_returns) > 0 else 0

        except Exception as e:
            self.logger.error(f"Error updating performance for {symbol}: {e}")

    def get_performance_summary(self, symbol: str) -> Dict[str, Any]"""
        """Get performance summary for a symbol"""
        if symbol not in self.model_performance:
            return {}

        perf = self.model_performance[symbol]

        # Add recent performance metrics
        recent_performance = list(self.performance_history[symbol])[-50:] if self.performance_history[symbol] else []

        if recent_performance:
            recent_accuracy = np.mean([p['success'] for p in recent_performance])
            recent_return = np.mean([p['actual_return'] for p in recent_performance])
        else:
            recent_accuracy = 0.0
            recent_return = 0.0

        return {
            **perf,
            'recent_accuracy': recent_accuracy,
            'recent_return': recent_return,
            'total_training_samples': len(self.training_data[symbol]),
            'last_retrain': self.last_retrain.get(symbol),
            'models_available': {
                'regime_model': symbol in self.regime_models,
                'meta_labeling_model': symbol in self.meta_labeling_models,
                'probabilistic_model': symbol in self.probabilistic_models,
            }
        }


