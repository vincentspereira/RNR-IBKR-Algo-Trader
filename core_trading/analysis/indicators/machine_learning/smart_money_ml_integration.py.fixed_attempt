            samples_needed = self.config.smart_retrain_frequency
            current_samples = len(self.training_data[symbol])

            if current_samples >= samples_needed:
                # Check if enough time has passed since last retraining
                if symbol not in self.last_retrain or \
                   (datetime.now(timezone.utc) - self.last_retrain[symbol]).hours > 24:
                    self._retrain_models(symbol)

