    def _assess_signal_quality(self, strength: float, confidence: float,
                             meta_probability: float, success_probability: float) -> SmartMoneySignalQuality:
        """Assess overall signal quality"""
        overall_quality = (confidence + meta_probability + success_probability) / 3.0

        if overall_quality > 0.8:
            return SmartMoneySignalQuality.INSTITUTIONAL_CONFIRMED
        elif overall_quality > 0.7:
            return SmartMoneySignalQuality.HIGH_CONFIDENCE_SMART
        elif overall_quality > 0.5:
            return SmartMoneySignalQuality.MODERATE_CONFIDENCE
        elif overall_quality > 0.3:
            return SmartMoneySignalQuality.LOW_CONFIDENCE_RETAIL
        elif overall_quality > 0.1:
            return SmartMoneySignalQuality.ANOMALOUS_SUSPICIOUS
        else:
            return SmartMoneySignalQuality.FILTERED_NOISE

    def _calculate_timing_metrics(self, symbol: str, metrics: SmartMoneyMetrics) -> Tuple[float, float, Optional[float]]"""
        """Calculate timing-related metrics"""
        now = datetime.now(timezone.utc)
        signal_age = (now - metrics.timestamp).total_seconds() / 3600.0  # hours

        # Decay factor based on signal age and confidence
        decay_rate = 0.95  # Per hour
        decay_factor = decay_rate ** signal_age

        # Optimal exit time based on regime and signal type
        optimal_exit = self._estimate_optimal_exit_time(metrics)

        return signal_age, decay_factor, optimal_exit

    def _estimate_optimal_exit_time(self, metrics: SmartMoneyMetrics) -> Optional[float]"""
        """Estimate optimal exit time in hours"""
        # Based on signal type and market conditions
        base_exit_times = {
            SmartMoneySignal.STRONG_ACCUMULATION: 24.0,  # 24 hours
            SmartMoneySignal.ACCUMULATION: 12.0,
            SmartMoneySignal.DISTRIBUTION: 8.0,
            SmartMoneySignal.STRONG_DISTRIBUTION: 6.0,
            SmartMoneySignal.NEUTRAL: 4.0,
            SmartMoneySignal.MANIPULATION: 1.0,  # Exit quickly
        }

        base_time = base_exit_times.get(metrics.smart_money_signal, 8.0)

        # Adjust based on institutional activity
        if metrics.activity_level == InstitutionalActivity.VERY_HIGH:
            base_time *= 1.5
        elif metrics.activity_level == InstitutionalActivity.HIGH:
            base_time *= 1.2

        # Adjust based on liquidity conditions
        if metrics.liquidity_condition == LiquidityCondition.THIN:
            base_time *= 0.7
