    def register_symbol(self, symbol: str, asset_class: str)"""
        """Register a symbol for comprehensive smart money analysis"""

        self.registered_symbols[symbol] = asset_class

        # Register with all components
        if self.institutional_flow_engine:
            asset_class_enum = AssetClass(asset_class.lower()) if asset_class.lower() in [ac.value for ac in AssetClass] else AssetClass.EQUITIES
            self.institutional_flow_engine.register_symbol(symbol, asset_class_enum)

        if self.pattern_recognition_engine:
            self.pattern_recognition_engine.register_symbol(symbol, asset_class)

        if self.volume_profile_engine:
            self.volume_profile_engine.register_symbol(symbol, asset_class)

        self.logger.info(f"Registered {symbol} ({asset_class}) for comprehensive smart money analysis")

    def update_market_data(self, symbol: str, price: float, volume: float,
                          ohlcv: Dict = None, timestamp: datetime = None):
        """
        Update market data and trigger comprehensive smart money analysis.
        Optimized for sub-100μs performance.
        """
        if timestamp is None:
            timestamp = datetime.now(timezone.utc)

        # Performance measurement start
        start_time = datetime.now()

        try:
            # Validate symbol registration
            if symbol not in self.registered_symbols:
                self.logger.warning(f"Symbol {symbol} not registered. Skipping analysis.")
                return

            # Update all components with market data
            asset_class = self.registered_symbols[symbol]

            # Update institutional flow engine
            if self.institutional_flow_engine:
                self.institutional_flow_engine.update_market_data(
                    symbol, price, volume, timestamp, ohlcv
                )

            # Update pattern recognition engine
            if self.pattern_recognition_engine and ohlcv:
                self.pattern_recognition_engine.update_market_data(
                    symbol, ohlcv, timestamp=timestamp
                )

            # Update volume profile engine
            if self.volume_profile_engine:
                self.volume_profile_engine.update_market_data(
                    symbol, price, volume, timestamp, ohlcv or {}
                )

            # Trigger comprehensive analysis
            if self._should_analyze(symbol):
                if self.config.enable_real_time_analysis:
                    self.analysis_queue.put_nowait({
                        'type': 'comprehensive_analysis',
                        'symbol': symbol,
                        'timestamp': timestamp,
                    })
                else:
                    self._run_comprehensive_analysis(symbol, timestamp)

            # Update performance stats
            processing_time = (datetime.now() - start_time).total_seconds() * 1000000  # microseconds
            self._update_performance_stats(processing_time)

        except Exception as e:
            self.logger.error(f"Error in comprehensive smart money analysis for {symbol}: {e}")

    def _should_analyze(self, symbol: str) -> bool"""
        """Determine if comprehensive analysis should be triggered"""

        # Check if symbol is registered
        if symbol not in self.registered_symbols:
            return False

        # Check timing (avoid too frequent analysis)
        if symbol in self.analysis_results and len(self.analysis_results[symbol]) > 0:
            last_analysis = self.analysis_results[symbol][-1]
            time_since = datetime.now(timezone.utc) - last_analysis.timestamp
            if time_since.total_seconds() < 30:  # Minimum 30 seconds between analyses
                return False

        return True

    def _run_comprehensive_analysis(self, symbol: str, timestamp: datetime)"""
        """Run comprehensive smart money analysis"""

        try:
            asset_class = self.registered_symbols[symbol]

            # Collect component analyses
            institutional_flow = None
            patterns = []
            volume_profile = None
            order_flow = None
            vwap_analysis = None

            # Get institutional flow analysis
            if self.institutional_flow_engine:
                institutional_flow = self.institutional_flow_engine.get_current_flow_metrics(symbol)

            # Get pattern recognition analysis
            if self.pattern_recognition_engine:
                patterns = self.pattern_recognition_engine.get_active_patterns(symbol)

            # Get volume profile analysis
            if self.volume_profile_engine:
                volume_profile = self.volume_profile_engine.get_current_volume_profile(symbol)
                order_flow = self.volume_profile_engine.get_current_order_flow_metrics(symbol)
                vwap_analysis = self.volume_profile_engine.get_vwap_analysis(symbol, 20)

            # Generate unified signal
            unified_signal = None
            if self.config.enable_unified_signals:
                unified_signal = self._generate_unified_signal(
                    symbol, asset_class, timestamp,
                    institutional_flow, patterns, volume_profile, order_flow, vwap_analysis
                )

            # Assess market conditions
            market_conditions = self._assess_market_conditions(
                symbol, institutional_flow, patterns, volume_profile, order_flow
            )

            # Create comprehensive analysis
            analysis = SmartMoneyAnalysis(
                symbol=symbol,
                asset_class=asset_class,
                timestamp=timestamp,
                signal=unified_signal,
                institutional_flow=institutional_flow,
                pattern_recognition=patterns,
                volume_profile=volume_profile,
