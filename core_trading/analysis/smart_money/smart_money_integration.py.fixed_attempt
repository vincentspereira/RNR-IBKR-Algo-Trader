    def cleanup_old_data(self, hours: int = 24)"""
        """Clean up old data to prevent memory issues"""

        cutoff_time = datetime.now(timezone.utc) - timedelta(hours=hours)

        with self.lock:
            # Clean up analysis results
            for symbol in list(self.analysis_results.keys()):
                while (self.analysis_results[symbol] and
                       self.analysis_results[symbol][0].timestamp < cutoff_time):
                    self.analysis_results[symbol].popleft()

            # Clean up signal history
            for symbol in list(self.signal_history.keys()):
                while (self.signal_history[symbol] and
                       self.signal_history[symbol][0].timestamp < cutoff_time):
                    self.signal_history[symbol].popleft()

            # Clean up alerts
            while self.alert_history and self.alert_history[0].timestamp < cutoff_time:
                self.alert_history.popleft()

        # Clean up component data
        if self.institutional_flow_engine:
            self.institutional_flow_engine.cleanup_old_data(hours)

        self.logger.info(f"Cleaned up smart money analysis data older than {hours} hours")

    def shutdown(self):
        """Shutdown the smart money analysis engine"""

        # Cancel background tasks
        for task in self.background_tasks:
            task.cancel()

        # Shutdown component engines
        if self.institutional_flow_engine:
            self.institutional_flow_engine.shutdown()

        if self.pattern_recognition_engine:
            self.pattern_recognition_engine.shutdown()

        if self.volume_profile_engine:
            self.volume_profile_engine.shutdown()

        # Clear caches and models
        self.ensemble_models.clear()
        self.signal_predictors.clear()

        self.logger.info("Smart Money Analysis Engine shutdown complete")


