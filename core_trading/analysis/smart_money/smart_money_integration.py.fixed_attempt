    def _start_background_processing(self):
        """Start background processing for intensive computations"""

        async def background_processor():
            while True:
                try:
                    # Process analysis queue
                    if not self.analysis_queue.empty():
                        task = await self.analysis_queue.get()
                        await self._process_background_task(task)

                    # Periodic model updates and optimization
                    await asyncio.sleep(1)

                    # Update ML models
                    if self.config.enable_ai_enhancement:
                        self._update_ml_models()

                except Exception as e:
                    self.logger.error(f"Error in background processing: {e}")
                    await asyncio.sleep(5)

        # Start background task
        task = asyncio.create_task(background_processor())
        self.background_tasks.add(task)
        task.add_done_callback(self.background_tasks.discard)

    async def _process_background_task(self, task: Dict)"""
        """Process background analysis task"""

        try:
            task_type = task.get('type')
            symbol = task.get('symbol')
            timestamp = task.get('timestamp')

            if task_type == 'comprehensive_analysis':
                self._run_comprehensive_analysis(symbol, timestamp)
            elif task_type == 'model_training':
                await self._train_ml_models(symbol)
            elif task_type == 'performance_analysis':
                await self._analyze_performance(symbol)

        except Exception as e:
            self.logger.error(f"Error processing background task {task_type}: {e}")

    async def _train_ml_models(self, symbol: str)"""
        """Train ML models for a symbol"""

        try:
            if not SKLEARN_AVAILABLE:
                return

            # Get historical signal data
            signal_history = list(self.signal_history.get(symbol, []))
            if len(signal_history) < 20:
                return

            # Prepare training data
            features = []
            labels = []

            for signal in signal_history:
                feature_vector = [
                    signal.institutional_flow_score,
                    signal.pattern_recognition_score,
                    signal.volume_profile_score,
                    signal.order_flow_score,
                ]

                # Label based on signal outcome (would need historical price data)
                # For now, use signal type as proxy
                if signal.signal_type in [SmartMoneySignalType.STRONG_BUY, SmartMoneySignalType.BUY]:
                    label = 1  # Positive
                elif signal.signal_type in [SmartMoneySignalType.STRONG_SELL, SmartMoneySignalType.SELL]:
                    label = -1  # Negative
                else:
                    label = 0  # Neutral

                features.append(feature_vector)
                labels.append(label)

            # Train ensemble model
            if len(features) >= 10:
                X = np.array(features)
                y = np.array(labels)

                # Convert to binary classification
                y_binary = (y > 0).astype(int)

                # Create ensemble model
                model = GradientBoostingClassifier(n_estimators=100, random_state=42)
                model.fit(X, y_binary)

                self.ensemble_models[symbol] = model

                self.logger.info(f"Trained ML model for {symbol} with {len(features)} samples")

        except Exception as e:
            self.logger.error(f"Error training ML models for {symbol}: {e}")

