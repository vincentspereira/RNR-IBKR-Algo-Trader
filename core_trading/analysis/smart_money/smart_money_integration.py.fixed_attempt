    def _generate_unified_signal(self, symbol: str, asset_class: str, timestamp: datetime,
                                institutional_flow: Optional[FlowMetrics],
                                patterns: List[Pattern],
                                volume_profile: Optional[VolumeProfile],
                                order_flow: Optional[OrderFlowMetrics],
                                vwap_analysis: Optional[VWAPAnalysis]) -> Optional[SmartMoneySignal]:
        """Generate unified smart money signal from all component analyses"""

        try:
            # Calculate component scores
            institutional_score = 0.0
            pattern_score = 0.0
            volume_score = 0.0
            flow_score = 0.0
            ai_score = 0.0

            # Institutional flow score
            if institutional_flow:
                # Score based on net flow, confidence, and activity level
                institutional_score = (
                    institutional_flow.net_institutional_flow * 0.4 +
                    institutional_flow.confidence_score * 0.3 +
                    (1.0 if institutional_flow.activity_level.value in ['high', 'very_high'] else 0.5) * 0.3
                )

            # Pattern recognition score
            if patterns:
                # Score based on best pattern confidence and direction
                best_pattern = max(patterns, key=lambda p: p.confidence) if patterns else None
                if best_pattern:
                    direction_score = 1.0 if best_pattern.direction == PatternDirection.BULLISH else -1.0 if best_pattern.direction == PatternDirection.BEARISH else 0.0
                    pattern_score = direction_score * best_pattern.confidence

            # Volume profile score
            if volume_profile:
                # Score based on VWAP position and volume nodes
                current_price = self.volume_profile_engine.price_data[symbol][-1][1] if self.volume_profile_engine.price_data.get(symbol) else 0
                if volume_profile.vwap and current_price > 0:
                    vwap_distance = (current_price - volume_profile.vwap) / volume_profile.vwap
                    volume_score = np.tanh(vwap_distance * 10)  # Normalize to -1 to 1

            # Order flow score
            if order_flow:
                # Score based on flow imbalance and institutional activity
                flow_score = (
                    order_flow.net_flow_imbalance * 0.6 +
                    order_flow.institutional_footprint * 0.4
                )

            # AI enhancement score
            if self.config.enable_ai_enhancement and SKLEARN_AVAILABLE:
                ai_score = self._calculate_ai_enhanced_score(
                    symbol, institutional_score, pattern_score, volume_score, flow_score
                )

            # Calculate weighted combined score
            combined_score = (
                institutional_score * 0.25 +
                pattern_score * 0.25 +
                volume_score * 0.20 +
                flow_score * 0.20 +
                ai_score * 0.10
            )

            # Determine signal type and confidence
            signal_type, confidence, strength = self._determine_signal_from_score(combined_score)

            # Generate trading recommendations
            entry_price, stop_loss, price_targets = self._generate_trading_recommendations(
                symbol, combined_score, volume_profile, patterns
            )

            # Create unified signal
            unified_signal = SmartMoneySignal(
                symbol=symbol,
                asset_class=asset_class,
                timestamp=timestamp,
                signal_type=signal_type,
                confidence=confidence,
                strength=strength,
                institutional_flow_score=institutional_score,
                pattern_recognition_score=pattern_score,
                volume_profile_score=volume_score,
                order_flow_score=flow_score,
                ai_enhanced_score=ai_score,
                entry_price=entry_price,
                stop_loss=stop_loss,
                price_targets=price_targets,
                ml_enhanced=self.config.enable_ai_enhancement,
                ensemble_agreement=self._calculate_ensemble_agreement(
                    institutional_score, pattern_score, volume_score, flow_score
                ),
            )

            # Add supporting evidence
            unified_signal.key_patterns = [p.pattern_type.value for p in patterns if p.confidence > 0.7]
            if institutional_flow:
                unified_signal.institutional_activity = f"{institutional_flow.flow_strength.value} {institutional_flow.net_institutional_flow:+.2f}"

            # Add technical levels
            if volume_profile:
                unified_signal.technical_levels = {
                    'vwap': volume_profile.vwap,
                    'poc': volume_profile.point_of_control,
                    'vah': volume_profile.value_area_high,
                    'val': volume_profile.value_area_low,
                }

            return unified_signal

        except Exception as e:
            self.logger.error(f"Error generating unified signal for {symbol}: {e}")
            return None

    def _calculate_ai_enhanced_score(self, symbol: str, institutional_score: float,
                                    pattern_score: float, volume_score: float,
                                    flow_score: float) -> float:
        """Calculate AI-enhanced score using ensemble methods"""

        try:
            if not SKLEARN_AVAILABLE or symbol not in self.ensemble_models:
                # Simple weighted average as fallback
                return (institutional_score + pattern_score + volume_score + flow_score) / 4

            # Extract features
            features = np.array([[institutional_score, pattern_score, volume_score, flow_score]])

            # Use ensemble model
            model = self.ensemble_models[symbol]
            prediction = model.predict_proba(features)[0]

            # Return probability of positive signal
            return prediction[1] - prediction[0]  # Positive - Negative probability

        except Exception as e:
            self.logger.error(f"Error calculating AI-enhanced score: {e}")
            return 0.0

    def _determine_signal_from_score(self, combined_score: float) -> Tuple[SmartMoneySignalType, float, float]"""
        """Determine signal type, confidence, and strength from combined score"""

        # Normalize score to 0-1 range for confidence
        confidence = min(1.0, abs(combined_score))

        # Determine signal type
        if combined_score > 0.6:
            signal_type = SmartMoneySignalType.STRONG_BUY
        elif combined_score > 0.2:
            signal_type = SmartMoneySignalType.BUY
        elif combined_score < -0.6:
            signal_type = SmartMoneySignalType.STRONG_SELL
        elif combined_score < -0.2:
            signal_type = SmartMoneySignalType.SELL
        else:
            signal_type = SmartMoneySignalType.HOLD

        # Strength is the absolute value of the score
        strength = min(1.0, abs(combined_score))

        return signal_type, confidence, strength

    def _generate_trading_recommendations(self, symbol: str, combined_score: float,
                                        volume_profile: Optional[VolumeProfile],
                                        patterns: List[Pattern]) -> Tuple[Optional[float], Optional[float], List[float]]:
        """Generate trading recommendations based on analysis"""

        try:
            current_price = 0.0
            if self.volume_profile_engine and symbol in self.volume_profile_engine.price_data:
                current_price = self.volume_profile_engine.price_data[symbol][-1][1]

            if current_price == 0:
                return None, None, []

            entry_price = current_price
            stop_loss = None
            price_targets = []

            # Calculate stop loss based on volume profile
            if volume_profile and volume_profile.vwap:
                if combined_score > 0:  # Long position
                    stop_loss = volume_profile.vwap * 0.98  # 2% below VWAP
                    price_targets = [
                        volume_profile.vwap * 1.02,  # 2% above VWAP
                        volume_profile.vwap * 1.05,  # 5% above VWAP
                        volume_profile.value_area_high if volume_profile.value_area_high else volume_profile.vwap * 1.03,
                    ]
                else:  # Short position
                    stop_loss = volume_profile.vwap * 1.02  # 2% above VWAP
                    price_targets = [
                        volume_profile.vwap * 0.98,  # 2% below VWAP
                        volume_profile.vwap * 0.95,  # 5% below VWAP
                        volume_profile.value_area_low if volume_profile.value_area_low else volume_profile.vwap * 0.97,
                    ]

            # Adjust based on patterns
            for pattern in patterns:
                if pattern.confidence > 0.7 and pattern.price_target:
                    if pattern.direction == PatternDirection.BULLISH and combined_score > 0:
                        price_targets.append(pattern.price_target)
                    elif pattern.direction == PatternDirection.BEARISH and combined_score < 0:
                        price_targets.append(pattern.price_target)

            # Remove duplicates and sort
            if combined_score > 0:
                price_targets = sorted(list(set([t for t in price_targets if t > entry_price])))
            else:
                price_targets = sorted(list(set([t for t in price_targets if t < entry_price])), reverse=True)

            return entry_price, stop_loss, price_targets

        except Exception as e:
            self.logger.error(f"Error generating trading recommendations: {e}")
            return None, None, []

    def _calculate_ensemble_agreement(self, institutional_score: float,
                                    pattern_score: float, volume_score: float,
                                    flow_score: float) -> float:
        """Calculate agreement between different components"""

        scores = [institutional_score, pattern_score, volume_score, flow_score]
        positive_scores = [s for s in scores if s > 0.1]
        negative_scores = [s for s in scores if s < -0.1]

        total_agreement = (len(positive_scores) + len(negative_scores)) / len(scores)
        return total_agreement

    def _assess_market_conditions(self, symbol: str, institutional_flow: Optional[FlowMetrics],
                                patterns: List[Pattern], volume_profile: Optional[VolumeProfile],
                                order_flow: Optional[OrderFlowMetrics]) -> Dict[str, str]:
        """Assess overall market conditions"""

        conditions = {
            'market_regime': 'normal',
            'liquidity_condition': 'normal',
            'volatility_level': 'normal',
            'trend_direction': 'neutral',
            'risk_level': 'medium',
            'manipulation_risk': 0.0,
            'sentiment_bias': 'neutral',
        }

        try:
            # Market regime based on institutional activity
            if institutional_flow:
                if institutional_flow.manipulation_risk > 0.7:
                    conditions['market_regime'] = 'manipulative'
                elif institutional_flow.anomaly_score > 0.6:
                    conditions['market_regime'] = 'anomalous'
                elif institutional_flow.institutional_frequency > 10:
                    conditions['market_regime'] = 'high_activity'

            # Liquidity condition
            if order_flow:
                conditions['liquidity_condition'] = order_flow.liquidity_level.value

            # Volatility level (simplified)
            if volume_profile and volume_profile.standard_deviation_1:
                if volume_profile.standard_deviation_1 > volume_profile.vwap * 0.03:
                    conditions['volatility_level'] = 'high'
                elif volume_profile.standard_deviation_1 > volume_profile.vwap * 0.015:
                    conditions['volatility_level'] = 'medium'
                else:
                    conditions['volatility_level'] = 'low'

            # Trend direction from patterns
            if patterns:
                bullish_patterns = [p for p in patterns if p.direction == PatternDirection.BULLISH]
                bearish_patterns = [p for p in patterns if p.direction == PatternDirection.BEARISH]

                if len(bullish_patterns) > len(bearish_patterns) * 1.5:
                    conditions['trend_direction'] = 'bullish'
                elif len(bearish_patterns) > len(bullish_patterns) * 1.5:
                    conditions['trend_direction'] = 'bearish'

            # Risk level
            if institutional_flow:
                conditions['risk_level'] = 'high' if institutional_flow.manipulation_risk > 0.5 else 'medium'
                conditions['manipulation_risk'] = institutional_flow.manipulation_risk

            # Sentiment bias
            if institutional_flow:
                net_flow = institutional_flow.net_institutional_flow
                if net_flow > 0.3:
                    conditions['sentiment_bias'] = 'bullish'
                elif net_flow < -0.3:
                    conditions['sentiment_bias'] = 'bearish'

        except Exception as e:
            self.logger.error(f"Error assessing market conditions: {e}")

        return conditions

    def _calculate_analysis_confidence(self, analysis: SmartMoneyAnalysis) -> float"""
        """Calculate overall confidence in the analysis"""

        confidence_factors = []

        # Component availability
        components_available = 0
        if analysis.institutional_flow:
            components_available += 1
            confidence_factors.append(analysis.institutional_flow.confidence_score)
        if analysis.pattern_recognition:
            components_available += 1
            pattern_confidence = np.mean([p.confidence for p in analysis.pattern_recognition]) if analysis.pattern_recognition else 0.5
            confidence_factors.append(pattern_confidence)
        if analysis.volume_profile:
            components_available += 1
            confidence_factors.append(0.7)  # Volume profile is generally reliable
        if analysis.order_flow:
            components_available += 1
            confidence_factors.append(0.6)  # Order flow confidence

        # Data quality score
        confidence_factors.append(analysis.data_quality_score)

        # Component coverage
        coverage_score = components_available / 4.0  # 4 possible components
        confidence_factors.append(coverage_score)

        return np.mean(confidence_factors) if confidence_factors else 0.5

    def _assess_data_quality(self, analysis: SmartMoneyAnalysis) -> float"""
        """Assess quality of data used in analysis"""

        quality_factors = []

        # Data freshness (all components should have recent data)
        current_time = datetime.now(timezone.utc)
        time_threshold = timedelta(minutes=5)

        for component_data in [analysis.institutional_flow, analysis.volume_profile, analysis.order_flow]:
            if component_data and hasattr(component_data, 'timestamp'):
                age = current_time - component_data.timestamp
                freshness_score = max(0, 1 - (age.total_seconds() / 300))  # 5 minute window
                quality_factors.append(freshness_score)

        # Pattern recency
        if analysis.pattern_recognition:
            pattern_ages = [(current_time - p.completion_time).total_seconds() for p in analysis.pattern_recognition]
            avg_pattern_age = np.mean(pattern_ages) if pattern_ages else 300
            pattern_freshness = max(0, 1 - (avg_pattern_age / 600))  # 10 minute window
            quality_factors.append(pattern_freshness)

        return np.mean(quality_factors) if quality_factors else 0.5

    def _generate_smart_money_alerts(self, analysis: SmartMoneyAnalysis)"""
        """Generate smart money alerts based on analysis"""

        if not analysis.signal or analysis.signal.confidence < self.config.alert_confidence_threshold:
            return

        try:
            # Generate signal alert
            if analysis.signal.signal_type in [SmartMoneySignalType.STRONG_BUY, SmartMoneySignalType.STRONG_SELL]:
                severity = "critical"
            elif analysis.signal.signal_type in [SmartMoneySignalType.BUY, SmartMoneySignalType.SELL]:
                severity = "high"
            else:
                severity = "medium"

            alert = SmartMoneyAlert(
                alert_type="unified_smart_money_signal",
                severity=severity,
                symbol=analysis.symbol,
                asset_class=analysis.asset_class,
                timestamp=analysis.timestamp,
                message=f"Smart money {analysis.signal.signal_type.value} signal for {analysis.symbol} "
                        f"with {analysis.signal.confidence:.1%} confidence",
                signal=analysis.signal,
                recommended_action=self._get_recommended_action(analysis.signal),
                urgency="high" if severity in ["critical", "high"] else "normal",
                market_impact="high" if analysis.signal.strength > 0.7 else "medium",
            )

            # Add alerts to the system
            with self.lock:
                self.alert_history.append(alert)
                self.analysis_stats['alerts_triggered'] += 1

            # Trigger callbacks
            for callback in self.alert_callbacks:
                try:
                    callback(alert)
                except Exception as e:
                    self.logger.error(f"Error in alert callback: {e}")

        except Exception as e:
            self.logger.error(f"Error generating smart money alerts: {e}")

    def _get_recommended_action(self, signal: SmartMoneySignal) -> str"""
        """Get recommended action based on signal"""

        if signal.signal_type in [SmartMoneySignalType.STRONG_BUY, SmartMoneySignalType.BUY]:
            return f"Consider BUYING {signal.symbol} at {signal.entry_price:.2f} with stop loss at {signal.stop_loss:.2f}"
        elif signal.signal_type in [SmartMoneySignalType.STRONG_SELL, SmartMoneySignalType.SELL]:
            return f"Consider SELLING {signal.symbol} at {signal.entry_price:.2f} with stop loss at {signal.stop_loss:.2f}"
        else:
            return f"HOLD {signal.symbol} - wait for clearer signals"

