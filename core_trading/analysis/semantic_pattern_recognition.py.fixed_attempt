class SemanticCategory(Enum):
    """Semantic categories for pattern classification."""
    TREND_FOLLOWING = "trend_following"
    MEAN_REVERSION = "mean_reversion"
    BREAKOUT = "breakout"
    CONSOLIDATION = "consolidation"
    REVERSAL = "reversal"
    CONTINUATION = "continuation"
    VOLATILITY_EXPANSION = "volatility_expansion"
    VOLATILITY_CONTRACTION = "volatility_contraction"


class MarketRegime(Enum):
    """Market regimes for pattern context."""
    BULL_MARKET = "bull_market"
    BEAR_MARKET = "bear_market"
    SIDEWAYS_MARKET = "sideways_market"
    HIGH_VOLATILITY = "high_volatility"
    LOW_VOLATILITY = "low_volatility"
    TRANSITIONAL = "transitional"


class PatternComplexity(Enum):
    """Pattern complexity levels."""
    SIMPLE = "simple"  # Basic price/volume patterns
    MODERATE = "moderate"  # Multi-indicator patterns
    COMPLEX = "complex"  # Multi-timeframe, multi-asset patterns
    SOPHISTICATED = "sophisticated"  # Advanced ML-detected patterns


