        print(f"Market regime: {semantic_pattern.market_regime.value}")
        print(f"Pattern complexity: {semantic_pattern.pattern_complexity.value}")
        print(f"Semantic tags: {semantic_pattern.semantic_tags}")

        # Find historical matches
        historical_matches = await semantic_analyzer.find_historical_matches(semantic_pattern, max_matches=5)
        print(f"Found {len(historical_matches)} historical matches")

        # Generate analysis report
        report = await semantic_analyzer.get_pattern_analysis_report(semantic_pattern)
        print(f"Analysis report generated with {len(report)} sections")

    finally:
        await vector_ml_engine.shutdown()


