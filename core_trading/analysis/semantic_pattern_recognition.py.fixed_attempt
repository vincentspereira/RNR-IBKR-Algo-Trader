    async def classify_pattern_semantically(self, pattern: MarketPattern) -> SemanticPattern"""
        """
        Classify a market pattern with semantic information.

        Args:
            pattern: Base market pattern to classify

        Returns:
            Semantically enhanced pattern
        """
        try:
            # Determine semantic category
            semantic_category = self._classify_semantic_category(pattern)

            # Detect market regime
            market_regime = self._detect_market_regime(pattern)

            # Assess pattern complexity
            complexity = self._assess_pattern_complexity(pattern)

            # Calculate semantic features
            conceptual_similarity = self._calculate_conceptual_similarity(pattern, semantic_category)
            contextual_relevance = self._calculate_contextual_relevance(pattern, market_regime)
            temporal_consistency = self._calculate_temporal_consistency(pattern)

            # Analyze historical context
            historical_frequency = self._calculate_historical_frequency(pattern)
            seasonal_strength = self._calculate_seasonal_strength(pattern)
            cyclical_components = self._identify_cyclical_components(pattern)

            # Determine cross-asset relationships
            correlated_assets = self._find_correlated_assets(pattern)
            lead_lag_relationships = self._determine_lead_lag_relationships(pattern)
            spillover_effects = self._identify_spillover_effects(pattern)

            # Build pattern taxonomy
            parent_patterns, child_patterns, sibling_patterns = self._build_pattern_relationships(
                pattern, semantic_category
            )

            # Generate semantic tags
            semantic_tags = self._generate_semantic_tags(pattern, semantic_category, market_regime)

            # Calculate confidence factors
            confidence_factors = self._calculate_confidence_factors(pattern)

            # Estimate uncertainty
            uncertainty_estimates = self._estimate_uncertainty(pattern)

            # Create semantic pattern
            semantic_pattern = SemanticPattern(
                base_pattern=pattern,
                semantic_category=semantic_category,
                market_regime=market_regime,
                pattern_complexity=complexity,
                conceptual_similarity=conceptual_similarity,
                contextual_relevance=contextual_relevance,
                temporal_consistency=temporal_consistency,
                historical_frequency=historical_frequency,
                seasonal_strength=seasonal_strength,
                cyclical_components=cyclical_components,
                correlated_assets=correlated_assets,
                lead_lag_relationships=lead_lag_relationships,
                spillover_effects=spillover_effects,
                parent_patterns=parent_patterns,
                child_patterns=child_patterns,
                sibling_patterns=sibling_patterns,
                semantic_tags=semantic_tags,
                confidence_factors=confidence_factors,
                uncertainty_estimates=uncertainty_estimates
            )

            self.logger.info(f"Classified pattern {pattern.pattern_id} as {semantic_category.value}")
            return semantic_pattern

        except Exception as e:
            self.logger.error(f"Error classifying pattern semantically: {e}")
            # Return basic semantic pattern on error
            return SemanticPattern(
                base_pattern=pattern,
                semantic_category=SemanticCategory.TREND_FOLLOWING,
                market_regime=MarketRegime.TRANSITIONAL,
                pattern_complexity=PatternComplexity.SIMPLE,
                conceptual_similarity=0.5,
                contextual_relevance=0.5,
                temporal_consistency=0.5,
                historical_frequency=0.5,
                seasonal_strength=0.5,
                confidence_factors={"base": 0.5},
                uncertainty_estimates={"total": 0.5}
            )

    def _classify_semantic_category(self, pattern: MarketPattern) -> SemanticCategory"""
        """Classify pattern into semantic category based on characteristics."""
        # Use pattern type as primary indicator
        pattern_type_mapping = {
            PatternType.BREAKOUT: SemanticCategory.BREAKOUT,
            PatternType.MOMENTUM: SemanticCategory.TREND_FOLLOWING,
            PatternType.MEAN_REVERSION: SemanticCategory.MEAN_REVERSION,
            PatternType.VOLATILITY: SemanticCategory.VOLATILITY_EXPANSION,
            PatternType.PRICE_ACTION: SemanticCategory.CONTINUATION,
            PatternType.TECHNICAL: SemanticCategory.TREND_FOLLOWING,
            PatternType.SENTIMENT: SemanticCategory.REVERSAL,
            PatternType.VOLUME: SemanticCategory.CONTINUATION
        }

        base_category = pattern_type_mapping.get(pattern.pattern_type, SemanticCategory.CONTINUATION)

        # Refine based on pattern characteristics
        if pattern.trend_strength > 0.7:
            if pattern.volatility > 0.4:
                return SemanticCategory.VOLATILITY_EXPANSION
            else:
                return SemanticCategory.TREND_FOLLOWING
        elif pattern.trend_strength < 0.3:
            if pattern.volatility < 0.2:
                return SemanticCategory.VOLATILITY_CONTRACTION
            else:
                return SemanticCategory.CONSOLIDATION
        else:
            # Use pattern metadata for more specific classification
            if pattern.metadata.get('reversal_indicator', False):
                return SemanticCategory.REVERSAL
            elif pattern.metadata.get('continuation_indicator', False):
                return SemanticCategory.CONTINUATION

        return base_category

    def _detect_market_regime(self, pattern: MarketPattern) -> MarketRegime"""
        """Detect market regime based on pattern characteristics."""
        # Determine trend direction
        if pattern.trend_strength > 0.6:
            if pattern.metadata.get('trend_direction', 'up') == 'up':
                regime = MarketRegime.BULL_MARKET
            else:
                regime = MarketRegime.BEAR_MARKET
        elif pattern.trend_strength < 0.4:
            regime = MarketRegime.SIDEWAYS_MARKET
        else:
            regime = MarketRegime.TRANSITIONAL

        # Adjust for volatility
        if pattern.volatility > 0.4:
            if regime == MarketRegime.TRANSITIONAL:
                regime = MarketRegime.HIGH_VOLATILITY
            else:
                # Add volatility modifier
                if regime == MarketRegime.BULL_MARKET:
                    regime = MarketRegime.TRANSITIONAL  # High volatility suggests uncertainty
        elif pattern.volatility < 0.15:
            if regime in [MarketRegime.SIDEWAYS_MARKET, MarketRegime.TRANSITIONAL]:
                regime = MarketRegime.LOW_VOLATILITY

        return regime

    def _assess_pattern_complexity(self, pattern: MarketPattern) -> PatternComplexity"""
        """Assess the complexity of a pattern."""
        complexity_score = 0

        # Base complexity from pattern type
        type_complexity = {
            PatternType.PRICE_ACTION: 1,
            PatternType.VOLUME: 1,
            PatternType.MOMENTUM: 2,
            PatternType.VOLATILITY: 2,
            PatternType.MEAN_REVERSION: 2,
            PatternType.BREAKOUT: 3,
            PatternType.TECHNICAL: 3,
            PatternType.SENTIMENT: 4
        }
        complexity_score += type_complexity.get(pattern.pattern_type, 2)

        # Add complexity for multi-timeframe data
        if pattern.metadata.get('multi_timeframe', False):
            complexity_score += 1

        # Add complexity for cross-asset data
        if pattern.metadata.get('cross_asset', False):
            complexity_score += 1

        # Add complexity for advanced indicators
        if len(pattern.metadata.get('indicators', [])) > 5:
            complexity_score += 1

        # Add complexity for ML-generated patterns
        if pattern.metadata.get('ml_generated', False):
            complexity_score += 1

        # Map score to complexity level
        if complexity_score <= 2:
            return PatternComplexity.SIMPLE
        elif complexity_score <= 4:
            return PatternComplexity.MODERATE
        elif complexity_score <= 6:
            return PatternComplexity.COMPLEX
        else:
            return PatternComplexity.SOPHISTICATED

    def _calculate_conceptual_similarity(self, pattern: MarketPattern, category: SemanticCategory) -> float"""
        """Calculate conceptual similarity to pattern category."""
        # Base similarity from pattern type matching
        type_match_score = 0.8 if pattern.pattern_type.value in category.value else 0.5

        # Adjust based on pattern characteristics
        characteristic_score = 0.0

        if category == SemanticCategory.TREND_FOLLOWING:
            characteristic_score = pattern.trend_strength
        elif category == SemanticCategory.MEAN_REVERSION:
            characteristic_score = 1.0 - pattern.trend_strength
        elif category == SemanticCategory.VOLATILITY_EXPANSION:
            characteristic_score = pattern.volatility
        elif category == SemanticCategory.VOLATILITY_CONTRACTION:
            characteristic_score = 1.0 - pattern.volatility
        elif category == SemanticCategory.BREAKOUT:
            characteristic_score = pattern.metadata.get('breakout_potential', 0.5)
        elif category == SemanticCategory.REVERSAL:
            characteristic_score = pattern.metadata.get('reversal_probability', 0.5)

        # Combine scores
        return (type_match_score + characteristic_score) / 2

    def _calculate_contextual_relevance(self, pattern: MarketPattern, regime: MarketRegime) -> float"""
        """Calculate contextual relevance to current market regime."""
        # Pattern-regime compatibility matrix
        compatibility_matrix = {
            (SemanticCategory.TREND_FOLLOWING, MarketRegime.BULL_MARKET): 0.9,
            (SemanticCategory.TREND_FOLLOWING, MarketRegime.BEAR_MARKET): 0.8,
            (SemanticCategory.TREND_FOLLOWING, MarketRegime.SIDEWAYS_MARKET): 0.4,
            (SemanticCategory.MEAN_REVERSION, MarketRegime.SIDEWAYS_MARKET): 0.9,
            (SemanticCategory.MEAN_REVERSION, MarketRegime.TRANSITIONAL): 0.7,
            (SemanticCategory.BREAKOUT, MarketRegime.TRANSITIONAL): 0.8,
            (SemanticCategory.BREAKOUT, MarketRegime.HIGH_VOLATILITY): 0.9,
            (SemanticCategory.REVERSAL, MarketRegime.BULL_MARKET): 0.7,
            (SemanticCategory.REVERSAL, MarketRegime.BEAR_MARKET): 0.7,
            (SemanticCategory.REVERSAL, MarketRegime.TRANSITIONAL): 0.8,
            (SemanticCategory.CONSOLIDATION, MarketRegime.SIDEWAYS_MARKET): 0.9,
            (SemanticCategory.CONSOLIDATION, MarketRegime.LOW_VOLATILITY): 0.8,
        }

        semantic_category = self._classify_semantic_category(pattern)
        compatibility_key = (semantic_category, regime)

        base_relevance = compatibility_matrix.get(compatibility_key, 0.5)

        # Adjust based on pattern confidence
        adjusted_relevance = base_relevance * (0.5 + 0.5 * pattern.confidence_score)

        return min(1.0, adjusted_relevance)

    def _calculate_temporal_consistency(self, pattern: MarketPattern) -> float"""
        """Calculate temporal consistency across timeframes."""
        # Check if pattern is consistent across multiple timeframes
        multi_timeframe_data = pattern.metadata.get('multi_timeframe_analysis', {})

        if not multi_timeframe_data:
            # Single timeframe pattern
            return 0.7  # Moderate consistency

        consistency_scores = []

        # Compare pattern characteristics across timeframes
        timeframes = list(multi_timeframe_data.keys())
        if len(timeframes) < 2:
            return 0.7

        for i in range(len(timeframes)):
            for j in range(i + 1, len(timeframes)):
                tf1, tf2 = timeframes[i], timeframes[j]
                data1, data2 = multi_timeframe_data[tf1], multi_timeframe_data[tf2]

                # Compare trend directions
                trend_consistency = 1.0 if data1.get('trend_direction') == data2.get('trend_direction') else 0.0

                # Compare pattern types
                pattern_consistency = 1.0 if data1.get('pattern_type') == data2.get('pattern_type') else 0.5

                # Compare volatility regimes
                vol_consistency = 1.0 - abs(data1.get('volatility', 0.5) - data2.get('volatility', 0.5))

                # Overall consistency for this pair
                pair_consistency = (trend_consistency + pattern_consistency + vol_consistency) / 3
                consistency_scores.append(pair_consistency)

        if consistency_scores:
            return np.mean(consistency_scores)
        else:
            return 0.7

    def _calculate_historical_frequency(self, pattern: MarketPattern) -> float"""
        """Calculate how frequently this pattern appears historically."""
        # This would typically query a historical pattern database
        # For now, use pattern metadata or return a default value
        return pattern.metadata.get('historical_frequency', 0.1)  # Default 10% frequency

    def _calculate_seasonal_strength(self, pattern: MarketPattern) -> float"""
        """Calculate seasonal characteristics of the pattern."""
        # Check if pattern has seasonal components
        seasonal_data = pattern.metadata.get('seasonal_analysis', {})

        if seasonal_data:
            return seasonal_data.get('seasonal_strength', 0.5)

        # Simple heuristic based on pattern timing
        pattern_month = pattern.start_time.month
        pattern_quarter = (pattern_month - 1) // 3

        # Some patterns have seasonal tendencies
        seasonal_patterns = {
            PatternType.BREAKOUT: {2: 0.7, 3: 0.8, 9: 0.6, 10: 0.7},  # Spring and Fall
            PatternType.MEAN_REVERSION: {1: 0.6, 7: 0.7, 8: 0.6},  # Winter and Summer
        }

        if pattern.pattern_type in seasonal_patterns:
            return seasonal_patterns[pattern.pattern_type].get(pattern_quarter, 0.5)

        return 0.5

    def _identify_cyclical_components(self, pattern: MarketPattern) -> List[str]"""
        """Identify cyclical components in the pattern."""
        cycles = []

        # Check for business cycle effects
        if pattern.metadata.get('business_cycle_sensitive', False):
            cycles.append("business_cycle")

        # Check for sector rotation
        if pattern.metadata.get('sector_rotation', False):
            cycles.append("sector_rotation")

        # Check for earnings cycle
        if pattern.metadata.get('earnings_related', False):
            cycles.append("earnings_cycle")

        # Check for monetary cycle
        if pattern.metadata.get('interest_rate_sensitive', False):
            cycles.append("monetary_cycle")

        # Check for seasonal cycles
        if self._calculate_seasonal_strength(pattern) > 0.7:
            cycles.append("seasonal")

        return cycles

