class DataSource(Enum):
    """Data source enumeration"""

    IBKR = "ibkr"
    YAHOO_FINANCE = "yahoo_finance"
    ALPHA_VANTAGE = "alpha_vantage"
    POLYGON = "polygon"
    FINNHUB = "finnhub"
    INVESTING_COM = "investing_com"
    CME_GROUP = "cme_group"
    TWELVE_DATA = "twelve_data"
    BARCHART = "barchart"
    SPIDERROCK = "spiderrock"
    TRADINGCHARTS = "tradingcharts"
    OANDA = "oanda"
    CACHE = "cached_data"


class DataStatus(Enum):
    """Data status enumeration"""

    SUCCESS = "success"
    FAILED = "failed"
    TIMEOUT = "timeout"
    NO_DATA = "no_data"
    STALE = "stale"


@dataclass
class MarketDataPoint:
    """Standard market data structure"""

    symbol: str
    timestamp: datetime
    open: float
    high: float
    low: float
    close: float
    volume: int
    source: DataSource
    status: DataStatus
    latency_ms: float = 0.0
    metadata: Dict[str, Any] = None
    error_message: str = ""

    def __post_init__(self):
        if self.metadata is None:
            self.metadata = {}

    @property
    def price(self) -> float:
        """Alias for close price for backward compatibility"""
        return self.close


@dataclass
class DataSourceConfig:
    """Data source configuration"""

    name: DataSource
    priority: int
    enabled: bool
    timeout_seconds: int
    rate_limit_per_minute: int
    api_key: Optional[str] = None
    base_url: Optional[str] = None
    metadata: Dict[str, Any] = None

    def __post_init__(self):
        if self.metadata is None:
            self.metadata = {}


class DataFeedManager:
    """Multi-source data feed manager with failover"""

    def __init__(self, config_path: Optional[str] = None):
        self.sources = {}
        self.fallback_order = []
        self.cache = {}
        self.source_stats = {}
        self.active_connections = {}
        self.config = {}
        self.fallback_chains = {}
        self.symbol_mapping = {}
        self.health_check_config = {}
        self.error_handling_config = {}
        self.monitoring_config = {}

        # Load configuration
        self.config_path = config_path or "config/data_feeds_config.yaml"
        self._load_configuration()

        # Initialize source configurations
        self._initialize_sources()

    def _load_configuration(self):
        """Load configuration from YAML file"""
        try:
            config_file = Path(self.config_path)
            if not config_file.exists():
                logger.warning(
                    f"Configuration file not found: {self.config_path}. Using default settings."
                )
                self._load_default_configuration()
                return

            with open(config_file, "r", encoding="utf-8") as f:
                self.config = yaml.safe_load(f)

            # Extract configuration sections
            self.fallback_chains = self.config.get("fallback_chains", {})
            self.symbol_mapping = self.config.get("symbol_mapping", {})
            self.health_check_config = self.config.get("health_check", {})
            self.error_handling_config = self.config.get("error_handling", {})
            self.monitoring_config = self.config.get("monitoring", {})

            logger.info(f"Configuration loaded from: {self.config_path}")

        except Exception as e:
            logger.error(f"Failed to load configuration: {e}. Using default settings.")
            self._load_default_configuration()

    def _load_default_configuration(self):
        """Load default configuration when config file is not available"""
        self.config = {
            "global": {
                "default_timeout": 30,
                "max_retries": 3,
                "rate_limiting": {"enabled": True, "default_requests_per_minute": 60},
            },
            "data_sources": {},
            "fallback_chains": {
                "stocks": {"primary": ["yahoo", "alpha_vantage", "polygon", "finnhub"]},
                "forex": {"primary": ["yahoo", "oanda", "alpha_vantage"]},
                "crypto": {"primary": ["yahoo", "alpha_vantage", "polygon"]},
            },
        }

    def _initialize_sources(self):
        """Initialize data source configurations from config file"""
        data_sources_config = self.config.get("data_sources", {})
        global_config = self.config.get("global", {})

        # Default timeout and retries
        default_timeout = global_config.get("default_timeout", 30)
        default_retries = global_config.get("max_retries", 3)
        default_rate_limit = global_config.get("rate_limiting", {}).get(
            "default_requests_per_minute", 60
        )

        # If no data sources configured, use defaults
        if not data_sources_config:
            self._initialize_default_sources()
            return

        # Initialize each configured data source
        for source_name, source_config in data_sources_config.items():
            if not source_config.get("enabled", True):
                continue

            # Map source name to DataSource enum
            data_source_enum = self._get_data_source_enum(source_name)
            if not data_source_enum:
                logger.warning(f"Unknown data source: {source_name}")
                continue

            settings = source_config.get("settings", {})

            # Create DataSourceConfig
            self.sources[data_source_enum] = DataSourceConfig(
                name=data_source_enum,
                priority=source_config.get("priority", 999),
                enabled=source_config.get("enabled", True),
                base_url=source_config.get("base_url", ""),
                api_key=self._resolve_api_key(source_config.get("api_key", "")),
                timeout_seconds=settings.get("timeout", default_timeout),
                rate_limit_per_minute=settings.get(
                    "rate_limit_per_minute", default_rate_limit
                ),
                metadata={
                    "asset_classes": source_config.get("asset_classes", []),
                    "endpoints": source_config.get("endpoints", {}),
                    "connection": source_config.get("connection", {}),
                },
            )

        # Add cache as virtual source if not configured
        if DataSource.CACHE not in self.sources:
            self.sources[DataSource.CACHE] = DataSourceConfig(
                name=DataSource.CACHE,
                priority=999,
                enabled=True,
                base_url="",
                api_key="",
                timeout_seconds=1,
                rate_limit_per_minute=10000,
                metadata={"virtual": True, "cache": True},
            )

        # Create fallback order (sorted by priority)
        self.fallback_order = sorted(
            [source for source in self.sources.values() if source.enabled],
            key=lambda x: x.priority,
        )

        # Initialize source statistics
        for source in self.sources.values():
            self.source_stats[source.name] = {
                "requests": 0,
                "successes": 0,
                "failures": 0,
                "avg_latency": 0.0,
                "last_success": None,
                "last_failure": None,
                "uptime_percentage": 100.0,
            }

