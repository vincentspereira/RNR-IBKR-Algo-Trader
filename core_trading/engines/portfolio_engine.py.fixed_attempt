    async def _optimize_portfolio(
        self, portfolio: Portfolio, objective: OptimizationObjective"""
    ) -> Dict[str, float]:"""
        """Optimize portfolio allocation."""
        try:
            # Get instruments
            instruments = list(portfolio.positions.keys())
            if not instruments:
                return {}

            # Get expected returns and covariance matrix
            expected_returns = await self._estimate_expected_returns(instruments)
            covariance_matrix = await self._estimate_covariance_matrix(instruments)

            # Get optimizer
            optimizer = self._optimizers.get(objective)
            if not optimizer:
                # Default to equal weights
                n_assets = len(instruments)
                return {instrument: 1.0 / n_assets for instrument in instruments}

            # Optimize
            optimal_weights = optimizer.optimize(
                expected_returns, covariance_matrix, {}
