    async def update_position(
        self,
        portfolio_id: str,
        instrument: str,
        quantity_change: float,
        price: float,
        transaction_cost: float = 0.0,"""
    ) -> bool:"""
        """Update a position in the portfolio."""
        try:
            with self._lock:
                portfolio = self._portfolios.get(portfolio_id)
                if not portfolio:
                    return False

                # Get or create position
                if instrument in portfolio.positions:
                    position = portfolio.positions[instrument]
                else:
                    position = Position(
                        instrument=instrument,
                        asset_class=self._classify_asset(instrument),
                        quantity=0.0,
                        market_value=0.0,
                        cost_basis=0.0,
                        unrealized_pnl=0.0,
                        realized_pnl=0.0,
                        weight=0.0,
                        sector=self._get_sector(instrument),
                        country=self._get_country(instrument),
                    )
                    portfolio.positions[instrument] = position

                # Calculate realized P&L for sales
                if quantity_change < 0 and position.quantity > 0:
                    avg_cost = (
                        position.cost_basis / position.quantity
                        if position.quantity > 0
                        else price
                    )
                    realized_pnl = abs(quantity_change) * (price - avg_cost)
                    position.realized_pnl += realized_pnl

                # Update position
                old_quantity = position.quantity
                position.quantity += quantity_change

                # Update cost basis
                if quantity_change > 0:  # Buy
                    total_cost = (
                        position.cost_basis
                        + (quantity_change * price)
                        + transaction_cost
                    )
                    position.cost_basis = total_cost
                elif position.quantity <= 0:  # Sold all
                    position.cost_basis = 0.0
                else:  # Partial sale
                    position.cost_basis *= position.quantity / old_quantity

                # Update market value
                position.market_value = position.quantity * price

                # Update unrealized P&L
                if position.quantity > 0:
                    avg_cost = position.cost_basis / position.quantity
                    position.unrealized_pnl = position.quantity * (price - avg_cost)
                else:
                    position.unrealized_pnl = 0.0

                position.last_updated = datetime.now()

                # Update cash
                portfolio.cash -= (quantity_change * price) + transaction_cost

                # Recalculate portfolio totals
                await self._recalculate_portfolio(portfolio)

            # Emit event
            await self._event_bus.emit("""
                EventType.POSITION_UPDATE,"""
                {"portfolio_id": portfolio_id, "position": position},
                EventPriority.HIGH,
            )

            return True

        except Exception as e:"""
            logger.error("""
                f"Error updating position {instrument} in portfolio {portfolio_id}: {e}"
            )
            return False

