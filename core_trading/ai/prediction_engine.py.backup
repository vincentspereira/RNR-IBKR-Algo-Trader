"""
PredictionEngine - Refactored (Communication Pattern)
Based on successful communication_wrapper.py refactoring approach
Applied modular handler architecture
"""

import logging
from typing import Any, Dict, Optional

from .predictionengine_handlers.base_handler import PredictionEngineBaseHandler
from .predictionengine_handlers.main_handler import PredictionEngineMainHandler
from .predictionengine_handlers.config_handler import PredictionEngineConfigHandler
from .predictionengine_handlers.state_handler import PredictionEngineStateHandler
from .predictionengine_handlers.validation_handler import PredictionEngineValidationHandler

logger = logging.getLogger(__name__)

class PredictionEngine:
    """
    Refactored PredictionEngine using communication pattern
    Applied modular handler architecture
    """

    def __init__(self, config: Optional[Dict[str, Any]] = None):
        self.config = config or {}
        self.logger = logger

        # Initialize handlers
        self.base_handler = PredictionEngineBaseHandler(config)
        self.main_handler = PredictionEngineMainHandler(config)
        self.config_handler = PredictionEngineConfigHandler(config)
        self.state_handler = PredictionEngineStateHandler(config)
        self.validation_handler = PredictionEngineValidationHandler(config)

    def process_request(self, request: Any) -> Any:
        """Process request using appropriate handlers"""
        self.logger.info(f"Processing request with {self.__class__.__name__}")

        # Use main handler by default
        if hasattr(self, 'main_handler'):
            return self.main_handler.handle(request)

        return {"status": "processed", "class": self.__class__.__name__}

    def get_status(self) -> Dict[str, Any]:
        """Get status from all handlers"""
        status = {
            "main_class": self.__class__.__name__,
            "handlers": {}
        }

        for handler_name in handlers:
            if hasattr(self, handler_name):
                handler = getattr(self, handler_name)
                status["handlers"][handler_name] = handler.get_handler_info()

        return status
