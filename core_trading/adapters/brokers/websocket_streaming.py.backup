"""WebSocket streaming support for real-time data across broker adapters

This module provides a unified WebSocket streaming interface for real-time
market data, order updates, and account information across different brokers.
"""

import asyncio
import json
import logging
import ssl
import threading
import time
import weakref
from abc import ABC, abstractmethod
from collections import defaultdict, deque
from dataclasses import dataclass, field
from enum import Enum
from typing import Any, Callable, Dict, List, Optional, Set, Union
from urllib.parse import urljoin, urlparse

import websockets
from websockets.exceptions import ConnectionClosed, WebSocketException


class StreamType(Enum):
    """Types of data streams"""

    MARKET_DATA = "market_data"
    ORDER_UPDATES = "order_updates"
    ACCOUNT_UPDATES = "account_updates"
    TRADE_UPDATES = "trade_updates"
    POSITION_UPDATES = "position_updates"
    BALANCE_UPDATES = "balance_updates"
    NEWS = "news"
    CUSTOM = "custom"


class StreamStatus(Enum):
    """Stream connection status"""

    DISCONNECTED = "disconnected"
    CONNECTING = "connecting"
    CONNECTED = "connected"
    RECONNECTING = "reconnecting"
    ERROR = "error"
    PAUSED = "paused"


class MessageType(Enum):
    """WebSocket message types"""

    SUBSCRIBE = "subscribe"
    UNSUBSCRIBE = "unsubscribe"
    DATA = "data"
    ERROR = "error"
    HEARTBEAT = "heartbeat"
    AUTH = "auth"
    STATUS = "status"


@dataclass
class StreamConfig:
    """WebSocket stream configuration"""

    url: str
    max_reconnect_attempts: int = 10
    reconnect_delay: float = 1.0
    exponential_backoff: bool = True
    max_backoff_delay: float = 60.0
    heartbeat_interval: float = 30.0
    ping_interval: float = 20.0
    ping_timeout: float = 10.0
    message_queue_size: int = 1000
    enable_compression: bool = True
    ssl_context: Optional[ssl.SSLContext] = None
    headers: Dict[str, str] = field(default_factory=dict)
    auth_required: bool = False
    auth_message: Optional[Dict[str, Any]] = None


@dataclass
class StreamMessage:
    """WebSocket stream message"""

    stream_type: StreamType
    message_type: MessageType
    data: Any
    timestamp: float = field(default_factory=time.time)
    symbol: Optional[str] = None
    channel: Optional[str] = None
    sequence: Optional[int] = None


@dataclass
class StreamMetrics:
    """Stream performance metrics"""

    messages_received: int = 0
    messages_sent: int = 0
    bytes_received: int = 0
    bytes_sent: int = 0
    connection_count: int = 0
    reconnection_count: int = 0
    last_message_time: float = 0.0
    average_latency: float = 0.0
    error_count: int = 0
    uptime: float = 0.0
    start_time: float = field(default_factory=time.time)


class StreamHandler(ABC):
    """Abstract base class for stream message handlers"""

    @abstractmethod
    async def handle_message(self, message: StreamMessage) -> None:
        """Handle incoming stream message"""
        pass

    @abstractmethod
    async def handle_error(self, error: Exception) -> None:
        """Handle stream error"""
        pass

    @abstractmethod
    async def handle_connection_change(self, status: StreamStatus) -> None:
        """Handle connection status change"""
        pass


class MessageBuffer:
    """Thread-safe message buffer with overflow protection"""

    def __init__(self, max_size: int = 1000):
        self.max_size = max_size
        self.buffer = deque(maxlen=max_size)
        self._lock = threading.Lock()
        self._condition = threading.Condition(self._lock)

    def put(self, message: StreamMessage) -> bool:
        """Add message to buffer"""
        with self._condition:
            if len(self.buffer) >= self.max_size:
                # Remove oldest message
                self.buffer.popleft()

            self.buffer.append(message)
            self._condition.notify()
            return True

    def get(self, timeout: Optional[float] = None) -> Optional[StreamMessage]:
        """Get message from buffer"""
        with self._condition:
            if not self.buffer:
                if timeout is None:
                    self._condition.wait()
                else:
                    self._condition.wait(timeout)

            return self.buffer.popleft() if self.buffer else None

    def get_all(self) -> List[StreamMessage]:
        """Get all messages from buffer"""
        with self._lock:
            messages = list(self.buffer)
            self.buffer.clear()
            return messages

    def size(self) -> int:
        """Get current buffer size"""
        with self._lock:
            return len(self.buffer)

    def clear(self):
        """Clear buffer"""
        with self._lock:
            self.buffer.clear()


class WebSocketStream:
    """Individual WebSocket stream connection"""

    def __init__(self, config: StreamConfig, handler: StreamHandler):
        self.config = config
        self.handler = handler
        self.websocket: Optional[websockets.WebSocketServerProtocol] = None
        self.status = StreamStatus.DISCONNECTED
        self.metrics = StreamMetrics()
        self.subscriptions: Set[str] = set()
        self.message_buffer = MessageBuffer(config.message_queue_size)
        self._reconnect_attempts = 0
        self._last_heartbeat = 0.0
        self._tasks: Set[asyncio.Task] = set()
        self._logger = logging.getLogger(f"{__name__}.{self.__class__.__name__}")
        self._stop_event = asyncio.Event()

    async def connect(self) -> bool:
        """Connect to WebSocket"""
        if self.status == StreamStatus.CONNECTED:
            return True

        self.status = StreamStatus.CONNECTING
        await self.handler.handle_connection_change(self.status)

        try:
            # Prepare connection parameters
            extra_headers = self.config.headers.copy()

            # Create SSL context if needed
            ssl_context = self.config.ssl_context
            if ssl_context is None and self.config.url.startswith("wss://"):
                ssl_context = ssl.create_default_context()

            # Connect to WebSocket
            self.websocket = await websockets.connect(
                self.config.url,
                extra_headers=extra_headers,
                ssl=ssl_context,
                ping_interval=self.config.ping_interval,
                ping_timeout=self.config.ping_timeout,
                compression="deflate" if self.config.enable_compression else None,
            )

            self.status = StreamStatus.CONNECTED
            self.metrics.connection_count += 1
            self._reconnect_attempts = 0
            self._last_heartbeat = time.time()

            self._logger.info(f"Connected to WebSocket: {self.config.url}")
            await self.handler.handle_connection_change(self.status)

            # Authenticate if required
            if self.config.auth_required and self.config.auth_message:
                await self._send_message(self.config.auth_message)

            # Start background tasks
            await self._start_tasks()

            return True

        except Exception as e:
            self._logger.error(f"Failed to connect to WebSocket: {e}")
            self.status = StreamStatus.ERROR
            await self.handler.handle_error(e)
            await self.handler.handle_connection_change(self.status)
            return False

    async def disconnect(self):
        """Disconnect from WebSocket"""
        self._stop_event.set()

        # Cancel all tasks
        for task in self._tasks:
            if not task.done():
                task.cancel()

        if self._tasks:
            await asyncio.gather(*self._tasks, return_exceptions=True)
        self._tasks.clear()

        # Close WebSocket connection
        if self.websocket:
            await self.websocket.close()
            self.websocket = None

        self.status = StreamStatus.DISCONNECTED
        await self.handler.handle_connection_change(self.status)
        self._logger.info("Disconnected from WebSocket")

    async def _start_tasks(self):
        """Start background tasks"""
        # Message receiving task
        receive_task = asyncio.create_task(self._receive_messages())
        self._tasks.add(receive_task)

        # Heartbeat task
        if self.config.heartbeat_interval > 0:
            heartbeat_task = asyncio.create_task(self._heartbeat_loop())
            self._tasks.add(heartbeat_task)

        # Message processing task
        process_task = asyncio.create_task(self._process_messages())
        self._tasks.add(process_task)

    async def _receive_messages(self):
        """Receive messages from WebSocket"""
        try:
            while not self._stop_event.is_set() and self.websocket:
                try:
                    raw_message = await asyncio.wait_for(
                        self.websocket.recv(), timeout=1.0
                    )

                    self.metrics.messages_received += 1
                    self.metrics.bytes_received += len(raw_message)
                    self.metrics.last_message_time = time.time()

                    # Parse message
                    message = await self._parse_message(raw_message)
                    if message:
                        self.message_buffer.put(message)

                except asyncio.TimeoutError:
                    continue
                except ConnectionClosed:
                    self._logger.warning("WebSocket connection closed")
                    break
                except Exception as e:
                    self._logger.error(f"Error receiving message: {e}")
                    await self.handler.handle_error(e)

        except Exception as e:
            self._logger.error(f"Fatal error in message receiving: {e}")
            await self.handler.handle_error(e)

        # Attempt reconnection if not manually stopped
        if not self._stop_event.is_set():
            await self._attempt_reconnection()

    async def _process_messages(self):
        """Process messages from buffer"""
        while not self._stop_event.is_set():
            try:
                message = self.message_buffer.get(timeout=1.0)
                if message:
                    await self.handler.handle_message(message)
            except Exception as e:
                self._logger.error(f"Error processing message: {e}")
                await self.handler.handle_error(e)

    async def _parse_message(
        self, raw_message: Union[str, bytes]
    ) -> Optional[StreamMessage]:
        """Parse raw WebSocket message"""
        try:
            if isinstance(raw_message, bytes):
                raw_message = raw_message.decode("utf-8")

            data = json.loads(raw_message)

            # Extract message information (broker-specific logic would go here)
            message_type = MessageType.DATA
            stream_type = StreamType.MARKET_DATA

            # Determine message type from data structure
            if "type" in data:
                msg_type = data.get("type", "").lower()
                if msg_type in ["error", "err"]:
                    message_type = MessageType.ERROR
                elif msg_type in ["heartbeat", "ping", "pong"]:
                    message_type = MessageType.HEARTBEAT
                elif msg_type in ["auth", "authentication"]:
                    message_type = MessageType.AUTH

            # Determine stream type from data structure
            if "channel" in data or "stream" in data:
                channel = data.get("channel") or data.get("stream", "")
                if "trade" in channel.lower():
                    stream_type = StreamType.TRADE_UPDATES
                elif "order" in channel.lower():
                    stream_type = StreamType.ORDER_UPDATES
                elif "account" in channel.lower():
                    stream_type = StreamType.ACCOUNT_UPDATES
                elif "position" in channel.lower():
                    stream_type = StreamType.POSITION_UPDATES

            return StreamMessage(
                stream_type=stream_type,
                message_type=message_type,
                data=data,
                symbol=data.get("symbol"),
                channel=data.get("channel") or data.get("stream"),
                sequence=data.get("sequence") or data.get("seq"),
            )

        except Exception as e:
            self._logger.error(f"Failed to parse message: {e}")
            return None

    async def _heartbeat_loop(self):
        """Send periodic heartbeat messages"""
        while not self._stop_event.is_set():
            try:
                await asyncio.sleep(self.config.heartbeat_interval)

                if self.websocket and self.status == StreamStatus.CONNECTED:
                    # Send heartbeat (implementation specific)
                    heartbeat_msg = {"type": "heartbeat", "timestamp": time.time()}
                    await self._send_message(heartbeat_msg)
                    self._last_heartbeat = time.time()

            except Exception as e:
                self._logger.error(f"Heartbeat error: {e}")

    async def _send_message(self, message: Dict[str, Any]) -> bool:
        """Send message to WebSocket"""
        try:
            if self.websocket and self.status == StreamStatus.CONNECTED:
                json_message = json.dumps(message)
                await self.websocket.send(json_message)

                self.metrics.messages_sent += 1
                self.metrics.bytes_sent += len(json_message)
                return True

        except Exception as e:
            self._logger.error(f"Failed to send message: {e}")
            await self.handler.handle_error(e)

        return False

    async def subscribe(self, channels: Union[str, List[str]]) -> bool:
        """Subscribe to data channels"""
        if isinstance(channels, str):
            channels = [channels]

        subscribe_msg = {
            "type": "subscribe",
            "channels": channels,
            "timestamp": time.time(),
        }

        success = await self._send_message(subscribe_msg)
        if success:
            self.subscriptions.update(channels)
            self._logger.info(f"Subscribed to channels: {channels}")

        return success

    async def unsubscribe(self, channels: Union[str, List[str]]) -> bool:
        """Unsubscribe from data channels"""
        if isinstance(channels, str):
            channels = [channels]

        unsubscribe_msg = {
            "type": "unsubscribe",
            "channels": channels,
            "timestamp": time.time(),
        }

        success = await self._send_message(unsubscribe_msg)
        if success:
            self.subscriptions.difference_update(channels)
            self._logger.info(f"Unsubscribed from channels: {channels}")

        return success

    async def _attempt_reconnection(self):
        """Attempt to reconnect with exponential backoff"""
        if self._reconnect_attempts >= self.config.max_reconnect_attempts:
            self._logger.error("Max reconnection attempts reached")
            self.status = StreamStatus.ERROR
            await self.handler.handle_connection_change(self.status)
            return

        self.status = StreamStatus.RECONNECTING
        await self.handler.handle_connection_change(self.status)

        # Calculate backoff delay
        delay = self.config.reconnect_delay
        if self.config.exponential_backoff:
            delay *= 2**self._reconnect_attempts
            delay = min(delay, self.config.max_backoff_delay)

        self._logger.info(
            f"Attempting reconnection in {delay} seconds (attempt {self._reconnect_attempts + 1})"
        )
        await asyncio.sleep(delay)

        self._reconnect_attempts += 1
        self.metrics.reconnection_count += 1

        # Attempt reconnection
        if await self.connect():
            # Resubscribe to previous channels
            if self.subscriptions:
                await self.subscribe(list(self.subscriptions))

    def get_metrics(self) -> StreamMetrics:
        """Get current stream metrics"""
        current_time = time.time()
        self.metrics.uptime = current_time - self.metrics.start_time
        return self.metrics


class WebSocketStreamManager:
    """Manager for multiple WebSocket streams"""

    def __init__(self):
        self.streams: Dict[str, WebSocketStream] = {}
        self.handlers: Dict[str, StreamHandler] = {}
        self._logger = logging.getLogger(f"{__name__}.{self.__class__.__name__}")

    def create_stream(
        self, stream_id: str, config: StreamConfig, handler: StreamHandler
    ) -> WebSocketStream:
        """Create a new WebSocket stream"""
        if stream_id in self.streams:
            raise ValueError(f"Stream {stream_id} already exists")

        stream = WebSocketStream(config, handler)
        self.streams[stream_id] = stream
        self.handlers[stream_id] = handler

        self._logger.info(f"Created stream: {stream_id}")
        return stream

    async def connect_stream(self, stream_id: str) -> bool:
        """Connect a specific stream"""
        if stream_id not in self.streams:
            raise ValueError(f"Stream {stream_id} not found")

        return await self.streams[stream_id].connect()

    async def disconnect_stream(self, stream_id: str):
        """Disconnect a specific stream"""
        if stream_id in self.streams:
            await self.streams[stream_id].disconnect()

    async def connect_all_streams(self) -> Dict[str, bool]:
        """Connect all streams"""
        results = {}
        for stream_id in self.streams:
            results[stream_id] = await self.connect_stream(stream_id)
        return results

    async def disconnect_all_streams(self):
        """Disconnect all streams"""
        for stream_id in list(self.streams.keys()):
            await self.disconnect_stream(stream_id)

    def remove_stream(self, stream_id: str):
        """Remove a stream"""
        if stream_id in self.streams:
            # Ensure stream is disconnected first
            stream = self.streams[stream_id]
            if stream.status != StreamStatus.DISCONNECTED:
                self._logger.warning(f"Removing connected stream: {stream_id}")

            del self.streams[stream_id]
            del self.handlers[stream_id]
            self._logger.info(f"Removed stream: {stream_id}")

    def get_stream(self, stream_id: str) -> Optional[WebSocketStream]:
        """Get a specific stream"""
        return self.streams.get(stream_id)

    def get_stream_status(self, stream_id: str) -> Optional[StreamStatus]:
        """Get stream status"""
        stream = self.streams.get(stream_id)
        return stream.status if stream else None

    def get_all_stream_metrics(self) -> Dict[str, StreamMetrics]:
        """Get metrics for all streams"""
        return {
            stream_id: stream.get_metrics()
            for stream_id, stream in self.streams.items()
        }

    def get_connected_streams(self) -> List[str]:
        """Get list of connected stream IDs"""
        return [
            stream_id
            for stream_id, stream in self.streams.items()
            if stream.status == StreamStatus.CONNECTED
        ]

    async def subscribe_to_channel(
        self, stream_id: str, channels: Union[str, List[str]]
    ) -> bool:
        """Subscribe to channels on a specific stream"""
        if stream_id not in self.streams:
            return False

        return await self.streams[stream_id].subscribe(channels)

    async def unsubscribe_from_channel(
        self, stream_id: str, channels: Union[str, List[str]]
    ) -> bool:
        """Unsubscribe from channels on a specific stream"""
        if stream_id not in self.streams:
            return False

        return await self.streams[stream_id].unsubscribe(channels)


# Example stream handler implementations
class MarketDataStreamHandler(StreamHandler):
    """Example handler for market data streams"""

    def __init__(self, callback: Optional[Callable[[StreamMessage], None]] = None):
        self.callback = callback
        self._logger = logging.getLogger(f"{__name__}.{self.__class__.__name__}")

    async def handle_message(self, message: StreamMessage) -> None:
        """Handle market data message"""
        self._logger.debug(
            f"Received {message.stream_type.value} message: {message.symbol}"
        )

        if self.callback:
            try:
                if asyncio.iscoroutinefunction(self.callback):
                    await self.callback(message)
                else:
                    self.callback(message)
            except Exception as e:
                self._logger.error(f"Error in message callback: {e}")

    async def handle_error(self, error: Exception) -> None:
        """Handle stream error"""
        self._logger.error(f"Stream error: {error}")

    async def handle_connection_change(self, status: StreamStatus) -> None:
        """Handle connection status change"""
        self._logger.info(f"Stream status changed to: {status.value}")


class OrderUpdateStreamHandler(StreamHandler):
    """Example handler for order update streams"""

    def __init__(
        self, order_callback: Optional[Callable[[StreamMessage], None]] = None
    ):
        self.order_callback = order_callback
        self._logger = logging.getLogger(f"{__name__}.{self.__class__.__name__}")

    async def handle_message(self, message: StreamMessage) -> None:
        """Handle order update message"""
        if message.stream_type == StreamType.ORDER_UPDATES:
            self._logger.info(f"Order update received: {message.data}")

            if self.order_callback:
                try:
                    if asyncio.iscoroutinefunction(self.order_callback):
                        await self.order_callback(message)
                    else:
                        self.order_callback(message)
                except Exception as e:
                    self._logger.error(f"Error in order callback: {e}")

    async def handle_error(self, error: Exception) -> None:
        """Handle stream error"""
        self._logger.error(f"Order stream error: {error}")

    async def handle_connection_change(self, status: StreamStatus) -> None:
        """Handle connection status change"""
        self._logger.info(f"Order stream status: {status.value}")
