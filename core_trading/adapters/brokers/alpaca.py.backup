"""
Alpaca Broker Adapter

This module provides a comprehensive adapter for Alpaca Markets integration,
supporting commission-free stock and ETF trading. The adapter implements the
BaseBrokerAdapter interface and provides functionality for order management,
position tracking, and account monitoring.

Features:
- Paper and live trading mode support
- Commission-free stock and ETF trading
- Real-time order execution and status updates
- Position and portfolio management
- Market data integration
- Fractional share trading support
- Crypto trading support (where available)
- Event-driven architecture with Kafka integration
- Advanced order types (market, limit, stop, bracket)
"""

import asyncio
import logging
import threading
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass, field
from datetime import datetime, timezone
from decimal import Decimal
from enum import Enum
from typing import Any, Callable, Dict, List, Optional

from ..base import (
    AdapterConfig,
    AdapterType,
    BaseBrokerAdapter,
    ConnectionStatus,
    HealthCheck,
)
from .error_handling import (
    BrokerError,
    BrokerErrorHandler,
    BrokerLogger,
    ErrorCategory,
    ErrorSeverity,
    RetryConfig,
    with_error_handling,
)
from .security import (
    AuthenticationType,
    CredentialManager,
    Credentials,
    SecurityAuditLogger,
    SecurityConfig,
    SecurityLevel,
    SecurityValidator,
    create_security_headers,
)

# Alpaca API imports (would be installed via pip install alpaca-trade-api)
try:
    import alpaca_trade_api as tradeapi
    from alpaca_trade_api.entity import Account, Order, Position
    from alpaca_trade_api.rest import APIError, TimeFrame

    ALPACA_AVAILABLE = True
except ImportError:
    ALPACA_AVAILABLE = False
    logging.warning(
        "Alpaca Trade API not available. Install with: pip install alpaca-trade-api"
    )


class AlpacaOrderType(Enum):
    """Alpaca order types"""

    MARKET = "market"
    LIMIT = "limit"
    STOP = "stop"
    STOP_LIMIT = "stop_limit"
    TRAILING_STOP = "trailing_stop"


class AlpacaOrderStatus(Enum):
    """Alpaca order status"""

    NEW = "new"
    PARTIALLY_FILLED = "partially_filled"
    FILLED = "filled"
    DONE_FOR_DAY = "done_for_day"
    CANCELED = "canceled"
    EXPIRED = "expired"
    REPLACED = "replaced"
    PENDING_CANCEL = "pending_cancel"
    PENDING_REPLACE = "pending_replace"
    ACCEPTED = "accepted"
    PENDING_NEW = "pending_new"
    ACCEPTED_FOR_BIDDING = "accepted_for_bidding"
    STOPPED = "stopped"
    REJECTED = "rejected"
    SUSPENDED = "suspended"
    CALCULATED = "calculated"


class AlpacaTimeInForce(Enum):
    """Alpaca time in force options"""

    DAY = "day"
    GTC = "gtc"  # Good Till Canceled
    OPG = "opg"  # Market On Open
    CLS = "cls"  # Market On Close
    IOC = "ioc"  # Immediate Or Cancel
    FOK = "fok"  # Fill Or Kill


@dataclass
class AlpacaConfig(AdapterConfig):
    """Alpaca specific configuration"""

    # Trading parameters
    default_currency: str = "USD"
    enable_fractional_shares: bool = True
    enable_crypto_trading: bool = False
    default_time_in_force: str = "day"

    # Risk management
    max_order_size: Optional[Decimal] = None
    max_daily_loss: Optional[Decimal] = None
    position_size_limit: Optional[Decimal] = None

    # Security configuration
    security_config: SecurityConfig = field(
        default_factory=lambda: SecurityConfig(
            security_level=SecurityLevel.STANDARD,
            encryption_enabled=True,
            audit_enabled=True,
        )
    )

    # Required parameters (must come after all default parameters)
    api_key: str = ""
    secret_key: str = ""
    base_url: str = "https://paper-api.alpaca.markets"  # Paper trading URL
    is_paper_trading: bool = True
    timeout: int = 30
    max_requests_per_second: int = 200
    enable_logging: bool = True
    log_level: str = "INFO"

    def __post_init__(self):
        """Post-initialization validation"""
        if not self.api_key:
            raise ValueError("API key is required")
        if not self.secret_key:
            raise ValueError("Secret key is required")

        # Set live trading URL if not paper trading
        if not self.is_paper_trading and self.base_url == "https://paper-api.alpaca.markets":
            self.base_url = "https://api.alpaca.markets"

    # Error handling configuration
    retry_config: RetryConfig = field(
        default_factory=lambda: RetryConfig(
            max_retries=3,
            base_delay=1.0,
            max_delay=30.0,
            exponential_base=2.0,
            jitter=True,
        )
    )

    def __post_init__(self):
        """Set live trading URL if not paper trading"""
        if not self.is_paper_trading:
            self.base_url = "https://api.alpaca.markets"


@dataclass
class AlpacaPosition:
    """Alpaca position data"""

    symbol: str
    quantity: Decimal
    market_value: Decimal
    cost_basis: Decimal
    unrealized_pl: Decimal
    unrealized_plpc: Decimal
    current_price: Decimal
    lastday_price: Decimal
    change_today: Decimal
    side: str  # "long" or "short"
    timestamp: datetime = field(default_factory=lambda: datetime.now(timezone.utc))


@dataclass
class AlpacaOrder:
    """Alpaca order data"""

    order_id: str
    client_order_id: str
    symbol: str
    asset_class: str
    quantity: Decimal
    notional: Optional[Decimal]  # For fractional shares
    order_type: AlpacaOrderType
    side: str  # "buy" or "sell"
    time_in_force: AlpacaTimeInForce
    limit_price: Optional[Decimal]
    stop_price: Optional[Decimal]
    trail_price: Optional[Decimal]
    trail_percent: Optional[Decimal]
    status: AlpacaOrderStatus
    filled_qty: Decimal = Decimal("0")
    filled_avg_price: Optional[Decimal] = None
    created_at: Optional[datetime] = None
    updated_at: Optional[datetime] = None
    submitted_at: Optional[datetime] = None
    filled_at: Optional[datetime] = None
    expired_at: Optional[datetime] = None
    canceled_at: Optional[datetime] = None
    failed_at: Optional[datetime] = None
    replaced_at: Optional[datetime] = None
    timestamp: datetime = field(default_factory=lambda: datetime.now(timezone.utc))


class AlpacaAdapter(BaseBrokerAdapter):
    """
    Alpaca Markets adapter implementation

    Provides comprehensive integration with Alpaca Markets API for commission-free
    stock and ETF trading. Supports both paper and live trading with real-time
    updates and advanced order management.
    """

    def __init__(self, config: AlpacaConfig):
        super().__init__(config)

        if not ALPACA_AVAILABLE:
            raise ImportError(
                "Alpaca Trade API not available. Install with: pip install alpaca-trade-api"
            )

        self.config = config

        # Initialize error handling and security
        self.error_handler = BrokerErrorHandler("alpaca", config.retry_config)
        self.credential_manager = CredentialManager(config.security_config)
        self.security_validator = SecurityValidator()
        self.audit_logger = SecurityAuditLogger("alpaca")
        self.broker_logger = BrokerLogger("alpaca")

        # Store credentials securely
        credentials = Credentials(
            credential_type=AuthenticationType.API_KEY,
            data={"api_key": config.api_key, "secret_key": config.secret_key},
        )
        self.credential_manager.store_credentials("alpaca", credentials)

        self.logger = self.broker_logger.get_logger()

        # Alpaca API client
        self.api: Optional[tradeapi.REST] = None

        # Connection management
        self._connection_status = ConnectionStatus.DISCONNECTED
        self._account_info: Optional[Dict[str, Any]] = None

        # Data storage
        self._positions: Dict[str, AlpacaPosition] = {}
        self._orders: Dict[str, AlpacaOrder] = {}

        # Threading and async
        self._executor = ThreadPoolExecutor(max_workers=4)
        self._lock = threading.RLock()

        # Event callbacks
        self._event_callbacks: Dict[str, List[Callable]] = {
            "order_status": [],
            "position_update": [],
            "execution": [],
            "error": [],
            "connection": [],
        }

        # Streaming connection (for real-time updates)
        self._stream_conn: Optional[Any] = None
        self._streaming_active = False

    @with_error_handling
    async def connect(self) -> bool:
        """Connect to Alpaca API"""
        try:
            # Validate configuration
            if not self.security_validator.validate_url(
                self.config.base_url, require_https=True
            ):
                raise BrokerError(
                    "INVALID_BASE_URL",
                    f"Invalid base URL: {self.config.base_url}",
                    ErrorSeverity.HIGH,
                    ErrorCategory.CONFIGURATION,
                )

            # Retrieve credentials
            credentials = self.credential_manager.get_credentials("alpaca")
            if not credentials:
                raise BrokerError(
                    "MISSING_CREDENTIALS",
                    "Failed to retrieve Alpaca credentials",
                    ErrorSeverity.HIGH,
                    ErrorCategory.AUTHENTICATION,
                )

            # Validate API key
            api_key = credentials.data.get("api_key")
            if not self.security_validator.validate_api_key(api_key, min_length=20):
                raise BrokerError(
                    "INVALID_API_KEY",
                    "Invalid or weak API key",
                    ErrorSeverity.HIGH,
                    ErrorCategory.AUTHENTICATION,
                )

            self.logger.info(
                f"Connecting to Alpaca API (Paper: {self.config.is_paper_trading})"
            )
            self.audit_logger.log_security_event(
                "CONNECTION_ATTEMPT",
                "INFO",
                {
                    "base_url": self.config.base_url,
                    "trading_mode": "paper" if self.config.is_paper_trading else "live",
                },
            )

            # Initialize API client
            self.api = tradeapi.REST(
                key_id=credentials.data["api_key"],
                secret_key=credentials.data["secret_key"],
                base_url=self.config.base_url,
                api_version="v2",
            )

            # Test connection by getting account info
            account = await self._get_account_async()
            if account:
                self._account_info = account
                self._connection_status = ConnectionStatus.CONNECTED

                # Initialize positions and orders
                await self._initialize_data()

                # Start streaming if configured
                if (
                    hasattr(self.config, "enable_streaming")
                    and self.config.enable_streaming
                ):
                    await self._start_streaming()

                self.logger.info("Successfully connected to Alpaca API")
                self.audit_logger.log_authentication_attempt(
                    True, {"account_id": account.get("account_id")}
                )
                return True
            else:
                error_msg = "Failed to retrieve account information"
                self.audit_logger.log_authentication_attempt(
                    False, {"reason": "no_account_info"}
                )
                raise BrokerError(
                    "CONNECTION_FAILED",
                    error_msg,
                    ErrorSeverity.HIGH,
                    ErrorCategory.CONNECTION,
                )

        except APIError as e:
            self.error_handler.handle_error(
                e, {"method": "connect", "api_error": str(e)}
            )
            self._connection_status = ConnectionStatus.ERROR
            return False
        except Exception as e:
            self.error_handler.handle_error(
                e, {"method": "connect", "config": str(self.config)}
            )
            self._connection_status = ConnectionStatus.ERROR
            return False

    async def disconnect(self) -> bool:
        """Disconnect from Alpaca API"""
        try:
            self.logger.info("Disconnecting from Alpaca API")

            # Stop streaming
            if self._streaming_active:
                await self._stop_streaming()

            self._connection_status = ConnectionStatus.DISCONNECTED
            self.api = None

            self.logger.info("Disconnected from Alpaca API")
            return True

        except Exception as e:
            self.logger.error(f"Disconnection error: {e}")
            return False

    async def _get_account_async(self) -> Optional[Dict[str, Any]]:
        """Get account information asynchronously"""
        try:
            loop = asyncio.get_event_loop()
            account = await loop.run_in_executor(self._executor, self.api.get_account)

            return {
                "account_id": account.id,
                "status": account.status,
                "currency": account.currency,
                "buying_power": float(account.buying_power),
                "cash": float(account.cash),
                "portfolio_value": float(account.portfolio_value),
                "equity": float(account.equity),
                "last_equity": float(account.last_equity),
                "multiplier": int(account.multiplier),
                "day_trade_count": int(account.day_trade_count),
                "daytrade_buying_power": float(account.daytrade_buying_power),
                "regt_buying_power": float(account.regt_buying_power),
                "shorting_enabled": account.shorting_enabled,
                "long_market_value": float(account.long_market_value),
                "short_market_value": float(account.short_market_value),
                "pattern_day_trader": account.pattern_day_trader,
                "trading_blocked": account.trading_blocked,
                "transfers_blocked": account.transfers_blocked,
                "account_blocked": account.account_blocked,
                "created_at": account.created_at.isoformat()
                if account.created_at
                else None,
            }

        except Exception as e:
            self.logger.error(f"Get account error: {e}")
            return None

    async def _initialize_data(self):
        """Initialize positions and orders data"""
        try:
            # Load positions
            await self._load_positions()

            # Load open orders
            await self._load_orders()

        except Exception as e:
            self.logger.error(f"Data initialization error: {e}")

    async def _load_positions(self):
        """Load current positions"""
        try:
            loop = asyncio.get_event_loop()
            positions = await loop.run_in_executor(
                self._executor, self.api.list_positions
            )

            with self._lock:
                self._positions.clear()
                for pos in positions:
                    alpaca_pos = AlpacaPosition(
                        symbol=pos.symbol,
                        quantity=Decimal(str(pos.qty)),
                        market_value=Decimal(str(pos.market_value)),
                        cost_basis=Decimal(str(pos.cost_basis)),
                        unrealized_pl=Decimal(str(pos.unrealized_pl)),
                        unrealized_plpc=Decimal(str(pos.unrealized_plpc)),
                        current_price=Decimal(str(pos.current_price)),
                        lastday_price=Decimal(str(pos.lastday_price)),
                        change_today=Decimal(str(pos.change_today)),
                        side=pos.side,
                    )
                    self._positions[pos.symbol] = alpaca_pos

            self.logger.info(f"Loaded {len(positions)} positions")

        except Exception as e:
            self.logger.error(f"Load positions error: {e}")

    async def _load_orders(self):
        """Load open orders"""
        try:
            loop = asyncio.get_event_loop()
            orders = await loop.run_in_executor(
                self._executor, lambda: self.api.list_orders(status="open")
            )

            with self._lock:
                for order in orders:
                    alpaca_order = self._convert_order(order)
                    self._orders[order.id] = alpaca_order

            self.logger.info(f"Loaded {len(orders)} open orders")

        except Exception as e:
            self.logger.error(f"Load orders error: {e}")

    async def place_order(
        self,
        symbol: str,
        quantity: Decimal,
        order_type: str,
        price: Optional[Decimal] = None,
        **kwargs,
    ) -> Optional[str]:
        """Place an order"""
        try:
            if not self.is_connected():
                raise RuntimeError("Not connected to broker")

            # Determine side
            side = "buy" if quantity > 0 else "sell"
            qty = abs(quantity)

            # Prepare order parameters
            order_params = {
                "symbol": symbol,
                "side": side,
                "type": order_type,
                "time_in_force": kwargs.get(
                    "time_in_force", self.config.default_time_in_force
                ),
            }

            # Handle fractional shares
            if self.config.enable_fractional_shares and kwargs.get("notional"):
                order_params["notional"] = float(kwargs["notional"])
            else:
                order_params["qty"] = float(qty)

            # Add price parameters
            if order_type in ["limit", "stop_limit"] and price is not None:
                order_params["limit_price"] = float(price)

            if order_type in ["stop", "stop_limit"] and kwargs.get("stop_price"):
                order_params["stop_price"] = float(kwargs["stop_price"])

            if order_type == "trailing_stop":
                if kwargs.get("trail_price"):
                    order_params["trail_price"] = float(kwargs["trail_price"])
                elif kwargs.get("trail_percent"):
                    order_params["trail_percent"] = float(kwargs["trail_percent"])

            # Add client order ID if provided
            if kwargs.get("client_order_id"):
                order_params["client_order_id"] = kwargs["client_order_id"]

            # Place order
            loop = asyncio.get_event_loop()
            order = await loop.run_in_executor(
                self._executor, lambda: self.api.submit_order(**order_params)
            )

            # Store order
            alpaca_order = self._convert_order(order)
            with self._lock:
                self._orders[order.id] = alpaca_order

            self.logger.info(
                f"Placed order {order.id} for {symbol}: {quantity} @ {order_type}"
            )
            return order.id

        except Exception as e:
            self.logger.error(f"Order placement error: {e}")
            return None

    async def cancel_order(self, order_id: str) -> bool:
        """Cancel an order"""
        try:
            if not self.is_connected():
                raise RuntimeError("Not connected to broker")

            loop = asyncio.get_event_loop()
            await loop.run_in_executor(
                self._executor, lambda: self.api.cancel_order(order_id)
            )

            # Update local order status
            with self._lock:
                if order_id in self._orders:
                    self._orders[order_id].status = AlpacaOrderStatus.PENDING_CANCEL

            self.logger.info(f"Cancelled order {order_id}")
            return True

        except Exception as e:
            self.logger.error(f"Order cancellation error: {e}")
            return False

    async def get_positions(self) -> List[Dict[str, Any]]:
        """Get current positions"""
        try:
            # Refresh positions
            await self._load_positions()

            positions = []
            with self._lock:
                for position in self._positions.values():
                    positions.append(
                        {
                            "symbol": position.symbol,
                            "quantity": float(position.quantity),
                            "market_value": float(position.market_value),
                            "cost_basis": float(position.cost_basis),
                            "unrealized_pnl": float(position.unrealized_pl),
                            "current_price": float(position.current_price),
                            "side": position.side,
                            "timestamp": position.timestamp.isoformat(),
                        }
                    )

            return positions

        except Exception as e:
            self.logger.error(f"Get positions error: {e}")
            return []

    async def get_orders(
        self, status_filter: Optional[str] = None
    ) -> List[Dict[str, Any]]:
        """Get orders with optional status filter"""
        try:
            # Refresh orders if no filter or filter is 'open'
            if not status_filter or status_filter == "open":
                await self._load_orders()

            orders = []
            with self._lock:
                for order in self._orders.values():
                    if status_filter and order.status.value != status_filter:
                        continue

                    orders.append(
                        {
                            "order_id": order.order_id,
                            "client_order_id": order.client_order_id,
                            "symbol": order.symbol,
                            "quantity": float(order.quantity)
                            if order.quantity
                            else None,
                            "notional": float(order.notional)
                            if order.notional
                            else None,
                            "order_type": order.order_type.value,
                            "side": order.side,
                            "status": order.status.value,
                            "filled_qty": float(order.filled_qty),
                            "filled_avg_price": float(order.filled_avg_price)
                            if order.filled_avg_price
                            else None,
                            "limit_price": float(order.limit_price)
                            if order.limit_price
                            else None,
                            "stop_price": float(order.stop_price)
                            if order.stop_price
                            else None,
                            "time_in_force": order.time_in_force.value,
                            "created_at": order.created_at.isoformat()
                            if order.created_at
                            else None,
                            "timestamp": order.timestamp.isoformat(),
                        }
                    )

            return orders

        except Exception as e:
            self.logger.error(f"Get orders error: {e}")
            return []

    async def get_account_info(self) -> Dict[str, Any]:
        """Get account information"""
        try:
            # Refresh account info
            account_info = await self._get_account_async()
            if account_info:
                self._account_info = account_info

            return self._account_info or {}

        except Exception as e:
            self.logger.error(f"Get account info error: {e}")
            return {}

    def is_connected(self) -> bool:
        """Check if connected to broker"""
        return (
            self._connection_status == ConnectionStatus.CONNECTED
            and self.api is not None
        )

    async def get_health_check(self) -> HealthCheck:
        """Get adapter health status"""
        try:
            is_healthy = self.is_connected()

            # Test API connectivity
            if is_healthy:
                try:
                    account = await self._get_account_async()
                    is_healthy = account is not None
                except:
                    is_healthy = False

            metrics = {
                "connection_status": self._connection_status.value,
                "positions_count": len(self._positions),
                "orders_count": len(self._orders),
                "is_paper_trading": self.config.is_paper_trading,
                "streaming_active": self._streaming_active,
            }

            if self._account_info:
                metrics.update(
                    {
                        "account_status": self._account_info.get("status"),
                        "buying_power": self._account_info.get("buying_power"),
                        "portfolio_value": self._account_info.get("portfolio_value"),
                    }
                )

            return HealthCheck(
                adapter_type=AdapterType.BROKER,
                adapter_name="Alpaca",
                is_healthy=is_healthy,
                status_message="Connected and operational"
                if is_healthy
                else "Disconnected or error",
                last_check=datetime.now(timezone.utc),
                metrics=metrics,
            )

        except Exception as e:
            return HealthCheck(
                adapter_type=AdapterType.BROKER,
                adapter_name="Alpaca",
                is_healthy=False,
                status_message=f"Health check error: {e}",
                last_check=datetime.now(timezone.utc),
                metrics={},
            )

    def _convert_order(self, order) -> AlpacaOrder:
        """Convert Alpaca API order to internal format"""
        return AlpacaOrder(
            order_id=order.id,
            client_order_id=order.client_order_id or "",
            symbol=order.symbol,
            asset_class=order.asset_class,
            quantity=Decimal(str(order.qty)) if order.qty else None,
            notional=Decimal(str(order.notional))
            if hasattr(order, "notional") and order.notional
            else None,
            order_type=AlpacaOrderType(order.order_type),
            side=order.side,
            time_in_force=AlpacaTimeInForce(order.time_in_force),
            limit_price=Decimal(str(order.limit_price)) if order.limit_price else None,
            stop_price=Decimal(str(order.stop_price)) if order.stop_price else None,
            trail_price=Decimal(str(order.trail_price))
            if hasattr(order, "trail_price") and order.trail_price
            else None,
            trail_percent=Decimal(str(order.trail_percent))
            if hasattr(order, "trail_percent") and order.trail_percent
            else None,
            status=AlpacaOrderStatus(order.status),
            filled_qty=Decimal(str(order.filled_qty))
            if order.filled_qty
            else Decimal("0"),
            filled_avg_price=Decimal(str(order.filled_avg_price))
            if order.filled_avg_price
            else None,
            created_at=order.created_at,
            updated_at=order.updated_at,
            submitted_at=order.submitted_at,
            filled_at=order.filled_at,
            expired_at=order.expired_at,
            canceled_at=order.canceled_at,
            failed_at=order.failed_at,
            replaced_at=order.replaced_at,
        )

    async def _start_streaming(self):
        """Start real-time streaming (placeholder for future implementation)"""
        # This would implement Alpaca's streaming API for real-time updates
        # For now, we'll use polling
        self._streaming_active = True
        self.logger.info("Streaming started (polling mode)")

    async def _stop_streaming(self):
        """Stop real-time streaming"""
        self._streaming_active = False
        self.logger.info("Streaming stopped")

    def add_event_callback(self, event_type: str, callback: Callable):
        """Add event callback"""
        if event_type in self._event_callbacks:
            self._event_callbacks[event_type].append(callback)

    def remove_event_callback(self, event_type: str, callback: Callable):
        """Remove event callback"""
        if (
            event_type in self._event_callbacks
            and callback in self._event_callbacks[event_type]
        ):
            self._event_callbacks[event_type].remove(callback)
