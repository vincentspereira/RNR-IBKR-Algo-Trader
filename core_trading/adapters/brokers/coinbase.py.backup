"""Coinbase Broker Adapter

This adapter provides integration with Coinbase Pro (Advanced Trade) API
for cryptocurrency trading. Coinbase is one of the largest and most trusted
cryptocurrency exchanges globally.

Features:
- Cryptocurrency spot trading
- Real-time market data via WebSocket
- Advanced order types (Market, Limit, Stop, Stop-Limit)
- Portfolio management
- Account information and balance tracking
- Historical data access
- Sandbox environment support
- Fee optimization

Supported Assets:
- Bitcoin (BTC), Ethereum (ETH), Litecoin (LTC)
- Major altcoins and stablecoins
- USD, EUR, GBP fiat pairs

API Documentation: https://docs.cloud.coinbase.com/advanced-trade-api/docs/welcome
"""

import asyncio
import base64
import hashlib
import hmac
import json
import logging
import time
from dataclasses import dataclass, field
from datetime import datetime, timedelta
from decimal import Decimal
from enum import Enum
from typing import Any, Dict, List, Optional, Union

try:
    import aiohttp
    import websockets

    WEBSOCKET_AVAILABLE = True
except ImportError:
    WEBSOCKET_AVAILABLE = False
    logging.warning(
        "WebSocket libraries not available. Install with: pip install websockets aiohttp"
    )

from ...events.base import EventType
from ..base import AdapterConfig, BaseBrokerAdapter, ConnectionStatus, HealthCheck


class CoinbaseOrderType(Enum):
    """Coinbase order types"""

    MARKET = "market_market_ioc"
    LIMIT = "limit_limit_gtc"
    STOP = "stop_limit_stop_limit_gtc"
    STOP_LIMIT = "stop_limit_stop_limit_gtc"


class CoinbaseOrderSide(Enum):
    """Coinbase order sides"""

    BUY = "BUY"
    SELL = "SELL"


class CoinbaseTimeInForce(Enum):
    """Coinbase time in force options"""

    GTC = "GOOD_TILL_CANCELLED"
    GTD = "GOOD_TILL_DATE"
    IOC = "IMMEDIATE_OR_CANCEL"
    FOK = "FILL_OR_KILL"


class CoinbaseEnvironment(Enum):
    """Coinbase environments"""

    SANDBOX = "sandbox"
    PRODUCTION = "production"


@dataclass
class CoinbaseConfig(AdapterConfig):
    """Coinbase adapter configuration"""

    api_key: str = ""
    api_secret: str = ""
    passphrase: str = ""
    environment: str = "sandbox"  # 'sandbox' or 'production'

    # Connection settings
    base_url: str = field(default="")
    websocket_url: str = field(default="")
    timeout: int = 30
    max_retries: int = 3
    retry_delay: float = 1.0

    # Rate limiting
    rate_limit_requests: int = 10
    rate_limit_window: int = 1

    # Trading parameters
    default_size: Decimal = Decimal("0.01")
    max_position_size: Decimal = Decimal("10.0")
    min_order_size: Decimal = Decimal("0.001")

    def __post_init__(self):
        super().__post_init__()
        if not self.api_key:
            raise ValueError("Coinbase API key is required")
        if not self.api_secret:
            raise ValueError("Coinbase API secret is required")
        if not self.passphrase:
            raise ValueError("Coinbase passphrase is required")

        # Set URLs based on environment
        if self.environment == "sandbox":
            self.base_url = "https://api-public.sandbox.exchange.coinbase.com"
            self.websocket_url = "wss://ws-feed-public.sandbox.exchange.coinbase.com"
        else:
            self.base_url = "https://api.exchange.coinbase.com"
            self.websocket_url = "wss://ws-feed.exchange.coinbase.com"


class CoinbaseAdapter(BaseBrokerAdapter):
    """Coinbase broker adapter implementation"""

    def __init__(self, config: CoinbaseConfig, adapter_id: Optional[str] = None):
        super().__init__(config, adapter_id)
        self.config = config
        self.logger = logging.getLogger(f"{self.__class__.__name__}[{self.adapter_id}]")

        if not WEBSOCKET_AVAILABLE:
            raise ImportError(
                "WebSocket libraries not available. Install with: pip install websockets aiohttp"
            )

        # HTTP session
        self.session: Optional[aiohttp.ClientSession] = None

        # WebSocket connection
        self.websocket: Optional[websockets.WebSocketServerProtocol] = None
        self.websocket_task: Optional[asyncio.Task] = None

        # Connection state
        self._connected = False
        self._last_heartbeat = None

        # Rate limiting
        self._request_times: List[datetime] = []

        # Cache
        self._products_cache: Dict[str, Any] = {}
        self._accounts_cache: Dict[str, Any] = {}

        self.logger.info(
            f"Initialized Coinbase adapter for {config.environment} environment"
        )

    async def connect(self) -> bool:
        """Connect to Coinbase API"""
        try:
            self.logger.info("Connecting to Coinbase API...")

            # Create HTTP session
            self.session = aiohttp.ClientSession(
                timeout=aiohttp.ClientTimeout(total=self.config.timeout)
            )

            # Test connection by getting accounts
            accounts = await self._get_accounts()

            if accounts:
                self._connected = True
                self._last_heartbeat = datetime.now()
                self._accounts_cache = {acc["currency"]: acc for acc in accounts}

                # Start WebSocket connection
                await self._start_websocket()

                self.logger.info(
                    f"Connected to Coinbase {self.config.environment} environment"
                )
                await self._emit_event(
                    EventType.BROKER_CONNECTED,
                    {
                        "broker_type": "coinbase",
                        "environment": self.config.environment,
                        "accounts_count": len(accounts),
                    },
                )

                return True

        except Exception as e:
            self.logger.error(f"Failed to connect to Coinbase: {e}")
            self._connected = False
            await self._emit_event(
                EventType.BROKER_ERROR,
                {"broker_type": "coinbase", "error": str(e), "operation": "connect"},
            )

        return False

    async def disconnect(self) -> bool:
        """Disconnect from Coinbase API"""
        try:
            self.logger.info("Disconnecting from Coinbase API...")

            # Stop WebSocket
            await self._stop_websocket()

            # Close HTTP session
            if self.session:
                await self.session.close()
                self.session = None

            self._connected = False

            await self._emit_event(
                EventType.BROKER_DISCONNECTED, {"broker_type": "coinbase"}
            )

            self.logger.info("Disconnected from Coinbase API")
            return True

        except Exception as e:
            self.logger.error(f"Error disconnecting from Coinbase: {e}")
            return False

    async def health_check(self) -> HealthCheck:
        """Perform health check"""
        try:
            if not self._connected or not self.session:
                return HealthCheck(
                    status=ConnectionStatus.DISCONNECTED,
                    timestamp=datetime.now(),
                    error_message="Not connected to Coinbase API",
                )

            # Test API connectivity
            start_time = time.time()
            response = await self._make_request("GET", "/time")
            latency = (time.time() - start_time) * 1000

            if response:
                self._last_heartbeat = datetime.now()
                return HealthCheck(
                    status=ConnectionStatus.CONNECTED,
                    timestamp=datetime.now(),
                    latency_ms=latency,
                    additional_info={
                        "environment": self.config.environment,
                        "server_time": response.get("iso"),
                        "websocket_connected": self.websocket is not None,
                    },
                )
            else:
                return HealthCheck(
                    status=ConnectionStatus.ERROR,
                    timestamp=datetime.now(),
                    error_message="Failed to get server time",
                )

        except Exception as e:
            self.logger.error(f"Health check failed: {e}")
            return HealthCheck(
                status=ConnectionStatus.ERROR,
                timestamp=datetime.now(),
                error_message=str(e),
            )

    async def place_order(self, order_data: Dict[str, Any]) -> Dict[str, Any]:
        """Place an order"""
        try:
            if not self._connected or not self.session:
                return {"success": False, "error": "Not connected to Coinbase"}

            # Validate order data
            required_fields = ["symbol", "quantity", "side"]
            for field in required_fields:
                if field not in order_data:
                    return {
                        "success": False,
                        "error": f"Missing required field: {field}",
                    }

            # Convert to Coinbase format
            product_id = order_data["symbol"]
            size = str(order_data["quantity"])
            side = order_data["side"].upper()
            order_type = order_data.get("order_type", "MARKET").upper()

            # Build order request
            order_request = {"product_id": product_id, "side": side, "size": size}

            # Set order type and additional parameters
            if order_type == "MARKET":
                order_request["type"] = "market"
            elif order_type == "LIMIT":
                order_request["type"] = "limit"
                if "price" not in order_data:
                    return {
                        "success": False,
                        "error": "Price required for limit orders",
                    }
                order_request["price"] = str(order_data["price"])
            elif order_type == "STOP":
                order_request["type"] = "stop"
                if "stop_price" not in order_data:
                    return {
                        "success": False,
                        "error": "Stop price required for stop orders",
                    }
                order_request["stop_price"] = str(order_data["stop_price"])

            # Add time in force
            if "time_in_force" in order_data:
                order_request["time_in_force"] = order_data["time_in_force"]

            # Place order
            response = await self._make_request("POST", "/orders", data=order_request)

            if response and "id" in response:
                order_id = response["id"]

                result = {
                    "success": True,
                    "order_id": order_id,
                    "status": response.get("status", "pending"),
                    "symbol": product_id,
                    "quantity": float(size),
                    "side": side,
                    "order_type": order_type,
                    "timestamp": datetime.now().isoformat(),
                }

                # Add price if available
                if "price" in response:
                    result["price"] = float(response["price"])

                self.logger.info(f"Order placed successfully: {order_id}")

                await self._emit_event(
                    EventType.ORDER_PLACED,
                    {
                        "order_id": order_id,
                        "symbol": product_id,
                        "quantity": float(size),
                        "side": side,
                        "broker_type": "coinbase",
                    },
                )

                return result
            else:
                error_msg = response.get("message", "Failed to place order")
                self.logger.error(error_msg)
                return {"success": False, "error": error_msg}

        except Exception as e:
            error_msg = f"Error placing order: {e}"
            self.logger.error(error_msg)
            return {"success": False, "error": error_msg}

    async def cancel_order(self, order_id: str) -> bool:
        """Cancel an order"""
        try:
            if not self._connected or not self.session:
                self.logger.error("Not connected to Coinbase")
                return False

            response = await self._make_request("DELETE", f"/orders/{order_id}")

            if response:
                self.logger.info(f"Order cancelled successfully: {order_id}")

                await self._emit_event(
                    EventType.ORDER_CANCELLED,
                    {"order_id": order_id, "broker_type": "coinbase"},
                )

                return True
            else:
                self.logger.error(f"Failed to cancel order: {order_id}")
                return False

        except Exception as e:
            self.logger.error(f"Error cancelling order {order_id}: {e}")
            return False

    async def get_order_status(self, order_id: str) -> Dict[str, Any]:
        """Get order status"""
        try:
            if not self._connected or not self.session:
                return {"error": "Not connected to Coinbase"}

            response = await self._make_request("GET", f"/orders/{order_id}")

            if response:
                return {
                    "order_id": response.get("id"),
                    "status": response.get("status", "unknown"),
                    "symbol": response.get("product_id"),
                    "quantity": float(response.get("size", 0)),
                    "side": response.get("side", "").upper(),
                    "order_type": response.get("type", "").upper(),
                    "price": float(response.get("price", 0))
                    if response.get("price")
                    else None,
                    "filled_quantity": float(response.get("filled_size", 0)),
                    "remaining_quantity": float(response.get("size", 0))
                    - float(response.get("filled_size", 0)),
                    "create_time": response.get("created_at"),
                    "update_time": response.get("done_at"),
                }
            else:
                return {"error": f"Order {order_id} not found"}

        except Exception as e:
            self.logger.error(f"Error getting order status {order_id}: {e}")
            return {"error": str(e)}

    async def get_positions(self) -> List[Dict[str, Any]]:
        """Get current positions (account balances for crypto)"""
        try:
            if not self._connected or not self.session:
                return []

            accounts = await self._get_accounts()

            if accounts:
                positions = []

                for account in accounts:
                    balance = float(account.get("balance", 0))
                    available = float(account.get("available", 0))
                    hold = float(account.get("hold", 0))

                    if balance > 0:
                        positions.append(
                            {
                                "symbol": account.get("currency"),
                                "quantity": balance,
                                "side": "LONG",
                                "available": available,
                                "hold": hold,
                                "market_value": balance,  # Would need price data for USD value
                            }
                        )

                return positions
            else:
                return []

        except Exception as e:
            self.logger.error(f"Error getting positions: {e}")
            return []

    async def get_account_info(self) -> Dict[str, Any]:
        """Get account information"""
        try:
            if not self._connected or not self.session:
                return {}

            accounts = await self._get_accounts()

            if accounts:
                total_balance = 0
                currencies = {}

                for account in accounts:
                    currency = account.get("currency")
                    balance = float(account.get("balance", 0))
                    available = float(account.get("available", 0))
                    hold = float(account.get("hold", 0))

                    currencies[currency] = {
                        "balance": balance,
                        "available": available,
                        "hold": hold,
                    }

                    # For USD, add to total balance
                    if currency == "USD":
                        total_balance += balance

                return {
                    "total_balance_usd": total_balance,
                    "currencies": currencies,
                    "account_count": len(accounts),
                }
            else:
                return {}

        except Exception as e:
            self.logger.error(f"Error getting account info: {e}")
            return {}

    async def get_portfolio_value(self) -> Decimal:
        """Get total portfolio value in USD"""
        try:
            account_info = await self.get_account_info()
            return Decimal(str(account_info.get("total_balance_usd", 0)))
        except Exception as e:
            self.logger.error(f"Error getting portfolio value: {e}")
            return Decimal("0")

    async def get_market_data(
        self, symbol: str, timeframe: str = "1m", limit: int = 100
    ) -> List[Dict[str, Any]]:
        """Get market data"""
        try:
            if not self._connected or not self.session:
                return []

            # Convert timeframe to Coinbase format
            granularity_map = {
                "1m": 60,
                "5m": 300,
                "15m": 900,
                "1h": 3600,
                "6h": 21600,
                "1d": 86400,
            }

            granularity = granularity_map.get(timeframe, 60)

            # Calculate start time
            end_time = datetime.now()
            start_time = end_time - timedelta(minutes=limit * (granularity // 60))

            params = {
                "start": start_time.isoformat(),
                "end": end_time.isoformat(),
                "granularity": granularity,
            }

            response = await self._make_request(
                "GET", f"/products/{symbol}/candles", params=params
            )

            if response:
                candles_data = []

                for candle in response:
                    # Coinbase returns [timestamp, low, high, open, close, volume]
                    candles_data.append(
                        {
                            "timestamp": datetime.fromtimestamp(candle[0]).isoformat(),
                            "open": float(candle[3]),
                            "high": float(candle[2]),
                            "low": float(candle[1]),
                            "close": float(candle[4]),
                            "volume": float(candle[5]),
                        }
                    )

                # Sort by timestamp (oldest first)
                candles_data.sort(key=lambda x: x["timestamp"])

                return candles_data[-limit:]  # Return last 'limit' candles
            else:
                return []

        except Exception as e:
            self.logger.error(f"Error getting market data for {symbol}: {e}")
            return []

    async def _get_accounts(self) -> List[Dict[str, Any]]:
        """Get account information"""
        try:
            response = await self._make_request("GET", "/accounts")
            return response if response else []
        except Exception as e:
            self.logger.error(f"Error getting accounts: {e}")
            return []

    async def _make_request(
        self,
        method: str,
        endpoint: str,
        data: Optional[Dict] = None,
        params: Optional[Dict] = None,
    ) -> Optional[Dict]:
        """Make authenticated API request"""
        try:
            if not self.session:
                return None

            # Check rate limit
            if not self._check_rate_limit():
                await asyncio.sleep(1)
                return None

            url = f"{self.config.base_url}{endpoint}"

            # Prepare request
            timestamp = str(time.time())
            body = json.dumps(data) if data else ""

            # Create signature
            message = timestamp + method + endpoint + body
            signature = base64.b64encode(
                hmac.new(
                    base64.b64decode(self.config.api_secret),
                    message.encode(),
                    hashlib.sha256,
                ).digest()
            ).decode()

            headers = {
                "CB-ACCESS-KEY": self.config.api_key,
                "CB-ACCESS-SIGN": signature,
                "CB-ACCESS-TIMESTAMP": timestamp,
                "CB-ACCESS-PASSPHRASE": self.config.passphrase,
                "Content-Type": "application/json",
            }

            # Make request
            async with self.session.request(
                method, url, headers=headers, json=data, params=params
            ) as response:
                if response.status == 200:
                    return await response.json()
                else:
                    error_text = await response.text()
                    self.logger.error(
                        f"API request failed: {response.status} - {error_text}"
                    )
                    return None

        except Exception as e:
            self.logger.error(f"Error making API request: {e}")
            return None

    async def _start_websocket(self) -> None:
        """Start WebSocket connection"""
        try:
            if self.websocket_task and not self.websocket_task.done():
                return

            self.websocket_task = asyncio.create_task(self._websocket_worker())
            self.logger.info("Started WebSocket connection")

        except Exception as e:
            self.logger.error(f"Error starting WebSocket: {e}")

    async def _stop_websocket(self) -> None:
        """Stop WebSocket connection"""
        try:
            if self.websocket:
                await self.websocket.close()
                self.websocket = None

            if self.websocket_task and not self.websocket_task.done():
                self.websocket_task.cancel()
                try:
                    await self.websocket_task
                except asyncio.CancelledError:
                    pass

            self.logger.info("Stopped WebSocket connection")

        except Exception as e:
            self.logger.error(f"Error stopping WebSocket: {e}")

    async def _websocket_worker(self) -> None:
        """WebSocket worker"""
        while self._connected:
            try:
                async with websockets.connect(self.config.websocket_url) as websocket:
                    self.websocket = websocket

                    # Subscribe to channels
                    subscribe_message = {
                        "type": "subscribe",
                        "channels": [
                            {"name": "heartbeat", "product_ids": ["BTC-USD"]},
                            {"name": "ticker", "product_ids": ["BTC-USD", "ETH-USD"]},
                        ],
                    }

                    await websocket.send(json.dumps(subscribe_message))

                    # Listen for messages
                    async for message in websocket:
                        try:
                            data = json.loads(message)
                            await self._handle_websocket_message(data)
                        except json.JSONDecodeError:
                            self.logger.warning(f"Invalid JSON received: {message}")
                        except Exception as e:
                            self.logger.error(f"Error handling WebSocket message: {e}")

            except websockets.exceptions.ConnectionClosed:
                self.logger.warning("WebSocket connection closed, reconnecting...")
                await asyncio.sleep(5)
            except Exception as e:
                self.logger.error(f"WebSocket error: {e}")
                await asyncio.sleep(5)

    async def _handle_websocket_message(self, data: Dict[str, Any]) -> None:
        """Handle WebSocket message"""
        try:
            message_type = data.get("type")

            if message_type == "heartbeat":
                self._last_heartbeat = datetime.now()
            elif message_type == "ticker":
                # Handle ticker data
                await self._emit_event(
                    EventType.MARKET_DATA_RECEIVED,
                    {
                        "symbol": data.get("product_id"),
                        "price": float(data.get("price", 0)),
                        "volume": float(data.get("volume_24h", 0)),
                        "broker_type": "coinbase",
                    },
                )
            elif message_type == "match":
                # Handle trade execution
                await self._emit_event(
                    EventType.TRADE_EXECUTED,
                    {
                        "symbol": data.get("product_id"),
                        "price": float(data.get("price", 0)),
                        "size": float(data.get("size", 0)),
                        "side": data.get("side"),
                        "broker_type": "coinbase",
                    },
                )

        except Exception as e:
            self.logger.error(f"Error handling WebSocket message: {e}")

    def _check_rate_limit(self) -> bool:
        """Check if we're within rate limits"""
        now = datetime.now()

        # Remove old requests outside the window
        cutoff = now - timedelta(seconds=self.config.rate_limit_window)
        self._request_times = [t for t in self._request_times if t > cutoff]

        # Check if we can make another request
        if len(self._request_times) >= self.config.rate_limit_requests:
            return False

        # Add current request
        self._request_times.append(now)
        return True

    def get_supported_order_types(self) -> List[str]:
        """Get supported order types"""
        return ["MARKET", "LIMIT", "STOP"]

    def get_supported_timeframes(self) -> List[str]:
        """Get supported timeframes"""
        return ["1m", "5m", "15m", "1h", "6h", "1d"]

    def get_trading_fees(self) -> Dict[str, Any]:
        """Get trading fees structure"""
        return {
            "type": "percentage",
            "maker_fee": "0.50%",
            "taker_fee": "0.50%",
            "description": "Fees may be lower based on trading volume",
            "volume_tiers": {
                "0-10k": {"maker": "0.50%", "taker": "0.50%"},
                "10k-50k": {"maker": "0.35%", "taker": "0.35%"},
                "50k-100k": {"maker": "0.25%", "taker": "0.25%"},
                "100k+": {"maker": "0.15%", "taker": "0.25%"},
            },
        }
