"""
Polygon.io Data Feed Adapter

This module provides a comprehensive adapter for Polygon.io data integration,
serving as a professional-grade data source for the trading system. The adapter
implements the BaseDataFeedAdapter interface and provides functionality for
real-time and historical market data with institutional-quality features.

Features:
- Professional-grade real-time and historical data
- Multi-asset class support (stocks, options, forex, crypto)
- WebSocket streaming for real-time data
- Advanced data aggregation and normalization
- Comprehensive error handling and reconnection logic
- Rate limiting and subscription management
- Event-driven data distribution
- Support for various timeframes and data types
"""

import asyncio
import json
import logging
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass, field
from datetime import datetime, timedelta, timezone
from decimal import Decimal
from enum import Enum
from typing import Any, Callable, Dict, List, Optional, Union

import aiohttp
import websockets

from ..base import (
    AdapterConfig,
    AdapterType,
    BaseDataFeedAdapter,
    ConnectionStatus,
    HealthCheck,
)

# Polygon imports (would be installed via pip install polygon-api-client)
try:
    from polygon import RESTClient
    from polygon.rest.models import Agg, Quote, Trade

    POLYGON_AVAILABLE = True
except ImportError:
    POLYGON_AVAILABLE = False
    logging.warning(
        "Polygon.io not available. Install with: pip install polygon-api-client"
    )


class PolygonDataType(Enum):
    """Polygon.io data types"""

    AGGREGATES = "aggregates"
    TRADES = "trades"
    QUOTES = "quotes"
    REAL_TIME = "real_time"
    OPTIONS = "options"
    FOREX = "forex"
    CRYPTO = "crypto"


class PolygonTimespan(Enum):
    """Polygon.io timespan values"""

    MINUTE = "minute"
    HOUR = "hour"
    DAY = "day"
    WEEK = "week"
    MONTH = "month"
    QUARTER = "quarter"
    YEAR = "year"


class PolygonMarketType(Enum):
    """Polygon.io market types"""

    STOCKS = "stocks"
    OPTIONS = "options"
    FOREX = "forex"
    CRYPTO = "crypto"


@dataclass
class PolygonConfig(AdapterConfig):
    """Polygon.io specific configuration"""

    base_url: str = "https://api.polygon.io"
    websocket_url: str = "wss://socket.polygon.io"
    timeout: int = 30
    max_requests_per_minute: int = 5  # Free tier limit

    # Subscription settings
    enable_real_time: bool = True
    enable_trades: bool = True
    enable_quotes: bool = True
    enable_aggregates: bool = True

    # Data parameters
    adjusted: bool = True  # Adjust for splits/dividends
    sort: str = "asc"  # Sort order for historical data
    limit: int = 5000  # Max results per request

    # Retry and error handling
    max_retries: int = 3
    retry_delay: float = 1.0
    backoff_multiplier: float = 2.0

    # WebSocket settings
    websocket_reconnect_delay: float = 5.0
    websocket_ping_interval: float = 30.0
    websocket_timeout: float = 60.0

    # Required parameters (must come after all default parameters)
    api_key: str = ""

    def __post_init__(self):
        """Validate configuration after initialization"""
        super().__post_init__() if hasattr(super(), '__post_init__') else None
        
        if not self.api_key:
            raise ValueError("Polygon API key is required")

    # Caching
    enable_caching: bool = True
    cache_duration_minutes: int = 1  # Short cache for real-time data


@dataclass
class PolygonBarData:
    """Polygon.io bar/aggregate data"""

    symbol: str
    timestamp: datetime
    open: Decimal
    high: Decimal
    low: Decimal
    close: Decimal
    volume: int
    vwap: Optional[Decimal] = None
    transactions: Optional[int] = None
    timespan: str = "day"

    def to_dict(self) -> Dict[str, Any]:
        """Convert to dictionary"""
        return {
            "symbol": self.symbol,
            "timestamp": self.timestamp.isoformat(),
            "open": float(self.open),
            "high": float(self.high),
            "low": float(self.low),
            "close": float(self.close),
            "volume": self.volume,
            "vwap": float(self.vwap) if self.vwap else None,
            "transactions": self.transactions,
            "timespan": self.timespan,
        }


@dataclass
class PolygonTradeData:
    """Polygon.io trade data"""

    symbol: str
    timestamp: datetime
    price: Decimal
    size: int
    exchange: Optional[str] = None
    conditions: Optional[List[str]] = None

    def to_dict(self) -> Dict[str, Any]:
        """Convert to dictionary"""
        return {
            "symbol": self.symbol,
            "timestamp": self.timestamp.isoformat(),
            "price": float(self.price),
            "size": self.size,
            "exchange": self.exchange,
            "conditions": self.conditions,
        }


@dataclass
class PolygonQuoteData:
    """Polygon.io quote data"""

    symbol: str
    timestamp: datetime
    bid: Decimal
    ask: Decimal
    bid_size: int
    ask_size: int
    exchange: Optional[str] = None

    def to_dict(self) -> Dict[str, Any]:
        """Convert to dictionary"""
        return {
            "symbol": self.symbol,
            "timestamp": self.timestamp.isoformat(),
            "bid": float(self.bid),
            "ask": float(self.ask),
            "bid_size": self.bid_size,
            "ask_size": self.ask_size,
            "exchange": self.exchange,
        }


class PolygonAdapter(BaseDataFeedAdapter):
    """
    Polygon.io data feed adapter implementation

    Provides comprehensive integration with Polygon.io for professional-grade
    market data. Supports both REST API and WebSocket streaming with advanced
    features for institutional trading requirements.
    """

    def __init__(self, config: PolygonConfig):
        super().__init__(config)

        if not POLYGON_AVAILABLE:
            raise ImportError(
                "Polygon.io not available. Install with: pip install polygon-api-client"
            )

        if not config.api_key:
            raise ValueError("Polygon.io API key is required")

        self.config = config
        self.logger = logging.getLogger(__name__)

        # REST client
        self.rest_client = RESTClient(api_key=config.api_key)

        # Connection management
        self._connection_status = ConnectionStatus.DISCONNECTED
        self._websocket = None
        self._websocket_task = None

        # Rate limiting
        self._last_request_time = 0.0
        self._request_count = 0
        self._rate_limit_window = 60.0  # 1 minute window

        # Threading and async
        self._executor = ThreadPoolExecutor(max_workers=8)
        self._lock = threading.RLock()

        # Subscriptions
        self._subscriptions: Dict[str, List[str]] = {
            "trades": [],
            "quotes": [],
            "aggregates": [],
        }

        # Caching
        self._cache: Dict[str, Dict[str, Any]] = {}
        self._cache_timestamps: Dict[str, datetime] = {}

        # Event callbacks
        self._event_callbacks: Dict[str, List[Callable]] = {
            "data_received": [],
            "trade": [],
            "quote": [],
            "aggregate": [],
            "error": [],
            "connection": [],
        }

        # WebSocket reconnection
        self._reconnect_attempts = 0
        self._max_reconnect_attempts = 10

    async def connect(self) -> bool:
        """Connect to Polygon.io"""
        try:
            self.logger.info("Connecting to Polygon.io data feed")

            # Test REST API connectivity
            loop = asyncio.get_event_loop()

            # Test with a simple request
            test_result = await loop.run_in_executor(
                self._executor,
                lambda: list(self.rest_client.list_tickers(market="stocks", limit=1)),
            )

            if not test_result:
                self.logger.error("Failed to connect to Polygon.io REST API")
                return False

            # Start WebSocket connection if enabled
            if self.config.enable_real_time:
                await self._connect_websocket()

            self._connection_status = ConnectionStatus.CONNECTED
            self.logger.info("Successfully connected to Polygon.io")
            return True

        except Exception as e:
            self.logger.error(f"Connection error: {e}")
            self._connection_status = ConnectionStatus.ERROR
            return False

    async def disconnect(self) -> bool:
        """Disconnect from Polygon.io"""
        try:
            self.logger.info("Disconnecting from Polygon.io")

            # Close WebSocket connection
            if self._websocket_task:
                self._websocket_task.cancel()
                try:
                    await self._websocket_task
                except asyncio.CancelledError:
                    logger.debug("Polygon WebSocket task cancelled during disconnect")

            if self._websocket:
                await self._websocket.close()
                self._websocket = None

            self._connection_status = ConnectionStatus.DISCONNECTED

            # Clear cache and subscriptions
            with self._lock:
                self._cache.clear()
                self._cache_timestamps.clear()
                for sub_type in self._subscriptions:
                    self._subscriptions[sub_type].clear()

            self.logger.info("Disconnected from Polygon.io")
            return True

        except Exception as e:
            self.logger.error(f"Disconnection error: {e}")
            return False

    async def get_historical_data(
        self,
        symbol: str,
        start_date: datetime,
        end_date: datetime,
        timespan: str = "day",
        multiplier: int = 1,
    ) -> List[PolygonBarData]:
        """Get historical aggregate data"""
        try:
            if not self.is_connected():
                raise RuntimeError("Not connected to data feed")

            # Check cache first
            cache_key = f"{symbol}_{start_date.date()}_{end_date.date()}_{timespan}_{multiplier}"
            cached_data = self._get_cached_data(cache_key)
            if cached_data:
                return cached_data

            # Rate limiting
            await self._rate_limit()

            # Get aggregates
            loop = asyncio.get_event_loop()
            aggs = await loop.run_in_executor(
                self._executor,
                lambda: list(
                    self.rest_client.get_aggs(
                        ticker=symbol,
                        multiplier=multiplier,
                        timespan=timespan,
                        from_=start_date.strftime("%Y-%m-%d"),
                        to=end_date.strftime("%Y-%m-%d"),
                        adjusted=self.config.adjusted,
                        sort=self.config.sort,
                        limit=self.config.limit,
                    )
                ),
            )

            if not aggs:
                self.logger.warning(f"No data returned for {symbol}")
                return []

            # Convert to bar data
            bars = []
            for agg in aggs:
                try:
                    bar = PolygonBarData(
                        symbol=symbol,
                        timestamp=datetime.fromtimestamp(
                            agg.timestamp / 1000, tz=timezone.utc
                        ),
                        open=Decimal(str(agg.open)),
                        high=Decimal(str(agg.high)),
                        low=Decimal(str(agg.low)),
                        close=Decimal(str(agg.close)),
                        volume=int(agg.volume),
                        vwap=Decimal(str(agg.vwap))
                        if hasattr(agg, "vwap") and agg.vwap
                        else None,
                        transactions=getattr(agg, "transactions", None),
                        timespan=timespan,
                    )

                    bars.append(bar)

                except (ValueError, TypeError) as e:
                    self.logger.warning(f"Invalid data point for {symbol}: {e}")
                    continue

            # Cache results
            if bars:
                self._cache_data(cache_key, bars)

            self.logger.info(f"Retrieved {len(bars)} bars for {symbol}")
            return bars

        except Exception as e:
            self.logger.error(f"Historical data error for {symbol}: {e}")
            return []

    async def get_trades(
        self, symbol: str, date: datetime, limit: int = 1000
    ) -> List[PolygonTradeData]:
        """Get trade data for a specific date"""
        try:
            if not self.is_connected():
                raise RuntimeError("Not connected to data feed")

            # Rate limiting
            await self._rate_limit()

            # Get trades
            loop = asyncio.get_event_loop()
            trades = await loop.run_in_executor(
                self._executor,
                lambda: list(
                    self.rest_client.list_trades(
                        ticker=symbol, timestamp=date.strftime("%Y-%m-%d"), limit=limit
                    )
                ),
            )

            if not trades:
                return []

            # Convert to trade data
            trade_data = []
            for trade in trades:
                try:
                    trade_obj = PolygonTradeData(
                        symbol=symbol,
                        timestamp=datetime.fromtimestamp(
                            trade.timestamp / 1000000000, tz=timezone.utc
                        ),
                        price=Decimal(str(trade.price)),
                        size=int(trade.size),
                        exchange=getattr(trade, "exchange", None),
                        conditions=getattr(trade, "conditions", None),
                    )

                    trade_data.append(trade_obj)

                except (ValueError, TypeError) as e:
                    self.logger.warning(f"Invalid trade data for {symbol}: {e}")
                    continue

            self.logger.info(f"Retrieved {len(trade_data)} trades for {symbol}")
            return trade_data

        except Exception as e:
            self.logger.error(f"Trades data error for {symbol}: {e}")
            return []

    async def get_quotes(
        self, symbol: str, date: datetime, limit: int = 1000
    ) -> List[PolygonQuoteData]:
        """Get quote data for a specific date"""
        try:
            if not self.is_connected():
                raise RuntimeError("Not connected to data feed")

            # Rate limiting
            await self._rate_limit()

            # Get quotes
            loop = asyncio.get_event_loop()
            quotes = await loop.run_in_executor(
                self._executor,
                lambda: list(
                    self.rest_client.list_quotes(
                        ticker=symbol, timestamp=date.strftime("%Y-%m-%d"), limit=limit
                    )
                ),
            )

            if not quotes:
                return []

            # Convert to quote data
            quote_data = []
            for quote in quotes:
                try:
                    quote_obj = PolygonQuoteData(
                        symbol=symbol,
                        timestamp=datetime.fromtimestamp(
                            quote.timestamp / 1000000000, tz=timezone.utc
                        ),
                        bid=Decimal(str(quote.bid)),
                        ask=Decimal(str(quote.ask)),
                        bid_size=int(quote.bid_size),
                        ask_size=int(quote.ask_size),
                        exchange=getattr(quote, "exchange", None),
                    )

                    quote_data.append(quote_obj)

                except (ValueError, TypeError) as e:
                    self.logger.warning(f"Invalid quote data for {symbol}: {e}")
                    continue

            self.logger.info(f"Retrieved {len(quote_data)} quotes for {symbol}")
            return quote_data

        except Exception as e:
            self.logger.error(f"Quotes data error for {symbol}: {e}")
            return []

    async def subscribe_trades(self, symbols: List[str]):
        """Subscribe to real-time trade data"""
        try:
            if not self._websocket:
                await self._connect_websocket()

            for symbol in symbols:
                if symbol not in self._subscriptions["trades"]:
                    self._subscriptions["trades"].append(symbol)

                    # Send subscription message
                    subscribe_msg = {"action": "subscribe", "params": f"T.{symbol}"}

                    await self._websocket.send(json.dumps(subscribe_msg))
                    self.logger.info(f"Subscribed to trades for {symbol}")

        except Exception as e:
            self.logger.error(f"Trade subscription error: {e}")

    async def subscribe_quotes(self, symbols: List[str]):
        """Subscribe to real-time quote data"""
        try:
            if not self._websocket:
                await self._connect_websocket()

            for symbol in symbols:
                if symbol not in self._subscriptions["quotes"]:
                    self._subscriptions["quotes"].append(symbol)

                    # Send subscription message
                    subscribe_msg = {"action": "subscribe", "params": f"Q.{symbol}"}

                    await self._websocket.send(json.dumps(subscribe_msg))
                    self.logger.info(f"Subscribed to quotes for {symbol}")

        except Exception as e:
            self.logger.error(f"Quote subscription error: {e}")

    async def subscribe_aggregates(self, symbols: List[str]):
        """Subscribe to real-time aggregate data"""
        try:
            if not self._websocket:
                await self._connect_websocket()

            for symbol in symbols:
                if symbol not in self._subscriptions["aggregates"]:
                    self._subscriptions["aggregates"].append(symbol)

                    # Send subscription message
                    subscribe_msg = {"action": "subscribe", "params": f"A.{symbol}"}

                    await self._websocket.send(json.dumps(subscribe_msg))
                    self.logger.info(f"Subscribed to aggregates for {symbol}")

        except Exception as e:
            self.logger.error(f"Aggregate subscription error: {e}")

    def is_connected(self) -> bool:
        """Check if connected to data feed"""
        return self._connection_status == ConnectionStatus.CONNECTED

    async def get_health_check(self) -> HealthCheck:
        """Get adapter health status"""
        try:
            is_healthy = self.is_connected()

            # Test with a simple request
            if is_healthy:
                try:
                    loop = asyncio.get_event_loop()
                    test_result = await loop.run_in_executor(
                        self._executor,
                        lambda: list(
                            self.rest_client.list_tickers(market="stocks", limit=1)
                        ),
                    )
                    is_healthy = bool(test_result)
                except:
                    is_healthy = False

            metrics = {
                "connection_status": self._connection_status.value,
                "websocket_connected": self._websocket is not None,
                "subscriptions": {k: len(v) for k, v in self._subscriptions.items()},
                "cache_size": len(self._cache),
                "request_count": self._request_count,
                "reconnect_attempts": self._reconnect_attempts,
            }

            return HealthCheck(
                adapter_type=AdapterType.DATA_FEED,
                adapter_name="Polygon",
                is_healthy=is_healthy,
                status_message="Connected and operational"
                if is_healthy
                else "Disconnected or error",
                last_check=datetime.now(timezone.utc),
                metrics=metrics,
            )

        except Exception as e:
            return HealthCheck(
                adapter_type=AdapterType.DATA_FEED,
                adapter_name="Polygon",
                is_healthy=False,
                status_message=f"Health check error: {e}",
                last_check=datetime.now(timezone.utc),
                metrics={},
            )

    async def _connect_websocket(self):
        """Connect to Polygon.io WebSocket"""
        try:
            if self._websocket:
                return

            # Construct WebSocket URL with auth
            ws_url = f"{self.config.websocket_url}/stocks?apikey={self.config.api_key}"

            self._websocket = await websockets.connect(
                ws_url,
                ping_interval=self.config.websocket_ping_interval,
                ping_timeout=self.config.websocket_timeout,
            )

            # Start message handler
            self._websocket_task = asyncio.create_task(
                self._handle_websocket_messages()
            )

            self.logger.info("WebSocket connected to Polygon.io")

        except Exception as e:
            self.logger.error(f"WebSocket connection error: {e}")
            self._websocket = None

    async def _handle_websocket_messages(self):
        """Handle incoming WebSocket messages"""
        try:
            async for message in self._websocket:
                try:
                    data = json.loads(message)

                    # Handle different message types
                    if isinstance(data, list):
                        for item in data:
                            await self._process_websocket_message(item)
                    else:
                        await self._process_websocket_message(data)

                except json.JSONDecodeError as e:
                    self.logger.warning(f"Invalid JSON message: {e}")
                except Exception as e:
                    self.logger.error(f"Message processing error: {e}")

        except websockets.exceptions.ConnectionClosed:
            self.logger.warning("WebSocket connection closed")
            await self._reconnect_websocket()
        except Exception as e:
            self.logger.error(f"WebSocket handler error: {e}")
            await self._reconnect_websocket()

    async def _process_websocket_message(self, message: Dict[str, Any]):
        """Process individual WebSocket message"""
        try:
            msg_type = message.get("ev")  # Event type

            if msg_type == "T":  # Trade
                trade = PolygonTradeData(
                    symbol=message.get("sym", ""),
                    timestamp=datetime.fromtimestamp(
                        message.get("t", 0) / 1000, tz=timezone.utc
                    ),
                    price=Decimal(str(message.get("p", 0))),
                    size=int(message.get("s", 0)),
                    exchange=message.get("x"),
                    conditions=message.get("c", []),
                )

                # Trigger callbacks
                for callback in self._event_callbacks["trade"]:
                    try:
                        await callback(trade)
                    except Exception as e:
                        self.logger.warning(f"Trade callback error: {e}")

            elif msg_type == "Q":  # Quote
                quote = PolygonQuoteData(
                    symbol=message.get("sym", ""),
                    timestamp=datetime.fromtimestamp(
                        message.get("t", 0) / 1000, tz=timezone.utc
                    ),
                    bid=Decimal(str(message.get("bp", 0))),
                    ask=Decimal(str(message.get("ap", 0))),
                    bid_size=int(message.get("bs", 0)),
                    ask_size=int(message.get("as", 0)),
                    exchange=message.get("x"),
                )

                # Trigger callbacks
                for callback in self._event_callbacks["quote"]:
                    try:
                        await callback(quote)
                    except Exception as e:
                        self.logger.warning(f"Quote callback error: {e}")

            elif msg_type == "A":  # Aggregate
                aggregate = PolygonBarData(
                    symbol=message.get("sym", ""),
                    timestamp=datetime.fromtimestamp(
                        message.get("s", 0) / 1000, tz=timezone.utc
                    ),
                    open=Decimal(str(message.get("o", 0))),
                    high=Decimal(str(message.get("h", 0))),
                    low=Decimal(str(message.get("l", 0))),
                    close=Decimal(str(message.get("c", 0))),
                    volume=int(message.get("v", 0)),
                    vwap=Decimal(str(message.get("vw", 0)))
                    if message.get("vw")
                    else None,
                    timespan="minute",
                )

                # Trigger callbacks
                for callback in self._event_callbacks["aggregate"]:
                    try:
                        await callback(aggregate)
                    except Exception as e:
                        self.logger.warning(f"Aggregate callback error: {e}")

        except Exception as e:
            self.logger.error(f"Message processing error: {e}")

    async def _reconnect_websocket(self):
        """Reconnect WebSocket with exponential backoff"""
        try:
            if self._reconnect_attempts >= self._max_reconnect_attempts:
                self.logger.error("Max reconnection attempts reached")
                return

            self._reconnect_attempts += 1
            delay = self.config.websocket_reconnect_delay * (
                2 ** (self._reconnect_attempts - 1)
            )

            self.logger.info(
                f"Reconnecting WebSocket in {delay} seconds (attempt {self._reconnect_attempts})"
            )
            await asyncio.sleep(delay)

            # Close existing connection
            if self._websocket:
                await self._websocket.close()
                self._websocket = None

            # Reconnect
            await self._connect_websocket()

            # Resubscribe to all active subscriptions
            await self._resubscribe_all()

            # Reset reconnect counter on success
            self._reconnect_attempts = 0

        except Exception as e:
            self.logger.error(f"Reconnection error: {e}")

    async def _resubscribe_all(self):
        """Resubscribe to all active subscriptions"""
        try:
            # Resubscribe to trades
            if self._subscriptions["trades"]:
                await self.subscribe_trades(self._subscriptions["trades"])

            # Resubscribe to quotes
            if self._subscriptions["quotes"]:
                await self.subscribe_quotes(self._subscriptions["quotes"])

            # Resubscribe to aggregates
            if self._subscriptions["aggregates"]:
                await self.subscribe_aggregates(self._subscriptions["aggregates"])

        except Exception as e:
            self.logger.error(f"Resubscription error: {e}")

    async def _rate_limit(self):
        """Apply rate limiting"""
        try:
            current_time = time.time()

            # Reset counter if window expired
            if current_time - self._last_request_time > self._rate_limit_window:
                self._request_count = 0

            # Check if we need to wait
            if self._request_count >= self.config.max_requests_per_minute:
                wait_time = self._rate_limit_window - (
                    current_time - self._last_request_time
                )
                if wait_time > 0:
                    await asyncio.sleep(wait_time)
                    self._request_count = 0

            # Update counters
            self._request_count += 1
            self._last_request_time = current_time

        except Exception as e:
            self.logger.warning(f"Rate limiting error: {e}")

    def _get_cached_data(self, cache_key: str) -> Optional[List[PolygonBarData]]:
        """Get data from cache if valid"""
        try:
            if not self.config.enable_caching:
                return None

            with self._lock:
                if cache_key in self._cache and cache_key in self._cache_timestamps:
                    cache_time = self._cache_timestamps[cache_key]
                    if datetime.now(timezone.utc) - cache_time < timedelta(
                        minutes=self.config.cache_duration_minutes
                    ):
                        return self._cache[cache_key]

            return None

        except Exception:
            return None

    def _cache_data(self, cache_key: str, data: List[PolygonBarData]):
        """Cache data with timestamp"""
        try:
            if not self.config.enable_caching:
                return

            with self._lock:
                self._cache[cache_key] = data
                self._cache_timestamps[cache_key] = datetime.now(timezone.utc)

                # Cleanup old cache entries (keep last 100)
                if len(self._cache) > 100:
                    oldest_key = min(
                        self._cache_timestamps.keys(),
                        key=lambda k: self._cache_timestamps[k],
                    )
                    del self._cache[oldest_key]
                    del self._cache_timestamps[oldest_key]

        except Exception as e:
            self.logger.warning(f"Cache error: {e}")

    def add_event_callback(self, event_type: str, callback: Callable):
        """Add event callback"""
        if event_type in self._event_callbacks:
            self._event_callbacks[event_type].append(callback)

    def remove_event_callback(self, event_type: str, callback: Callable):
        """Remove event callback"""
        if (
            event_type in self._event_callbacks
            and callback in self._event_callbacks[event_type]
        ):
            self._event_callbacks[event_type].remove(callback)
