"""Oanda Data Feed Adapter

This module provides a comprehensive adapter for Oanda API integration,
serving as a specialized data source for forex, CFDs, and commodities.
Oanda provides real-time and historical data with high-quality execution
and comprehensive market coverage for retail and institutional traders.

Features:
- Comprehensive forex coverage (70+ currency pairs)
- CFDs on indices, commodities, bonds
- Real-time streaming quotes
- Historical data with granular intervals
- Economic calendar integration
- Position and account management
- Advanced order types
- Comprehensive error handling and retry logic
- Rate limiting and request management
- Event-driven data distribution
"""

import asyncio
import json
import logging
import math
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass, field
from datetime import datetime, timedelta, timezone
from decimal import Decimal
from enum import Enum
from typing import Any, Callable, Dict, List, Optional, Union
from urllib.parse import urlencode, urljoin

import aiohttp

from ..base import (
    AdapterConfig,
    AdapterType,
    BaseDataFeedAdapter,
    ConnectionStatus,
    HealthCheck,
)

# Oanda imports (would be installed via pip install oandapyV20)
try:
    import numpy as np
    import pandas as pd
    import requests

    # Note: oandapyV20 would be the official Oanda API client
    # import oandapyV20
    # from oandapyV20 import API
    # from oandapyV20.endpoints import instruments, pricing, accounts
    OANDA_AVAILABLE = True
except ImportError:
    OANDA_AVAILABLE = False
    logging.warning(
        "Oanda dependencies not available. Install with: pip install pandas requests numpy oandapyV20"
    )


class OandaEnvironment(Enum):
    """Oanda trading environments"""

    PRACTICE = "practice"
    LIVE = "live"


class OandaInstrumentType(Enum):
    """Oanda instrument types"""

    CURRENCY = "CURRENCY"
    CFD = "CFD"
    METAL = "METAL"


class OandaGranularity(Enum):
    """Oanda supported granularities"""

    S5 = "S5"  # 5 seconds
    S10 = "S10"  # 10 seconds
    S15 = "S15"  # 15 seconds
    S30 = "S30"  # 30 seconds
    M1 = "M1"  # 1 minute
    M2 = "M2"  # 2 minutes
    M4 = "M4"  # 4 minutes
    M5 = "M5"  # 5 minutes
    M10 = "M10"  # 10 minutes
    M15 = "M15"  # 15 minutes
    M30 = "M30"  # 30 minutes
    H1 = "H1"  # 1 hour
    H2 = "H2"  # 2 hours
    H3 = "H3"  # 3 hours
    H4 = "H4"  # 4 hours
    H6 = "H6"  # 6 hours
    H8 = "H8"  # 8 hours
    H12 = "H12"  # 12 hours
    D = "D"  # Daily
    W = "W"  # Weekly
    M = "M"  # Monthly


class OandaPriceComponent(Enum):
    """Oanda price components"""

    BID = "B"  # Bid prices
    ASK = "A"  # Ask prices
    MID = "M"  # Midpoint prices
    BA = "BA"  # Bid and Ask
    BM = "BM"  # Bid and Mid
    AM = "AM"  # Ask and Mid
    BAM = "BAM"  # Bid, Ask, and Mid


@dataclass
class OandaConfig(AdapterConfig):
    """Oanda specific configuration"""

    api_token: str = ""  # Required Oanda API token
    account_id: str = ""  # Oanda account ID
    environment: str = "practice"  # practice or live
    base_url: str = ""  # Will be set based on environment
    stream_url: str = ""  # Will be set based on environment
    timeout: int = 30
    max_requests_per_second: int = 100  # Oanda allows high rate limits
    retry_attempts: int = 3
    retry_delay: float = 1.0
    cache_duration: int = 60  # 1 minute cache for forex data

    # Data preferences
    default_granularity: str = "M1"  # 1 minute default
    default_price_component: str = "M"  # Midpoint prices
    include_bid_ask: bool = True
    include_volume: bool = True

    # Streaming settings
    enable_streaming: bool = True
    stream_heartbeat: int = 5  # seconds
    stream_reconnect_delay: int = 5  # seconds

    # Popular forex pairs
    major_pairs: List[str] = field(
        default_factory=lambda: [
            "EUR_USD",
            "GBP_USD",
            "USD_JPY",
            "USD_CHF",
            "AUD_USD",
            "USD_CAD",
            "NZD_USD",
        ]
    )

    minor_pairs: List[str] = field(
        default_factory=lambda: [
            "EUR_GBP",
            "EUR_JPY",
            "EUR_CHF",
            "EUR_AUD",
            "EUR_CAD",
            "GBP_JPY",
            "GBP_CHF",
            "AUD_JPY",
        ]
    )

    exotic_pairs: List[str] = field(
        default_factory=lambda: [
            "USD_SGD",
            "USD_HKD",
            "USD_NOK",
            "USD_SEK",
            "USD_TRY",
            "USD_ZAR",
            "USD_MXN",
        ]
    )

    # CFD instruments
    cfd_indices: List[str] = field(
        default_factory=lambda: [
            "SPX500_USD",
            "NAS100_USD",
            "US30_USD",
            "DE30_EUR",
            "UK100_GBP",
            "FR40_EUR",
            "JP225_USD",
            "AUS200_AUD",
        ]
    )

    cfd_commodities: List[str] = field(
        default_factory=lambda: [
            "XAU_USD",
            "XAG_USD",
            "XPT_USD",
            "XPD_USD",
            "BCO_USD",
            "WTICO_USD",
            "NATGAS_USD",
        ]
    )

    # Economic calendar settings
    include_economic_calendar: bool = True
    calendar_importance_filter: List[str] = field(
        default_factory=lambda: ["HIGH", "MEDIUM"]
    )

    def __post_init__(self):
        """Set URLs based on environment"""
        if self.environment == "practice":
            self.base_url = "https://api-fxpractice.oanda.com"
            self.stream_url = "https://stream-fxpractice.oanda.com"
        else:
            self.base_url = "https://api-fxtrade.oanda.com"
            self.stream_url = "https://stream-fxtrade.oanda.com"


class OandaAdapter(BaseDataFeedAdapter):
    """
    Oanda data feed adapter implementation

    Provides comprehensive integration with Oanda API for forex, CFDs,
    and commodities. Supports both REST API and streaming data feeds
    with advanced order management capabilities.
    """

    def __init__(self, config: OandaConfig):
        super().__init__(config)
        self.config = config
        self.session: Optional[aiohttp.ClientSession] = None
        self.stream_session: Optional[aiohttp.ClientSession] = None
        self.rate_limiter = asyncio.Semaphore(config.max_requests_per_second)
        self.cache: Dict[str, Any] = {}
        self.last_request_time = 0.0

        # Request headers
        self.headers = {
            "Authorization": f"Bearer {config.api_token}",
            "Content-Type": "application/json",
            "Accept-Datetime-Format": "RFC3339",
        }

        # Initialize caches
        self.instruments_cache: Dict[str, Dict] = {}
        self.pricing_cache: Dict[str, Dict] = {}
        self.candles_cache: Dict[str, pd.DataFrame] = {}
        self.economic_calendar_cache: Dict[str, List] = {}
        self.cache_expiry: Dict[str, datetime] = {}

        # Streaming components
        self.streaming_active = False
        self.stream_tasks: Dict[str, asyncio.Task] = {}
        self.price_callbacks: List[Callable] = []

        # Instrument mappings
        self.instrument_mappings = self._initialize_instrument_mappings()
        self.instrument_types = self._initialize_instrument_types()

        logger.info(f"Initialized Oanda adapter with config: {config.name}")

    async def connect(self) -> bool:
        """Establish connection to Oanda API"""
        try:
            if not OANDA_AVAILABLE:
                logger.error("Oanda dependencies not available")
                self.status = ConnectionStatus.FAILED
                return False

            if not self.config.api_token:
                logger.error("Oanda API token not provided")
                self.status = ConnectionStatus.FAILED
                return False

            # Create HTTP session
            connector = aiohttp.TCPConnector(
                limit=50, limit_per_host=20, ttl_dns_cache=300, use_dns_cache=True
            )

            timeout = aiohttp.ClientTimeout(total=self.config.timeout)
            self.session = aiohttp.ClientSession(
                connector=connector, timeout=timeout, headers=self.headers
            )

            # Test connection with account info
            account_info = await self._test_connection()

            if account_info:
                self.status = ConnectionStatus.CONNECTED
                logger.info(
                    f"Successfully connected to Oanda API (Account: {self.config.account_id})"
                )

                # Initialize instruments cache
                await self._initialize_instruments_cache()

                # Start streaming if enabled
                if self.config.enable_streaming:
                    await self._start_streaming()

                return True
            else:
                logger.error("Failed to retrieve account information from Oanda")
                self.status = ConnectionStatus.FAILED
                return False

        except Exception as e:
            logger.error(f"Error connecting to Oanda: {e}")
            self.status = ConnectionStatus.FAILED
            return False

    async def disconnect(self) -> bool:
        """Disconnect from Oanda API"""
        try:
            # Stop streaming
            if self.streaming_active:
                await self._stop_streaming()

            # Close HTTP sessions
            if self.session:
                await self.session.close()
                self.session = None

            if self.stream_session:
                await self.stream_session.close()
                self.stream_session = None

            self.status = ConnectionStatus.DISCONNECTED
            logger.info("Disconnected from Oanda API")
            return True

        except Exception as e:
            logger.error(f"Error disconnecting from Oanda: {e}")
            return False

    async def get_historical_data(
        self,
        symbol: str,
        start_date: datetime,
        end_date: datetime,
        interval: str = "1m",
        **kwargs,
    ) -> Optional[pd.DataFrame]:
        """Get historical forex/CFD data from Oanda"""
        try:
            if not self._is_connected():
                await self.connect()

            # Map symbol and interval to Oanda format
            oanda_instrument = self._map_symbol(symbol)
            oanda_granularity = self._map_interval(interval)

            # Prepare API parameters
            params = {
                "from": start_date.strftime("%Y-%m-%dT%H:%M:%S.%fZ"),
                "to": end_date.strftime("%Y-%m-%dT%H:%M:%S.%fZ"),
                "granularity": oanda_granularity,
                "price": kwargs.get(
                    "price_component", self.config.default_price_component
                ),
            }

            # Add optional parameters
            if "count" in kwargs:
                params["count"] = min(kwargs["count"], 5000)  # Oanda limit
            if "includeFirst" in kwargs:
                params["includeFirst"] = str(kwargs["includeFirst"]).lower()

            # Make API request
            url = f"{self.config.base_url}/v3/instruments/{oanda_instrument}/candles"

            async with self.rate_limiter:
                await self._respect_rate_limit()

                async with self.session.get(url, params=params) as response:
                    if response.status == 200:
                        data = await response.json()

                        if data and "candles" in data:
                            # Convert to DataFrame
                            df = self._process_candles_data(
                                data["candles"], symbol, interval
                            )

                            if not df.empty:
                                # Add metadata
                                df.attrs = {
                                    "symbol": symbol,
                                    "source": "oanda",
                                    "data_type": "historical",
                                    "start_date": start_date,
                                    "end_date": end_date,
                                    "interval": interval,
                                    "granularity": oanda_granularity,
                                    "price_component": params["price"],
                                }

                                logger.info(
                                    f"Retrieved {len(df)} historical records for {symbol}"
                                )
                                return df

                        return None

                    elif response.status == 429:
                        logger.warning("Rate limit exceeded, waiting before retry")
                        await asyncio.sleep(self.config.retry_delay * 2)
                        return await self.get_historical_data(
                            symbol, start_date, end_date, interval, **kwargs
                        )

                    else:
                        logger.error(f"HTTP error {response.status} for {symbol}")
                        return None

        except Exception as e:
            logger.error(f"Error getting historical data for {symbol}: {e}")
            return None

    async def get_real_time_quote(self, symbol: str) -> Optional[Dict[str, Any]]:
        """Get real-time forex/CFD quote from Oanda"""
        try:
            if not self._is_connected():
                await self.connect()

            # Check cache first
            cache_key = f"quote_{symbol}"
            if self._is_cached(cache_key):
                return self.cache[cache_key]

            # Map symbol to Oanda format
            oanda_instrument = self._map_symbol(symbol)

            # Prepare API parameters
            params = {
                "instruments": oanda_instrument,
                "includeUnitsAvailable": "true",
                "includeHomeConversions": "true",
            }

            # Make API request
            url = f"{self.config.base_url}/v3/accounts/{self.config.account_id}/pricing"

            async with self.rate_limiter:
                await self._respect_rate_limit()

                async with self.session.get(url, params=params) as response:
                    if response.status == 200:
                        data = await response.json()

                        if data and "prices" in data and data["prices"]:
                            # Process pricing data
                            price_data = data["prices"][0]
                            quote_data = self._process_pricing_data(symbol, price_data)

                            # Cache the result
                            self._cache_data(cache_key, quote_data)

                            logger.debug(
                                f"Retrieved quote for {symbol}: {quote_data.get('bid', 0):.5f}/{quote_data.get('ask', 0):.5f}"
                            )
                            return quote_data

                        return None

                    elif response.status == 429:
                        logger.warning("Rate limit exceeded, waiting before retry")
                        await asyncio.sleep(self.config.retry_delay)
                        return await self.get_real_time_quote(symbol)

                    else:
                        logger.error(f"HTTP error {response.status} for {symbol}")
                        return None

        except Exception as e:
            logger.error(f"Error getting quote for {symbol}: {e}")
            return None

    async def get_instruments(
        self, instrument_type: str = "all"
    ) -> Optional[List[Dict[str, Any]]]:
        """Get available instruments from Oanda"""
        try:
            if not self._is_connected():
                await self.connect()

            # Check cache first
            cache_key = f"instruments_{instrument_type}"
            if self._is_cached(cache_key):
                return self.instruments_cache.get(cache_key, [])

            # Make API request
            url = f"{self.config.base_url}/v3/accounts/{self.config.account_id}/instruments"

            async with self.rate_limiter:
                await self._respect_rate_limit()

                async with self.session.get(url) as response:
                    if response.status == 200:
                        data = await response.json()

                        if data and "instruments" in data:
                            # Process instruments data
                            instruments = self._process_instruments_data(
                                data["instruments"], instrument_type
                            )

                            # Cache the result
                            self.instruments_cache[cache_key] = instruments
                            self._set_cache_expiry(cache_key)

                            logger.info(
                                f"Retrieved {len(instruments)} instruments for type: {instrument_type}"
                            )
                            return instruments

                        return None

                    else:
                        logger.error(f"HTTP error {response.status} for instruments")
                        return None

        except Exception as e:
            logger.error(f"Error getting instruments: {e}")
            return None

    async def get_economic_calendar(self, **kwargs) -> Optional[List[Dict[str, Any]]]:
        """Get economic calendar events from Oanda"""
        try:
            if not self._is_connected():
                await self.connect()

            if not self.config.include_economic_calendar:
                logger.info("Economic calendar disabled in configuration")
                return None

            # Check cache first
            cache_key = "economic_calendar"
            if self._is_cached(cache_key):
                return self.economic_calendar_cache.get(cache_key, [])

            # Prepare API parameters
            params = {
                "period": kwargs.get("period", 86400),  # 24 hours in seconds
                "instrument": kwargs.get("instrument", ""),
            }

            # Make API request
            url = f"{self.config.base_url}/v3/instruments/{params.get('instrument', 'EUR_USD')}/orderBook"

            async with self.rate_limiter:
                await self._respect_rate_limit()

                async with self.session.get(url, params=params) as response:
                    if response.status == 200:
                        data = await response.json()

                        if data:
                            # Process economic calendar data
                            events = self._process_economic_calendar(data)

                            # Cache the result
                            self.economic_calendar_cache[cache_key] = events
                            self._set_cache_expiry(cache_key)

                            logger.info(
                                f"Retrieved {len(events)} economic calendar events"
                            )
                            return events

                        return None

                    else:
                        logger.error(
                            f"HTTP error {response.status} for economic calendar"
                        )
                        return None

        except Exception as e:
            logger.error(f"Error getting economic calendar: {e}")
            return None

    async def get_account_summary(self) -> Optional[Dict[str, Any]]:
        """Get account summary from Oanda"""
        try:
            if not self._is_connected():
                await self.connect()

            # Make API request
            url = f"{self.config.base_url}/v3/accounts/{self.config.account_id}/summary"

            async with self.rate_limiter:
                await self._respect_rate_limit()

                async with self.session.get(url) as response:
                    if response.status == 200:
                        data = await response.json()

                        if data and "account" in data:
                            # Process account summary
                            summary = self._process_account_summary(data["account"])

                            logger.info(
                                f"Retrieved account summary for {self.config.account_id}"
                            )
                            return summary

                        return None

                    else:
                        logger.error(
                            f"HTTP error {response.status} for account summary"
                        )
                        return None

        except Exception as e:
            logger.error(f"Error getting account summary: {e}")
            return None

    async def health_check(self) -> HealthCheck:
        """Perform health check"""
        start_time = time.time()

        try:
            if not self._is_connected():
                return HealthCheck(
                    is_healthy=False,
                    status="disconnected",
                    latency_ms=0,
                    error_message="Not connected to Oanda API",
                )

            # Test with account summary request
            account_summary = await self._test_connection()

            latency = (time.time() - start_time) * 1000

            if account_summary:
                return HealthCheck(
                    is_healthy=True,
                    status="connected",
                    latency_ms=latency,
                    additional_info={
                        "account_id": self.config.account_id,
                        "environment": self.config.environment,
                        "cache_size": len(self.cache),
                        "instruments_cache_size": len(self.instruments_cache),
                        "pricing_cache_size": len(self.pricing_cache),
                        "candles_cache_size": len(self.candles_cache),
                        "streaming_active": self.streaming_active,
                        "stream_tasks_count": len(self.stream_tasks),
                        "enable_streaming": self.config.enable_streaming,
                        "include_economic_calendar": self.config.include_economic_calendar,
                    },
                )
            else:
                return HealthCheck(
                    is_healthy=False,
                    status="error",
                    latency_ms=latency,
                    error_message="Failed to retrieve account summary",
                )

        except Exception as e:
            latency = (time.time() - start_time) * 1000
            return HealthCheck(
                is_healthy=False,
                status="error",
                latency_ms=latency,
                error_message=str(e),
            )

    # Streaming methods

    async def _start_streaming(self):
        """Start streaming price data"""
        try:
            if self.streaming_active:
                logger.warning("Streaming already active")
                return

            # Create streaming session
            connector = aiohttp.TCPConnector(
                limit=10, limit_per_host=5, ttl_dns_cache=300, use_dns_cache=True
            )

            self.stream_session = aiohttp.ClientSession(
                connector=connector, headers=self.headers
            )

            # Start streaming for major pairs
            instruments = ",".join(
                self.config.major_pairs[:10]
            )  # Limit to avoid overwhelming

            # Start pricing stream
            pricing_task = asyncio.create_task(self._stream_pricing(instruments))
            self.stream_tasks["pricing"] = pricing_task

            self.streaming_active = True
            logger.info(f"Started streaming for instruments: {instruments}")

        except Exception as e:
            logger.error(f"Error starting streaming: {e}")

    async def _stop_streaming(self):
        """Stop streaming price data"""
        try:
            self.streaming_active = False

            # Cancel all streaming tasks
            for task_name, task in self.stream_tasks.items():
                if not task.done():
                    task.cancel()
                    try:
                        await task
                    except asyncio.CancelledError:
                        logger.debug(
                            f"Oanda streaming task {task_name} cancelled during stop"
                        )
                logger.info(f"Stopped streaming task: {task_name}")

            self.stream_tasks.clear()

            # Close streaming session
            if self.stream_session:
                await self.stream_session.close()
                self.stream_session = None

            logger.info("Stopped all streaming")

        except Exception as e:
            logger.error(f"Error stopping streaming: {e}")

    async def _stream_pricing(self, instruments: str):
        """Stream pricing data for instruments"""
        try:
            url = f"{self.config.stream_url}/v3/accounts/{self.config.account_id}/pricing/stream"
            params = {"instruments": instruments, "snapshot": "true"}

            while self.streaming_active:
                try:
                    async with self.stream_session.get(url, params=params) as response:
                        if response.status == 200:
                            async for line in response.content:
                                if not self.streaming_active:
                                    break

                                try:
                                    line_str = line.decode("utf-8").strip()
                                    if line_str:
                                        data = json.loads(line_str)
                                        await self._process_stream_data(data)
                                except json.JSONDecodeError:
                                    continue
                                except Exception as e:
                                    logger.warning(f"Error processing stream data: {e}")
                                    continue
                        else:
                            logger.error(f"Streaming HTTP error: {response.status}")
                            await asyncio.sleep(self.config.stream_reconnect_delay)

                except Exception as e:
                    logger.error(f"Streaming connection error: {e}")
                    if self.streaming_active:
                        await asyncio.sleep(self.config.stream_reconnect_delay)

        except asyncio.CancelledError:
            logger.info("Pricing stream cancelled")
        except Exception as e:
            logger.error(f"Error in pricing stream: {e}")

    async def _process_stream_data(self, data: Dict):
        """Process streaming data"""
        try:
            if "type" in data:
                if data["type"] == "PRICE":
                    # Process price update
                    instrument = data.get("instrument", "")
                    symbol = self._unmap_symbol(instrument)

                    quote_data = {
                        "symbol": symbol,
                        "bid": float(data.get("bids", [{}])[0].get("price", 0))
                        if data.get("bids")
                        else 0,
                        "ask": float(data.get("asks", [{}])[0].get("price", 0))
                        if data.get("asks")
                        else 0,
                        "timestamp": datetime.now(timezone.utc),
                        "source": "oanda_stream",
                    }

                    # Calculate mid price
                    if quote_data["bid"] > 0 and quote_data["ask"] > 0:
                        quote_data["mid"] = (quote_data["bid"] + quote_data["ask"]) / 2
                        quote_data["spread"] = quote_data["ask"] - quote_data["bid"]
                        quote_data["spread_pct"] = (
                            (quote_data["spread"] / quote_data["mid"]) * 100
                            if quote_data["mid"] > 0
                            else 0
                        )

                    # Update cache
                    cache_key = f"quote_{symbol}"
                    self._cache_data(cache_key, quote_data)

                    # Notify callbacks
                    for callback in self.price_callbacks:
                        try:
                            await callback(quote_data)
                        except Exception as e:
                            logger.warning(f"Error in price callback: {e}")

                elif data["type"] == "HEARTBEAT":
                    # Process heartbeat
                    logger.debug("Received heartbeat from Oanda stream")

        except Exception as e:
            logger.error(f"Error processing stream data: {e}")

    def add_price_callback(self, callback: Callable):
        """Add callback for streaming price updates"""
        self.price_callbacks.append(callback)

    def remove_price_callback(self, callback: Callable):
        """Remove callback for streaming price updates"""
        if callback in self.price_callbacks:
            self.price_callbacks.remove(callback)

    # Private helper methods

    async def _test_connection(self) -> bool:
        """Test connection with account summary request"""
        try:
            url = f"{self.config.base_url}/v3/accounts/{self.config.account_id}/summary"

            async with self.session.get(url) as response:
                if response.status == 200:
                    data = await response.json()
                    return "account" in data
                else:
                    return False

        except Exception as e:
            logger.error(f"Error testing Oanda connection: {e}")
            return False

    async def _initialize_instruments_cache(self):
        """Initialize cache for available instruments"""
        try:
            # Cache instruments by type
            for instrument_type in ["CURRENCY", "CFD", "METAL"]:
                try:
                    await self.get_instruments(instrument_type.lower())
                    await asyncio.sleep(0.1)  # Small delay between requests
                except Exception as e:
                    logger.warning(
                        f"Error caching instruments for {instrument_type}: {e}"
                    )
                    continue

            logger.info(f"Initialized instruments cache")

        except Exception as e:
            logger.warning(f"Error initializing instruments cache: {e}")

    def _process_candles_data(
        self, candles: List[Dict], symbol: str, interval: str
    ) -> pd.DataFrame:
        """Process historical candles data"""
        try:
            if not candles:
                return pd.DataFrame()

            # Convert to DataFrame
            df_data = []
            for candle in candles:
                if not candle.get("complete", False):
                    continue  # Skip incomplete candles

                # Extract price data (mid prices by default)
                mid_data = candle.get("mid", {})
                if not mid_data:
                    continue

                df_data.append(
                    {
                        "timestamp": pd.to_datetime(candle.get("time")),
                        "open": float(mid_data.get("o", 0)),
                        "high": float(mid_data.get("h", 0)),
                        "low": float(mid_data.get("l", 0)),
                        "close": float(mid_data.get("c", 0)),
                        "volume": int(candle.get("volume", 0)),
                    }
                )

                # Add bid/ask data if available
                if self.config.include_bid_ask:
                    bid_data = candle.get("bid", {})
                    ask_data = candle.get("ask", {})

                    if bid_data:
                        df_data[-1].update(
                            {
                                "bid_open": float(bid_data.get("o", 0)),
                                "bid_high": float(bid_data.get("h", 0)),
                                "bid_low": float(bid_data.get("l", 0)),
                                "bid_close": float(bid_data.get("c", 0)),
                            }
                        )

                    if ask_data:
                        df_data[-1].update(
                            {
                                "ask_open": float(ask_data.get("o", 0)),
                                "ask_high": float(ask_data.get("h", 0)),
                                "ask_low": float(ask_data.get("l", 0)),
                                "ask_close": float(ask_data.get("c", 0)),
                            }
                        )

            df = pd.DataFrame(df_data)

            if not df.empty:
                # Set timestamp as index
                df.set_index("timestamp", inplace=True)
                df.sort_index(inplace=True)

                # Add calculated fields
                df["typical_price"] = (df["high"] + df["low"] + df["close"]) / 3
                df["price_change"] = df["close"].diff()
                df["price_change_pct"] = df["close"].pct_change() * 100

                # Add spread calculations if bid/ask available
                if (
                    self.config.include_bid_ask
                    and "bid_close" in df.columns
                    and "ask_close" in df.columns
                ):
                    df["spread"] = df["ask_close"] - df["bid_close"]
                    df["spread_pct"] = (df["spread"] / df["close"]) * 100
                    df["mid_price"] = (df["bid_close"] + df["ask_close"]) / 2

            return df

        except Exception as e:
            logger.error(f"Error processing candles data for {symbol}: {e}")
            return pd.DataFrame()

    def _process_pricing_data(self, symbol: str, price_data: Dict) -> Dict[str, Any]:
        """Process real-time pricing data"""
        try:
            current_time = datetime.now(timezone.utc)

            # Extract bid/ask prices
            bids = price_data.get("bids", [])
            asks = price_data.get("asks", [])

            bid_price = float(bids[0]["price"]) if bids else 0
            ask_price = float(asks[0]["price"]) if asks else 0

            # Extract additional data
            quote = {
                "symbol": symbol,
                "bid": bid_price,
                "ask": ask_price,
                "timestamp": pd.to_datetime(price_data.get("time", current_time)),
                "tradeable": price_data.get("tradeable", False),
                "source": "oanda",
            }

            # Calculate derived metrics
            if bid_price > 0 and ask_price > 0:
                quote["mid"] = (bid_price + ask_price) / 2
                quote["spread"] = ask_price - bid_price
                quote["spread_pct"] = (
                    (quote["spread"] / quote["mid"]) * 100 if quote["mid"] > 0 else 0
                )
            else:
                quote["mid"] = 0
                quote["spread"] = 0
                quote["spread_pct"] = 0

            # Add liquidity information if available
            if bids:
                quote["bid_liquidity"] = float(bids[0].get("liquidity", 0))
            if asks:
                quote["ask_liquidity"] = float(asks[0].get("liquidity", 0))

            # Add instrument type
            quote["instrument_type"] = self._get_instrument_type(symbol)

            return quote

        except Exception as e:
            logger.error(f"Error processing pricing data for {symbol}: {e}")
            return {}

    def _process_instruments_data(
        self, instruments: List[Dict], instrument_type: str
    ) -> List[Dict[str, Any]]:
        """Process instruments data"""
        try:
            processed_instruments = []

            for instrument in instruments:
                # Filter by instrument type if specified
                if instrument_type != "all":
                    if instrument.get("type", "").lower() != instrument_type.lower():
                        continue

                processed_instrument = {
                    "name": instrument.get("name", ""),
                    "display_name": instrument.get("displayName", ""),
                    "type": instrument.get("type", ""),
                    "pip_location": int(instrument.get("pipLocation", 0)),
                    "display_precision": int(instrument.get("displayPrecision", 0)),
                    "trade_units_precision": int(
                        instrument.get("tradeUnitsPrecision", 0)
                    ),
                    "minimum_trade_size": float(instrument.get("minimumTradeSize", 0)),
                    "maximum_trailing_stop_distance": float(
                        instrument.get("maximumTrailingStopDistance", 0)
                    ),
                    "minimum_trailing_stop_distance": float(
                        instrument.get("minimumTrailingStopDistance", 0)
                    ),
                    "maximum_position_size": float(
                        instrument.get("maximumPositionSize", 0)
                    ),
                    "maximum_order_units": float(
                        instrument.get("maximumOrderUnits", 0)
                    ),
                    "margin_rate": float(instrument.get("marginRate", 0)),
                    "commission": instrument.get("commission", {}),
                    "financing": instrument.get("financing", {}),
                    "tags": instrument.get("tags", []),
                    "timestamp": datetime.now(timezone.utc),
                    "source": "oanda",
                }

                processed_instruments.append(processed_instrument)

            return processed_instruments

        except Exception as e:
            logger.error(f"Error processing instruments data: {e}")
            return []

    def _process_economic_calendar(self, calendar_data: Dict) -> List[Dict[str, Any]]:
        """Process economic calendar data"""
        try:
            # Note: Oanda doesn't have a direct economic calendar API
            # This is a placeholder for order book data that could be used
            # for market sentiment analysis

            events = []

            if "orderBook" in calendar_data:
                order_book = calendar_data["orderBook"]

                # Create a synthetic event from order book data
                event = {
                    "time": pd.to_datetime(order_book.get("time", datetime.now())),
                    "instrument": order_book.get("instrument", ""),
                    "price": float(order_book.get("price", 0)),
                    "bucket_width": float(order_book.get("bucketWidth", 0)),
                    "buckets": order_book.get("buckets", []),
                    "type": "order_book_snapshot",
                    "importance": "MEDIUM",
                    "source": "oanda",
                }

                events.append(event)

            return events

        except Exception as e:
            logger.error(f"Error processing economic calendar: {e}")
            return []

    def _process_account_summary(self, account_data: Dict) -> Dict[str, Any]:
        """Process account summary data"""
        try:
            summary = {
                "account_id": account_data.get("id", ""),
                "alias": account_data.get("alias", ""),
                "currency": account_data.get("currency", ""),
                "balance": float(account_data.get("balance", 0)),
                "nav": float(account_data.get("NAV", 0)),
                "unrealized_pl": float(account_data.get("unrealizedPL", 0)),
                "realized_pl": float(account_data.get("realizedPL", 0)),
                "margin_used": float(account_data.get("marginUsed", 0)),
                "margin_available": float(account_data.get("marginAvailable", 0)),
                "margin_rate": float(account_data.get("marginRate", 0)),
                "margin_call_enter_time": account_data.get("marginCallEnterTime"),
                "margin_call_extension_count": int(
                    account_data.get("marginCallExtensionCount", 0)
                ),
                "open_trade_count": int(account_data.get("openTradeCount", 0)),
                "open_position_count": int(account_data.get("openPositionCount", 0)),
                "pending_order_count": int(account_data.get("pendingOrderCount", 0)),
                "hedging_enabled": account_data.get("hedgingEnabled", False),
                "last_transaction_id": account_data.get("lastTransactionID", ""),
                "timestamp": datetime.now(timezone.utc),
                "source": "oanda",
            }

            return summary

        except Exception as e:
            logger.error(f"Error processing account summary: {e}")
            return {}

    def _initialize_instrument_mappings(self) -> Dict[str, str]:
        """Initialize instrument mappings for Oanda"""
        return {
            # Major forex pairs
            "EURUSD": "EUR_USD",
            "GBPUSD": "GBP_USD",
            "USDJPY": "USD_JPY",
            "USDCHF": "USD_CHF",
            "AUDUSD": "AUD_USD",
            "USDCAD": "USD_CAD",
            "NZDUSD": "NZD_USD",
            # Minor pairs
            "EURGBP": "EUR_GBP",
            "EURJPY": "EUR_JPY",
            "EURCHF": "EUR_CHF",
            "EURAUD": "EUR_AUD",
            "EURCAD": "EUR_CAD",
            "GBPJPY": "GBP_JPY",
            "GBPCHF": "GBP_CHF",
            "AUDJPY": "AUD_JPY",
            # CFD indices
            "SPX500": "SPX500_USD",
            "NAS100": "NAS100_USD",
            "US30": "US30_USD",
            "DE30": "DE30_EUR",
            "UK100": "UK100_GBP",
            "FR40": "FR40_EUR",
            "JP225": "JP225_USD",
            "AUS200": "AUS200_AUD",
            # Commodities
            "XAUUSD": "XAU_USD",  # Gold
            "XAGUSD": "XAG_USD",  # Silver
            "XPTUSD": "XPT_USD",  # Platinum
            "XPDUSD": "XPD_USD",  # Palladium
            "BCOUSD": "BCO_USD",  # Brent Crude
            "WTICOUSD": "WTICO_USD",  # WTI Crude
            "NATGASUSD": "NATGAS_USD",  # Natural Gas
        }

    def _initialize_instrument_types(self) -> Dict[str, str]:
        """Initialize instrument types mapping"""
        return {
            # Forex pairs
            "EUR_USD": "CURRENCY",
            "GBP_USD": "CURRENCY",
            "USD_JPY": "CURRENCY",
            "USD_CHF": "CURRENCY",
            "AUD_USD": "CURRENCY",
            "USD_CAD": "CURRENCY",
            "NZD_USD": "CURRENCY",
            "EUR_GBP": "CURRENCY",
            "EUR_JPY": "CURRENCY",
            # CFD indices
            "SPX500_USD": "CFD",
            "NAS100_USD": "CFD",
            "US30_USD": "CFD",
            "DE30_EUR": "CFD",
            "UK100_GBP": "CFD",
            "FR40_EUR": "CFD",
            # Metals
            "XAU_USD": "METAL",
            "XAG_USD": "METAL",
            "XPT_USD": "METAL",
            "XPD_USD": "METAL",
        }

    def _map_symbol(self, symbol: str) -> str:
        """Map symbol to Oanda format"""
        return self.instrument_mappings.get(
            symbol.upper().replace("/", "_"), symbol.upper().replace("/", "_")
        )

    def _unmap_symbol(self, oanda_symbol: str) -> str:
        """Map Oanda symbol back to standard format"""
        # Reverse mapping
        for standard, oanda in self.instrument_mappings.items():
            if oanda == oanda_symbol:
                return standard
        return oanda_symbol.replace("_", "")

    def _get_instrument_type(self, symbol: str) -> str:
        """Get instrument type for symbol"""
        oanda_symbol = self._map_symbol(symbol)
        return self.instrument_types.get(oanda_symbol, "UNKNOWN")

    def _map_interval(self, interval: str) -> str:
        """Map interval to Oanda granularity"""
        interval_mapping = {
            "5s": "S5",
            "10s": "S10",
            "15s": "S15",
            "30s": "S30",
            "1m": "M1",
            "2m": "M2",
            "4m": "M4",
            "5m": "M5",
            "10m": "M10",
            "15m": "M15",
            "30m": "M30",
            "1h": "H1",
            "2h": "H2",
            "3h": "H3",
            "4h": "H4",
            "6h": "H6",
            "8h": "H8",
            "12h": "H12",
            "1d": "D",
            "1w": "W",
            "1M": "M",
        }
        return interval_mapping.get(interval, "M1")

    async def _respect_rate_limit(self):
        """Respect API rate limits"""
        current_time = time.time()
        time_since_last = current_time - self.last_request_time

        # Minimum time between requests
        min_interval = 1.0 / self.config.max_requests_per_second

        if time_since_last < min_interval:
            sleep_time = min_interval - time_since_last
            await asyncio.sleep(sleep_time)

        self.last_request_time = time.time()

    def _is_connected(self) -> bool:
        """Check if adapter is connected"""
        return self.status == ConnectionStatus.CONNECTED and self.session is not None

    def _is_cached(self, key: str) -> bool:
        """Check if data is cached and not expired"""
        if (
            key not in self.cache
            and key not in self.instruments_cache
            and key not in self.pricing_cache
            and key not in self.candles_cache
            and key not in self.economic_calendar_cache
        ):
            return False

        if key in self.cache_expiry:
            return datetime.now() < self.cache_expiry[key]

        return True

    def _cache_data(self, key: str, data: Any):
        """Cache data with expiration"""
        self.cache[key] = data
        self._set_cache_expiry(key)

    def _set_cache_expiry(self, key: str):
        """Set cache expiration time"""
        self.cache_expiry[key] = datetime.now() + timedelta(
            seconds=self.config.cache_duration
        )


# Logger setup
logger = logging.getLogger(__name__)
