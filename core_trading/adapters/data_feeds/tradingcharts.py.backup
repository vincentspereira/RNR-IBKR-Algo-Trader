"""TradingCharts Data Feed Adapter

This module provides a comprehensive adapter for TradingCharts.com API integration,
serving as a specialized data source for commodity futures, agricultural products,
and energy markets. TradingCharts provides real-time and historical data for
commodity markets with a focus on futures contracts and agricultural products.

Features:
- Comprehensive commodity futures coverage
- Agricultural products data
- Energy markets (crude oil, natural gas, etc.)
- Metals markets (gold, silver, copper, etc.)
- Real-time and delayed quotes
- Historical futures data
- Contract specifications
- Seasonal patterns and analytics
- Weather data integration
- Comprehensive error handling and retry logic
- Rate limiting and request management
- Event-driven data distribution
"""

import asyncio
import json
import logging
import math
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass, field
from datetime import datetime, timedelta, timezone
from decimal import Decimal
from enum import Enum
from typing import Any, AsyncGenerator, Callable, Dict, List, Optional, Union
from urllib.parse import urlencode, urljoin

import aiohttp

from ..base import (
    AdapterConfig,
    AdapterType,
    BaseDataFeedAdapter,
    ConnectionStatus,
    HealthCheck,
)

# TradingCharts imports (would be installed via pip install pandas requests)
try:
    import numpy as np
    import pandas as pd
    import requests

    TRADINGCHARTS_AVAILABLE = True
except ImportError:
    TRADINGCHARTS_AVAILABLE = False
    logging.warning(
        "TradingCharts dependencies not available. Install with: pip install pandas requests numpy"
    )


class TradingChartsMarket(Enum):
    """TradingCharts supported markets"""

    GRAINS = "grains"
    LIVESTOCK = "livestock"
    SOFTS = "softs"
    ENERGY = "energy"
    METALS = "metals"
    FINANCIALS = "financials"
    CURRENCIES = "currencies"
    INDICES = "indices"
    ALL = "all"


class TradingChartsDataType(Enum):
    """TradingCharts data types"""

    REAL_TIME = "realtime"
    DELAYED = "delayed"
    HISTORICAL = "historical"
    INTRADAY = "intraday"
    END_OF_DAY = "eod"


class TradingChartsInterval(Enum):
    """TradingCharts supported intervals"""

    TICK = "tick"
    MINUTE_1 = "1min"
    MINUTE_5 = "5min"
    MINUTE_15 = "15min"
    MINUTE_30 = "30min"
    HOUR_1 = "1hour"
    HOUR_4 = "4hour"
    DAILY = "daily"
    WEEKLY = "weekly"
    MONTHLY = "monthly"


class TradingChartsContract(Enum):
    """TradingCharts contract types"""

    FRONT_MONTH = "front"
    CONTINUOUS = "continuous"
    SPECIFIC = "specific"
    SPREAD = "spread"


@dataclass
class TradingChartsConfig(AdapterConfig):
    """TradingCharts specific configuration"""

    api_key: str = ""  # Required for premium features
    username: str = ""
    password: str = ""
    base_url: str = "https://api.tradingcharts.com"
    timeout: int = 30
    max_requests_per_second: int = 5  # Conservative rate limit
    retry_attempts: int = 3
    retry_delay: float = 2.0
    cache_duration: int = 300  # 5 minutes cache for commodity data

    # Data preferences
    default_data_type: str = "delayed"  # Free delayed data
    default_contract_type: str = "continuous"  # Continuous contracts
    include_volume: bool = True
    include_open_interest: bool = True

    # Market-specific settings
    preferred_markets: List[str] = field(
        default_factory=lambda: ["grains", "energy", "metals", "livestock"]
    )

    # Popular commodity symbols
    popular_commodities: List[str] = field(
        default_factory=lambda: [
            # Grains
            "ZC",  # Corn
            "ZS",  # Soybeans
            "ZW",  # Wheat
            "ZO",  # Oats
            "ZR",  # Rice
            # Energy
            "CL",  # Crude Oil
            "NG",  # Natural Gas
            "HO",  # Heating Oil
            "RB",  # RBOB Gasoline
            # Metals
            "GC",  # Gold
            "SI",  # Silver
            "HG",  # Copper
            "PL",  # Platinum
            "PA",  # Palladium
            # Livestock
            "LC",  # Live Cattle
            "FC",  # Feeder Cattle
            "LH",  # Lean Hogs
            # Softs
            "CC",  # Cocoa
            "CT",  # Cotton
            "KC",  # Coffee
            "SB",  # Sugar
            "OJ",  # Orange Juice
        ]
    )

    # Weather data settings
    include_weather_data: bool = True
    weather_regions: List[str] = field(
        default_factory=lambda: [
            "midwest",
            "great_plains",
            "southeast",
            "brazil",
            "argentina",
        ]
    )

    # Seasonal analysis settings
    include_seasonal_patterns: bool = True
    seasonal_years_back: int = 10


class TradingChartsAdapter(BaseDataFeedAdapter):
    """
    TradingCharts.com data feed adapter implementation

    Provides comprehensive integration with TradingCharts API for commodity
    futures, agricultural products, and energy markets. Specializes in
    futures contracts with seasonal analysis and weather data integration.
    """

    def __init__(self, config: TradingChartsConfig):
        super().__init__(config)
        self.config = config
        self.session: Optional[aiohttp.ClientSession] = None
        self.rate_limiter = asyncio.Semaphore(config.max_requests_per_second)
        self.cache: Dict[str, Any] = {}
        self.last_request_time = 0.0

        # Request headers
        self.headers = {
            "User-Agent": "TradingCharts-Python-Client/1.0",
            "Accept": "application/json",
            "Content-Type": "application/json",
        }

        if config.api_key:
            self.headers["X-API-Key"] = config.api_key

        # Initialize caches
        self.futures_cache: Dict[str, pd.DataFrame] = {}
        self.weather_cache: Dict[str, Dict] = {}
        self.seasonal_cache: Dict[str, Dict] = {}
        self.contract_specs_cache: Dict[str, Dict] = {}
        self.cache_expiry: Dict[str, datetime] = {}

        # Market data mappings
        self.symbol_mappings = self._initialize_symbol_mappings()
        self.market_categories = self._initialize_market_categories()

        logger.info(f"Initialized TradingCharts adapter with config: {config.name}")

    async def connect(self) -> bool:
        """Establish connection to TradingCharts API"""
        try:
            if not TRADINGCHARTS_AVAILABLE:
                logger.error("TradingCharts dependencies not available")
                self.status = ConnectionStatus.FAILED
                return False

            # Create HTTP session
            connector = aiohttp.TCPConnector(
                limit=20, limit_per_host=10, ttl_dns_cache=300, use_dns_cache=True
            )

            timeout = aiohttp.ClientTimeout(total=self.config.timeout)
            self.session = aiohttp.ClientSession(
                connector=connector, timeout=timeout, headers=self.headers
            )

            # Test connection with a simple request
            test_symbol = "CL"  # Crude Oil
            test_data = await self._test_connection(test_symbol)

            if test_data:
                self.status = ConnectionStatus.CONNECTED
                logger.info("Successfully connected to TradingCharts API")

                # Initialize popular commodities cache
                await self._initialize_commodities_cache()

                return True
            else:
                logger.error("Failed to retrieve test data from TradingCharts")
                self.status = ConnectionStatus.FAILED
                return False

        except Exception as e:
            logger.error(f"Error connecting to TradingCharts: {e}")
            self.status = ConnectionStatus.FAILED
            return False

    async def disconnect(self) -> bool:
        """Disconnect from TradingCharts API"""
        try:
            # Close HTTP session
            if self.session:
                await self.session.close()
                self.session = None

            self.status = ConnectionStatus.DISCONNECTED
            logger.info("Disconnected from TradingCharts API")
            return True

        except Exception as e:
            logger.error(f"Error disconnecting from TradingCharts: {e}")
            return False

    async def get_historical_data(
        self,
        symbol: str,
        start_date: datetime,
        end_date: datetime,
        interval: str = "1d",
        **kwargs,
    ) -> Optional[pd.DataFrame]:
        """Get historical commodity futures data from TradingCharts"""
        try:
            if not self._is_connected():
                await self.connect()

            # Map interval to TradingCharts format
            tc_interval = self._map_interval(interval)
            contract_type = kwargs.get(
                "contract_type", self.config.default_contract_type
            )

            # Prepare API parameters
            params = {
                "symbol": self._map_symbol(symbol),
                "startDate": start_date.strftime("%Y-%m-%d"),
                "endDate": end_date.strftime("%Y-%m-%d"),
                "interval": tc_interval,
                "contractType": contract_type,
                "dataType": kwargs.get("data_type", self.config.default_data_type),
            }

            # Add optional parameters
            if "exchange" in kwargs:
                params["exchange"] = kwargs["exchange"]
            if "contract_month" in kwargs:
                params["contractMonth"] = kwargs["contract_month"]

            # Make API request
            url = f"{self.config.base_url}/v1/historical"

            async with self.rate_limiter:
                await self._respect_rate_limit()

                async with self.session.get(url, params=params) as response:
                    if response.status == 200:
                        data = await response.json()

                        if data and "data" in data:
                            # Convert to DataFrame
                            df = self._process_historical_data(
                                data["data"], symbol, interval
                            )

                            if not df.empty:
                                # Add metadata
                                df.attrs = {
                                    "symbol": symbol,
                                    "source": "tradingcharts",
                                    "data_type": "historical",
                                    "start_date": start_date,
                                    "end_date": end_date,
                                    "interval": interval,
                                    "contract_type": contract_type,
                                }

                                logger.info(
                                    f"Retrieved {len(df)} historical records for {symbol}"
                                )
                                return df

                        return None

                    elif response.status == 429:
                        logger.warning("Rate limit exceeded, waiting before retry")
                        await asyncio.sleep(self.config.retry_delay * 2)
                        return await self.get_historical_data(
                            symbol, start_date, end_date, interval, **kwargs
                        )

                    else:
                        logger.error(f"HTTP error {response.status} for {symbol}")
                        return None

        except Exception as e:
            logger.error(f"Error getting historical data for {symbol}: {e}")
            return None

    async def get_quote(self, symbol: str) -> Optional[Dict[str, Any]]:
        """Get real-time commodity futures quote from TradingCharts"""
        try:
            if not self._is_connected():
                await self.connect()

            # Check cache first
            cache_key = f"quote_{symbol}"
            if self._is_cached(cache_key):
                return self.cache[cache_key]

            # Prepare API parameters
            params = {
                "symbol": self._map_symbol(symbol),
                "dataType": self.config.default_data_type,
                "includeVolume": str(self.config.include_volume).lower(),
                "includeOpenInterest": str(self.config.include_open_interest).lower(),
            }

            # Make API request
            url = f"{self.config.base_url}/v1/quote"

            async with self.rate_limiter:
                await self._respect_rate_limit()

                async with self.session.get(url, params=params) as response:
                    if response.status == 200:
                        data = await response.json()

                        if data and "quote" in data:
                            # Process quote data
                            quote_data = self._process_quote_data(symbol, data["quote"])

                            # Cache the result
                            self._cache_data(cache_key, quote_data)

                            logger.debug(
                                f"Retrieved quote for {symbol}: ${quote_data.get('last', 0):.2f}"
                            )
                            return quote_data

                        return None

                    elif response.status == 429:
                        logger.warning("Rate limit exceeded, waiting before retry")
                        await asyncio.sleep(self.config.retry_delay)
                        return await self.get_real_time_quote(symbol)

                    else:
                        logger.error(f"HTTP error {response.status} for {symbol}")
                        return None

        except Exception as e:
            logger.error(f"Error getting quote for {symbol}: {e}")
            return None

    async def get_real_time_quote(self, symbol: str) -> Optional[Dict[str, Any]]:
        """Get real-time commodity futures quote from TradingCharts (legacy method)"""
        quote_data = await self.get_quote(symbol)
        return quote_data if quote_data else None

    async def subscribe_real_time(
        self, symbols: List[str]
    ) -> AsyncGenerator[Dict[str, Any], None]:
        """Subscribe to real-time market data (BaseDataFeedAdapter abstract method)"""
        try:
            if not symbols:
                return

            logger.info(
                f"Starting TradingCharts real-time subscription for {len(symbols)} symbols"
            )

            while True:
                for symbol in symbols:
                    try:
                        quote_data = await self.get_quote(symbol)
                        if quote_data:
                            yield {
                                "symbol": symbol,
                                "data": quote_data,
                                "timestamp": datetime.now(timezone.utc),
                                "source": "tradingcharts",
                            }
                    except Exception as e:
                        logger.error(f"Error getting real-time data for {symbol}: {e}")
                        continue

                # Wait before next polling cycle (respect rate limits)
                await asyncio.sleep(3.0)  # 3 seconds between polls for commodity data

        except Exception as e:
            logger.error(f"Error in TradingCharts real-time subscription: {e}")
            return

    async def search_symbols(self, query: str, limit: int = 20) -> List[Dict[str, Any]]:
        """Search for symbols (BaseDataFeedAdapter abstract method)"""
        try:
            results = []
            query_lower = query.lower()

            # Search in popular commodities
            popular_commodities = [
                ("CL", "Crude Oil Futures"),
                ("NG", "Natural Gas Futures"),
                ("GC", "Gold Futures"),
                ("SI", "Silver Futures"),
                ("HG", "Copper Futures"),
                ("C", "Corn Futures"),
                ("S", "Soybean Futures"),
                ("W", "Wheat Futures"),
                ("LC", "Live Cattle Futures"),
                ("LH", "Lean Hogs Futures"),
                ("CC", "Cocoa Futures"),
                ("CT", "Cotton Futures"),
                ("SB", "Sugar Futures"),
                ("KC", "Coffee Futures"),
                ("PA", "Palladium Futures"),
                ("PL", "Platinum Futures"),
                ("HO", "Heating Oil Futures"),
                ("RB", "RBOB Gasoline Futures"),
                ("ZC", "Corn Futures (CBOT)"),
                ("ZS", "Soybean Futures (CBOT)"),
            ]

            for symbol, name in popular_commodities:
                if query_lower in symbol.lower() or query_lower in name.lower():
                    results.append(
                        {
                            "symbol": symbol,
                            "name": name,
                            "exchange": "Multiple",
                            "asset_type": "commodity_futures",
                            "source": "tradingcharts",
                        }
                    )

            # If no results found, provide some common commodity symbols
            if not results:
                common_symbols = [
                    ("CL", "Crude Oil Futures"),
                    ("GC", "Gold Futures"),
                    ("NG", "Natural Gas Futures"),
                    ("C", "Corn Futures"),
                    ("S", "Soybean Futures"),
                    ("W", "Wheat Futures"),
                    ("SI", "Silver Futures"),
                    ("HG", "Copper Futures"),
                    ("LC", "Live Cattle Futures"),
                    ("CC", "Cocoa Futures"),
                ]

                for symbol, name in common_symbols:
                    results.append(
                        {
                            "symbol": symbol,
                            "name": name,
                            "exchange": "Multiple",
                            "asset_type": "commodity_futures",
                            "source": "tradingcharts",
                        }
                    )

            return results[:limit]

        except Exception as e:
            logger.error(f"Error searching TradingCharts symbols: {e}")
            return []

    async def get_contract_specifications(
        self, symbol: str
    ) -> Optional[Dict[str, Any]]:
        """Get futures contract specifications from TradingCharts"""
        try:
            if not self._is_connected():
                await self.connect()

            # Check cache first
            cache_key = f"contract_specs_{symbol}"
            if self._is_cached(cache_key):
                return self.contract_specs_cache.get(cache_key)

            # Prepare API parameters
            params = {"symbol": self._map_symbol(symbol)}

            # Make API request
            url = f"{self.config.base_url}/v1/contract-specs"

            async with self.rate_limiter:
                await self._respect_rate_limit()

                async with self.session.get(url, params=params) as response:
                    if response.status == 200:
                        data = await response.json()

                        if data and "contractSpecs" in data:
                            # Process contract specifications
                            specs = self._process_contract_specs(
                                data["contractSpecs"], symbol
                            )

                            # Cache the result
                            self.contract_specs_cache[cache_key] = specs
                            self._set_cache_expiry(cache_key)

                            logger.info(
                                f"Retrieved contract specifications for {symbol}"
                            )
                            return specs

                        return None

                    else:
                        logger.error(
                            f"HTTP error {response.status} for contract specs {symbol}"
                        )
                        return None

        except Exception as e:
            logger.error(f"Error getting contract specifications for {symbol}: {e}")
            return None

    async def get_seasonal_patterns(
        self, symbol: str, **kwargs
    ) -> Optional[Dict[str, Any]]:
        """Get seasonal patterns analysis from TradingCharts"""
        try:
            if not self._is_connected():
                await self.connect()

            if not self.config.include_seasonal_patterns:
                logger.info("Seasonal patterns disabled in configuration")
                return None

            # Check cache first
            cache_key = f"seasonal_{symbol}"
            if self._is_cached(cache_key):
                return self.seasonal_cache.get(cache_key)

            # Prepare API parameters
            params = {
                "symbol": self._map_symbol(symbol),
                "yearsBack": kwargs.get("years_back", self.config.seasonal_years_back),
                "analysisType": kwargs.get("analysis_type", "monthly"),
            }

            # Make API request
            url = f"{self.config.base_url}/v1/seasonal-analysis"

            async with self.rate_limiter:
                await self._respect_rate_limit()

                async with self.session.get(url, params=params) as response:
                    if response.status == 200:
                        data = await response.json()

                        if data and "seasonalData" in data:
                            # Process seasonal patterns
                            patterns = self._process_seasonal_patterns(
                                data["seasonalData"], symbol
                            )

                            # Cache the result
                            self.seasonal_cache[cache_key] = patterns
                            self._set_cache_expiry(cache_key)

                            logger.info(f"Retrieved seasonal patterns for {symbol}")
                            return patterns

                        return None

                    else:
                        logger.error(
                            f"HTTP error {response.status} for seasonal patterns {symbol}"
                        )
                        return None

        except Exception as e:
            logger.error(f"Error getting seasonal patterns for {symbol}: {e}")
            return None

    async def get_weather_data(
        self, region: str = "midwest", **kwargs
    ) -> Optional[Dict[str, Any]]:
        """Get weather data affecting commodity markets"""
        try:
            if not self._is_connected():
                await self.connect()

            if not self.config.include_weather_data:
                logger.info("Weather data disabled in configuration")
                return None

            # Check cache first
            cache_key = f"weather_{region}"
            if self._is_cached(cache_key):
                return self.weather_cache.get(cache_key)

            # Prepare API parameters
            params = {
                "region": region,
                "dataType": kwargs.get("data_type", "current"),
                "includeForecast": str(kwargs.get("include_forecast", True)).lower(),
            }

            # Make API request
            url = f"{self.config.base_url}/v1/weather"

            async with self.rate_limiter:
                await self._respect_rate_limit()

                async with self.session.get(url, params=params) as response:
                    if response.status == 200:
                        data = await response.json()

                        if data and "weatherData" in data:
                            # Process weather data
                            weather = self._process_weather_data(
                                data["weatherData"], region
                            )

                            # Cache the result
                            self.weather_cache[cache_key] = weather
                            self._set_cache_expiry(cache_key)

                            logger.info(f"Retrieved weather data for {region}")
                            return weather

                        return None

                    else:
                        logger.error(
                            f"HTTP error {response.status} for weather data {region}"
                        )
                        return None

        except Exception as e:
            logger.error(f"Error getting weather data for {region}: {e}")
            return None

