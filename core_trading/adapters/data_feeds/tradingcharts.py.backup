            return None

    async def health_check(self) -> HealthCheck:
        """Perform health check"""
        start_time = time.time()

        try:
            if not self._is_connected():
                return HealthCheck(
                    is_healthy=False,
                    status="disconnected",
                    latency_ms=0,
                    error_message="Not connected to TradingCharts API",
                )

            # Test with a simple quote request
            test_symbol = "CL"  # Crude Oil
            test_data = await self._test_connection(test_symbol)

            latency = (time.time() - start_time) * 1000

            if test_data:
                return HealthCheck(
                    is_healthy=True,
                    status="connected",
                    latency_ms=latency,
                    additional_info={
                        "cache_size": len(self.cache),
                        "futures_cache_size": len(self.futures_cache),
                        "weather_cache_size": len(self.weather_cache),
                        "seasonal_cache_size": len(self.seasonal_cache),
                        "contract_specs_cache_size": len(self.contract_specs_cache),
                        "include_weather_data": self.config.include_weather_data,
                        "include_seasonal_patterns": self.config.include_seasonal_patterns,
                        "preferred_markets": self.config.preferred_markets,
                    },
                )
            else:
                return HealthCheck(
                    is_healthy=False,
                    status="error",
                    latency_ms=latency,
                    error_message="Failed to retrieve test data",
                )

        except Exception as e:
            latency = (time.time() - start_time) * 1000
            return HealthCheck(
                is_healthy=False,
                status="error",
                latency_ms=latency,
                error_message=str(e),
            )

    # Private helper methods

    async def _test_connection(self, symbol: str) -> bool:
        """Test connection with a simple API call"""
        try:
            params = {"symbol": self._map_symbol(symbol), "dataType": "delayed"}

            url = f"{self.config.base_url}/v1/quote"

            async with self.session.get(url, params=params) as response:
                if response.status == 200:
                    data = await response.json()
                    return "quote" in data
                else:
                    return False

        except Exception as e:
            logger.error(f"Error testing TradingCharts connection: {e}")
            return False

    async def _initialize_commodities_cache(self):
        """Initialize cache for popular commodities"""
        try:
            # Cache basic info for popular commodities
            for symbol in self.config.popular_commodities[
                :10
            ]:  # Limit to avoid rate limits
                try:
                    await self.get_real_time_quote(symbol)
                    await asyncio.sleep(0.3)  # Small delay between requests
                except Exception as e:
                    logger.warning(f"Error caching {symbol}: {e}")
                    continue

            logger.info(f"Initialized cache for popular commodities")

        except Exception as e:
            logger.warning(f"Error initializing commodities cache: {e}")

    def _process_historical_data(
        self, data: List[Dict], symbol: str, interval: str
    ) -> pd.DataFrame:
        """Process historical commodity data"""
        try:
            if not data:
                return pd.DataFrame()

            # Convert to DataFrame
            df_data = []
            for record in data:
                df_data.append(
                    {
                        "timestamp": pd.to_datetime(record.get("timestamp")),
                        "open": float(record.get("open", 0)),
                        "high": float(record.get("high", 0)),
                        "low": float(record.get("low", 0)),
                        "close": float(record.get("close", 0)),
                        "volume": int(record.get("volume", 0)),
                        "open_interest": int(record.get("openInterest", 0)),
                    }
                )

            df = pd.DataFrame(df_data)

            if not df.empty:
                # Set timestamp as index
                df.set_index("timestamp", inplace=True)
                df.sort_index(inplace=True)

                # Add calculated fields
                df["typical_price"] = (df["high"] + df["low"] + df["close"]) / 3
                df["price_change"] = df["close"].diff()
                df["price_change_pct"] = df["close"].pct_change() * 100

                # Add commodity-specific metrics
                if self.config.include_volume and "volume" in df.columns:
                    df["volume_sma_20"] = df["volume"].rolling(window=20).mean()
                    df["volume_ratio"] = df["volume"] / df["volume_sma_20"]

                if self.config.include_open_interest and "open_interest" in df.columns:
                    df["oi_change"] = df["open_interest"].diff()
                    df["oi_change_pct"] = df["open_interest"].pct_change() * 100

            return df

        except Exception as e:
            logger.error(f"Error processing historical data for {symbol}: {e}")
            return pd.DataFrame()

    def _process_quote_data(self, symbol: str, quote_data: Dict) -> Dict[str, Any]:
        """Process real-time quote data"""
        try:
            current_time = datetime.now(timezone.utc)

            # Extract basic quote information
            quote = {
                "symbol": symbol,
                "last": float(quote_data.get("last", 0)),
                "bid": float(quote_data.get("bid", 0)),
                "ask": float(quote_data.get("ask", 0)),
                "open": float(quote_data.get("open", 0)),
                "high": float(quote_data.get("high", 0)),
                "low": float(quote_data.get("low", 0)),
                "previous_close": float(quote_data.get("previousClose", 0)),
                "timestamp": current_time,
                "source": "tradingcharts",
            }

            # Add volume and open interest if available
            if self.config.include_volume and "volume" in quote_data:
                quote["volume"] = int(quote_data["volume"])
                quote["avg_volume"] = int(quote_data.get("avgVolume", 0))

            if self.config.include_open_interest and "openInterest" in quote_data:
                quote["open_interest"] = int(quote_data["openInterest"])
                quote["oi_change"] = int(quote_data.get("oiChange", 0))

            # Calculate derived metrics
            if quote["previous_close"] > 0:
                quote["change"] = quote["last"] - quote["previous_close"]
                quote["change_percent"] = (
                    quote["change"] / quote["previous_close"]
                ) * 100
            else:
                quote["change"] = 0
                quote["change_percent"] = 0

            # Add bid-ask spread
            if quote["bid"] > 0 and quote["ask"] > 0:
                quote["bid_ask_spread"] = quote["ask"] - quote["bid"]
                quote["bid_ask_spread_pct"] = (
                    (quote["bid_ask_spread"] / quote["last"]) * 100
                    if quote["last"] > 0
                    else 0
                )
            else:
                quote["bid_ask_spread"] = 0
                quote["bid_ask_spread_pct"] = 0

            # Add market category
            quote["market_category"] = self._get_market_category(symbol)

            return quote

        except Exception as e:
            logger.error(f"Error processing quote data for {symbol}: {e}")
            return {}

    def _process_contract_specs(self, specs_data: Dict, symbol: str) -> Dict[str, Any]:
        """Process futures contract specifications"""
        try:
            specs = {
                "symbol": symbol,
                "contract_name": specs_data.get("contractName", ""),
                "exchange": specs_data.get("exchange", ""),
                "contract_size": specs_data.get("contractSize", ""),
                "tick_size": float(specs_data.get("tickSize", 0)),
                "tick_value": float(specs_data.get("tickValue", 0)),
                "currency": specs_data.get("currency", "USD"),
                "trading_hours": specs_data.get("tradingHours", ""),
                "contract_months": specs_data.get("contractMonths", []),
                "first_notice_day": specs_data.get("firstNoticeDay", ""),
                "last_trading_day": specs_data.get("lastTradingDay", ""),
                "delivery_method": specs_data.get("deliveryMethod", ""),
                "margin_requirement": float(specs_data.get("marginRequirement", 0)),
                "point_value": float(specs_data.get("pointValue", 0)),
                "market_category": self._get_market_category(symbol),
                "timestamp": datetime.now(timezone.utc),
                "source": "tradingcharts",
            }

            return specs

        except Exception as e:
            logger.error(f"Error processing contract specs for {symbol}: {e}")
            return {}

    def _process_seasonal_patterns(
        self, seasonal_data: Dict, symbol: str
    ) -> Dict[str, Any]:
        """Process seasonal patterns data"""
        try:
            patterns = {
                "symbol": symbol,
                "analysis_period": seasonal_data.get("analysisPeriod", ""),
                "years_analyzed": int(seasonal_data.get("yearsAnalyzed", 0)),
                "monthly_patterns": {},
                "quarterly_patterns": {},
                "best_months": [],
                "worst_months": [],
                "seasonal_strength": float(seasonal_data.get("seasonalStrength", 0)),
                "timestamp": datetime.now(timezone.utc),
                "source": "tradingcharts",
            }

            # Process monthly patterns
            if "monthlyPatterns" in seasonal_data:
                for month_data in seasonal_data["monthlyPatterns"]:
                    month = month_data.get("month", "")
                    patterns["monthly_patterns"][month] = {
                        "avg_return": float(month_data.get("avgReturn", 0)),
                        "win_rate": float(month_data.get("winRate", 0)),
                        "volatility": float(month_data.get("volatility", 0)),
                        "strength": float(month_data.get("strength", 0)),
                    }

            # Process quarterly patterns
            if "quarterlyPatterns" in seasonal_data:
                for quarter_data in seasonal_data["quarterlyPatterns"]:
                    quarter = quarter_data.get("quarter", "")
                    patterns["quarterly_patterns"][quarter] = {
                        "avg_return": float(quarter_data.get("avgReturn", 0)),
                        "win_rate": float(quarter_data.get("winRate", 0)),
                        "volatility": float(quarter_data.get("volatility", 0)),
                    }

            # Extract best and worst performing months
            if "bestMonths" in seasonal_data:
                patterns["best_months"] = seasonal_data["bestMonths"]
            if "worstMonths" in seasonal_data:
                patterns["worst_months"] = seasonal_data["worstMonths"]

            return patterns

        except Exception as e:
            logger.error(f"Error processing seasonal patterns for {symbol}: {e}")
            return {}

    def _process_weather_data(self, weather_data: Dict, region: str) -> Dict[str, Any]:
        """Process weather data"""
        try:
            weather = {
                "region": region,
                "current_conditions": {},
                "forecast": [],
                "agricultural_impact": {},
                "timestamp": datetime.now(timezone.utc),
                "source": "tradingcharts",
            }

            # Process current conditions
            if "currentConditions" in weather_data:
                current = weather_data["currentConditions"]
                weather["current_conditions"] = {
                    "temperature": float(current.get("temperature", 0)),
                    "humidity": float(current.get("humidity", 0)),
                    "precipitation": float(current.get("precipitation", 0)),
                    "wind_speed": float(current.get("windSpeed", 0)),
                    "soil_moisture": float(current.get("soilMoisture", 0)),
                    "growing_degree_days": float(current.get("growingDegreeDays", 0)),
                }

            # Process forecast
            if "forecast" in weather_data:
                for forecast_item in weather_data["forecast"]:
                    weather["forecast"].append(
                        {
                            "date": forecast_item.get("date", ""),
                            "temperature_high": float(
                                forecast_item.get("temperatureHigh", 0)
                            ),
                            "temperature_low": float(
                                forecast_item.get("temperatureLow", 0)
                            ),
                            "precipitation_chance": float(
                                forecast_item.get("precipitationChance", 0)
                            ),
                            "precipitation_amount": float(
                                forecast_item.get("precipitationAmount", 0)
                            ),
                        }
                    )

            # Process agricultural impact
            if "agriculturalImpact" in weather_data:
                impact = weather_data["agriculturalImpact"]
                weather["agricultural_impact"] = {
                    "crop_stress_index": float(impact.get("cropStressIndex", 0)),
                    "drought_severity": impact.get("droughtSeverity", ""),
                    "planting_conditions": impact.get("plantingConditions", ""),
                    "harvest_outlook": impact.get("harvestOutlook", ""),
                    "yield_impact": float(impact.get("yieldImpact", 0)),
                }

            return weather

        except Exception as e:
            logger.error(f"Error processing weather data for {region}: {e}")
            return {}

    def _process_market_summary(
        self, summary_data: Dict, market: str
    ) -> Dict[str, Any]:
        """Process market summary data"""
        try:
            summary = {
                "market": market,
                "sectors": {},
                "top_gainers": [],
                "top_losers": [],
                "most_active": [],
                "market_sentiment": {},
                "timestamp": datetime.now(timezone.utc),
                "source": "tradingcharts",
            }

            # Process sector performance
            if "sectors" in summary_data:
                for sector_data in summary_data["sectors"]:
                    sector_name = sector_data.get("name", "")
                    summary["sectors"][sector_name] = {
                        "change_percent": float(sector_data.get("changePercent", 0)),
                        "volume": int(sector_data.get("volume", 0)),
                        "leaders": sector_data.get("leaders", []),
                        "laggards": sector_data.get("laggards", []),
                    }

            # Process top performers
            if "topGainers" in summary_data:
                summary["top_gainers"] = summary_data["topGainers"]
            if "topLosers" in summary_data:
                summary["top_losers"] = summary_data["topLosers"]
            if "mostActive" in summary_data:
                summary["most_active"] = summary_data["mostActive"]

            # Process market sentiment
            if "marketSentiment" in summary_data:
                sentiment = summary_data["marketSentiment"]
                summary["market_sentiment"] = {
                    "bullish_percent": float(sentiment.get("bullishPercent", 0)),
                    "bearish_percent": float(sentiment.get("bearishPercent", 0)),
                    "neutral_percent": float(sentiment.get("neutralPercent", 0)),
                    "fear_greed_index": float(sentiment.get("fearGreedIndex", 0)),
                }

            return summary

        except Exception as e:
            logger.error(f"Error processing market summary for {market}: {e}")
            return {}

    def _initialize_symbol_mappings(self) -> Dict[str, str]:
        """Initialize symbol mappings for TradingCharts"""
        return {
            # Grains
            "CORN": "ZC",
            "SOYBEANS": "ZS",
            "WHEAT": "ZW",
            "OATS": "ZO",
            "RICE": "ZR",
            # Energy
            "CRUDE_OIL": "CL",
            "NATURAL_GAS": "NG",
            "HEATING_OIL": "HO",
            "GASOLINE": "RB",
            # Metals
            "GOLD": "GC",
            "SILVER": "SI",
            "COPPER": "HG",
            "PLATINUM": "PL",
            "PALLADIUM": "PA",
            # Livestock
            "LIVE_CATTLE": "LC",
            "FEEDER_CATTLE": "FC",
            "LEAN_HOGS": "LH",
            # Softs
            "COCOA": "CC",
            "COTTON": "CT",
            "COFFEE": "KC",
            "SUGAR": "SB",
            "ORANGE_JUICE": "OJ",
        }

    def _initialize_market_categories(self) -> Dict[str, str]:
        """Initialize market categories mapping"""
        return {
            # Grains
            "ZC": "grains",
            "ZS": "grains",
            "ZW": "grains",
            "ZO": "grains",
            "ZR": "grains",
            # Energy
            "CL": "energy",
            "NG": "energy",
            "HO": "energy",
            "RB": "energy",
            # Metals
            "GC": "metals",
            "SI": "metals",
            "HG": "metals",
            "PL": "metals",
            "PA": "metals",
            # Livestock
            "LC": "livestock",
            "FC": "livestock",
            "LH": "livestock",
            # Softs
            "CC": "softs",
            "CT": "softs",
            "KC": "softs",
            "SB": "softs",
            "OJ": "softs",
        }

    def _map_symbol(self, symbol: str) -> str:
        """Map symbol to TradingCharts format"""
        return self.symbol_mappings.get(symbol.upper(), symbol.upper())

    def _get_market_category(self, symbol: str) -> str:
        """Get market category for symbol"""
        return self.market_categories.get(symbol.upper(), "unknown")

    def _map_interval(self, interval: str) -> str:
        """Map interval to TradingCharts format"""
        interval_mapping = {
            "1m": "1min",
            "5m": "5min",
            "15m": "15min",
            "30m": "30min",
            "1h": "1hour",
            "4h": "4hour",
            "1d": "daily",
            "1w": "weekly",
            "1M": "monthly",
        }
        return interval_mapping.get(interval, "daily")

    async def _respect_rate_limit(self):
        """Respect API rate limits"""
        current_time = time.time()
        time_since_last = current_time - self.last_request_time

        # Minimum time between requests
        min_interval = 1.0 / self.config.max_requests_per_second

        if time_since_last < min_interval:
            sleep_time = min_interval - time_since_last
            await asyncio.sleep(sleep_time)

        self.last_request_time = time.time()

    def _is_connected(self) -> bool:
        """Check if adapter is connected"""
        return self.status == ConnectionStatus.CONNECTED and self.session is not None

    def _is_cached(self, key: str) -> bool:
        """Check if data is cached and not expired"""
        if (
            key not in self.cache
            and key not in self.futures_cache
            and key not in self.weather_cache
            and key not in self.seasonal_cache
            and key not in self.contract_specs_cache
        ):
            return False

        if key in self.cache_expiry:
            return datetime.now() < self.cache_expiry[key]

        return True

    def _cache_data(self, key: str, data: Any):
        """Cache data with expiration"""
        self.cache[key] = data
        self._set_cache_expiry(key)

    def _set_cache_expiry(self, key: str):
        """Set cache expiration time"""
        self.cache_expiry[key] = datetime.now() + timedelta(
            seconds=self.config.cache_duration
        )


# Logger setup
logger = logging.getLogger(__name__)
