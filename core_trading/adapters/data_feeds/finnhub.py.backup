"""
Finnhub Data Feed Adapter

This module provides a comprehensive adapter for Finnhub data integration,
serving as a reliable data source for real-time stock prices, company fundamentals,
and market news. The adapter implements the BaseDataFeedAdapter interface.

Features:
- Real-time stock prices and quotes
- Company fundamentals and financials
- Market news and sentiment analysis
- Economic indicators and earnings data
- WebSocket streaming for real-time data
- Comprehensive error handling and retry logic
- Rate limiting and request management
- Event-driven data distribution
"""

import asyncio
import json
import logging
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass, field
from datetime import datetime, timedelta, timezone
from decimal import Decimal
from enum import Enum
from typing import Any, Callable, Dict, List, Optional, Union

import aiohttp
import websockets

from ..base import (
    AdapterConfig,
    AdapterType,
    BaseDataFeedAdapter,
    ConnectionStatus,
    HealthCheck,
)

# Finnhub imports (would be installed via pip install finnhub-python)
try:
    import finnhub
    import pandas as pd

    FINNHUB_AVAILABLE = True
except ImportError:
    FINNHUB_AVAILABLE = False
    logging.warning(
        "Finnhub not available. Install with: pip install finnhub-python pandas"
    )


class FinnhubDataType(Enum):
    """Finnhub data types"""

    QUOTE = "quote"
    CANDLES = "candles"
    COMPANY_PROFILE = "company-profile2"
    FINANCIALS = "financials-reported"
    NEWS = "company-news"
    EARNINGS = "earnings"
    RECOMMENDATION = "recommendation"
    PRICE_TARGET = "price-target"
    INSIDER_TRADING = "insider-trading"
    SENTIMENT = "news-sentiment"


class FinnhubResolution(Enum):
    """Finnhub candle resolutions"""

    MIN_1 = "1"
    MIN_5 = "5"
    MIN_15 = "15"
    MIN_30 = "30"
    MIN_60 = "60"
    DAILY = "D"
    WEEKLY = "W"
    MONTHLY = "M"


@dataclass
class FinnhubConfig(AdapterConfig):
    """Finnhub specific configuration"""

    base_url: str = "https://finnhub.io/api/v1"
    websocket_url: str = "wss://ws.finnhub.io"
    timeout: int = 30
    max_requests_per_minute: int = 60  # Free tier limit

    # WebSocket configuration
    enable_websocket: bool = True
    websocket_reconnect_delay: float = 5.0
    websocket_ping_interval: int = 20

    # Data parameters
    include_extended_hours: bool = False

    # Retry and error handling
    max_retries: int = 3
    retry_delay: float = 1.0
    backoff_multiplier: float = 2.0

    # Caching
    enable_caching: bool = True
    cache_duration_minutes: int = 5  # Short cache for real-time data

    # Premium features (if available)
    premium_key: bool = False

    # Required parameters (must come after all default parameters)
    api_key: str = ""

    def __post_init__(self):
        """Validate configuration after initialization"""
        super().__post_init__() if hasattr(super(), '__post_init__') else None
        
        if not self.api_key:
            raise ValueError("Finnhub API key is required")


@dataclass
class FinnhubQuote:
    """Finnhub real-time quote data"""

    symbol: str
    timestamp: datetime
    current_price: Decimal
    change: Decimal
    percent_change: Decimal
    high: Decimal
    low: Decimal
    open: Decimal
    previous_close: Decimal
    volume: Optional[int] = None

    def to_dict(self) -> Dict[str, Any]:
        """Convert to dictionary"""
        return {
            "symbol": self.symbol,
            "timestamp": self.timestamp.isoformat(),
            "current_price": float(self.current_price),
            "change": float(self.change),
            "percent_change": float(self.percent_change),
            "high": float(self.high),
            "low": float(self.low),
            "open": float(self.open),
            "previous_close": float(self.previous_close),
            "volume": self.volume,
        }


@dataclass
class FinnhubCandle:
    """Finnhub candle/bar data"""

    symbol: str
    timestamp: datetime
    open: Decimal
    high: Decimal
    low: Decimal
    close: Decimal
    volume: int
    resolution: str

    def to_dict(self) -> Dict[str, Any]:
        """Convert to dictionary"""
        return {
            "symbol": self.symbol,
            "timestamp": self.timestamp.isoformat(),
            "open": float(self.open),
            "high": float(self.high),
            "low": float(self.low),
            "close": float(self.close),
            "volume": self.volume,
            "resolution": self.resolution,
        }


@dataclass
class FinnhubCompanyProfile:
    """Finnhub company profile data"""

    symbol: str
    timestamp: datetime
    name: str
    country: str
    currency: str
    exchange: str
    ipo: Optional[str] = None
    market_cap: Optional[Decimal] = None
    outstanding_shares: Optional[Decimal] = None
    logo: Optional[str] = None
    phone: Optional[str] = None
    weburl: Optional[str] = None
    industry: Optional[str] = None

    def to_dict(self) -> Dict[str, Any]:
        """Convert to dictionary"""
        return {
            "symbol": self.symbol,
            "timestamp": self.timestamp.isoformat(),
            "name": self.name,
            "country": self.country,
            "currency": self.currency,
            "exchange": self.exchange,
            "ipo": self.ipo,
            "market_cap": float(self.market_cap) if self.market_cap else None,
            "outstanding_shares": float(self.outstanding_shares)
            if self.outstanding_shares
            else None,
            "logo": self.logo,
            "phone": self.phone,
            "weburl": self.weburl,
            "industry": self.industry,
        }


@dataclass
class FinnhubNews:
    """Finnhub news data"""

    symbol: str
    timestamp: datetime
    headline: str
    summary: str
    url: str
    source: str
    sentiment: Optional[str] = None
    sentiment_score: Optional[Decimal] = None

    def to_dict(self) -> Dict[str, Any]:
        """Convert to dictionary"""
        return {
            "symbol": self.symbol,
            "timestamp": self.timestamp.isoformat(),
            "headline": self.headline,
            "summary": self.summary,
            "url": self.url,
            "source": self.source,
            "sentiment": self.sentiment,
            "sentiment_score": float(self.sentiment_score)
            if self.sentiment_score
            else None,
        }


class FinnhubAdapter(BaseDataFeedAdapter):
    """
    Finnhub data feed adapter implementation

    Provides comprehensive integration with Finnhub for real-time stock data,
    company fundamentals, and market news. Supports both REST API and WebSocket
    streaming for real-time updates.
    """

    def __init__(self, config: FinnhubConfig):
        super().__init__(config)

        if not FINNHUB_AVAILABLE:
            raise ImportError(
                "Finnhub not available. Install with: pip install finnhub-python pandas"
            )

        if not config.api_key:
            raise ValueError("Finnhub API key is required")

        self.config = config
        self.logger = logging.getLogger(__name__)

        # Finnhub client
        self.client = finnhub.Client(api_key=config.api_key)

        # Connection management
        self._connection_status = ConnectionStatus.DISCONNECTED

        # Rate limiting
        self._last_request_time = 0.0
        self._request_count = 0
        self._rate_limit_window = 60.0  # 1 minute window

        # Threading and async
        self._executor = ThreadPoolExecutor(max_workers=8)
        self._lock = threading.RLock()

        # Caching
        self._cache: Dict[str, Dict[str, Any]] = {}
        self._cache_timestamps: Dict[str, datetime] = {}

        # WebSocket management
        self._websocket = None
        self._websocket_task = None
        self._subscribed_symbols: set = set()

        # Event callbacks
        self._event_callbacks: Dict[str, List[Callable]] = {
            "quote": [],
            "trade": [],
            "news": [],
            "error": [],
            "connection": [],
        }

        # HTTP session for direct API calls
        self._session = None

    async def connect(self) -> bool:
        """Connect to Finnhub"""
        try:
            self.logger.info("Connecting to Finnhub data feed")

            # Create HTTP session
            self._session = aiohttp.ClientSession(
                timeout=aiohttp.ClientTimeout(total=self.config.timeout)
            )

            # Test connectivity with a simple request
            test_url = (
                f"{self.config.base_url}/quote?symbol=AAPL&token={self.config.api_key}"
            )

            async with self._session.get(test_url) as response:
                if response.status == 200:
                    data = await response.json()

                    # Check for API errors
                    if "error" in data:
                        self.logger.error(f"Finnhub API error: {data['error']}")
                        return False

                    self._connection_status = ConnectionStatus.CONNECTED

                    # Start WebSocket connection if enabled
                    if self.config.enable_websocket:
                        await self._start_websocket()

                    self.logger.info("Successfully connected to Finnhub")
                    return True
                else:
                    self.logger.error(f"HTTP error: {response.status}")
                    return False

        except Exception as e:
            self.logger.error(f"Connection error: {e}")
            self._connection_status = ConnectionStatus.ERROR
            return False

    async def disconnect(self) -> bool:
        """Disconnect from Finnhub"""
        try:
            self.logger.info("Disconnecting from Finnhub")

            # Stop WebSocket
            if self._websocket_task:
                self._websocket_task.cancel()
                try:
                    await self._websocket_task
                except asyncio.CancelledError:
                    logger.debug("Finnhub WebSocket task cancelled during disconnect")

            if self._websocket:
                await self._websocket.close()
                self._websocket = None

            # Close HTTP session
            if self._session:
                await self._session.close()
                self._session = None

            self._connection_status = ConnectionStatus.DISCONNECTED

            # Clear cache and subscriptions
            with self._lock:
                self._cache.clear()
                self._cache_timestamps.clear()
                self._subscribed_symbols.clear()

            self.logger.info("Disconnected from Finnhub")
            return True

        except Exception as e:
            self.logger.error(f"Disconnection error: {e}")
            return False

    async def get_quote(self, symbol: str) -> Optional[FinnhubQuote]:
        """Get real-time quote for a symbol"""
        try:
            if not self.is_connected():
                raise RuntimeError("Not connected to data feed")

            # Check cache first
            cache_key = f"quote_{symbol}"
            cached_data = self._get_cached_data(cache_key)
            if cached_data:
                return cached_data[0] if cached_data else None

            # Rate limiting
            await self._rate_limit()

            # Get quote data
            loop = asyncio.get_event_loop()
            data = await loop.run_in_executor(
                self._executor, lambda: self.client.quote(symbol)
            )

            if not data or "c" not in data:
                return None

            # Convert to quote object
            quote = FinnhubQuote(
                symbol=symbol,
                timestamp=datetime.now(timezone.utc),
                current_price=Decimal(str(data["c"])),  # Current price
                change=Decimal(str(data["d"])),  # Change
                percent_change=Decimal(str(data["dp"])),  # Percent change
                high=Decimal(str(data["h"])),  # High price of the day
                low=Decimal(str(data["l"])),  # Low price of the day
                open=Decimal(str(data["o"])),  # Open price of the day
                previous_close=Decimal(str(data["pc"])),  # Previous close price
            )

            # Cache result
            self._cache_data(cache_key, [quote])

            return quote

        except Exception as e:
            self.logger.error(f"Quote error for {symbol}: {e}")
            return None

    async def get_candles(
        self,
        symbol: str,
        resolution: str = "D",
        from_timestamp: Optional[int] = None,
        to_timestamp: Optional[int] = None,
    ) -> List[FinnhubCandle]:
        """Get historical candle data"""
        try:
            if not self.is_connected():
                raise RuntimeError("Not connected to data feed")

            # Default time range (last 30 days for daily, last day for intraday)
            if not from_timestamp or not to_timestamp:
                now = datetime.now(timezone.utc)
                if resolution == "D":
                    from_dt = now - timedelta(days=30)
                else:
                    from_dt = now - timedelta(days=1)

                from_timestamp = int(from_dt.timestamp())
                to_timestamp = int(now.timestamp())

            # Check cache first
            cache_key = f"candles_{symbol}_{resolution}_{from_timestamp}_{to_timestamp}"
            cached_data = self._get_cached_data(cache_key)
            if cached_data:
                return cached_data

            # Rate limiting
            await self._rate_limit()

            # Get candle data
            loop = asyncio.get_event_loop()
            data = await loop.run_in_executor(
                self._executor,
                lambda: self.client.stock_candles(
                    symbol, resolution, from_timestamp, to_timestamp
                ),
            )

            if not data or data.get("s") != "ok" or not data.get("c"):
                return []

            # Convert to candle objects
            candles = []
            timestamps = data["t"]
            opens = data["o"]
            highs = data["h"]
            lows = data["l"]
            closes = data["c"]
            volumes = data["v"]

            for i in range(len(timestamps)):
                try:
                    candle = FinnhubCandle(
                        symbol=symbol,
                        timestamp=datetime.fromtimestamp(
                            timestamps[i], tz=timezone.utc
                        ),
                        open=Decimal(str(opens[i])),
                        high=Decimal(str(highs[i])),
                        low=Decimal(str(lows[i])),
                        close=Decimal(str(closes[i])),
                        volume=int(volumes[i]),
                        resolution=resolution,
                    )

                    candles.append(candle)

                except (ValueError, TypeError, IndexError) as e:
                    self.logger.warning(f"Invalid candle data for {symbol}: {e}")
                    continue

            # Sort by timestamp
            candles.sort(key=lambda x: x.timestamp)

            # Cache results
            if candles:
                self._cache_data(cache_key, candles)

            self.logger.info(f"Retrieved {len(candles)} candles for {symbol}")
            return candles

        except Exception as e:
            self.logger.error(f"Candles error for {symbol}: {e}")
            return []

    async def get_company_profile(self, symbol: str) -> Optional[FinnhubCompanyProfile]:
        """Get company profile information"""
        try:
            if not self.is_connected():
                raise RuntimeError("Not connected to data feed")

            # Check cache first
            cache_key = f"profile_{symbol}"
            cached_data = self._get_cached_data(cache_key)
            if cached_data:
                return cached_data[0] if cached_data else None

            # Rate limiting
            await self._rate_limit()

            # Get company profile
            loop = asyncio.get_event_loop()
            data = await loop.run_in_executor(
                self._executor, lambda: self.client.company_profile2(symbol=symbol)
            )

            if not data or not data.get("name"):
                return None

            # Convert to profile object
            profile = FinnhubCompanyProfile(
                symbol=symbol,
                timestamp=datetime.now(timezone.utc),
                name=data.get("name", ""),
                country=data.get("country", ""),
                currency=data.get("currency", ""),
                exchange=data.get("exchange", ""),
                ipo=data.get("ipo"),
                market_cap=Decimal(str(data["marketCapitalization"]))
                if data.get("marketCapitalization")
                else None,
                outstanding_shares=Decimal(str(data["shareOutstanding"]))
                if data.get("shareOutstanding")
                else None,
                logo=data.get("logo"),
                phone=data.get("phone"),
                weburl=data.get("weburl"),
                industry=data.get("finnhubIndustry"),
            )

            # Cache result (longer cache for profile data)
            self._cache_data(cache_key, [profile])

            return profile

        except Exception as e:
            self.logger.error(f"Company profile error for {symbol}: {e}")
            return None

    async def get_company_news(
        self,
        symbol: str,
        from_date: Optional[str] = None,
        to_date: Optional[str] = None,
    ) -> List[FinnhubNews]:
        """Get company news"""
        try:
            if not self.is_connected():
                raise RuntimeError("Not connected to data feed")

            # Default date range (last 7 days)
            if not from_date or not to_date:
                now = datetime.now(timezone.utc)
                to_date = now.strftime("%Y-%m-%d")
                from_date = (now - timedelta(days=7)).strftime("%Y-%m-%d")

            # Rate limiting
            await self._rate_limit()

            # Get news data
            loop = asyncio.get_event_loop()
            data = await loop.run_in_executor(
                self._executor,
                lambda: self.client.company_news(symbol, _from=from_date, to=to_date),
            )

            if not data:
                return []

            # Convert to news objects
            news_items = []
            for item in data:
                try:
                    news = FinnhubNews(
                        symbol=symbol,
                        timestamp=datetime.fromtimestamp(
                            item["datetime"], tz=timezone.utc
                        ),
                        headline=item.get("headline", ""),
                        summary=item.get("summary", ""),
                        url=item.get("url", ""),
                        source=item.get("source", ""),
                        sentiment=item.get("sentiment"),
                        sentiment_score=Decimal(str(item["sentiment"]))
                        if item.get("sentiment")
                        and isinstance(item["sentiment"], (int, float))
                        else None,
                    )

                    news_items.append(news)

                except (ValueError, TypeError, KeyError) as e:
                    self.logger.warning(f"Invalid news data for {symbol}: {e}")
                    continue

            # Sort by timestamp (newest first)
            news_items.sort(key=lambda x: x.timestamp, reverse=True)

            self.logger.info(f"Retrieved {len(news_items)} news items for {symbol}")
            return news_items

        except Exception as e:
            self.logger.error(f"Company news error for {symbol}: {e}")
            return []

    async def subscribe_to_symbol(self, symbol: str):
        """Subscribe to real-time updates for a symbol"""
        try:
            if not self.config.enable_websocket or not self._websocket:
                self.logger.warning("WebSocket not available for subscriptions")
                return

            if symbol in self._subscribed_symbols:
                return

            # Send subscription message
            subscribe_msg = {"type": "subscribe", "symbol": symbol}

            await self._websocket.send(json.dumps(subscribe_msg))
            self._subscribed_symbols.add(symbol)

            self.logger.info(f"Subscribed to real-time updates for {symbol}")

        except Exception as e:
            self.logger.error(f"Subscription error for {symbol}: {e}")

    async def unsubscribe_from_symbol(self, symbol: str):
        """Unsubscribe from real-time updates for a symbol"""
        try:
            if not self.config.enable_websocket or not self._websocket:
                return

            if symbol not in self._subscribed_symbols:
                return

            # Send unsubscription message
            unsubscribe_msg = {"type": "unsubscribe", "symbol": symbol}

            await self._websocket.send(json.dumps(unsubscribe_msg))
            self._subscribed_symbols.discard(symbol)

            self.logger.info(f"Unsubscribed from real-time updates for {symbol}")

        except Exception as e:
            self.logger.error(f"Unsubscription error for {symbol}: {e}")

    def is_connected(self) -> bool:
        """Check if connected to data feed"""
        return self._connection_status == ConnectionStatus.CONNECTED

    async def get_health_check(self) -> HealthCheck:
        """Get adapter health status"""
        try:
            is_healthy = self.is_connected()

            # Test with a simple request
            if is_healthy and self._session:
                try:
                    test_url = f"{self.config.base_url}/quote?symbol=AAPL&token={self.config.api_key}"
                    async with self._session.get(test_url) as response:
                        is_healthy = response.status == 200
                except:
                    is_healthy = False

            metrics = {
                "connection_status": self._connection_status.value,
                "websocket_connected": self._websocket is not None,
                "subscribed_symbols": len(self._subscribed_symbols),
                "cache_size": len(self._cache),
                "request_count": self._request_count,
                "premium_key": self.config.premium_key,
            }

            return HealthCheck(
                adapter_type=AdapterType.DATA_FEED,
                adapter_name="Finnhub",
                is_healthy=is_healthy,
                status_message="Connected and operational"
                if is_healthy
                else "Disconnected or error",
                last_check=datetime.now(timezone.utc),
                metrics=metrics,
            )

        except Exception as e:
            return HealthCheck(
                adapter_type=AdapterType.DATA_FEED,
                adapter_name="Finnhub",
                is_healthy=False,
                status_message=f"Health check error: {e}",
                last_check=datetime.now(timezone.utc),
                metrics={},
            )

    async def _start_websocket(self):
        """Start WebSocket connection for real-time data"""
        try:
            websocket_url = f"{self.config.websocket_url}?token={self.config.api_key}"

            self._websocket = await websockets.connect(
                websocket_url, ping_interval=self.config.websocket_ping_interval
            )

            # Start WebSocket message handler
            self._websocket_task = asyncio.create_task(
                self._handle_websocket_messages()
            )

            self.logger.info("WebSocket connection established")

        except Exception as e:
            self.logger.error(f"WebSocket connection error: {e}")
            self._websocket = None

    async def _handle_websocket_messages(self):
        """Handle incoming WebSocket messages"""
        try:
            while self._websocket:
                try:
                    message = await self._websocket.recv()
                    data = json.loads(message)

                    # Handle different message types
                    if data.get("type") == "trade":
                        await self._handle_trade_message(data)
                    elif data.get("type") == "ping":
                        # Respond to ping
                        pong_msg = {"type": "pong"}
                        await self._websocket.send(json.dumps(pong_msg))

                except websockets.exceptions.ConnectionClosed:
                    self.logger.warning("WebSocket connection closed")
                    break
                except json.JSONDecodeError as e:
                    self.logger.warning(f"Invalid JSON in WebSocket message: {e}")
                    continue
                except Exception as e:
                    self.logger.error(f"WebSocket message handling error: {e}")
                    continue

        except Exception as e:
            self.logger.error(f"WebSocket handler error: {e}")
        finally:
            # Attempt reconnection
            if self._connection_status == ConnectionStatus.CONNECTED:
                await asyncio.sleep(self.config.websocket_reconnect_delay)
                await self._start_websocket()

    async def _handle_trade_message(self, data: Dict[str, Any]):
        """Handle trade message from WebSocket"""
        try:
            if "data" not in data:
                return

            for trade_data in data["data"]:
                symbol = trade_data.get("s")
                price = trade_data.get("p")
                volume = trade_data.get("v")
                timestamp = trade_data.get("t")

                if symbol and price:
                    # Create trade event
                    trade_event = {
                        "symbol": symbol,
                        "price": float(price),
                        "volume": volume,
                        "timestamp": datetime.fromtimestamp(
                            timestamp / 1000, tz=timezone.utc
                        )
                        if timestamp
                        else datetime.now(timezone.utc),
                    }

                    # Notify callbacks
                    for callback in self._event_callbacks.get("trade", []):
                        try:
                            await callback(trade_event)
                        except Exception as e:
                            self.logger.warning(f"Trade callback error: {e}")

        except Exception as e:
            self.logger.error(f"Trade message handling error: {e}")

    async def _rate_limit(self):
        """Apply rate limiting"""
        try:
            current_time = time.time()

            # Finnhub free tier: 60 requests per minute
            # Premium: 300+ requests per minute
            max_requests = 300 if self.config.premium_key else 60

            # Reset counter if window expired
            if current_time - self._last_request_time > self._rate_limit_window:
                self._request_count = 0

            # Check if we need to wait
            if self._request_count >= max_requests:
                wait_time = self._rate_limit_window - (
                    current_time - self._last_request_time
                )
                if wait_time > 0:
                    self.logger.info(
                        f"Rate limit reached, waiting {wait_time:.1f} seconds"
                    )
                    await asyncio.sleep(wait_time)
                    self._request_count = 0

            # Update counters
            self._request_count += 1
            self._last_request_time = current_time

        except Exception as e:
            self.logger.warning(f"Rate limiting error: {e}")

    def _get_cached_data(self, cache_key: str) -> Optional[List]:
        """Get data from cache if valid"""
        try:
            if not self.config.enable_caching:
                return None

            with self._lock:
                if cache_key in self._cache and cache_key in self._cache_timestamps:
                    cache_time = self._cache_timestamps[cache_key]
                    if datetime.now(timezone.utc) - cache_time < timedelta(
                        minutes=self.config.cache_duration_minutes
                    ):
                        return self._cache[cache_key]

            return None

        except Exception:
            return None

    def _cache_data(self, cache_key: str, data: List):
        """Cache data with timestamp"""
        try:
            if not self.config.enable_caching:
                return

            with self._lock:
                self._cache[cache_key] = data
                self._cache_timestamps[cache_key] = datetime.now(timezone.utc)

                # Cleanup old cache entries (keep last 100)
                if len(self._cache) > 100:
                    oldest_key = min(
                        self._cache_timestamps.keys(),
                        key=lambda k: self._cache_timestamps[k],
                    )
                    del self._cache[oldest_key]
                    del self._cache_timestamps[oldest_key]

        except Exception as e:
            self.logger.warning(f"Cache error: {e}")

    def add_event_callback(self, event_type: str, callback: Callable):
        """Add event callback"""
        if event_type in self._event_callbacks:
            self._event_callbacks[event_type].append(callback)

    def remove_event_callback(self, event_type: str, callback: Callable):
        """Remove event callback"""
        if (
            event_type in self._event_callbacks
            and callback in self._event_callbacks[event_type]
        ):
            self._event_callbacks[event_type].remove(callback)
