"""Barchart Data Feed Adapter

This module provides a comprehensive adapter for Barchart OnDemand API integration,
serving as a professional data source for stocks, futures, options, forex, and
commodities. The adapter implements the BaseDataFeedAdapter interface and provides
functionality for real-time and historical market data with a focus on agricultural
and commodity markets.

Features:
- Comprehensive commodity and futures coverage
- Real-time and historical market data
- Options chains and derivatives data
- Agricultural market specialization
- Weather data integration
- Market news and analysis
- Technical indicators and studies
- Professional-grade data quality
- Comprehensive error handling and retry logic
- Rate limiting and request management
- Event-driven data distribution
"""

import asyncio
import json
import logging
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass, field
from datetime import datetime, timedelta, timezone
from decimal import Decimal
from enum import Enum
from typing import Any, AsyncGenerator, Callable, Dict, List, Optional, Union
from urllib.parse import urlencode, urljoin

import aiohttp

from ..base import (
    AdapterConfig,
    AdapterType,
    BaseDataFeedAdapter,
    ConnectionStatus,
    HealthCheck,
)

# Barchart imports (would be installed via pip install pandas requests)
try:
    import pandas as pd
    import requests

    BARCHART_AVAILABLE = True
except ImportError:
    BARCHART_AVAILABLE = False
    logging.warning(
        "Barchart dependencies not available. Install with: pip install pandas requests"
    )


class BarchartInterval(Enum):
    """Barchart supported intervals"""

    TICK = "tick"
    MIN_1 = "1m"
    MIN_5 = "5m"
    MIN_15 = "15m"
    MIN_30 = "30m"
    HOUR_1 = "1h"
    HOUR_2 = "2h"
    HOUR_4 = "4h"
    DAY_1 = "1d"
    WEEK_1 = "1w"
    MONTH_1 = "1M"
    QUARTER_1 = "1Q"
    YEAR_1 = "1Y"


class BarchartAssetType(Enum):
    """Barchart asset types"""

    STOCK = "stock"
    ETF = "etf"
    INDEX = "index"
    FUTURE = "future"
    OPTION = "option"
    FOREX = "forex"
    COMMODITY = "commodity"
    CRYPTOCURRENCY = "crypto"
    BOND = "bond"
    MUTUAL_FUND = "mutual_fund"


class BarchartExchange(Enum):
    """Barchart supported exchanges"""

    CME = "CME"
    CBOT = "CBOT"
    NYMEX = "NYMEX"
    COMEX = "COMEX"
    ICE = "ICE"
    NYSE = "NYSE"
    NASDAQ = "NASDAQ"
    CBOE = "CBOE"


@dataclass
class BarchartConfig(AdapterConfig):
    """Barchart specific configuration"""

    api_key: str = ""  # Required for production use
    base_url: str = "https://ondemand.websol.barchart.com"
    timeout: int = 30
    max_requests_per_minute: int = 400  # Free tier: 400/day, paid tiers higher
    retry_attempts: int = 3
    retry_delay: float = 1.5
    cache_duration: int = 300  # 5 minutes cache

    # API settings
    format_type: str = "json"

    # Specialization settings
    focus_commodities: bool = True
    include_weather_data: bool = True
    include_news: bool = True

    # Supported asset classes with focus on commodities
    supported_asset_classes: List[str] = field(
        default_factory=lambda: [
            "grains",
            "livestock",
            "softs",
            "energy",
            "metals",
            "currencies",
            "indices",
            "stocks",
        ]
    )

    # Popular commodity symbols
    popular_commodities: Dict[str, str] = field(
        default_factory=lambda: {
            # Grains
            "ZC*0": "Corn Futures",
            "ZS*0": "Soybean Futures",
            "ZW*0": "Wheat Futures",
            "ZM*0": "Soybean Meal Futures",
            "ZL*0": "Soybean Oil Futures",
            "ZO*0": "Oat Futures",
            "ZR*0": "Rice Futures",
            # Livestock
            "LE*0": "Live Cattle Futures",
            "GF*0": "Feeder Cattle Futures",
            "HE*0": "Lean Hog Futures",
            # Softs
            "CC*0": "Cocoa Futures",
            "CT*0": "Cotton Futures",
            "KC*0": "Coffee Futures",
            "SB*0": "Sugar Futures",
            "OJ*0": "Orange Juice Futures",
            # Energy
            "CL*0": "Crude Oil Futures",
            "NG*0": "Natural Gas Futures",
            "RB*0": "RBOB Gasoline Futures",
            "HO*0": "Heating Oil Futures",
            # Metals
            "GC*0": "Gold Futures",
            "SI*0": "Silver Futures",
            "HG*0": "Copper Futures",
            "PA*0": "Palladium Futures",
            "PL*0": "Platinum Futures",
        }
    )

    # Weather stations for agricultural data
    weather_stations: List[str] = field(
        default_factory=lambda: ["KORD", "KMDW", "KDSM", "KOMN", "KILX", "KDVN", "KDBQ"]
    )


class BarchartAdapter(BaseDataFeedAdapter):
    """
    Barchart OnDemand data feed adapter implementation

    Provides comprehensive integration with Barchart OnDemand API for commodity
    and futures market data. Specializes in agricultural markets with weather
    data integration and comprehensive commodity coverage.
    """

    def __init__(self, config: BarchartConfig):
        super().__init__(config)
        self.config = config
        self.session: Optional[aiohttp.ClientSession] = None
        self.rate_limiter = asyncio.Semaphore(config.max_requests_per_minute)
        self.cache: Dict[str, Any] = {}
        self.last_request_time = 0.0

        # Request headers
        self.headers = {
            "User-Agent": "Barchart-Python-Client/1.0",
            "Accept": "application/json",
            "Content-Type": "application/json",
        }

        # Initialize caches
        self.symbol_info_cache: Dict[str, Dict] = {}
        self.weather_cache: Dict[str, Dict] = {}
        self.news_cache: Dict[str, List] = {}
        self.cache_expiry: Dict[str, datetime] = {}

        # Daily request counter for free tier management
        self.daily_requests = 0
        self.request_date = datetime.now().date()

        logger.info(f"Initialized Barchart adapter with config: {config.name}")

    async def connect(self) -> bool:
        """Establish connection to Barchart OnDemand API"""
        try:
            if not BARCHART_AVAILABLE:
                logger.error("Barchart dependencies not available")
                self.status = ConnectionStatus.FAILED
                return False

            # Create HTTP session
            connector = aiohttp.TCPConnector(
                limit=30, limit_per_host=15, ttl_dns_cache=300, use_dns_cache=True
            )

            timeout = aiohttp.ClientTimeout(total=self.config.timeout)
            self.session = aiohttp.ClientSession(
                connector=connector, timeout=timeout, headers=self.headers
            )

            # Test API connection with a simple quote request
            test_params = {
                "apikey": self.config.api_key,
                "symbols": "ZC*0",  # Corn futures
                "fields": "symbol,lastPrice",
            }

            test_url = f"{self.config.base_url}/getQuote.json"

            async with self.rate_limiter:
                async with self.session.get(test_url, params=test_params) as response:
                    if response.status == 200:
                        data = await response.json()
                        if "results" in data and data["results"]:
                            self.status = ConnectionStatus.CONNECTED
                            logger.info(
                                "Successfully connected to Barchart OnDemand API"
                            )

                            # Initialize commodity specifications
                            await self._initialize_commodity_specs()

                            return True
                        else:
                            logger.error(f"Invalid API response: {data}")
                            self.status = ConnectionStatus.FAILED
                            return False
                    elif response.status == 401:
                        logger.error("Invalid API key for Barchart OnDemand")
                        self.status = ConnectionStatus.FAILED
                        return False
                    else:
                        logger.error(
                            f"Failed to connect to Barchart: HTTP {response.status}"
                        )
                        self.status = ConnectionStatus.FAILED
                        return False

        except Exception as e:
            logger.error(f"Error connecting to Barchart: {e}")
            self.status = ConnectionStatus.FAILED
            return False

    async def disconnect(self) -> bool:
        """Disconnect from Barchart OnDemand API"""
        try:
            if self.session:
                await self.session.close()
                self.session = None

            self.status = ConnectionStatus.DISCONNECTED
            logger.info("Disconnected from Barchart OnDemand API")
            return True

        except Exception as e:
            logger.error(f"Error disconnecting from Barchart: {e}")
            return False

    async def get_historical_data(
        self,
        symbol: str,
        start_date: datetime,
        end_date: datetime,
        interval: str = "1d",
        **kwargs,
    ) -> Optional[pd.DataFrame]:
        """Get historical market data from Barchart"""
        try:
            if not self._is_connected():
                await self.connect()

            # Check daily request limit
            if not self._check_request_limit():
                logger.warning("Daily request limit reached for Barchart")
                return None

            # Validate interval
            if interval not in [e.value for e in BarchartInterval]:
                logger.warning(f"Invalid interval {interval}, using 1d")
                interval = "1d"

            # Prepare API parameters
            params = {
                "apikey": self.config.api_key,
                "symbol": symbol,
                "type": interval,
                "startDate": start_date.strftime("%Y%m%d"),
                "endDate": end_date.strftime("%Y%m%d"),
                "format": self.config.format_type,
            }

            # Add optional parameters
            if "maxRecords" in kwargs:
                params["maxRecords"] = kwargs["maxRecords"]

            # Make API request
            url = f"{self.config.base_url}/getHistory.json"

            async with self.rate_limiter:
                await self._respect_rate_limit()

                async with self.session.get(url, params=params) as response:
                    if response.status == 200:
                        data = await response.json()

                        if "results" in data and data["results"]:
                            # Convert to DataFrame
                            df = pd.DataFrame(data["results"])

                            if not df.empty:
                                # Process and standardize data
                                df = self._process_historical_data(df, symbol)

                                # Add metadata
                                df.attrs = {
                                    "symbol": symbol,
                                    "source": "barchart",
                                    "interval": interval,
                                    "start_date": start_date,
                                    "end_date": end_date,
                                    "asset_type": self._determine_asset_type(symbol),
                                }

                                self._increment_request_count()
                                logger.info(
                                    f"Retrieved {len(df)} historical data points for {symbol}"
                                )
                                return df

                        elif "status" in data and data["status"]["code"] != 200:
                            logger.error(
                                f"API error for {symbol}: {data['status']['message']}"
                            )

                        return None

                    else:
                        logger.error(f"HTTP error {response.status} for {symbol}")
                        return None

        except Exception as e:
            logger.error(f"Error getting historical data for {symbol}: {e}")
            return None

    async def get_quote(self, symbol: str) -> Optional[Dict[str, Any]]:
        """Get real-time quote from Barchart (BaseDataFeedAdapter abstract method)"""
        try:
            if not self._is_connected():
                await self.connect()

            # Check daily request limit
            if not self._check_request_limit():
                logger.warning("Daily request limit reached for Barchart")
                return None

            # Check cache first
            cache_key = f"quote_{symbol}"
            if self._is_cached(cache_key):
                return self.cache[cache_key]

            # Prepare API parameters
            params = {
                "apikey": self.config.api_key,
                "symbols": symbol,
                "fields": "symbol,lastPrice,netChange,percentChange,high,low,open,volume,tradeTimestamp,openInterest",
            }

            # Make API request
            url = f"{self.config.base_url}/getQuote.json"

            async with self.rate_limiter:
                await self._respect_rate_limit()

                async with self.session.get(url, params=params) as response:
                    if response.status == 200:
                        data = await response.json()

                        if "results" in data and data["results"]:
                            # Process quote data
                            quote_data = self._process_quote_data(
                                symbol, data["results"][0]
                            )

                            # Cache the result
                            self._cache_data(cache_key, quote_data)

                            self._increment_request_count()
                            logger.debug(
                                f"Retrieved quote for {symbol}: {quote_data.get('last_price')}"
                            )
                            return quote_data

                        elif "status" in data and data["status"]["code"] != 200:
                            logger.error(
                                f"API error for {symbol}: {data['status']['message']}"
                            )

                        return None

                    else:
                        logger.error(f"HTTP error {response.status} for {symbol}")
                        return None

        except Exception as e:
            logger.error(f"Error getting Barchart quote for {symbol}: {e}")
            return None

    async def get_real_time_quote(self, symbol: str) -> Optional[Dict[str, Any]]:
        """Get real-time quote from Barchart (legacy method)"""
        quote_data = await self.get_quote(symbol)
        return quote_data if quote_data else None

    async def subscribe_real_time(
        self, symbols: List[str]
    ) -> AsyncGenerator[Dict[str, Any], None]:
        """Subscribe to real-time market data (BaseDataFeedAdapter abstract method)"""
        try:
            if not symbols:
                return

            logger.info(
                f"Starting Barchart real-time subscription for {len(symbols)} symbols"
            )

            while True:
                for symbol in symbols:
                    try:
                        quote_data = await self.get_quote(symbol)
                        if quote_data:
                            yield {
                                "symbol": symbol,
                                "data": quote_data,
                                "timestamp": datetime.now(timezone.utc),
                                "source": "barchart",
                            }
                    except Exception as e:
                        logger.error(f"Error getting real-time data for {symbol}: {e}")
                        continue

                # Wait before next polling cycle (respect rate limits)
                await asyncio.sleep(3.0)  # 3 seconds between polls

        except Exception as e:
            logger.error(f"Error in Barchart real-time subscription: {e}")
            return

    async def search_symbols(self, query: str, limit: int = 20) -> List[Dict[str, Any]]:
        """Search for symbols (BaseDataFeedAdapter abstract method)"""
        try:
            results = []
            query_lower = query.lower()

            # Search in popular commodities
            for symbol, description in self.config.popular_commodities.items():
                if query_lower in symbol.lower() or query_lower in description.lower():
                    results.append(
                        {
                            "symbol": symbol,
                            "name": description,
                            "exchange": self._determine_exchange(symbol),
                            "asset_type": self._determine_asset_type(symbol),
                            "source": "barchart",
                        }
                    )

            # If no results found, provide some common commodity symbols
            if not results:
                common_symbols = [
                    ("ZC*0", "Corn Futures"),
                    ("ZS*0", "Soybean Futures"),
                    ("ZW*0", "Wheat Futures"),
                    ("CL*0", "Crude Oil Futures"),
                    ("NG*0", "Natural Gas Futures"),
                    ("GC*0", "Gold Futures"),
                    ("SI*0", "Silver Futures"),
                    ("LE*0", "Live Cattle Futures"),
                    ("HE*0", "Lean Hog Futures"),
                    ("CC*0", "Cocoa Futures"),
                ]

                for symbol, name in common_symbols:
                    if query_lower in symbol.lower() or query_lower in name.lower():
                        results.append(
                            {
                                "symbol": symbol,
                                "name": name,
                                "exchange": self._determine_exchange(symbol),
                                "asset_type": self._determine_asset_type(symbol),
                                "source": "barchart",
                            }
                        )

            return results[:limit]

        except Exception as e:
            logger.error(f"Error searching Barchart symbols: {e}")
            return []

    async def get_options_chain(
        self, underlying_symbol: str, **kwargs
    ) -> Optional[pd.DataFrame]:
        """Get options chain data from Barchart"""
        try:
            if not self._is_connected():
                await self.connect()

            # Check daily request limit
            if not self._check_request_limit():
                logger.warning("Daily request limit reached for Barchart")
                return None

            # Prepare API parameters
            params = {
                "apikey": self.config.api_key,
                "root": underlying_symbol,
                "fields": "symbol,strike,expirationDate,daysToExpiration,bidPrice,askPrice,lastPrice,volume,openInterest,impliedVolatility",
            }

            # Add optional filters
            if "expiration" in kwargs:
                params["expiration"] = kwargs["expiration"]
            if "moneyness" in kwargs:
                params["moneyness"] = kwargs["moneyness"]

            # Make API request
            url = f"{self.config.base_url}/getOptions.json"

            async with self.rate_limiter:
                await self._respect_rate_limit()

                async with self.session.get(url, params=params) as response:
                    if response.status == 200:
                        data = await response.json()

                        if "results" in data and data["results"]:
                            # Convert to DataFrame
                            df = pd.DataFrame(data["results"])

                            if not df.empty:
                                # Process options data
                                df = self._process_options_data(df, underlying_symbol)

                                self._increment_request_count()
                                logger.info(
                                    f"Retrieved options chain for {underlying_symbol}: {len(df)} contracts"
                                )
                                return df

                        return None

                    else:
                        logger.error(
                            f"HTTP error {response.status} for options chain {underlying_symbol}"
                        )
                        return None

        except Exception as e:
            logger.error(f"Error getting options chain for {underlying_symbol}: {e}")
            return None

    async def get_weather_data(
        self, station_id: str, **kwargs
    ) -> Optional[Dict[str, Any]]:
        """Get weather data from Barchart (agricultural focus)"""
        try:
            if not self._is_connected():
                await self.connect()

            if not self.config.include_weather_data:
                logger.info("Weather data disabled in configuration")
                return None

            # Check cache first
            cache_key = f"weather_{station_id}"
            if self._is_cached(cache_key):
                return self.cache[cache_key]

            # Prepare API parameters
            params = {
                "apikey": self.config.api_key,
                "stations": station_id,
                "fields": "stationId,temperature,humidity,windSpeed,windDirection,precipitation,pressure",
            }

            # Make API request
            url = f"{self.config.base_url}/getWeather.json"

            async with self.rate_limiter:
                await self._respect_rate_limit()

                async with self.session.get(url, params=params) as response:
                    if response.status == 200:
                        data = await response.json()

                        if "results" in data and data["results"]:
                            weather_data = self._process_weather_data(
                                station_id, data["results"][0]
                            )

                            # Cache the result
                            self._cache_data(cache_key, weather_data)

                            self._increment_request_count()
                            logger.debug(
                                f"Retrieved weather data for station {station_id}"
                            )
                            return weather_data

                        return None

                    else:
                        logger.error(
                            f"HTTP error {response.status} for weather station {station_id}"
                        )
                        return None

        except Exception as e:
            logger.error(f"Error getting weather data for {station_id}: {e}")
            return None

    async def get_market_news(
        self, symbols: Optional[List[str]] = None, **kwargs
    ) -> List[Dict[str, Any]]:
        """Get market news from Barchart"""
        try:
            if not self._is_connected():
                await self.connect()

            if not self.config.include_news:
                logger.info("News data disabled in configuration")
                return []

            # Check cache first
            cache_key = f"news_{','.join(symbols) if symbols else 'general'}"
            if self._is_cached(cache_key):
                return self.cache[cache_key]

            # Prepare API parameters
            params = {
                "apikey": self.config.api_key,
                "sources": "barchart",
                "maxRecords": kwargs.get("max_records", 20),
            }

            if symbols:
                params["symbols"] = ",".join(symbols)

            # Make API request
            url = f"{self.config.base_url}/getNews.json"

            async with self.rate_limiter:
                await self._respect_rate_limit()

                async with self.session.get(url, params=params) as response:
                    if response.status == 200:
                        data = await response.json()

                        if "results" in data and data["results"]:
                            news_data = self._process_news_data(data["results"])

                            # Cache the result
                            self._cache_data(cache_key, news_data)

                            self._increment_request_count()
                            logger.info(f"Retrieved {len(news_data)} news articles")
                            return news_data

                        return []

                    else:
                        logger.error(f"HTTP error {response.status} for news request")
                        return []

        except Exception as e:
            logger.error(f"Error getting market news: {e}")
            return []

    async def subscribe_to_stream(self, symbols: List[str], callback: Callable) -> bool:
        """Subscribe to real-time data stream (polling-based)"""
        try:
            if not symbols:
                return False

            logger.info(
                f"Starting polling-based stream for {len(symbols)} Barchart symbols"
            )

            # Start polling task
            self.streaming_task = asyncio.create_task(
                self._polling_stream(symbols, callback)
            )

            self.is_streaming = True
            return True

        except Exception as e:
            logger.error(f"Error subscribing to Barchart stream: {e}")
            return False

    async def unsubscribe_from_stream(self) -> bool:
        """Unsubscribe from real-time data stream"""
        try:
            if hasattr(self, "streaming_task") and self.streaming_task:
                self.streaming_task.cancel()
                try:
                    await self.streaming_task
                except asyncio.CancelledError:
                    logger.debug("Barchart streaming task cancelled during unsubscribe")

            self.is_streaming = False
            logger.info("Unsubscribed from Barchart stream")
            return True

        except Exception as e:
            logger.error(f"Error unsubscribing from Barchart stream: {e}")
            return False

    async def health_check(self) -> HealthCheck:
        """Perform health check"""
        start_time = time.time()

        try:
            if not self._is_connected():
                return HealthCheck(
                    is_healthy=False,
                    status="disconnected",
                    latency_ms=0,
                    error_message="Not connected to Barchart OnDemand API",
                )

            # Test with a simple quote request
            params = {
                "apikey": self.config.api_key,
                "symbols": "ZC*0",
                "fields": "symbol,lastPrice",
            }

            url = f"{self.config.base_url}/getQuote.json"

            async with self.session.get(url, params=params) as response:
                latency = (time.time() - start_time) * 1000

                if response.status == 200:
                    data = await response.json()
                    if "results" in data and data["results"]:
                        return HealthCheck(
                            is_healthy=True,
                            status="connected",
                            latency_ms=latency,
                            additional_info={
                                "cache_size": len(self.cache),
                                "daily_requests": self.daily_requests,
                                "focus_commodities": self.config.focus_commodities,
                                "weather_enabled": self.config.include_weather_data,
                                "news_enabled": self.config.include_news,
                            },
                        )
                    else:
                        return HealthCheck(
                            is_healthy=False,
                            status="error",
                            latency_ms=latency,
                            error_message="Invalid API response format",
                        )
                else:
                    return HealthCheck(
                        is_healthy=False,
                        status="error",
                        latency_ms=latency,
                        error_message=f"HTTP {response.status}",
                    )

        except Exception as e:
            latency = (time.time() - start_time) * 1000
            return HealthCheck(
                is_healthy=False,
                status="error",
                latency_ms=latency,
                error_message=str(e),
            )

    # Private helper methods

    async def _initialize_commodity_specs(self):
        """Initialize commodity specifications cache"""
        try:
            # Cache popular commodity specifications
            for symbol, description in self.config.popular_commodities.items():
                try:
                    spec = await self._fetch_symbol_info(symbol)
                    if spec:
                        self.symbol_info_cache[symbol] = spec
                except Exception as e:
                    logger.warning(f"Error caching spec for {symbol}: {e}")
                    continue

            logger.info(
                f"Cached {len(self.symbol_info_cache)} commodity specifications"
            )

        except Exception as e:
            logger.warning(f"Error initializing commodity specs: {e}")

    async def _fetch_symbol_info(self, symbol: str) -> Optional[Dict]:
        """Fetch symbol information from Barchart"""
        try:
            # Mock symbol information for now
            # In production, this would make API calls to get contract specifications
            info = {
                "symbol": symbol,
                "description": self.config.popular_commodities.get(
                    symbol, f"Contract {symbol}"
                ),
                "exchange": self._determine_exchange(symbol),
                "asset_type": self._determine_asset_type(symbol),
                "contract_size": self._get_contract_size(symbol),
                "tick_size": self._get_tick_size(symbol),
                "currency": "USD",
                "trading_hours": self._get_trading_hours(symbol),
            }

            return info

        except Exception as e:
            logger.error(f"Error fetching symbol info for {symbol}: {e}")
            return None

    def _process_historical_data(self, df: pd.DataFrame, symbol: str) -> pd.DataFrame:
        """Process and standardize historical data"""
        try:
            # Convert timestamp column
            if "timestamp" in df.columns:
                df["timestamp"] = pd.to_datetime(df["timestamp"])
                df.set_index("timestamp", inplace=True)
            elif "tradingDay" in df.columns:
                df["tradingDay"] = pd.to_datetime(df["tradingDay"])
                df.set_index("tradingDay", inplace=True)

            # Standardize column names
            column_map = {
                "openPrice": "open",
                "highPrice": "high",
                "lowPrice": "low",
                "closePrice": "close",
                "lastPrice": "close",
                "volume": "volume",
                "openInterest": "open_interest",
            }

            df = df.rename(columns=column_map)

            # Convert numeric columns
            numeric_columns = ["open", "high", "low", "close", "volume"]
            for col in numeric_columns:
                if col in df.columns:
                    df[col] = pd.to_numeric(df[col], errors="coerce")

            # Sort by timestamp
            df.sort_index(inplace=True)

            return df

        except Exception as e:
            logger.error(f"Error processing historical data for {symbol}: {e}")
            return df

    def _process_quote_data(self, symbol: str, data: Dict) -> Dict[str, Any]:
        """Process and standardize quote data"""
        try:
            current_time = datetime.now(timezone.utc)

            # Extract price information
            last_price = float(data.get("lastPrice", 0))

            quote_data = {
                "symbol": symbol,
                "last_price": last_price,
                "price": last_price,
                "open": float(data.get("open", last_price)),
                "high": float(data.get("high", last_price)),
                "low": float(data.get("low", last_price)),
                "close": last_price,
                "volume": int(data.get("volume", 0)),
                "open_interest": int(data.get("openInterest", 0)),
                "net_change": float(data.get("netChange", 0)),
                "percent_change": float(data.get("percentChange", 0)),
                "timestamp": current_time,
                "source": "barchart",
                "exchange": self._determine_exchange(symbol),
                "asset_type": self._determine_asset_type(symbol),
            }

            # Add trade timestamp if available
            if "tradeTimestamp" in data:
                try:
                    quote_data["trade_timestamp"] = pd.to_datetime(
                        data["tradeTimestamp"]
                    )
                except Exception as e:
                    logger.debug(f"Failed to parse trade timestamp: {e}")

            return quote_data

        except Exception as e:
            logger.error(f"Error processing quote data for {symbol}: {e}")
            return {}

    def _process_options_data(
        self, df: pd.DataFrame, underlying_symbol: str
    ) -> pd.DataFrame:
        """Process and standardize options data"""
        try:
            # Convert numeric columns
            numeric_columns = [
                "strike",
                "bidPrice",
                "askPrice",
                "lastPrice",
                "volume",
                "openInterest",
                "impliedVolatility",
            ]
            for col in numeric_columns:
                if col in df.columns:
                    df[col] = pd.to_numeric(df[col], errors="coerce")

            # Convert expiration date
            if "expirationDate" in df.columns:
                df["expirationDate"] = pd.to_datetime(df["expirationDate"])

            # Add option type (call/put) based on symbol
            if "symbol" in df.columns:
                df["option_type"] = df["symbol"].apply(self._determine_option_type)

            # Add underlying symbol
            df["underlying_symbol"] = underlying_symbol

            return df

        except Exception as e:
            logger.error(f"Error processing options data for {underlying_symbol}: {e}")
            return df

    def _process_weather_data(self, station_id: str, data: Dict) -> Dict[str, Any]:
        """Process and standardize weather data"""
        try:
            current_time = datetime.now(timezone.utc)

            weather_data = {
                "station_id": station_id,
                "temperature": float(data.get("temperature", 0)),
                "humidity": float(data.get("humidity", 0)),
                "wind_speed": float(data.get("windSpeed", 0)),
                "wind_direction": float(data.get("windDirection", 0)),
                "precipitation": float(data.get("precipitation", 0)),
                "pressure": float(data.get("pressure", 0)),
                "timestamp": current_time,
                "source": "barchart",
            }

            return weather_data

        except Exception as e:
            logger.error(f"Error processing weather data for {station_id}: {e}")
            return {}

    def _process_news_data(self, news_list: List[Dict]) -> List[Dict[str, Any]]:
        """Process and standardize news data"""
        try:
            processed_news = []

            for news_item in news_list:
                processed_item = {
                    "title": news_item.get("title", ""),
                    "summary": news_item.get("summary", ""),
                    "url": news_item.get("url", ""),
                    "source": news_item.get("source", "barchart"),
                    "symbols": news_item.get("symbols", []),
                    "timestamp": pd.to_datetime(
                        news_item.get("timestamp", datetime.now())
                    ),
                    "category": news_item.get("category", "general"),
                }
                processed_news.append(processed_item)

            return processed_news

        except Exception as e:
            logger.error(f"Error processing news data: {e}")
            return []

    async def _polling_stream(self, symbols: List[str], callback: Callable):
        """Polling-based streaming for real-time data"""
        try:
            while self.is_streaming:
                for symbol in symbols:
                    try:
                        quote = await self.get_quote(symbol)
                        if quote:
                            await callback(quote)
                    except Exception as e:
                        logger.error(
                            f"Error in Barchart polling stream for {symbol}: {e}"
                        )

                # Wait before next poll (respect rate limits)
                await asyncio.sleep(3.0)  # 3 seconds between polls

        except asyncio.CancelledError:
            logger.info("Barchart polling stream cancelled")
        except Exception as e:
            logger.error(f"Error in Barchart polling stream: {e}")

    def _determine_asset_type(self, symbol: str) -> str:
        """Determine asset type based on symbol"""
        symbol_upper = symbol.upper()

        if any(
            grain in symbol_upper
            for grain in ["ZC", "ZS", "ZW", "ZM", "ZL", "ZO", "ZR"]
        ):
            return "grains"
        elif any(livestock in symbol_upper for livestock in ["LE", "GF", "HE"]):
            return "livestock"
        elif any(soft in symbol_upper for soft in ["CC", "CT", "KC", "SB", "OJ"]):
            return "softs"
        elif any(energy in symbol_upper for energy in ["CL", "NG", "RB", "HO"]):
            return "energy"
        elif any(metal in symbol_upper for metal in ["GC", "SI", "HG", "PA", "PL"]):
            return "metals"
        else:
            return "other"

    def _determine_exchange(self, symbol: str) -> str:
        """Determine exchange based on symbol"""
        symbol_upper = symbol.upper()

        if any(
            cme_symbol in symbol_upper
            for cme_symbol in ["ES", "NQ", "YM", "RTY", "LE", "GF", "HE"]
        ):
            return "CME"
        elif any(
            cbot_symbol in symbol_upper
            for cbot_symbol in ["ZC", "ZS", "ZW", "ZM", "ZL", "ZN", "ZB"]
        ):
            return "CBOT"
        elif any(
            nymex_symbol in symbol_upper for nymex_symbol in ["CL", "NG", "RB", "HO"]
        ):
            return "NYMEX"
        elif any(comex_symbol in symbol_upper for comex_symbol in ["GC", "SI", "HG"]):
            return "COMEX"
        else:
            return "UNKNOWN"

    def _get_contract_size(self, symbol: str) -> int:
        """Get contract size based on symbol"""
        # Mock contract sizes - in production, fetch from API
        contract_sizes = {
            "ZC": 5000,  # 5,000 bushels
            "ZS": 5000,  # 5,000 bushels
            "ZW": 5000,  # 5,000 bushels
            "CL": 1000,  # 1,000 barrels
            "NG": 10000,  # 10,000 MMBtu
            "GC": 100,  # 100 troy ounces
            "SI": 5000,  # 5,000 troy ounces
        }

        base_symbol = symbol.split("*")[0] if "*" in symbol else symbol
        return contract_sizes.get(base_symbol, 1)

    def _get_tick_size(self, symbol: str) -> float:
        """Get tick size based on symbol"""
        # Mock tick sizes - in production, fetch from API
        tick_sizes = {
            "ZC": 0.25,  # 1/4 cent per bushel
            "ZS": 0.25,  # 1/4 cent per bushel
            "ZW": 0.25,  # 1/4 cent per bushel
            "CL": 0.01,  # 1 cent per barrel
            "NG": 0.001,  # 0.1 cent per MMBtu
            "GC": 0.10,  # 10 cents per troy ounce
            "SI": 0.005,  # 0.5 cent per troy ounce
        }

        base_symbol = symbol.split("*")[0] if "*" in symbol else symbol
        return tick_sizes.get(base_symbol, 0.01)

    def _get_trading_hours(self, symbol: str) -> str:
        """Get trading hours based on symbol"""
        # Mock trading hours - in production, fetch from API
        return "17:00-16:00 CT"  # Standard CME hours

    def _determine_option_type(self, symbol: str) -> str:
        """Determine option type (call/put) from symbol"""
        # This is a simplified implementation
        # In practice, option symbols have specific formats
        if "C" in symbol.upper():
            return "call"
        elif "P" in symbol.upper():
            return "put"
        else:
            return "unknown"

    def _check_request_limit(self) -> bool:
        """Check if daily request limit is reached"""
        current_date = datetime.now().date()

        # Reset counter if new day
        if current_date != self.request_date:
            self.daily_requests = 0
            self.request_date = current_date

        # Check limit (conservative for free tier)
        return self.daily_requests < 350  # Leave some buffer

    def _increment_request_count(self):
        """Increment daily request counter"""
        self.daily_requests += 1

    async def _respect_rate_limit(self):
        """Respect API rate limits"""
        current_time = time.time()
        time_since_last = current_time - self.last_request_time

        # Minimum time between requests (based on rate limit)
        min_interval = 60.0 / self.config.max_requests_per_minute

        if time_since_last < min_interval:
            sleep_time = min_interval - time_since_last
            await asyncio.sleep(sleep_time)

        self.last_request_time = time.time()

    def _is_connected(self) -> bool:
        """Check if adapter is connected"""
        return self.status == ConnectionStatus.CONNECTED and self.session is not None

    def _is_cached(self, key: str) -> bool:
        """Check if data is cached and not expired"""
        if key not in self.cache:
            return False

        if key in self.cache_expiry:
            return datetime.now() < self.cache_expiry[key]

        return True

    def _cache_data(self, key: str, data: Any):
        """Cache data with expiration"""
        self.cache[key] = data
        self.cache_expiry[key] = datetime.now() + timedelta(
            seconds=self.config.cache_duration
        )


# Logger setup
logger = logging.getLogger(__name__)
