"""
Momentum Strategy Templates

This module implements comprehensive momentum-based trading strategies
for the NautilusTrader engine with 5-pillar architecture compliance.

Strategy Types:
- MomentumStrategy: Base momentum strategy framework
- TrendFollowingStrategy: Multi-timeframe trend following
- BreakoutStrategy: Volatility breakout with volume confirmation
- MovingAverageCrossoverStrategy: Advanced MA crossover system

Key Features:
- Multi-timeframe analysis
- Volume-weighted indicators
- Dynamic position sizing
- Risk management integration
- Market regime awareness
"""

import asyncio
from dataclasses import dataclass
from datetime import datetime, timezone
from typing import Any, Dict, List, Optional, Tuple

import numpy as np
import pandas as pd
from nautilus_trader.model.data.bar import Bar
from nautilus_trader.model.data.tick import QuoteTick, TradeTick
from nautilus_trader.model.identifiers import InstrumentId
from nautilus_trader.model.orders.limit import LimitOrder
from nautilus_trader.model.orders.market import MarketOrder

from .base import (
    BaseStrategy,
    MarketRegime,
    PositionSizing,
    RiskParameters,
    SignalStrength,
    StrategyConfig,
    StrategyType,
)


@dataclass
class MomentumConfig(StrategyConfig):
    """Momentum strategy configuration"""

    # Momentum parameters
    momentum_period: int = 20
    momentum_threshold: float = 0.02
    volume_confirmation: bool = True
    volume_period: int = 20

    # Trend parameters
    trend_period_fast: int = 10
    trend_period_slow: int = 30
    trend_strength_threshold: float = 0.5

    # Breakout parameters
    breakout_period: int = 20
    breakout_multiplier: float = 2.0
    volume_breakout_threshold: float = 1.5

    # Risk management
    atr_period: int = 14
    atr_multiplier: float = 2.0
    max_risk_per_trade: float = 0.02

    def __post_init__(self):
        super().__post_init__()
        self.strategy_type = StrategyType.MOMENTUM


class MomentumStrategy(BaseStrategy):
    """
    Base momentum strategy implementation

    Provides framework for momentum-based trading with:
    - Price momentum calculation
    - Volume confirmation
    - Multi-timeframe analysis
    - Dynamic risk management
    """

    def __init__(self, config: MomentumConfig):
        super().__init__(config)
        self.momentum_config: MomentumConfig = config

        # Momentum indicators
        self._price_momentum = {}
        self._volume_momentum = {}
        self._trend_strength = {}
        self._volatility = {}

        # Signal tracking
        self._current_signals = {}
        self._signal_strength = {}

        self.logger.info(
            f"Initialized MomentumStrategy with config: {config.strategy_name}"
        )

    async def on_start(self):
        """Initialize momentum strategy"""
        self.logger.info("Starting momentum strategy")

        # Initialize indicators for each instrument
        for instrument in self.config.instruments:
            self._price_momentum[instrument] = []
            self._volume_momentum[instrument] = []
            self._trend_strength[instrument] = []
            self._volatility[instrument] = []
            self._current_signals[instrument] = None
            self._signal_strength[instrument] = SignalStrength.MODERATE

    async def on_stop(self):
        """Clean up momentum strategy"""
        self.logger.info("Stopping momentum strategy")

        # Clear indicators
        self._price_momentum.clear()
        self._volume_momentum.clear()
        self._trend_strength.clear()
        self._volatility.clear()

    async def on_bar(self, bar: Bar):
        """Process new bar data"""
        instrument_id = bar.bar_type.instrument_id

        # Update indicators
        await self._update_momentum_indicators(instrument_id, bar)

        # Generate signals
        signals = await self.generate_signals(instrument_id)

        # Process signals
        for signal in signals:
            await self._process_signal(signal)

    async def on_quote_tick(self, tick: QuoteTick):
        """Process quote tick (optional for momentum strategies)"""
        try:
            # Update bid-ask spread tracking for momentum analysis
            instrument_id = tick.instrument_id

            if instrument_id not in self._quote_data:
                self._quote_data[instrument_id] = []

            # Store quote data for spread analysis
            quote_info = {
                "timestamp": tick.ts_event,
                "bid": tick.bid_price,
                "ask": tick.ask_price,
                "bid_size": tick.bid_size,
                "ask_size": tick.ask_size,
                "spread": tick.ask_price - tick.bid_price,
            }

            self._quote_data[instrument_id].append(quote_info)

            # Keep only recent quotes (last 100)
            if len(self._quote_data[instrument_id]) > 100:
                self._quote_data[instrument_id] = self._quote_data[instrument_id][-100:]

            # Update momentum indicators with quote data
            await self._update_quote_momentum_indicators(instrument_id, quote_info)

        except Exception as e:
            self.logger.error(f"Error processing quote tick: {e}")

    async def on_trade_tick(self, tick: TradeTick):
        """Process trade tick (optional for momentum strategies)"""
        try:
            # Process trade ticks for volume-based momentum analysis
            instrument_id = tick.instrument_id

            if instrument_id not in self._trade_data:
                self._trade_data[instrument_id] = []

            # Store trade data for volume momentum analysis
            trade_info = {
                "timestamp": tick.ts_event,
                "price": tick.price,
                "size": tick.size,
                "aggressor_side": getattr(tick, "aggressor_side", None),
            }

            self._trade_data[instrument_id].append(trade_info)

            # Keep only recent trades (last 1000)
            if len(self._trade_data[instrument_id]) > 1000:
                self._trade_data[instrument_id] = self._trade_data[instrument_id][
                    -1000:
                ]

            # Update volume momentum indicators
            await self._update_trade_momentum_indicators(instrument_id, trade_info)

            # Check for momentum signals based on trade flow
            if len(self._trade_data[instrument_id]) >= 10:
                await self._check_trade_momentum_signals(instrument_id)

        except Exception as e:
            self.logger.error(f"Error processing trade tick: {e}")

    async def generate_signals(
        self, instrument_id: InstrumentId
    ) -> List[Dict[str, Any]]:
        """Generate momentum signals"""
        signals = []

        try:
            # Get current momentum values
            price_momentum = self._get_current_momentum(instrument_id)
            volume_momentum = self._get_current_volume_momentum(instrument_id)
            trend_strength = self._get_current_trend_strength(instrument_id)

            # Check for momentum signal
            if abs(price_momentum) > self.momentum_config.momentum_threshold:
                signal_direction = 1 if price_momentum > 0 else -1

                # Volume confirmation
                volume_confirmed = True
                if self.momentum_config.volume_confirmation:
                    volume_confirmed = volume_momentum > 1.0

                if volume_confirmed:
                    signal_strength = self._calculate_signal_strength(
                        price_momentum, volume_momentum, trend_strength
                    )

                    signal = {
                        "instrument_id": instrument_id,
                        "signal_type": "momentum",
                        "direction": signal_direction,
                        "strength": signal_strength,
                        "price_momentum": price_momentum,
                        "volume_momentum": volume_momentum,
                        "trend_strength": trend_strength,
                        "timestamp": datetime.now(timezone.utc),
                        "confidence": self._calculate_confidence(signal_strength),
                    }

                    signals.append(signal)

                    # Store current signal
                    self._current_signals[str(instrument_id)] = signal
                    self._signal_strength[str(instrument_id)] = signal_strength

            return signals

        except Exception as e:
            self.logger.error(f"Error generating momentum signals: {e}")
            return []

    async def calculate_position_size(self, signal: Dict[str, Any]) -> float:
        """Calculate position size based on momentum and volatility"""
        try:
            # Base position size
            base_size = self.momentum_config.max_risk_per_trade

            # Adjust for signal strength
            strength_multiplier = signal["strength"].value / 3.0  # Normalize to 0-1.67

            # Adjust for volatility
            instrument_id = signal["instrument_id"]
            volatility = self._get_current_volatility(str(instrument_id))
            volatility_adjustment = 1.0 / (1.0 + volatility) if volatility > 0 else 1.0

            # Calculate final size
            position_size = base_size * strength_multiplier * volatility_adjustment

            # Apply direction
            position_size *= signal["direction"]

            return position_size

        except Exception as e:
            self.logger.error(f"Error calculating position size: {e}")
            return 0.0

    async def _update_momentum_indicators(self, instrument_id: InstrumentId, bar: Bar):
        """Update momentum indicators"""
        try:
            instrument_str = str(instrument_id)

            # Store bar data
            if instrument_str not in self._bars:
                self._bars[instrument_str] = pd.DataFrame()

            # Add new bar
            bar_data = {
                "timestamp": bar.ts_init,
                "open": float(bar.open),
                "high": float(bar.high),
                "low": float(bar.low),
                "close": float(bar.close),
                "volume": float(bar.volume),
            }

            self._bars[instrument_str] = pd.concat(
                [self._bars[instrument_str], pd.DataFrame([bar_data])]
            ).tail(self.momentum_config.lookback_periods)

            # Calculate momentum indicators
            await self._calculate_price_momentum(instrument_str)
            await self._calculate_volume_momentum(instrument_str)
            await self._calculate_trend_strength(instrument_str)
            await self._calculate_volatility(instrument_str)

        except Exception as e:
            self.logger.error(f"Error updating momentum indicators: {e}")

    async def _calculate_price_momentum(self, instrument_id: str):
        """Calculate price momentum"""
        try:
            df = self._bars[instrument_id]
            if len(df) < self.momentum_config.momentum_period:
                return

            # Rate of change momentum
            period = self.momentum_config.momentum_period
            momentum = df["close"].iloc[-1] / df["close"].iloc[-period] - 1.0

            self._price_momentum[instrument_id] = momentum

        except Exception as e:
            self.logger.error(f"Error calculating price momentum: {e}")

    async def _calculate_volume_momentum(self, instrument_id: str):
        """Calculate volume momentum"""
        try:
            df = self._bars[instrument_id]
            if len(df) < self.momentum_config.volume_period:
                return

            # Volume ratio to average
            period = self.momentum_config.volume_period
            avg_volume = df["volume"].tail(period).mean()
            current_volume = df["volume"].iloc[-1]

            volume_momentum = current_volume / avg_volume if avg_volume > 0 else 1.0

            self._volume_momentum[instrument_id] = volume_momentum

        except Exception as e:
            self.logger.error(f"Error calculating volume momentum: {e}")

    async def _calculate_trend_strength(self, instrument_id: str):
        """Calculate trend strength"""
        try:
            df = self._bars[instrument_id]
            if len(df) < max(
                self.momentum_config.trend_period_fast,
                self.momentum_config.trend_period_slow,
            ):
                return

            # Moving average trend strength
            fast_ma = df["close"].tail(self.momentum_config.trend_period_fast).mean()
            slow_ma = df["close"].tail(self.momentum_config.trend_period_slow).mean()

            trend_strength = (fast_ma / slow_ma - 1.0) if slow_ma > 0 else 0.0

            self._trend_strength[instrument_id] = trend_strength

        except Exception as e:
            self.logger.error(f"Error calculating trend strength: {e}")

    async def _calculate_volatility(self, instrument_id: str):
        """Calculate volatility (ATR-based)"""
        try:
            df = self._bars[instrument_id]
            if len(df) < self.momentum_config.atr_period:
                return

            # True Range calculation
            df_calc = df.copy()
            df_calc["prev_close"] = df_calc["close"].shift(1)
            df_calc["tr1"] = df_calc["high"] - df_calc["low"]
            df_calc["tr2"] = abs(df_calc["high"] - df_calc["prev_close"])
            df_calc["tr3"] = abs(df_calc["low"] - df_calc["prev_close"])
            df_calc["tr"] = df_calc[["tr1", "tr2", "tr3"]].max(axis=1)

            # Average True Range
            atr = df_calc["tr"].tail(self.momentum_config.atr_period).mean()
            current_price = df["close"].iloc[-1]

            volatility = atr / current_price if current_price > 0 else 0.0

            self._volatility[instrument_id] = volatility

        except Exception as e:
            self.logger.error(f"Error calculating volatility: {e}")

    def _calculate_signal_strength(
        self, price_momentum: float, volume_momentum: float, trend_strength: float
    ) -> SignalStrength:
        """Calculate signal strength based on momentum factors"""
        try:
            # Normalize factors
            momentum_score = min(
                abs(price_momentum) / self.momentum_config.momentum_threshold, 2.0
            )
            volume_score = min(volume_momentum, 3.0) / 3.0
            trend_score = min(
                abs(trend_strength) / self.momentum_config.trend_strength_threshold, 2.0
            )

            # Weighted average
            combined_score = (
                momentum_score * 0.4 + volume_score * 0.3 + trend_score * 0.3
            )

            # Map to signal strength
            if combined_score >= 1.5:
                return SignalStrength.VERY_STRONG
            elif combined_score >= 1.2:
                return SignalStrength.STRONG
            elif combined_score >= 0.8:
                return SignalStrength.MODERATE
            elif combined_score >= 0.5:
                return SignalStrength.WEAK
            else:
                return SignalStrength.VERY_WEAK

        except Exception as e:
            self.logger.error(f"Error calculating signal strength: {e}")
            return SignalStrength.MODERATE

    def _calculate_confidence(self, signal_strength: SignalStrength) -> float:
        """Calculate signal confidence"""
        confidence_map = {
            SignalStrength.VERY_STRONG: 0.9,
            SignalStrength.STRONG: 0.75,
            SignalStrength.MODERATE: 0.6,
            SignalStrength.WEAK: 0.4,
            SignalStrength.VERY_WEAK: 0.2,
        }
        return confidence_map.get(signal_strength, 0.5)

    def _get_current_momentum(self, instrument_id: InstrumentId) -> float:
        """Get current price momentum"""
        return self._price_momentum.get(str(instrument_id), 0.0)

    def _get_current_volume_momentum(self, instrument_id: InstrumentId) -> float:
        """Get current volume momentum"""
        return self._volume_momentum.get(str(instrument_id), 1.0)

    def _get_current_trend_strength(self, instrument_id: InstrumentId) -> float:
        """Get current trend strength"""
        return self._trend_strength.get(str(instrument_id), 0.0)

    def _get_current_volatility(self, instrument_id: str) -> float:
        """Get current volatility"""
        return self._volatility.get(instrument_id, 0.0)

    async def _process_signal(self, signal: Dict[str, Any]):
        """Process generated signal"""
        try:
            # Check risk limits
            if not await self._check_risk_limits(signal):
                self.logger.warning(f"Signal rejected due to risk limits: {signal}")
                return

            # Calculate position size
            position_size = await self.calculate_position_size(signal)

            if abs(position_size) > 0:
                # Create and submit order
                await self._submit_order(signal, position_size)

                # Log signal
                self._signal_history.append(signal)

                # Emit signal event
                await self._emit_event("signal_generated", signal)

        except Exception as e:
            self.logger.error(f"Error processing signal: {e}")

    async def _submit_order(self, signal: Dict[str, Any], position_size: float):
        """Submit order based on signal"""
        try:
            instrument_id = signal["instrument_id"]

            # Create market order (simplified)
            # In real implementation, this would use NautilusTrader's order system
            order_data = {
                "instrument_id": instrument_id,
                "quantity": abs(position_size),
                "side": "BUY" if position_size > 0 else "SELL",
                "order_type": "MARKET",
                "timestamp": datetime.now(timezone.utc),
            }

            self.logger.info(f"Submitting order: {order_data}")

            # Store trade
            self._trade_history.append(
                {
                    "signal": signal,
                    "order": order_data,
                    "timestamp": datetime.now(timezone.utc),
                }
            )

        except Exception as e:
            self.logger.error(f"Error submitting order: {e}")


class TrendFollowingStrategy(MomentumStrategy):
    """
    Advanced trend following strategy

    Features:
    - Multi-timeframe trend analysis
    - Adaptive moving averages
    - Trend strength filtering
    - Dynamic stop losses
    """

    def __init__(self, config: MomentumConfig):
        super().__init__(config)

        # Trend following specific parameters
        self._trend_filters = {}
        self._adaptive_periods = {}

        self.logger.info("Initialized TrendFollowingStrategy")

    async def generate_signals(
        self, instrument_id: InstrumentId
    ) -> List[Dict[str, Any]]:
        """Generate trend following signals"""
        signals = []

        try:
            # Get base momentum signals
            base_signals = await super().generate_signals(instrument_id)

            # Apply trend filters
            for signal in base_signals:
                if await self._validate_trend_signal(signal):
                    # Enhance signal with trend information
                    signal["signal_type"] = "trend_following"
                    signal["trend_filter"] = True
                    signals.append(signal)

            return signals

        except Exception as e:
            self.logger.error(f"Error generating trend following signals: {e}")
            return []

    async def _validate_trend_signal(self, signal: Dict[str, Any]) -> bool:
        """Validate signal against trend filters"""
        try:
            # Check trend strength
            trend_strength = signal.get("trend_strength", 0.0)
            if abs(trend_strength) < self.momentum_config.trend_strength_threshold:
                return False

            # Check trend direction alignment
            signal_direction = signal["direction"]
            trend_direction = 1 if trend_strength > 0 else -1

            return signal_direction == trend_direction

        except Exception as e:
            self.logger.error(f"Error validating trend signal: {e}")
            return False


class BreakoutStrategy(MomentumStrategy):
    """
    Volatility breakout strategy

    Features:
    - Bollinger Band breakouts
    - Volume confirmation
    - False breakout filtering
    - Dynamic volatility adjustment
    """

    def __init__(self, config: MomentumConfig):
        super().__init__(config)

        # Breakout specific indicators
        self._bollinger_bands = {}
        self._breakout_levels = {}

        self.logger.info("Initialized BreakoutStrategy")

    async def generate_signals(
        self, instrument_id: InstrumentId
    ) -> List[Dict[str, Any]]:
        """Generate breakout signals"""
        signals = []

        try:
            # Calculate breakout levels
            await self._calculate_breakout_levels(instrument_id)

            # Check for breakouts
            breakout_signal = await self._detect_breakout(instrument_id)

            if breakout_signal:
                # Enhance with momentum analysis
                base_signals = await super().generate_signals(instrument_id)

                if base_signals:
                    signal = base_signals[0].copy()
                    signal["signal_type"] = "breakout"
                    signal["breakout_level"] = breakout_signal["level"]
                    signal["breakout_direction"] = breakout_signal["direction"]
                    signals.append(signal)

            return signals

        except Exception as e:
            self.logger.error(f"Error generating breakout signals: {e}")
            return []

    async def _calculate_breakout_levels(self, instrument_id: InstrumentId):
        """Calculate dynamic breakout levels"""
        try:
            instrument_str = str(instrument_id)
            df = self._bars.get(instrument_str)

            if df is None or len(df) < self.momentum_config.breakout_period:
                return

            # Bollinger Bands
            period = self.momentum_config.breakout_period
            multiplier = self.momentum_config.breakout_multiplier

            sma = df["close"].tail(period).mean()
            std = df["close"].tail(period).std()

            upper_band = sma + (multiplier * std)
            lower_band = sma - (multiplier * std)

            self._breakout_levels[instrument_str] = {
                "upper": upper_band,
                "lower": lower_band,
                "middle": sma,
            }

        except Exception as e:
            self.logger.error(f"Error calculating breakout levels: {e}")

    async def _detect_breakout(
        self, instrument_id: InstrumentId
    ) -> Optional[Dict[str, Any]]:
        """Detect breakout conditions"""
        try:
            instrument_str = str(instrument_id)
            df = self._bars.get(instrument_str)
            levels = self._breakout_levels.get(instrument_str)

            if df is None or levels is None or len(df) < 2:
                return None

            current_price = df["close"].iloc[-1]
            previous_price = df["close"].iloc[-2]

            # Check for breakout
            if current_price > levels["upper"] and previous_price <= levels["upper"]:
                # Upward breakout
                volume_confirmed = await self._confirm_breakout_volume(instrument_str)
                if volume_confirmed:
                    return {
                        "direction": 1,
                        "level": levels["upper"],
                        "type": "upward_breakout",
                    }

            elif current_price < levels["lower"] and previous_price >= levels["lower"]:
                # Downward breakout
                volume_confirmed = await self._confirm_breakout_volume(instrument_str)
                if volume_confirmed:
                    return {
                        "direction": -1,
                        "level": levels["lower"],
                        "type": "downward_breakout",
                    }

            return None

        except Exception as e:
            self.logger.error(f"Error detecting breakout: {e}")
            return None

    async def _confirm_breakout_volume(self, instrument_id: str) -> bool:
        """Confirm breakout with volume analysis"""
        try:
            volume_momentum = self._volume_momentum.get(instrument_id, 1.0)
            return volume_momentum >= self.momentum_config.volume_breakout_threshold

        except Exception as e:
            self.logger.error(f"Error confirming breakout volume: {e}")
            return False


class MovingAverageCrossoverStrategy(MomentumStrategy):
    """
    Advanced moving average crossover strategy

    Features:
    - Multiple MA types (SMA, EMA, WMA)
    - Multi-timeframe analysis
    - Trend strength filtering
    - Adaptive periods
    """

    def __init__(self, config: MomentumConfig):
        super().__init__(config)

        # MA crossover specific parameters
        self._ma_fast = {}
        self._ma_slow = {}
        self._crossover_signals = {}

        self.logger.info("Initialized MovingAverageCrossoverStrategy")

    async def generate_signals(
        self, instrument_id: InstrumentId
    ) -> List[Dict[str, Any]]:
        """Generate MA crossover signals"""
        signals = []

        try:
            # Calculate moving averages
            await self._calculate_moving_averages(instrument_id)

            # Detect crossovers
            crossover = await self._detect_crossover(instrument_id)

            if crossover:
                # Get momentum confirmation
                base_signals = await super().generate_signals(instrument_id)

                # Create crossover signal
                signal = {
                    "instrument_id": instrument_id,
                    "signal_type": "ma_crossover",
                    "direction": crossover["direction"],
                    "strength": crossover["strength"],
                    "ma_fast": crossover["ma_fast"],
                    "ma_slow": crossover["ma_slow"],
                    "crossover_type": crossover["type"],
                    "timestamp": datetime.now(timezone.utc),
                    "confidence": crossover["confidence"],
                }

                # Add momentum confirmation if available
                if base_signals:
                    momentum_signal = base_signals[0]
                    if momentum_signal["direction"] == crossover["direction"]:
                        signal["momentum_confirmed"] = True
                        signal["strength"] = max(
                            signal["strength"], momentum_signal["strength"]
                        )

                signals.append(signal)

            return signals

        except Exception as e:
            self.logger.error(f"Error generating MA crossover signals: {e}")
            return []

    async def _calculate_moving_averages(self, instrument_id: InstrumentId):
        """Calculate fast and slow moving averages"""
        try:
            instrument_str = str(instrument_id)
            df = self._bars.get(instrument_str)

            if df is None or len(df) < self.momentum_config.trend_period_slow:
                return

            # Fast MA (EMA)
            fast_period = self.momentum_config.trend_period_fast
            alpha_fast = 2.0 / (fast_period + 1)

            if instrument_str not in self._ma_fast:
                self._ma_fast[instrument_str] = df["close"].iloc[-fast_period:].mean()

            current_price = df["close"].iloc[-1]
            self._ma_fast[instrument_str] = (
                alpha_fast * current_price
                + (1 - alpha_fast) * self._ma_fast[instrument_str]
            )

            # Slow MA (EMA)
            slow_period = self.momentum_config.trend_period_slow
            alpha_slow = 2.0 / (slow_period + 1)

            if instrument_str not in self._ma_slow:
                self._ma_slow[instrument_str] = df["close"].iloc[-slow_period:].mean()

            self._ma_slow[instrument_str] = (
                alpha_slow * current_price
                + (1 - alpha_slow) * self._ma_slow[instrument_str]
            )

        except Exception as e:
            self.logger.error(f"Error calculating moving averages: {e}")

    async def _detect_crossover(
        self, instrument_id: InstrumentId
    ) -> Optional[Dict[str, Any]]:
        """Detect MA crossover signals"""
        try:
            instrument_str = str(instrument_id)

            ma_fast = self._ma_fast.get(instrument_str)
            ma_slow = self._ma_slow.get(instrument_str)

            if ma_fast is None or ma_slow is None:
                return None

            # Get previous crossover state
            prev_crossover = self._crossover_signals.get(instrument_str, {})
            prev_above = prev_crossover.get("fast_above_slow", ma_fast > ma_slow)

            # Current state
            current_above = ma_fast > ma_slow

            # Detect crossover
            if current_above != prev_above:
                # Calculate crossover strength
                ma_diff = abs(ma_fast - ma_slow) / ma_slow if ma_slow > 0 else 0
                strength = self._calculate_crossover_strength(ma_diff)

                crossover = {
                    "direction": 1 if current_above else -1,
                    "type": "bullish_crossover"
                    if current_above
                    else "bearish_crossover",
                    "strength": strength,
                    "ma_fast": ma_fast,
                    "ma_slow": ma_slow,
                    "ma_diff": ma_diff,
                    "confidence": min(ma_diff * 10, 0.9),  # Scale to 0-0.9
                }

                # Update crossover state
                self._crossover_signals[instrument_str] = {
                    "fast_above_slow": current_above,
                    "last_crossover": datetime.now(timezone.utc),
                }

                return crossover

            return None

        except Exception as e:
            self.logger.error(f"Error detecting crossover: {e}")
            return None

    def _calculate_crossover_strength(self, ma_diff: float) -> SignalStrength:
        """Calculate crossover signal strength"""
        try:
            # Normalize MA difference to signal strength
            if ma_diff >= 0.05:  # 5% difference
                return SignalStrength.VERY_STRONG
            elif ma_diff >= 0.03:  # 3% difference
                return SignalStrength.STRONG
            elif ma_diff >= 0.02:  # 2% difference
                return SignalStrength.MODERATE
            elif ma_diff >= 0.01:  # 1% difference
                return SignalStrength.WEAK
            else:
                return SignalStrength.VERY_WEAK

        except Exception as e:
            self.logger.error(f"Error calculating crossover strength: {e}")
            return SignalStrength.MODERATE
