    def _generate_multi_factor_signal(
        self, factor_scores: List[FactorScore]"""
    ) -> MultiFactorSignal:"""
        """Generate comprehensive multi-factor signal."""

        Parameters
        ----------
        factor_scores : List[FactorScore]
            All calculated factor scores

        Returns
        -------
        MultiFactorSignal"""
            Comprehensive multi-factor signal"""
        """
        if not factor_scores:
            return MultiFactorSignal(
                overall_signal=SignalType.HOLD,
                overall_confidence=0.0,
                factor_scores=factor_scores,
                consensus_strength=0.0,
                divergence_score=1.0,
                risk_adjusted_signal=SignalType.HOLD,
                position_sizing_multiplier=0.0,
            )

        # Calculate weighted signals
        bullish_weight = sum(
            fs.weight * fs.confidence
            for fs in factor_scores
            if fs.signal_type == SignalType.BUY
        )
        bearish_weight = sum(
            fs.weight * fs.confidence
            for fs in factor_scores
            if fs.signal_type == SignalType.SELL
        )
        total_weight = sum(fs.weight for fs in factor_scores)

        # Determine overall signal
        if (
            bullish_weight > bearish_weight
            and bullish_weight / total_weight > self.consensus_threshold
        ):
            overall_signal = SignalType.BUY
        elif (
            bearish_weight > bullish_weight
            and bearish_weight / total_weight > self.consensus_threshold
        ):
            overall_signal = SignalType.SELL
        else:
            overall_signal = SignalType.HOLD

        # Calculate consensus strength
        if overall_signal == SignalType.BUY:
            consensus_strength = bullish_weight / total_weight
        elif overall_signal == SignalType.SELL:
            consensus_strength = bearish_weight / total_weight
        else:
            consensus_strength = max(bullish_weight, bearish_weight) / total_weight

        # Calculate divergence score
        signal_variance = np.var(
            [
                1
                if fs.signal_type == SignalType.BUY
                else -1
                if fs.signal_type == SignalType.SELL
                else 0
                for fs in factor_scores
