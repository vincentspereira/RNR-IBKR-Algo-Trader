"""
    def _calculate_contrarian_volume_confirmation(self, bar: Bar) -> float"""
        """Calculate contrarian volume confirmation for mean reversion."""

        For mean reversion, we want to see decreasing volume on extreme moves
        (exhaustion) rather than increasing volume.

        Parameters
        ----------
        bar : Bar
            The bar data

        Returns
        -------
        float"""
            Contrarian volume confirmation score"""
        """
        if len(self.volume_data) < 10:
            return 0.5

        current_volume = float(bar.volume)
        avg_volume = np.mean(self.volume_data[-10:])

        if avg_volume == 0:
            return 0.5

        volume_ratio = current_volume / avg_volume

        # For mean reversion, lower volume on extremes is better
        if volume_ratio < 0.8:  # Volume decreasing
            confirmation = 0.8
        elif volume_ratio > 1.5:  # High volume might indicate continuation
            confirmation = 0.3
        else:
            confirmation = 0.6

        return confirmation
"""
    def _calculate_mean_reversion_regime_alignment(self) -> float:"""
        """Calculate regime alignment for mean reversion strategies."""

        Mean reversion works better in sideways/ranging markets.

        Returns
        -------
        float"""
            Regime alignment score"""
        """
        if not self.vw_config.enable_regime_adaptation:
            return 0.5

        # Mean reversion favors sideways markets
        if self.current_regime == VWMarketRegime.SIDEWAYS:
            return 0.9
        elif self.current_regime in [
            VWMarketRegime.LOW_VOLUME_VOLATILITY,
            VWMarketRegime.NORMAL,
        ]:
            return 0.7
        else:  # Trending markets are less favorable
            return 0.3

    def _calculate_mean_reversion_behavioral_score(
        self, signal_type: SignalType"""
    ) -> float:"""
        """Calculate behavioral overlay score for mean reversion."""

        Parameters
        ----------
        signal_type : SignalType
            The current signal type

        Returns
        -------
        float"""
            Behavioral overlay score"""
        """
        if not self.vw_config.enable_behavioral_overlay:
            return 0.5

        # Reward persistence in extreme conditions
        if signal_type != SignalType.HOLD and self.extreme_duration > 2:
            return min(0.7 + (self.extreme_duration * 0.05), 1.0)
        elif signal_type != SignalType.HOLD:
            return 0.6
        else:
            return 0.4
"""
    def _calculate_mean_reversion_risk_score(self, bar: Bar) -> float"""
        """Calculate risk management score for mean reversion."""

        Parameters
        ----------
        bar : Bar
            The current bar data

        Returns
        -------
        float"""
            Risk management score"""
        """
        risk_score = 0.5

        # Mean reversion is riskier in trending markets
        if self.current_regime in [
            VWMarketRegime.TRENDING_UP,
            VWMarketRegime.TRENDING_DOWN,
        ]:
            risk_score *= 0.6
        elif self.current_regime == VWMarketRegime.SIDEWAYS:
            risk_score *= 1.3

        # Adjust for extreme strength
        risk_score *= 1.0 + self.mean_reversion_strength * 0.2

        return min(risk_score, 1.0)

    def _calculate_mean_reversion_position_size(
        self, confidence: float, extreme_level: float"""
    ) -> float:"""
        """Calculate position size for mean reversion strategy."""

        Parameters
        ----------
        confidence : float
            Signal confidence
        extreme_level : float
            Level of price extreme

        Returns
        -------
        float"""
            Risk-adjusted position size"""
        """
        base_size = self.vw_config.max_volume_exposure * 0.8  # More conservative

        # Adjust for confidence
        confidence_multiplier = confidence * 1.2

        # Adjust for extreme level (higher extremes = larger positions)
        extreme_multiplier = 1.0 + (extreme_level * 0.3)

        # Adjust for regime (reduce size in trending markets)
        regime_multiplier = self.vw_config.regime_risk_adjustment
        if self.current_regime in [
            VWMarketRegime.TRENDING_UP,
            VWMarketRegime.TRENDING_DOWN,
        ]:
            regime_multiplier *= 0.7

        adjusted_size = (
            base_size * confidence_multiplier * extreme_multiplier * regime_multiplier
        )

        return min(adjusted_size, self.vw_config.max_volume_exposure * 1.5)

