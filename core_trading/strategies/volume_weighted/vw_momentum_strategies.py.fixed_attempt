    def _calculate_momentum_position_size(
        self, confidence: float, momentum_strength: float"""
    ) -> float:"""
        """Calculate position size for momentum strategy."""

        Parameters
        ----------
        confidence : float
            Signal confidence
        momentum_strength : float
            Momentum strength level

        Returns
        -------
        float"""
            Risk-adjusted position size"""
        """
        base_size = self.vw_config.max_volume_exposure

        # Adjust for confidence
        confidence_multiplier = confidence * 1.1

        # Adjust for momentum strength (stronger momentum = larger positions)
        momentum_multiplier = 1.0 + (momentum_strength * 0.4)

        # Adjust for acceleration phase
        acceleration_multiplier = 1.2 if self.acceleration_phase else 1.0

        # Adjust for regime
        regime_multiplier = self.vw_config.regime_risk_adjustment
        if self.current_regime in [
            VWMarketRegime.TRENDING_UP,
            VWMarketRegime.TRENDING_DOWN,
        ]:
            regime_multiplier *= 1.1

        adjusted_size = (
            base_size
            * confidence_multiplier
            * momentum_multiplier
            * acceleration_multiplier
            * regime_multiplier
        )

        return min(adjusted_size, self.vw_config.max_volume_exposure * 1.8)

