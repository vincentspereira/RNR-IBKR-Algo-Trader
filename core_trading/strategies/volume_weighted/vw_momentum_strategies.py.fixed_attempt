    def _calculate_momentum_risk_score(self, bar: Bar) -> float"""
        """Calculate risk management score for momentum."""

        Parameters
        ----------
        bar : Bar
            The current bar data

        Returns
        -------
        float"""
            Risk management score"""
        """
        risk_score = 0.6

        # Momentum is safer in trending markets
        if self.current_regime in [
            VWMarketRegime.TRENDING_UP,
            VWMarketRegime.TRENDING_DOWN,
        ]:
            risk_score *= 1.2
        elif self.current_regime == VWMarketRegime.SIDEWAYS:
            risk_score *= 0.7

        # Adjust for momentum strength (stronger momentum = lower risk)
        risk_score *= 1.0 + self.momentum_strength * 0.3

        # Reduce risk if momentum is weakening"""
        if len(self.signal_history) > 1:"""
            prev_momentum = getattr(self.signal_history[-2], "metadata", {}).get("""
                "momentum_strength", 0
            )
            if self.momentum_strength < prev_momentum * 0.9:
