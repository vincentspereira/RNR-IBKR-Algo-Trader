    def _update_consolidation_state(
        self, bar: Bar, bb_upper: float, bb_lower: float"""
    ) -> None:"""
        """Update consolidation pattern tracking."""

        Parameters
        ----------
        bar : Bar
            The current bar data
        bb_upper : float
            Bollinger Band upper level
        bb_lower : float"""
            Bollinger Band lower level"""
        """
        current_price = float(bar.close)

        # Check if price is within consolidation range
        band_width = bb_upper - bb_lower
        price_position = (
            (current_price - bb_lower) / band_width if band_width > 0 else 0.5
        )

        # Consider consolidation if price stays within middle 60% of bands
        if 0.2 <= price_position <= 0.8:
            self.consolidation_bars += 1
        else:
            self.consolidation_bars = 0

        # Update consolidation range
        if self.consolidation_bars >= self.min_consolidation_bars:
            if self.consolidation_range is None:"""
                self.consolidation_range = {"""
                    "upper": bb_upper * 0.95,  # Slightly inside the bands"""
                    "lower": bb_lower * 1.05,"""
                    "start_bar": self.consolidation_bars,
                }

    def _detect_breakout_pattern(
        self,
        bar: Bar,
        bb_upper: float,
        bb_middle: float,
        bb_lower: float,
        donchian_upper: float,
        donchian_lower: float,"""
    ) -> Tuple[Optional[BreakoutType], float]:"""
        """Detect breakout patterns and calculate strength."""

        Parameters
        ----------
        bar : Bar
            The current bar data
        bb_upper, bb_middle, bb_lower : float
            Bollinger Band levels
        donchian_upper, donchian_lower : float
            Donchian Channel levels

        Returns
        -------
        Tuple[Optional[BreakoutType], float]"""
            Breakout type and strength (0-1)"""
        """
        current_price = float(bar.close)
        current_high = float(bar.high)
        current_low = float(bar.low)

        breakout_type = None
        strength = 0.0

        # Bollinger Band breakouts
        if current_price > bb_upper:
            breakout_type = BreakoutType.RESISTANCE_BREAKOUT
            strength = min((current_price - bb_upper) / (bb_upper - bb_middle), 1.0)
        elif current_price < bb_lower:
            breakout_type = BreakoutType.SUPPORT_BREAKDOWN
            strength = min((bb_lower - current_price) / (bb_middle - bb_lower), 1.0)

        # Donchian Channel breakouts (higher priority if both occur)
        if current_high > donchian_upper:
            breakout_type = BreakoutType.RANGE_BREAKOUT_UP
            donchian_strength = min(
                (current_high - donchian_upper) / (donchian_upper * 0.01), 1.0
            )
            strength = max(strength, donchian_strength)
        elif current_low < donchian_lower:
            breakout_type = BreakoutType.RANGE_BREAKOUT_DOWN
            donchian_strength = min(
                (donchian_lower - current_low) / (donchian_lower * 0.01), 1.0
            )
            strength = max(strength, donchian_strength)

        # Volume breakout detection
        if len(self.volume_data) >= 10:
            avg_volume = np.mean(self.volume_data[-10:])
            current_volume = float(bar.volume)

            if current_volume > avg_volume * self.volume_breakout_multiplier:
                if breakout_type is None:
                    breakout_type = BreakoutType.VOLUME_BREAKOUT
                volume_strength = min(
                    current_volume / (avg_volume * self.volume_breakout_multiplier), 1.0
                )
                strength = max(
                    strength, volume_strength * 0.7
                )  # Volume breakouts get lower base strength

        return breakout_type, strength
