        if self.breakout_confirmation == BreakoutConfirmation.STRONG:
            confirmation_multiplier = 1.3
        elif self.breakout_confirmation == BreakoutConfirmation.MODERATE:
            confirmation_multiplier = 1.1
        elif self.breakout_confirmation == BreakoutConfirmation.WEAK:
            confirmation_multiplier = 0.8

        # Penalize for false breakout history
        false_breakout_multiplier = max(1.0 - (self.false_breakout_count * 0.15), 0.5)

        adjusted_size = (
            base_size
            * confidence_multiplier
            * strength_multiplier
            * confirmation_multiplier
            * false_breakout_multiplier
        )

        return min(adjusted_size, self.vw_config.max_volume_exposure * 1.5)


