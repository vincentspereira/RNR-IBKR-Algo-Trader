        base_size = self.vw_config.max_volume_exposure * 0.9  # Slightly conservative

        # Adjust for confidence
        confidence_multiplier = confidence * 1.1

        # Adjust for breakout strength
        strength_multiplier = 1.0 + (breakout_strength * 0.5)

        # Adjust for confirmation level
