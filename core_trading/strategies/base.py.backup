"""
Base Strategy Classes and Enums

This module provides the foundational classes and enums for all trading strategies
in the NautilusTrader engine, implementing 5-pillar architecture compliance
and comprehensive strategy management capabilities.

Key Components:
- BaseStrategy: Abstract base class for all strategies
- StrategyConfig: Configuration management
- Strategy enums and data classes
- Risk management parameters
- Performance metrics tracking
"""

import asyncio
import logging
import uuid
from abc import ABC, abstractmethod
from dataclasses import dataclass, field
from datetime import datetime, timezone
from enum import Enum
from typing import Any, Callable, Dict, List, Optional, Set, Union

import numpy as np
import pandas as pd
from nautilus_trader.model.data.bar import Bar
from nautilus_trader.model.data.tick import QuoteTick, TradeTick
from nautilus_trader.model.events.order import OrderEvent
from nautilus_trader.model.events.position import PositionEvent
from nautilus_trader.model.identifiers import InstrumentId, StrategyId
from nautilus_trader.model.instruments.base import Instrument
from nautilus_trader.model.orders.base import Order
from nautilus_trader.model.position import Position
from nautilus_trader.trading.strategy import Strategy


class StrategyType(Enum):
    """Strategy type enumeration"""

    MOMENTUM = "momentum"
    MEAN_REVERSION = "mean_reversion"
    ARBITRAGE = "arbitrage"
    MACHINE_LEARNING = "machine_learning"
    MULTI_ASSET = "multi_asset"
    VOLATILITY = "volatility"
    PAIRS_TRADING = "pairs_trading"
    STATISTICAL_ARBITRAGE = "statistical_arbitrage"
    MARKET_MAKING = "market_making"
    NEWS_BASED = "news_based"


class StrategyStatus(Enum):
    """Strategy status enumeration"""

    INITIALIZED = "initialized"
    STARTING = "starting"
    RUNNING = "running"
    STOPPING = "stopping"
    STOPPED = "stopped"
    ERROR = "error"
    PAUSED = "paused"
    DEGRADED = "degraded"


class SignalStrength(Enum):
    """Signal strength enumeration"""

    VERY_WEAK = 1
    WEAK = 2
    MODERATE = 3
    STRONG = 4
    VERY_STRONG = 5


class MarketRegime(Enum):
    """Market regime enumeration"""

    TRENDING_UP = "trending_up"
    TRENDING_DOWN = "trending_down"
    SIDEWAYS = "sideways"
    HIGH_VOLATILITY = "high_volatility"
    LOW_VOLATILITY = "low_volatility"
    CRISIS = "crisis"
    RECOVERY = "recovery"
    UNKNOWN = "unknown"


class PositionSizing(Enum):
    """Position sizing method enumeration"""

    FIXED = "fixed"
    PERCENT_RISK = "percent_risk"
    VOLATILITY_ADJUSTED = "volatility_adjusted"
    KELLY_CRITERION = "kelly_criterion"
    OPTIMAL_F = "optimal_f"
    EQUAL_WEIGHT = "equal_weight"
    RISK_PARITY = "risk_parity"


@dataclass
class RiskParameters:
    """Risk management parameters"""

    # Position sizing
    max_position_size: float = 0.1  # Maximum position size as % of portfolio
    max_portfolio_risk: float = 0.02  # Maximum portfolio risk per trade
    position_sizing_method: PositionSizing = PositionSizing.PERCENT_RISK

    # Stop losses and take profits
    stop_loss_pct: Optional[float] = None  # Stop loss as percentage
    take_profit_pct: Optional[float] = None  # Take profit as percentage
    trailing_stop_pct: Optional[float] = None  # Trailing stop as percentage

    # Risk limits
    max_daily_loss: float = 0.05  # Maximum daily loss as % of portfolio
    max_drawdown: float = 0.15  # Maximum drawdown as % of portfolio
    max_consecutive_losses: int = 5  # Maximum consecutive losses

    # Exposure limits
    max_sector_exposure: float = 0.3  # Maximum sector exposure
    max_single_position: float = 0.1  # Maximum single position size
    max_correlation: float = 0.7  # Maximum correlation between positions

    # Time-based limits
    max_holding_period: Optional[int] = None  # Maximum holding period in days
    min_holding_period: Optional[int] = None  # Minimum holding period in days

    # Volatility adjustments
    volatility_lookback: int = 20  # Volatility calculation lookback
    volatility_target: Optional[float] = None  # Target volatility for sizing

    # Emergency controls
    circuit_breaker_threshold: float = 0.1  # Circuit breaker threshold
    emergency_liquidation: bool = True  # Enable emergency liquidation


@dataclass
class StrategyMetrics:
    """Strategy performance metrics"""

    # Basic metrics
    total_return: float = 0.0
    annualized_return: float = 0.0
    volatility: float = 0.0
    sharpe_ratio: float = 0.0
    sortino_ratio: float = 0.0
    calmar_ratio: float = 0.0

    # Risk metrics
    max_drawdown: float = 0.0
    var_95: float = 0.0  # Value at Risk (95%)
    cvar_95: float = 0.0  # Conditional Value at Risk (95%)
    beta: float = 0.0
    alpha: float = 0.0

    # Trade metrics
    total_trades: int = 0
    winning_trades: int = 0
    losing_trades: int = 0
    win_rate: float = 0.0
    avg_win: float = 0.0
    avg_loss: float = 0.0
    profit_factor: float = 0.0

    # Timing metrics
    avg_holding_period: float = 0.0
    avg_time_to_profit: float = 0.0
    avg_time_to_loss: float = 0.0

    # Advanced metrics
    information_ratio: float = 0.0
    treynor_ratio: float = 0.0
    tracking_error: float = 0.0
    upside_capture: float = 0.0
    downside_capture: float = 0.0

    # Real-time metrics
    current_drawdown: float = 0.0
    days_since_high: int = 0
    consecutive_losses: int = 0
    daily_pnl: float = 0.0

    # Timestamps
    last_updated: datetime = field(default_factory=lambda: datetime.now(timezone.utc))
    start_date: Optional[datetime] = None
    end_date: Optional[datetime] = None


@dataclass
class StrategyConfig:
    """Strategy configuration parameters"""

    # Basic configuration
    strategy_id: str = field(default_factory=lambda: str(uuid.uuid4()))
    strategy_name: str = "BaseStrategy"
    strategy_type: StrategyType = StrategyType.MOMENTUM
    description: str = ""
    version: str = "1.0.0"

    # Instruments and markets
    instruments: List[str] = field(default_factory=list)
    primary_instrument: Optional[str] = None
    market_hours_only: bool = True
    supported_venues: List[str] = field(default_factory=list)

    # Timeframes and data
    primary_timeframe: str = "1m"
    secondary_timeframes: List[str] = field(default_factory=list)
    lookback_periods: int = 100
    warmup_periods: int = 50

    # Risk management
    risk_parameters: RiskParameters = field(default_factory=RiskParameters)

    # Execution parameters
    order_management: Dict[str, Any] = field(default_factory=dict)
    execution_delay_ms: int = 0
    slippage_model: Optional[str] = None
    commission_model: Optional[str] = None

    # Strategy-specific parameters
    parameters: Dict[str, Any] = field(default_factory=dict)

    # Monitoring and alerting
    enable_monitoring: bool = True
    alert_thresholds: Dict[str, float] = field(default_factory=dict)
    notification_channels: List[str] = field(default_factory=list)

    # Backtesting configuration
    backtest_start: Optional[datetime] = None
    backtest_end: Optional[datetime] = None
    initial_capital: float = 100000.0

    # Live trading configuration
    paper_trading: bool = True
    live_trading_enabled: bool = False
    broker_config: Dict[str, Any] = field(default_factory=dict)

    # Performance tracking
    benchmark_symbol: Optional[str] = None
    performance_attribution: bool = True

    # Machine learning configuration
    ml_enabled: bool = False
    model_path: Optional[str] = None
    feature_engineering: Dict[str, Any] = field(default_factory=dict)

    # Integration settings
    kafka_topics: List[str] = field(default_factory=list)
    database_config: Dict[str, Any] = field(default_factory=dict)

    # Logging and debugging
    log_level: str = "INFO"
    debug_mode: bool = False
    save_signals: bool = True
    save_trades: bool = True


class BaseStrategy(Strategy, ABC):
    """
    Abstract base class for all trading strategies

    Provides comprehensive framework for strategy development with:
    - 5-pillar architecture compliance
    - Risk management integration
    - Performance monitoring
    - Event-driven execution
    - Configuration management
    """

    def __init__(self, config: StrategyConfig):
        """Initialize base strategy"""
        super().__init__(config=config.parameters)

        self.config = config
        self.strategy_id = StrategyId(config.strategy_id)
        self.logger = logging.getLogger(
            f"{self.__class__.__name__}.{config.strategy_id}"
        )

        # Strategy state
        self._status = StrategyStatus.INITIALIZED
        self._start_time: Optional[datetime] = None
        self._stop_time: Optional[datetime] = None

        # Performance tracking
        self.metrics = StrategyMetrics()
        self._trade_history: List[Dict[str, Any]] = []
        self._signal_history: List[Dict[str, Any]] = []

        # Risk management
        self._current_positions: Dict[str, Position] = {}
        self._daily_pnl = 0.0
        self._peak_equity = config.initial_capital
        self._current_drawdown = 0.0

        # Data management
        self._bars: Dict[str, pd.DataFrame] = {}
        self._ticks: Dict[str, pd.DataFrame] = {}
        self._indicators: Dict[str, Any] = {}

        # Event handlers
        self._event_handlers: Dict[str, List[Callable]] = {}

        # Market regime detection
        self._current_regime = MarketRegime.UNKNOWN
        self._regime_confidence = 0.0

        # Initialize components
        self._initialize_risk_management()
        self._initialize_indicators()
        self._initialize_event_handlers()

    @abstractmethod
    async def on_start(self):
        """Called when strategy starts"""
        raise NotImplementedError("Subclasses must implement on_start method")

    @abstractmethod
    async def on_stop(self):
        """Called when strategy stops"""
        raise NotImplementedError("Subclasses must implement on_stop method")

    @abstractmethod
    async def on_bar(self, bar: Bar):
        """Called when new bar data is received"""
        raise NotImplementedError("Subclasses must implement on_bar method")

    @abstractmethod
    async def on_quote_tick(self, tick: QuoteTick):
        """Called when new quote tick is received"""
        raise NotImplementedError("Subclasses must implement on_quote_tick method")

    @abstractmethod
    async def on_trade_tick(self, tick: TradeTick):
        """Called when new trade tick is received"""
        raise NotImplementedError("Subclasses must implement on_trade_tick method")

    @abstractmethod
    async def generate_signals(
        self, instrument_id: InstrumentId
    ) -> List[Dict[str, Any]]:
        """Generate trading signals for instrument"""
        raise NotImplementedError("Subclasses must implement generate_signals method")

    @abstractmethod
    async def calculate_position_size(self, signal: Dict[str, Any]) -> float:
        """Calculate position size for signal"""
        raise NotImplementedError(
            "Subclasses must implement calculate_position_size method"
        )

    # Strategy lifecycle methods

    async def start_strategy(self):
        """Start the strategy"""
        try:
            self._status = StrategyStatus.STARTING
            self._start_time = datetime.now(timezone.utc)

            self.logger.info(f"Starting strategy: {self.config.strategy_name}")

            # Initialize data subscriptions
            await self._initialize_data_subscriptions()

            # Call strategy-specific start logic
            await self.on_start()

            self._status = StrategyStatus.RUNNING
            self.logger.info("Strategy started successfully")

            # Notify event
            await self._emit_event(
                "strategy_started",
                {
                    "strategy_id": self.config.strategy_id,
                    "start_time": self._start_time,
                },
            )

        except Exception as e:
            self._status = StrategyStatus.ERROR
            self.logger.error(f"Error starting strategy: {e}")
            raise

    async def stop_strategy(self):
        """Stop the strategy"""
        try:
            self._status = StrategyStatus.STOPPING
            self._stop_time = datetime.now(timezone.utc)

            self.logger.info("Stopping strategy")

            # Close all positions if configured
            if self.config.risk_parameters.emergency_liquidation:
                await self._emergency_liquidation()

            # Call strategy-specific stop logic
            await self.on_stop()

            self._status = StrategyStatus.STOPPED
            self.logger.info("Strategy stopped successfully")

            # Notify event
            await self._emit_event(
                "strategy_stopped",
                {
                    "strategy_id": self.config.strategy_id,
                    "stop_time": self._stop_time,
                    "final_metrics": self.metrics,
                },
            )

        except Exception as e:
            self._status = StrategyStatus.ERROR
            self.logger.error(f"Error stopping strategy: {e}")
            raise

    async def pause_strategy(self):
        """Pause the strategy"""
        if self._status == StrategyStatus.RUNNING:
            self._status = StrategyStatus.PAUSED
            self.logger.info("Strategy paused")

            await self._emit_event(
                "strategy_paused",
                {
                    "strategy_id": self.config.strategy_id,
                    "pause_time": datetime.now(timezone.utc),
                },
            )

    async def resume_strategy(self):
        """Resume the strategy"""
        if self._status == StrategyStatus.PAUSED:
            self._status = StrategyStatus.RUNNING
            self.logger.info("Strategy resumed")

            await self._emit_event(
                "strategy_resumed",
                {
                    "strategy_id": self.config.strategy_id,
                    "resume_time": datetime.now(timezone.utc),
                },
            )

    # Risk management methods

    def _initialize_risk_management(self):
        """Initialize risk management components"""
        self.logger.debug("Initializing risk management")

        # Set up risk monitoring
        self._risk_checks = {
            "position_size": self._check_position_size,
            "portfolio_risk": self._check_portfolio_risk,
            "daily_loss": self._check_daily_loss,
            "drawdown": self._check_drawdown,
            "correlation": self._check_correlation,
        }

    async def _check_risk_limits(self, signal: Dict[str, Any]) -> bool:
        """Check if signal passes risk limits"""
        try:
            for check_name, check_func in self._risk_checks.items():
                if not await check_func(signal):
                    self.logger.warning(f"Risk check failed: {check_name}")
                    return False

            return True

        except Exception as e:
            self.logger.error(f"Error in risk check: {e}")
            return False

    async def _check_position_size(self, signal: Dict[str, Any]) -> bool:
        """Check position size limits"""
        position_size = await self.calculate_position_size(signal)
        max_size = self.config.risk_parameters.max_position_size

        return abs(position_size) <= max_size

    async def _check_portfolio_risk(self, signal: Dict[str, Any]) -> bool:
        """Check portfolio risk limits"""
        # Implementation depends on portfolio manager integration
        return True

    async def _check_daily_loss(self, signal: Dict[str, Any]) -> bool:
        """Check daily loss limits"""
        max_daily_loss = self.config.risk_parameters.max_daily_loss
        current_loss = abs(self._daily_pnl) / self.config.initial_capital

        return current_loss <= max_daily_loss

    async def _check_drawdown(self, signal: Dict[str, Any]) -> bool:
        """Check drawdown limits"""
        max_drawdown = self.config.risk_parameters.max_drawdown
        return self._current_drawdown <= max_drawdown

    async def _check_correlation(self, signal: Dict[str, Any]) -> bool:
        """Check correlation limits"""
        # Implementation depends on correlation calculation
        return True

    async def _emergency_liquidation(self):
        """Emergency liquidation of all positions"""
        self.logger.warning("Initiating emergency liquidation")

        for instrument_id, position in self._current_positions.items():
            if position.is_open():
                # Close position logic would go here
                self.logger.info(f"Closing position: {instrument_id}")

    # Performance tracking methods

    def _update_metrics(self):
        """Update strategy performance metrics"""
        try:
            # Calculate basic metrics
            self._calculate_returns()
            self._calculate_risk_metrics()
            self._calculate_trade_metrics()

            # Update timestamp
            self.metrics.last_updated = datetime.now(timezone.utc)

        except Exception as e:
            self.logger.error(f"Error updating metrics: {e}")

    def _calculate_returns(self):
        """Calculate return metrics"""
        try:
            if not self._trade_history:
                return

            # Calculate total return
            total_pnl = sum(trade.get("pnl", 0) for trade in self._trade_history)
            if self.config.initial_capital > 0:
                self.metrics.total_return = total_pnl / self.config.initial_capital

            # Calculate daily returns
            daily_returns = []
            current_date = None
            daily_pnl = 0

            for trade in sorted(
                self._trade_history, key=lambda x: x.get("timestamp", 0)
            ):
                trade_date = datetime.fromtimestamp(trade.get("timestamp", 0)).date()

                if current_date is None:
                    current_date = trade_date

                if trade_date != current_date:
                    if daily_pnl != 0:
                        daily_returns.append(daily_pnl / self.config.initial_capital)
                    daily_pnl = 0
                    current_date = trade_date

                daily_pnl += trade.get("pnl", 0)

            # Add final day
            if daily_pnl != 0:
                daily_returns.append(daily_pnl / self.config.initial_capital)

            # Calculate Sharpe ratio
            if daily_returns and len(daily_returns) > 1:
                avg_return = sum(daily_returns) / len(daily_returns)
                return_std = (
                    sum((r - avg_return) ** 2 for r in daily_returns)
                    / (len(daily_returns) - 1)
                ) ** 0.5

                if return_std > 0:
                    # Assuming risk-free rate of 2% annually (0.02/252 daily)
                    risk_free_daily = 0.02 / 252
                    self.metrics.sharpe_ratio = (
                        avg_return - risk_free_daily
                    ) / return_std

        except Exception as e:
            self.logger.error(f"Error calculating returns: {e}")

    def _calculate_risk_metrics(self):
        """Calculate risk metrics"""
        try:
            if not self._trade_history:
                return

            # Calculate maximum drawdown
            running_max = 0
            running_pnl = 0
            max_drawdown = 0

            for trade in sorted(
                self._trade_history, key=lambda x: x.get("timestamp", 0)
            ):
                running_pnl += trade.get("pnl", 0)
                running_max = max(running_max, running_pnl)
                drawdown = running_max - running_pnl
                max_drawdown = max(max_drawdown, drawdown)

            if self.config.initial_capital > 0:
                self.metrics.max_drawdown = max_drawdown / self.config.initial_capital

            # Calculate volatility
            pnl_values = [trade.get("pnl", 0) for trade in self._trade_history]
            if len(pnl_values) > 1:
                avg_pnl = sum(pnl_values) / len(pnl_values)
                variance = sum((pnl - avg_pnl) ** 2 for pnl in pnl_values) / (
                    len(pnl_values) - 1
                )
                self.metrics.volatility = (
                    variance**0.5 / self.config.initial_capital
                    if self.config.initial_capital > 0
                    else 0
                )

            # Calculate Value at Risk (95% confidence)
            if len(pnl_values) >= 20:
                sorted_pnl = sorted(pnl_values)
                var_index = int(len(sorted_pnl) * 0.05)  # 5th percentile
                self.metrics.var_95 = (
                    abs(sorted_pnl[var_index]) / self.config.initial_capital
                    if self.config.initial_capital > 0
                    else 0
                )

        except Exception as e:
            self.logger.error(f"Error calculating risk metrics: {e}")

    def _calculate_trade_metrics(self):
        """Calculate trade metrics"""
        if self._trade_history:
            total_trades = len(self._trade_history)
            winning_trades = sum(
                1 for trade in self._trade_history if trade.get("pnl", 0) > 0
            )

            self.metrics.total_trades = total_trades
            self.metrics.winning_trades = winning_trades
            self.metrics.losing_trades = total_trades - winning_trades
            self.metrics.win_rate = (
                winning_trades / total_trades if total_trades > 0 else 0.0
            )

    # Data management methods

    async def _initialize_data_subscriptions(self):
        """Initialize data subscriptions"""
        self.logger.debug("Initializing data subscriptions")

        try:
            # Subscribe to instruments
            for instrument in self.config.instruments:
                self.logger.info(f"Subscribing to data for {instrument}")

                # Subscribe to bars if configured
                if hasattr(self.config, "bar_types") and self.config.bar_types:
                    for bar_type in self.config.bar_types:
                        self.logger.debug(
                            f"Subscribing to {bar_type} bars for {instrument}"
                        )
                        # Actual subscription would be handled by the data engine
                        # self.data_engine.subscribe_bars(instrument, bar_type)

                # Subscribe to quote ticks if configured
                if getattr(self.config, "subscribe_quotes", False):
                    self.logger.debug(f"Subscribing to quote ticks for {instrument}")
                    # self.data_engine.subscribe_quote_ticks(instrument)

                # Subscribe to trade ticks if configured
                if getattr(self.config, "subscribe_trades", False):
                    self.logger.debug(f"Subscribing to trade ticks for {instrument}")
                    # self.data_engine.subscribe_trade_ticks(instrument)

            self.logger.info(
                f"Data subscriptions initialized for {len(self.config.instruments)} instruments"
            )

        except Exception as e:
            self.logger.error(f"Error initializing data subscriptions: {e}")

    def _initialize_indicators(self):
        """Initialize technical indicators"""
        self.logger.debug("Initializing indicators")

        try:
            # Initialize indicator storage
            self._indicators = {}

            # Get indicator configuration from strategy config
            indicator_config = getattr(self.config, "indicators", {})

            for instrument in self.config.instruments:
                self._indicators[instrument] = {}

                # Initialize common indicators if configured
                if "sma" in indicator_config:
                    periods = indicator_config["sma"].get("periods", [20, 50])
                    for period in periods:
                        self._indicators[instrument][f"sma_{period}"] = {
                            "values": [],
                            "period": period,
                            "type": "sma",
                        }

                if "ema" in indicator_config:
                    periods = indicator_config["ema"].get("periods", [12, 26])
                    for period in periods:
                        self._indicators[instrument][f"ema_{period}"] = {
                            "values": [],
                            "period": period,
                            "type": "ema",
                            "alpha": 2.0 / (period + 1),
                        }

                if "rsi" in indicator_config:
                    period = indicator_config["rsi"].get("period", 14)
                    self._indicators[instrument]["rsi"] = {
                        "values": [],
                        "gains": [],
                        "losses": [],
                        "period": period,
                        "type": "rsi",
                    }

                if "macd" in indicator_config:
                    fast = indicator_config["macd"].get("fast", 12)
                    slow = indicator_config["macd"].get("slow", 26)
                    signal = indicator_config["macd"].get("signal", 9)
                    self._indicators[instrument]["macd"] = {
                        "fast_ema": [],
                        "slow_ema": [],
                        "macd_line": [],
                        "signal_line": [],
                        "histogram": [],
                        "fast_period": fast,
                        "slow_period": slow,
                        "signal_period": signal,
                        "type": "macd",
                    }

            self.logger.info(
                f"Indicators initialized for {len(self.config.instruments)} instruments"
            )

        except Exception as e:
            self.logger.error(f"Error initializing indicators: {e}")

    def _initialize_event_handlers(self):
        """Initialize event handlers"""
        self.logger.debug("Initializing event handlers")

        # Set up event handler registry
        self._event_handlers = {
            "strategy_started": [],
            "strategy_stopped": [],
            "strategy_paused": [],
            "strategy_resumed": [],
            "signal_generated": [],
            "order_placed": [],
            "position_opened": [],
            "position_closed": [],
            "risk_limit_breached": [],
            "error_occurred": [],
        }

    async def _emit_event(self, event_type: str, data: Dict[str, Any]):
        """Emit strategy event"""
        try:
            # Call registered handlers
            for handler in self._event_handlers.get(event_type, []):
                await handler(data)

            # Publish to Kafka if configured
            if self.config.kafka_topics:
                await self._publish_to_kafka(event_type, data)

        except Exception as e:
            self.logger.error(f"Error emitting event {event_type}: {e}")

    async def _publish_to_kafka(self, event_type: str, data: Dict[str, Any]):
        """Publish event to Kafka"""
        try:
            if not hasattr(self, "_kafka_producer") or not self._kafka_producer:
                self.logger.warning(
                    "Kafka producer not initialized, skipping event publication"
                )
                return

            # Prepare message
            message = {
                "strategy_id": self.config.strategy_id,
                "event_type": event_type,
                "timestamp": datetime.now(timezone.utc).isoformat(),
                "data": data,
            }

            # Determine topic
            topic = self.config.kafka_topics.get(
                event_type, self.config.kafka_topics.get("default", "strategy_events")
            )

            # Publish message
            # await self._kafka_producer.send(topic, message)
            self.logger.debug(f"Published {event_type} event to Kafka topic {topic}")

        except Exception as e:
            self.logger.error(f"Error publishing to Kafka: {e}")

    # Utility methods

    def get_status(self) -> StrategyStatus:
        """Get current strategy status"""
        return self._status

    def get_metrics(self) -> StrategyMetrics:
        """Get current strategy metrics"""
        return self.metrics

    def get_config(self) -> StrategyConfig:
        """Get strategy configuration"""
        return self.config

    def add_event_handler(self, event_type: str, handler: Callable):
        """Add event handler"""
        if event_type in self._event_handlers:
            self._event_handlers[event_type].append(handler)

    def remove_event_handler(self, event_type: str, handler: Callable):
        """Remove event handler"""
        if (
            event_type in self._event_handlers
            and handler in self._event_handlers[event_type]
        ):
            self._event_handlers[event_type].remove(handler)
