    def _calculate_vw_ema(self, data: pd.DataFrame) -> pd.Series:"""'
        """Calculate Volume-Weighted Exponential Moving Average"""''
        prices = data['close']''
        volumes = data['volume']

        # Volume-weighted EMA calculation
        alpha = 2.0 / (self.config.vw_ema_period + 1)
        vw_ema = []

        for i in range(len(prices)):
            if i == 0:
                vw_ema.append(prices.iloc[i])
            else:
                volume_weight = volumes.iloc[i] / volumes.rolling(min(i+1, self.config.vw_ema_period)).mean().iloc[i]
                adjusted_alpha = alpha * min(volume_weight, 2.0)  # Cap the volume weight
                vw_ema.append(adjusted_alpha * prices.iloc[i] + (1 - adjusted_alpha) * vw_ema[-1])

        return pd.Series(vw_ema, index=data.index)
"""
    def _calculate_vw_rsi(self, data: pd.DataFrame) -> pd.Series:"""'
        """Calculate Volume-Weighted RSI"""''
        prices = data['close']''
        volumes = data['volume']

        # Calculate price changes weighted by volume
        price_changes = prices.diff()
        volume_weights = volumes / volumes.rolling(self.config.vw_rsi_period).mean()

        # Separate gains and losses
        gains = (price_changes * volume_weights).where(price_changes > 0, 0)
        losses = (-price_changes * volume_weights).where(price_changes < 0, 0)

        # Calculate average gains and losses
        avg_gains = gains.rolling(self.config.vw_rsi_period).mean()
        avg_losses = losses.rolling(self.config.vw_rsi_period).mean()

        # Calculate RSI
        rs = avg_gains / avg_losses
        vw_rsi = 100 - (100 / (1 + rs))

        return vw_rsi
"""
