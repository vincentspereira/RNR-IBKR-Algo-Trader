    # Venue breakdown
    venue_performance: Dict[VenueType, Dict[str, float]] = field(default_factory=dict)

    # Risk metrics
    tracking_error: float = 0.0
    maximum_adverse_excursion: float = 0.0
"""
    def get_execution_quality(self) -> ExecutionQuality:"""
        """Determine overall execution quality"""
        if self.success_rate >= 0.95 and abs(self.slippage) <= 0.002:
            return ExecutionQuality.EXCELLENT
        elif self.success_rate >= 0.90 and abs(self.slippage) <= 0.005:
            return ExecutionQuality.GOOD
        elif self.success_rate >= 0.80 and abs(self.slippage) <= 0.01:
            return ExecutionQuality.AVERAGE
        elif self.success_rate >= 0.60:
            return ExecutionQuality.POOR
        else:
            return ExecutionQuality.FAILED


