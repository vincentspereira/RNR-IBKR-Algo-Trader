"""
Arbitrage Strategy Templates

This module implements comprehensive arbitrage trading strategies
for the NautilusTrader engine with 5-pillar architecture compliance.

Strategy Types:
- ArbitrageStrategy: Base arbitrage framework
- StatisticalArbitrageStrategy: Statistical arbitrage with ML
- CrossExchangeArbitrageStrategy: Cross-exchange price differences
- TriangularArbitrageStrategy: Currency triangular arbitrage

Key Features:
- Real-time price monitoring
- Latency optimization
- Risk-free profit identification
- Multi-venue execution
- Transaction cost analysis
"""

import asyncio
from dataclasses import dataclass
from datetime import datetime, timezone
from itertools import combinations
from typing import Any, Dict, List, Optional, Tuple

import networkx as nx
import numpy as np
import pandas as pd
from nautilus_trader.model.data.bar import Bar
from nautilus_trader.model.data.tick import QuoteTick, TradeTick
from nautilus_trader.model.identifiers import InstrumentId
from nautilus_trader.model.orders.limit import LimitOrder
from nautilus_trader.model.orders.market import MarketOrder

from .base import (
    BaseStrategy,
    MarketRegime,
    PositionSizing,
    RiskParameters,
    SignalStrength,
    StrategyConfig,
    StrategyType,
)


@dataclass
class ArbitrageConfig(StrategyConfig):
    """Arbitrage strategy configuration"""

    # Arbitrage parameters
    min_profit_threshold: float = 0.001  # 0.1% minimum profit
    max_execution_time: float = 5.0  # seconds
    transaction_cost: float = 0.0005  # 0.05% per trade
    slippage_tolerance: float = 0.0002  # 0.02%

    # Statistical arbitrage parameters
    lookback_period: int = 60
    z_score_threshold: float = 2.0
    half_life_threshold: int = 10  # bars

    # Cross-exchange parameters
    exchange_pairs: List[Tuple[str, str]] = None
    latency_threshold: float = 100.0  # milliseconds
    min_volume_threshold: float = 1000.0

    # Triangular arbitrage parameters
    currency_triplets: List[Tuple[str, str, str]] = None
    max_chain_length: int = 3

    # Risk management
    max_position_size: float = 0.1  # 10% of portfolio
    max_concurrent_arbitrages: int = 5
    emergency_exit_threshold: float = -0.005  # -0.5% loss

    def __post_init__(self):
        super().__post_init__()
        self.strategy_type = StrategyType.ARBITRAGE

        # Default exchange pairs if not provided
        if self.exchange_pairs is None:
            self.exchange_pairs = [
                ("binance", "coinbase"),
                ("binance", "kraken"),
                ("coinbase", "kraken"),
            ]

        # Default currency triplets if not provided
        if self.currency_triplets is None:
            self.currency_triplets = [
                ("USD", "EUR", "GBP"),
                ("USD", "EUR", "JPY"),
                ("USD", "GBP", "JPY"),
            ]


class ArbitrageStrategy(BaseStrategy):
    """
    Base arbitrage strategy implementation

    Provides framework for arbitrage trading with:
    - Price difference detection
    - Execution timing optimization
    - Transaction cost analysis
    - Risk management
    """

    def __init__(self, config: ArbitrageConfig):
        super().__init__(config)
        self.arbitrage_config: ArbitrageConfig = config

        # Arbitrage tracking
        self._price_feeds = {}
        self._arbitrage_opportunities = {}
        self._execution_times = {}
        self._active_arbitrages = {}

        # Performance metrics
        self._profit_history = []
        self._execution_latency = []

        self.logger.info(
            f"Initialized ArbitrageStrategy with config: {config.strategy_name}"
        )

    async def on_start(self):
        """Initialize arbitrage strategy"""
        self.logger.info("Starting arbitrage strategy")

        # Initialize tracking for each instrument
        for instrument in self.config.instruments:
            self._price_feeds[instrument] = {}
            self._arbitrage_opportunities[instrument] = []
            self._execution_times[instrument] = []
            self._active_arbitrages[instrument] = {}

    async def on_stop(self):
        """Clean up arbitrage strategy"""
        self.logger.info("Stopping arbitrage strategy")

        # Close any active arbitrages
        for instrument in self._active_arbitrages:
            for arb_id in list(self._active_arbitrages[instrument].keys()):
                await self._close_arbitrage(instrument, arb_id)

        # Clear tracking data
        self._price_feeds.clear()
        self._arbitrage_opportunities.clear()
        self._execution_times.clear()
        self._active_arbitrages.clear()

    async def on_bar(self, bar: Bar):
        """Process new bar data"""
        instrument_id = bar.bar_type.instrument_id

        # Update price feeds
        await self._update_price_feed(instrument_id, bar)

        # Generate signals
        signals = await self.generate_signals(instrument_id)

        # Process signals
        for signal in signals:
            await self._process_signal(signal)

    async def on_quote_tick(self, tick: QuoteTick):
        """Process quote tick for real-time arbitrage"""
        instrument_id = tick.instrument_id

        # Update real-time price feed
        await self._update_tick_feed(instrument_id, tick)

        # Check for immediate arbitrage opportunities
        await self._check_real_time_arbitrage(instrument_id, tick)

    async def on_trade_tick(self, tick: TradeTick):
        """Process trade tick for execution confirmation"""
        instrument_id = tick.instrument_id

        # Update execution tracking
        await self._update_execution_tracking(instrument_id, tick)

    async def generate_signals(
        self, instrument_id: InstrumentId
    ) -> List[Dict[str, Any]]:
        """Generate arbitrage signals"""
        signals = []

        try:
            # Check for arbitrage opportunities
            opportunities = await self._identify_arbitrage_opportunities(instrument_id)

            for opportunity in opportunities:
                if await self._validate_arbitrage_opportunity(opportunity):
                    signal = {
                        "instrument_id": instrument_id,
                        "signal_type": "arbitrage",
                        "opportunity_type": opportunity["type"],
                        "expected_profit": opportunity["profit"],
                        "execution_plan": opportunity["execution_plan"],
                        "risk_assessment": opportunity["risk"],
                        "timestamp": datetime.now(timezone.utc),
                        "confidence": opportunity["confidence"],
                    }

                    signals.append(signal)

            return signals

        except Exception as e:
            self.logger.error(f"Error generating arbitrage signals: {e}")
            return []

    async def calculate_position_size(self, signal: Dict[str, Any]) -> float:
        """Calculate position size for arbitrage opportunity"""
        try:
            # Base position size
            base_size = self.arbitrage_config.max_position_size

            # Adjust for expected profit
            profit_multiplier = min(
                signal["expected_profit"] / self.arbitrage_config.min_profit_threshold,
                3.0,
            )

            # Adjust for risk assessment
            risk_adjustment = 1.0 - signal["risk_assessment"].get("total_risk", 0.0)

            # Calculate final size
            position_size = base_size * profit_multiplier * risk_adjustment

            return position_size

        except Exception as e:
            self.logger.error(f"Error calculating position size: {e}")
            return 0.0

    async def _update_price_feed(self, instrument_id: InstrumentId, bar: Bar):
        """Update price feed with new bar data"""
        try:
            instrument_str = str(instrument_id)

            # Store bar data
            if instrument_str not in self._bars:
                self._bars[instrument_str] = pd.DataFrame()

            # Add new bar
            bar_data = {
                "timestamp": bar.ts_init,
                "open": float(bar.open),
                "high": float(bar.high),
                "low": float(bar.low),
                "close": float(bar.close),
                "volume": float(bar.volume),
            }

            self._bars[instrument_str] = pd.concat(
                [self._bars[instrument_str], pd.DataFrame([bar_data])]
            ).tail(self.arbitrage_config.lookback_periods)

            # Update price feed
            self._price_feeds[instrument_str]["last_price"] = float(bar.close)
            self._price_feeds[instrument_str]["last_update"] = datetime.now(
                timezone.utc
            )

        except Exception as e:
            self.logger.error(f"Error updating price feed: {e}")

    async def _update_tick_feed(self, instrument_id: InstrumentId, tick: QuoteTick):
        """Update real-time tick feed"""
        try:
            instrument_str = str(instrument_id)

            # Update bid/ask prices
            self._price_feeds[instrument_str]["bid"] = float(tick.bid)
            self._price_feeds[instrument_str]["ask"] = float(tick.ask)
            self._price_feeds[instrument_str]["spread"] = float(tick.ask - tick.bid)
            self._price_feeds[instrument_str]["tick_update"] = datetime.now(
                timezone.utc
            )

        except Exception as e:
            self.logger.error(f"Error updating tick feed: {e}")

    async def _identify_arbitrage_opportunities(
        self, instrument_id: InstrumentId
    ) -> List[Dict[str, Any]]:
        """Identify potential arbitrage opportunities"""
        opportunities = []

        try:
            # This is a base implementation - specific strategies will override
            instrument_str = str(instrument_id)
            price_data = self._price_feeds.get(instrument_str, {})

            if not price_data:
                return opportunities

            # Simple price difference arbitrage (placeholder)
            current_price = price_data.get("last_price", 0)
            if current_price > 0:
                # Check against historical average (simplified)
                df = self._bars.get(instrument_str)
                if df is not None and len(df) > 10:
                    avg_price = df["close"].tail(10).mean()
                    price_diff = (current_price - avg_price) / avg_price

                    if abs(price_diff) > self.arbitrage_config.min_profit_threshold:
                        opportunity = {
                            "type": "price_reversion",
                            "instrument": instrument_id,
                            "current_price": current_price,
                            "target_price": avg_price,
                            "profit": abs(price_diff)
                            - self.arbitrage_config.transaction_cost,
                            "execution_plan": self._create_execution_plan(
                                instrument_id, price_diff
                            ),
                            "risk": self._assess_arbitrage_risk(
                                instrument_id, price_diff
                            ),
                            "confidence": min(abs(price_diff) * 10, 0.9),
                        }

                        opportunities.append(opportunity)

            return opportunities

        except Exception as e:
            self.logger.error(f"Error identifying arbitrage opportunities: {e}")
            return []

    async def _validate_arbitrage_opportunity(
        self, opportunity: Dict[str, Any]
    ) -> bool:
        """Validate arbitrage opportunity"""
        try:
            # Check minimum profit threshold
            if opportunity["profit"] < self.arbitrage_config.min_profit_threshold:
                return False

            # Check maximum concurrent arbitrages
            active_count = sum(len(arbs) for arbs in self._active_arbitrages.values())
            if active_count >= self.arbitrage_config.max_concurrent_arbitrages:
                return False

            # Check execution time feasibility
            execution_plan = opportunity["execution_plan"]
            estimated_time = execution_plan.get("estimated_time", float("inf"))
            if estimated_time > self.arbitrage_config.max_execution_time:
                return False

            # Check risk assessment
            risk_assessment = opportunity["risk"]
            if risk_assessment.get("total_risk", 1.0) > 0.5:  # 50% risk threshold
                return False

            return True

        except Exception as e:
            self.logger.error(f"Error validating arbitrage opportunity: {e}")
            return False

    def _create_execution_plan(
        self, instrument_id: InstrumentId, price_diff: float
    ) -> Dict[str, Any]:
        """Create execution plan for arbitrage"""
        try:
            plan = {
                "instrument": instrument_id,
                "direction": 1 if price_diff < 0 else -1,  # Buy low, sell high
                "estimated_time": 2.0,  # seconds
                "steps": [
                    {
                        "action": "buy" if price_diff < 0 else "sell",
                        "timing": "immediate",
                        "order_type": "market",
                    },
                    {
                        "action": "sell" if price_diff < 0 else "buy",
                        "timing": "after_fill",
                        "order_type": "limit",
                    },
                ],
            }

            return plan

        except Exception as e:
            self.logger.error(f"Error creating execution plan: {e}")
            return {}

    def _assess_arbitrage_risk(
        self, instrument_id: InstrumentId, price_diff: float
    ) -> Dict[str, Any]:
        """Assess risk for arbitrage opportunity"""
        try:
            # Calculate various risk factors
            execution_risk = min(abs(price_diff) * 2, 0.3)  # Higher diff = higher risk
            liquidity_risk = 0.1  # Placeholder
            timing_risk = 0.05  # Placeholder

            total_risk = execution_risk + liquidity_risk + timing_risk

            risk_assessment = {
                "execution_risk": execution_risk,
                "liquidity_risk": liquidity_risk,
                "timing_risk": timing_risk,
                "total_risk": min(total_risk, 1.0),
                "risk_level": "low"
                if total_risk < 0.2
                else "medium"
                if total_risk < 0.5
                else "high",
            }

            return risk_assessment

        except Exception as e:
            self.logger.error(f"Error assessing arbitrage risk: {e}")
            return {"total_risk": 1.0, "risk_level": "high"}

    async def _check_real_time_arbitrage(
        self, instrument_id: InstrumentId, tick: QuoteTick
    ):
        """Check for real-time arbitrage opportunities"""
        try:
            # This method would be implemented by specific arbitrage strategies
            # for real-time opportunity detection

            # Base implementation: log the tick for monitoring
            self.logger.debug(
                f"Processing real-time tick for {instrument_id}: {tick.bid_price}/{tick.ask_price}"
            )

            # Subclasses should override this method to implement specific arbitrage logic
            # such as cross-exchange price comparison, statistical arbitrage detection, etc.
            await self._log_opportunity_metrics(instrument_id, tick)

        except Exception as e:
            self.logger.error(f"Error checking real-time arbitrage: {e}")

    async def _update_execution_tracking(
        self, instrument_id: InstrumentId, tick: TradeTick
    ):
        """Update execution tracking with trade tick"""
        try:
            instrument_str = str(instrument_id)

            # Record execution latency
            current_time = datetime.now(timezone.utc)
            self._execution_latency.append(
                {
                    "instrument": instrument_str,
                    "timestamp": current_time,
                    "price": float(tick.price),
                    "size": float(tick.size),
                }
            )

            # Keep only recent latency data
            self._execution_latency = self._execution_latency[-100:]

        except Exception as e:
            self.logger.error(f"Error updating execution tracking: {e}")

    async def _close_arbitrage(self, instrument: str, arb_id: str):
        """Close active arbitrage position"""
        try:
            arbitrage = self._active_arbitrages[instrument].get(arb_id)
            if arbitrage:
                # Close position logic would go here
                self.logger.info(f"Closing arbitrage {arb_id} for {instrument}")

                # Remove from active arbitrages
                del self._active_arbitrages[instrument][arb_id]

        except Exception as e:
            self.logger.error(f"Error closing arbitrage: {e}")


class StatisticalArbitrageStrategy(ArbitrageStrategy):
    """
    Statistical arbitrage strategy using ML models

    Features:
    - Mean reversion detection
    - Cointegration analysis
    - Machine learning predictions
    - Risk-adjusted returns
    """

    def __init__(self, config: ArbitrageConfig):
        super().__init__(config)

        # Statistical arbitrage specific parameters
        self._cointegration_pairs = {}
        self._ml_models = {}
        self._prediction_cache = {}

        self.logger.info("Initialized StatisticalArbitrageStrategy")

    async def generate_signals(
        self, instrument_id: InstrumentId
    ) -> List[Dict[str, Any]]:
        """Generate statistical arbitrage signals"""
        signals = []

        try:
            # Find cointegrated pairs
            pairs = await self._find_cointegrated_pairs(instrument_id)

            for pair_instrument in pairs:
                # Calculate statistical measures
                stats = await self._calculate_pair_statistics(
                    instrument_id, pair_instrument
                )

                # Check for arbitrage opportunity
                if await self._detect_statistical_arbitrage(stats):
                    signal = {
                        "instrument_id": instrument_id,
                        "pair_instrument": pair_instrument,
                        "signal_type": "statistical_arbitrage",
                        "z_score": stats["z_score"],
                        "half_life": stats["half_life"],
                        "expected_profit": stats["expected_profit"],
                        "execution_plan": await self._create_pairs_execution_plan(
                            instrument_id, pair_instrument, stats
                        ),
                        "risk_assessment": await self._assess_pairs_risk(stats),
                        "timestamp": datetime.now(timezone.utc),
                        "confidence": stats["confidence"],
                    }

                    signals.append(signal)

            return signals

        except Exception as e:
            self.logger.error(f"Error generating statistical arbitrage signals: {e}")
            return []

    async def _find_cointegrated_pairs(self, instrument_id: InstrumentId) -> List[str]:
        """Find cointegrated instrument pairs"""
        cointegrated_pairs = []

        try:
            for other_instrument in self.config.instruments:
                if other_instrument == str(instrument_id):
                    continue

                # Test cointegration
                is_cointegrated = await self._test_cointegration(
                    instrument_id, other_instrument
                )

                if is_cointegrated:
                    cointegrated_pairs.append(other_instrument)

            return cointegrated_pairs

        except Exception as e:
            self.logger.error(f"Error finding cointegrated pairs: {e}")
            return []

    async def _test_cointegration(
        self, instrument1: InstrumentId, instrument2: str
    ) -> bool:
        """Test cointegration between two instruments"""
        try:
            df1 = self._bars.get(str(instrument1))
            df2 = self._bars.get(instrument2)

            if df1 is None or df2 is None:
                return False

            period = self.arbitrage_config.lookback_period

            if len(df1) < period or len(df2) < period:
                return False

            # Get price series
            prices1 = df1["close"].tail(period).values
            prices2 = df2["close"].tail(period).values

            # Simple cointegration test (in practice, use Johansen test or ADF)
            correlation = np.corrcoef(prices1, prices2)[0, 1]

            return abs(correlation) > 0.8  # Simplified threshold

        except Exception as e:
            self.logger.error(f"Error testing cointegration: {e}")
            return False

    async def _calculate_pair_statistics(
        self, instrument1: InstrumentId, instrument2: str
    ) -> Dict[str, Any]:
        """Calculate statistical measures for pair"""
        try:
            df1 = self._bars.get(str(instrument1))
            df2 = self._bars.get(instrument2)

            if df1 is None or df2 is None:
                return {}

            period = self.arbitrage_config.lookback_period

            # Get price series
            prices1 = df1["close"].tail(period)
            prices2 = df2["close"].tail(period)

            # Calculate spread
            spread = prices2 - prices1
            spread_mean = spread.mean()
            spread_std = spread.std()

            # Calculate Z-score
            current_spread = prices2.iloc[-1] - prices1.iloc[-1]
            z_score = (
                (current_spread - spread_mean) / spread_std if spread_std > 0 else 0
            )

            # Calculate half-life (simplified)
            half_life = self._calculate_half_life(spread.values)

            # Expected profit calculation
            expected_profit = (
                abs(z_score) * spread_std / prices1.iloc[-1]
                - self.arbitrage_config.transaction_cost
            )

            stats = {
                "z_score": z_score,
                "half_life": half_life,
                "spread_mean": spread_mean,
                "spread_std": spread_std,
                "expected_profit": expected_profit,
                "confidence": min(abs(z_score) / 3.0, 0.9),
            }

            return stats

        except Exception as e:
            self.logger.error(f"Error calculating pair statistics: {e}")
            return {}

    def _calculate_half_life(self, spread: np.ndarray) -> float:
        """Calculate mean reversion half-life"""
        try:
            # Simple AR(1) model for half-life calculation
            spread_lag = spread[:-1]
            spread_diff = np.diff(spread)

            if len(spread_lag) == 0 or len(spread_diff) == 0:
                return float("inf")

            # Linear regression
            X = spread_lag.reshape(-1, 1)
            y = spread_diff

            # Calculate coefficient (simplified)
            coef = (
                np.corrcoef(spread_lag, spread_diff)[0, 1] if len(spread_lag) > 1 else 0
            )

            if coef >= 0:
                return float("inf")

            half_life = -np.log(2) / np.log(1 + coef)

            return max(half_life, 1.0)

        except Exception as e:
            self.logger.error(f"Error calculating half-life: {e}")
            return float("inf")

    async def _detect_statistical_arbitrage(self, stats: Dict[str, Any]) -> bool:
        """Detect statistical arbitrage opportunity"""
        try:
            if not stats:
                return False

            # Check Z-score threshold
            if abs(stats["z_score"]) < self.arbitrage_config.z_score_threshold:
                return False

            # Check half-life threshold
            if stats["half_life"] > self.arbitrage_config.half_life_threshold:
                return False

            # Check expected profit
            if stats["expected_profit"] < self.arbitrage_config.min_profit_threshold:
                return False

            return True

        except Exception as e:
            self.logger.error(f"Error detecting statistical arbitrage: {e}")
            return False

    async def _create_pairs_execution_plan(
        self, instrument1: InstrumentId, instrument2: str, stats: Dict[str, Any]
    ) -> Dict[str, Any]:
        """Create execution plan for pairs trading"""
        try:
            z_score = stats["z_score"]

            plan = {
                "instrument1": instrument1,
                "instrument2": instrument2,
                "direction1": -1 if z_score > 0 else 1,  # Mean reversion
                "direction2": 1 if z_score > 0 else -1,
                "estimated_time": stats["half_life"],
                "steps": [
                    {
                        "instrument": instrument1,
                        "action": "sell" if z_score > 0 else "buy",
                        "timing": "immediate",
                        "order_type": "market",
                    },
                    {
                        "instrument": instrument2,
                        "action": "buy" if z_score > 0 else "sell",
                        "timing": "immediate",
                        "order_type": "market",
                    },
                ],
            }

            return plan

        except Exception as e:
            self.logger.error(f"Error creating pairs execution plan: {e}")
            return {}

    async def _assess_pairs_risk(self, stats: Dict[str, Any]) -> Dict[str, Any]:
        """Assess risk for pairs trading"""
        try:
            # Calculate risk factors
            mean_reversion_risk = 1.0 / max(
                stats.get("half_life", 1), 1
            )  # Faster reversion = lower risk
            volatility_risk = min(stats.get("spread_std", 0) * 10, 0.5)
            execution_risk = 0.1  # Base execution risk

            total_risk = mean_reversion_risk + volatility_risk + execution_risk

            risk_assessment = {
                "mean_reversion_risk": mean_reversion_risk,
                "volatility_risk": volatility_risk,
                "execution_risk": execution_risk,
                "total_risk": min(total_risk, 1.0),
                "risk_level": "low"
                if total_risk < 0.3
                else "medium"
                if total_risk < 0.6
                else "high",
            }

            return risk_assessment

        except Exception as e:
            self.logger.error(f"Error assessing pairs risk: {e}")
            return {"total_risk": 1.0, "risk_level": "high"}


class CrossExchangeArbitrageStrategy(ArbitrageStrategy):
    """
    Cross-exchange arbitrage strategy

    Features:
    - Multi-exchange price monitoring
    - Latency optimization
    - Volume analysis
    - Execution coordination
    """

    def __init__(self, config: ArbitrageConfig):
        super().__init__(config)

        # Cross-exchange specific parameters
        self._exchange_prices = {}
        self._exchange_volumes = {}
        self._latency_measurements = {}

        self.logger.info("Initialized CrossExchangeArbitrageStrategy")

    async def generate_signals(
        self, instrument_id: InstrumentId
    ) -> List[Dict[str, Any]]:
        """Generate cross-exchange arbitrage signals"""
        signals = []

        try:
            # Check all exchange pairs
            for exchange1, exchange2 in self.arbitrage_config.exchange_pairs:
                opportunity = await self._detect_cross_exchange_opportunity(
                    instrument_id, exchange1, exchange2
                )

                if opportunity:
                    signal = {
                        "instrument_id": instrument_id,
                        "signal_type": "cross_exchange_arbitrage",
                        "buy_exchange": opportunity["buy_exchange"],
                        "sell_exchange": opportunity["sell_exchange"],
                        "price_difference": opportunity["price_difference"],
                        "expected_profit": opportunity["expected_profit"],
                        "execution_plan": opportunity["execution_plan"],
                        "risk_assessment": opportunity["risk_assessment"],
                        "timestamp": datetime.now(timezone.utc),
                        "confidence": opportunity["confidence"],
                    }

                    signals.append(signal)

            return signals

        except Exception as e:
            self.logger.error(f"Error generating cross-exchange arbitrage signals: {e}")
            return []

    async def _detect_cross_exchange_opportunity(
        self, instrument_id: InstrumentId, exchange1: str, exchange2: str
    ) -> Optional[Dict[str, Any]]:
        """Detect cross-exchange arbitrage opportunity"""
        try:
            # Get prices from both exchanges (simulated)
            price1 = await self._get_exchange_price(instrument_id, exchange1)
            price2 = await self._get_exchange_price(instrument_id, exchange2)

            if price1 is None or price2 is None:
                return None

            # Calculate price difference
            price_diff = abs(price1 - price2)
            price_diff_pct = price_diff / min(price1, price2)

            # Check if profitable after costs
            total_cost = self.arbitrage_config.transaction_cost * 2  # Two trades
            net_profit = price_diff_pct - total_cost

            if net_profit < self.arbitrage_config.min_profit_threshold:
                return None

            # Determine buy/sell exchanges
            buy_exchange = exchange1 if price1 < price2 else exchange2
            sell_exchange = exchange2 if price1 < price2 else exchange1
            buy_price = min(price1, price2)
            sell_price = max(price1, price2)

            # Check volume availability
            if not await self._check_exchange_volume(
                instrument_id, buy_exchange, sell_exchange
            ):
                return None

            # Check latency
            if not await self._check_execution_latency(buy_exchange, sell_exchange):
                return None

            opportunity = {
                "buy_exchange": buy_exchange,
                "sell_exchange": sell_exchange,
                "buy_price": buy_price,
                "sell_price": sell_price,
                "price_difference": price_diff,
                "expected_profit": net_profit,
                "execution_plan": self._create_cross_exchange_plan(
                    instrument_id, buy_exchange, sell_exchange, buy_price, sell_price
                ),
                "risk_assessment": self._assess_cross_exchange_risk(
                    price_diff_pct, buy_exchange, sell_exchange
                ),
                "confidence": min(
                    net_profit / self.arbitrage_config.min_profit_threshold, 0.9
                ),
            }

            return opportunity

        except Exception as e:
            self.logger.error(f"Error detecting cross-exchange opportunity: {e}")
            return None

    async def _get_exchange_price(
        self, instrument_id: InstrumentId, exchange: str
    ) -> Optional[float]:
        """Get current price from specific exchange"""
        try:
            # This would connect to actual exchange APIs
            # For now, simulate with some price variation
            base_price = self._price_feeds.get(str(instrument_id), {}).get(
                "last_price", 100.0
            )

            # Simulate exchange-specific price differences
            exchange_multipliers = {
                "binance": 1.0,
                "coinbase": 1.001,
                "kraken": 0.999,
                "bitfinex": 1.002,
            }

            multiplier = exchange_multipliers.get(exchange, 1.0)
            return base_price * multiplier

        except Exception as e:
            self.logger.error(f"Error getting exchange price: {e}")
            return None

    async def _check_exchange_volume(
        self, instrument_id: InstrumentId, buy_exchange: str, sell_exchange: str
    ) -> bool:
        """Check if sufficient volume is available on both exchanges"""
        try:
            # This would check actual exchange order books
            # For now, simulate volume check
            return True  # Simplified

        except Exception as e:
            self.logger.error(f"Error checking exchange volume: {e}")
            return False

    async def _check_execution_latency(self, exchange1: str, exchange2: str) -> bool:
        """Check if execution latency is within acceptable limits"""
        try:
            # This would measure actual latency to exchanges
            # For now, simulate latency check
            simulated_latency = 50.0  # milliseconds
            return simulated_latency < self.arbitrage_config.latency_threshold

        except Exception as e:
            self.logger.error(f"Error checking execution latency: {e}")
            return False

    def _create_cross_exchange_plan(
        self,
        instrument_id: InstrumentId,
        buy_exchange: str,
        sell_exchange: str,
        buy_price: float,
        sell_price: float,
    ) -> Dict[str, Any]:
        """Create execution plan for cross-exchange arbitrage"""
        try:
            plan = {
                "instrument": instrument_id,
                "simultaneous_execution": True,
                "steps": [
                    {
                        "exchange": buy_exchange,
                        "action": "buy",
                        "price": buy_price,
                        "timing": "immediate",
                        "order_type": "market",
                    },
                    {
                        "exchange": sell_exchange,
                        "action": "sell",
                        "price": sell_price,
                        "timing": "immediate",
                        "order_type": "market",
                    },
                ],
                "estimated_time": 1.0,  # seconds
            }

            return plan

        except Exception as e:
            self.logger.error(f"Error creating cross-exchange plan: {e}")
            return {}

    def _assess_cross_exchange_risk(
        self, price_diff_pct: float, buy_exchange: str, sell_exchange: str
    ) -> Dict[str, Any]:
        """Assess risk for cross-exchange arbitrage"""
        try:
            # Calculate risk factors
            execution_risk = min(price_diff_pct * 5, 0.3)  # Higher spread = higher risk
            latency_risk = 0.1  # Base latency risk
            liquidity_risk = 0.05  # Base liquidity risk
            exchange_risk = 0.02  # Exchange-specific risk

            total_risk = execution_risk + latency_risk + liquidity_risk + exchange_risk

            risk_assessment = {
                "execution_risk": execution_risk,
                "latency_risk": latency_risk,
                "liquidity_risk": liquidity_risk,
                "exchange_risk": exchange_risk,
                "total_risk": min(total_risk, 1.0),
                "risk_level": "low"
                if total_risk < 0.2
                else "medium"
                if total_risk < 0.5
                else "high",
            }

            return risk_assessment

        except Exception as e:
            self.logger.error(f"Error assessing cross-exchange risk: {e}")
            return {"total_risk": 1.0, "risk_level": "high"}


class TriangularArbitrageStrategy(ArbitrageStrategy):
    """
    Triangular arbitrage strategy for currency markets

    Features:
    - Currency triplet analysis
    - Exchange rate calculations
    - Path optimization
    - Multi-leg execution
    """

    def __init__(self, config: ArbitrageConfig):
        super().__init__(config)

        # Triangular arbitrage specific parameters
        self._currency_rates = {}
        self._arbitrage_paths = {}
        self._rate_graph = nx.DiGraph()

        self.logger.info("Initialized TriangularArbitrageStrategy")

    async def generate_signals(
        self, instrument_id: InstrumentId
    ) -> List[Dict[str, Any]]:
        """Generate triangular arbitrage signals"""
        signals = []

        try:
            # Update currency rate graph
            await self._update_rate_graph()

            # Check all currency triplets
            for triplet in self.arbitrage_config.currency_triplets:
                opportunity = await self._detect_triangular_opportunity(triplet)

                if opportunity:
                    signal = {
                        "instrument_id": instrument_id,
                        "signal_type": "triangular_arbitrage",
                        "currency_triplet": triplet,
                        "arbitrage_path": opportunity["path"],
                        "expected_profit": opportunity["expected_profit"],
                        "execution_plan": opportunity["execution_plan"],
                        "risk_assessment": opportunity["risk_assessment"],
                        "timestamp": datetime.now(timezone.utc),
                        "confidence": opportunity["confidence"],
                    }

                    signals.append(signal)

            return signals

        except Exception as e:
            self.logger.error(f"Error generating triangular arbitrage signals: {e}")
            return []

    async def _update_rate_graph(self):
        """Update currency exchange rate graph"""
        try:
            # Clear existing graph
            self._rate_graph.clear()

            # Add currency pairs and rates (simulated)
            currency_pairs = [
                ("USD", "EUR", 0.85),
                ("EUR", "USD", 1.18),
                ("USD", "GBP", 0.73),
                ("GBP", "USD", 1.37),
                ("EUR", "GBP", 0.86),
                ("GBP", "EUR", 1.16),
                ("USD", "JPY", 110.0),
                ("JPY", "USD", 0.0091),
                ("EUR", "JPY", 129.0),
                ("JPY", "EUR", 0.0078),
            ]

            for base, quote, rate in currency_pairs:
                self._rate_graph.add_edge(base, quote, rate=rate, weight=-np.log(rate))
                self._currency_rates[f"{base}/{quote}"] = rate

        except Exception as e:
            self.logger.error(f"Error updating rate graph: {e}")

    async def _detect_triangular_opportunity(
        self, triplet: Tuple[str, str, str]
    ) -> Optional[Dict[str, Any]]:
        """Detect triangular arbitrage opportunity"""
        try:
            curr1, curr2, curr3 = triplet

            # Find all possible paths
            paths = [[curr1, curr2, curr3, curr1], [curr1, curr3, curr2, curr1]]

            best_opportunity = None
            best_profit = 0

            for path in paths:
                opportunity = await self._calculate_path_profit(path)

                if opportunity and opportunity["profit"] > best_profit:
                    best_profit = opportunity["profit"]
                    best_opportunity = opportunity

            if (
                best_opportunity
                and best_profit > self.arbitrage_config.min_profit_threshold
            ):
                return best_opportunity

            return None

        except Exception as e:
            self.logger.error(f"Error detecting triangular opportunity: {e}")
            return None

    async def _calculate_path_profit(self, path: List[str]) -> Optional[Dict[str, Any]]:
        """Calculate profit for a specific arbitrage path"""
        try:
            if len(path) < 4:
                return None

            # Calculate total exchange rate through the path
            total_rate = 1.0
            execution_steps = []

            for i in range(len(path) - 1):
                from_curr = path[i]
                to_curr = path[i + 1]

                # Get exchange rate
                rate_key = f"{from_curr}/{to_curr}"
                rate = self._currency_rates.get(rate_key)

                if rate is None:
                    return None

                total_rate *= rate

                execution_steps.append(
                    {
                        "from_currency": from_curr,
                        "to_currency": to_curr,
                        "rate": rate,
                        "action": f"Exchange {from_curr} to {to_curr}",
                    }
                )

            # Calculate profit (should be > 1.0 for profitable arbitrage)
            gross_profit = total_rate - 1.0

            # Subtract transaction costs
            num_trades = len(execution_steps)
            total_cost = self.arbitrage_config.transaction_cost * num_trades
            net_profit = gross_profit - total_cost

            if net_profit <= 0:
                return None

            opportunity = {
                "path": path,
                "execution_steps": execution_steps,
                "total_rate": total_rate,
                "profit": net_profit,
                "expected_profit": net_profit,
                "execution_plan": self._create_triangular_execution_plan(
                    execution_steps
                ),
                "risk_assessment": self._assess_triangular_risk(path, net_profit),
                "confidence": min(
                    net_profit / self.arbitrage_config.min_profit_threshold, 0.9
                ),
            }

            return opportunity

        except Exception as e:
            self.logger.error(f"Error calculating path profit: {e}")
            return None

    def _create_triangular_execution_plan(
        self, execution_steps: List[Dict[str, Any]]
    ) -> Dict[str, Any]:
        """Create execution plan for triangular arbitrage"""
        try:
            plan = {
                "execution_type": "sequential",
                "steps": [],
                "estimated_time": len(execution_steps) * 0.5,  # 0.5 seconds per step
            }

            for i, step in enumerate(execution_steps):
                plan_step = {
                    "step_number": i + 1,
                    "from_currency": step["from_currency"],
                    "to_currency": step["to_currency"],
                    "exchange_rate": step["rate"],
                    "action": step["action"],
                    "timing": "immediate" if i == 0 else "after_previous",
                    "order_type": "market",
                }

                plan["steps"].append(plan_step)

            return plan

        except Exception as e:
            self.logger.error(f"Error creating triangular execution plan: {e}")
            return {}

    def _assess_triangular_risk(self, path: List[str], profit: float) -> Dict[str, Any]:
        """Assess risk for triangular arbitrage"""
        try:
            # Calculate risk factors
            path_length_risk = (len(path) - 3) * 0.05  # Longer paths = higher risk
            execution_risk = min(profit * 2, 0.2)  # Higher profit = higher risk
            rate_volatility_risk = 0.1  # Base rate volatility risk
            timing_risk = len(path) * 0.02  # More steps = higher timing risk

            total_risk = (
                path_length_risk + execution_risk + rate_volatility_risk + timing_risk
            )

            risk_assessment = {
                "path_length_risk": path_length_risk,
                "execution_risk": execution_risk,
                "rate_volatility_risk": rate_volatility_risk,
                "timing_risk": timing_risk,
                "total_risk": min(total_risk, 1.0),
                "risk_level": "low"
                if total_risk < 0.2
                else "medium"
                if total_risk < 0.5
                else "high",
            }

            return risk_assessment

        except Exception as e:
            self.logger.error(f"Error assessing triangular risk: {e}")
            return {"total_risk": 1.0, "risk_level": "high"}
